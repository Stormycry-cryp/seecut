+  if (value.attemptId !== journal.attemptId) throw fail("原生任务查询回执无效", "SEECUT_JOURNAL_INVALID", 409);
+  journal.status = nativeStatus(value);
+  journal.capturedCredits = actualCredits(value.tasks ?? []);
+  journal.dispatched = value.dispatched;
+  journal.readyToSubmit = value.readyToSubmit;
+  journal.error = value.error ? messageOf(value.error) : undefined;
+  if (journal.status === "completed") await registerResults(directory, path, journal, signal);
+  else await persist(path, journal);
+}
+
+export async function recoverSeecutMedia(cwd: string, mediaType: "image" | "video" | "audio", clientRequestId: string, outputDirectory?: string, signal?: AbortSignal) {
+  const { directory, projectId } = await workspace(cwd);
+  const path = await journalPath(directory, clientRequestId);
+  const current = await readJournal(path);
+  if (!current) throw fail("找不到此节点的原生成记录，请保留请求编号并核对", "SEECUT_GENERATION_NOT_FOUND", 404);
+  if (current.projectId !== projectId || current.clientRequestId !== clientRequestId || current.mediaType !== mediaType || outputDirectory !== undefined && outputDirectory !== current.outputDirectory) throw fail("恢复参数与原生成任务不一致", "SEECUT_JOURNAL_MISMATCH", 409);
+  await account(current.scopeKey);
+  if (active.has(path)) return publicJournal(current);
+  if (current.status === "failed") return publicJournal(current);
+  const pending = recovery.get(path);
+  if (pending) return pending;
+  const work = (async () => {
+    try { await refresh(directory, path, current, signal); }
+    catch (error) {
+      current.status = "unknown"; current.error = messageOf(error); await persist(path, current);
+      if (["FLOW_ACCOUNT_CHANGED", "SIGNED_OUT", "SEECUT_JOURNAL_MISMATCH", "SEECUT_JOURNAL_INVALID"].includes(String((error as { code?: string }).code))) throw error;
+    }
+    return publicJournal(current);
+  })();
+  recovery.set(path, work);
+  try { return await work; } finally { if (recovery.get(path) === work) recovery.delete(path); }
+}
+
+/** Explicit user action only: submit the original frozen attempt, never prepare a replacement. */
+export async function resumeSeecutGeneration(cwd: string, mediaType: "image" | "video" | "audio", clientRequestId: string, outputDirectory?: string) {
+  const { directory, projectId } = await workspace(cwd);
+  const path = await journalPath(directory, clientRequestId);
+  let journal = await readJournal(path);
+  if (!journal) throw fail("找不到原生成记录，不能继续提交", "SEECUT_GENERATION_NOT_FOUND", 404);
+  if (journal.projectId !== projectId || journal.clientRequestId !== clientRequestId || journal.mediaType !== mediaType || outputDirectory !== undefined && outputDirectory !== journal.outputDirectory) throw fail("继续提交参数与原任务不一致", "SEECUT_JOURNAL_MISMATCH", 409);
+  await account(journal.scopeKey);
+  if (active.has(path)) throw fail("原生成请求仍在处理，请先查询原任务", "SEECUT_GENERATION_PENDING", 409);
+  const submittedAlready = resuming.get(path);
+  if (submittedAlready) return submittedAlready;
+  const pending = recovery.get(path);
+  const work = (async () => {
+    if (pending) {
+      await pending;
+      journal = (await readJournal(path))!;
+      await account(journal.scopeKey);
+    }
+    await refresh(directory, path, journal);
+    if (journal.dispatched === true) return publicJournal(journal);
+    if (journal.dispatched !== false || journal.readyToSubmit !== true || journal.status !== "prepared" || !journal.attemptId) throw fail("原任务尚无可继续提交的冻结报价，请保留记录并核对", "SEECUT_GENERATION_NOT_READY", 409);
+    journal.status = "submitting";
+    delete journal.dispatched;
+    delete journal.readyToSubmit;
+    await persist(path, journal);
+    try {
+      const submitted = await nativeCall<NativeAttempt>("generation.submit", { attemptId: journal.attemptId, expectedScopeKey: journal.scopeKey }, 125000);
+      if (submitted.attemptId !== journal.attemptId) throw fail("继续提交回执与原任务不匹配", "SEECUT_JOURNAL_MISMATCH", 409);
+      await refresh(directory, path, journal);
+    } catch (error) {
+      journal.status = "unknown"; journal.error = messageOf(error); await persist(path, journal);
+      if (["FLOW_ACCOUNT_CHANGED", "SIGNED_OUT", "SEECUT_JOURNAL_MISMATCH"].includes(String((error as { code?: string }).code))) throw error;
+    }
+    return publicJournal(journal);
+  })();
+  resuming.set(path, work);
+  recovery.set(path, work);
+  try { return await work; } finally {
+    resuming.delete(path);
+    if (recovery.get(path) === work) recovery.delete(path);
+  }
+}
+
+async function parameters(directory: string, mediaType: Kind, request: Request, scopeKey: string) {
+  if (request.providerId !== "seecut") throw fail("嵌入工作区只使用 SeeCut 模型");
+  if (request.firstFrame || request.lastFrame || typeof request.mode === "string" && !["text", "singleImage"].includes(request.mode)) throw fail("此通道尚未开放首尾帧角色，请使用普通参考素材");
+  const catalog = await nativeCall<Catalog>("generation.catalog", { expectedScopeKey: scopeKey });
+  if (catalog.scopeKey !== scopeKey) throw fail("账户已切换，请重新选择模型", "FLOW_ACCOUNT_CHANGED", 409);
+  const choice = choices(catalog).find(item => item.id === request.modelId && item.model.kind === mediaType);
+  if (!choice) throw fail("所选模型或强度策略已不可用，请重新选择", "SEECUT_MODEL_UNAVAILABLE", 409);
+  const specs = choice.model.parameters;
+  const promptLimit = specs.prompt?.max_length;
+  if (typeof promptLimit === "number" && Array.from(request.prompt.trim()).length > promptLimit) throw fail(`生成提示词超过模型允许的 ${promptLimit} 个字符`);
+  const select = (field: string, requested?: unknown) => {
+    const spec = specs[field];
+    const value = requested ?? spec?.default;
+    if (value === undefined || spec?.values && !spec.values.includes(value)) throw fail(`模型参数无效或缺失：${field}`);
+    return value;
+  };
+  const values: Record<string, unknown> = { quantity: 1 };
+  select("quantity", 1);
+  if (mediaType === "image") {
+    let size = request.size;
+    if (!specs.aspect_ratio && !size && request.ratio) size = strings(specs.size?.values).find(item => ratioForSize(item) === request.ratio);
+    values.size = select("size", size);
+    if (!specs.aspect_ratio && request.ratio && ratioForSize(String(values.size)) !== request.ratio) throw fail("图片比例与实际尺寸不匹配，请选择模型支持的尺寸");
+    if (specs.quality) values.quality = select("quality");
+    if (specs.aspect_ratio) values.aspect_ratio = select("aspect_ratio", request.ratio);
+    if (request.videos?.length || request.audios?.length) throw fail("图片生成只支持图片参考");
+  } else {
+    values.resolution = select("resolution", request.resolution);
+    values.duration = select("duration", request.duration);
+    values.aspect_ratio = select("aspect_ratio", request.ratio);
+    if (specs.generate_audio) {
+      values.generate_audio = select("generate_audio", request.generateAudio);
+      if (typeof values.generate_audio !== "boolean") throw fail("模型音频参数无效");
+    } else if (request.generateAudio === true) throw fail("当前模型未开放生成声音参数");
+    if (choice.model.duration_resolution_map && !choice.model.duration_resolution_map.some(item => item.resolution.includes(String(values.resolution)) && item.duration.includes(Number(values.duration)))) throw fail("所选清晰度不支持此时长");
+  }
+  if (choice.effort) Object.assign(values, { effort_id: choice.effort.id, policy_revision: choice.effort.policy_revision });
+  const references: { path: string; kind: Kind | "audio" }[] = [];
+  for (const [kind, items] of [["image", request.images], ["video", request.videos], ["audio", request.audios]] as const) {
+    for (const item of items ?? []) {
+      const actual = await resolveWorkspacePath(directory, item.path);
+      const info = await lstat(actual.path);
+      if (!info.isFile() || info.isSymbolicLink() || !info.size || info.size > maxMediaBytes) throw fail("参考素材需要项目内不超过 100 MB 的普通文件");
+      references.push({ path: relative(directory, actual.path).replaceAll("\\", "/"), kind });
+    }
+  }
+  const referenceSpec = specs.reference_asset_ids;
+  if (references.length > (referenceSpec?.max_items ?? 0)) throw fail("参考素材数量超过模型范围");
+  for (const kind of ["image", "video", "audio"] as const) {
+    const maximum = referenceSpec?.max_per_kind?.[kind];
+    if (maximum !== undefined && references.filter(item => item.kind === kind).length > maximum) throw fail(`模型${kind}参考数量超出范围`);
+  }
+  return { modelId: choice.model.id, parameters: values, references };
+}
+
+export async function generateSeecutMedia(cwd: string, mediaType: "image" | "video" | "audio", request: Request, signal?: AbortSignal): Promise<Result[]> {
+  if (mediaType === "audio") throw fail("SeeCut 当前未开放独立音频生成");
+  if (!request.prompt.trim()) throw fail("请输入生成提示词");
+  const { directory, projectId } = await workspace(cwd);
+  const clientRequestId = request.clientRequestId ?? randomUUID();
+  const path = await journalPath(directory, clientRequestId);
+  const outputDirectory = request.outputDirectory ?? "assets/generated";
+  if (outputDirectory.startsWith(".seecut") || outputDirectory.startsWith(".agent")) throw fail("生成结果需要使用素材目录");
+  await resolveWorkspacePath(directory, outputDirectory, true);
+  const fingerprint = hash(canonical({ mediaType, ...request, clientRequestId, outputDirectory }));
+  const existing = active.get(path);
+  if (existing) {
+    if (existing.fingerprint !== fingerprint) throw fail("同一请求编号不能用于其他生成内容", "SEECUT_REQUEST_CONFLICT", 409);
+    return existing.promise;
+  }
+  const promise = (async () => {
+    let journal = await readJournal(path);
+    let current: Awaited<ReturnType<typeof account>>;
+    try { current = await account(); }
+    catch (error) { throw !journal && isLocalRefusal(error) ? unsubmitted(error, clientRequestId) : error; }
+    if (journal) {
+      if (journal.fingerprint !== fingerprint || journal.projectId !== projectId || journal.scopeKey !== current.scopeKey) throw fail("请求编号、项目或账户与原生成记录不一致", "SEECUT_REQUEST_CONFLICT", 409);
+      const pendingRecovery = recovery.get(path);
+      if (pendingRecovery) {
+        await pendingRecovery;
+        journal = (await readJournal(path))!;
+      }
+      if (journal.status === "failed") throw fail(journal.error || "原任务已失败，请修正后创建新的生成请求", "SEECUT_GENERATION_FAILED", 422);
+      await refresh(directory, path, journal, signal);
+      if (journal.status === "completed") return journal.results.map(result => ({ ...result, capturedCredits: journal?.capturedCredits ?? 0 }));
+      throw fail(journal.error || "原任务尚未完成，请恢复原任务，不要重复提交", "SEECUT_GENERATION_PENDING", 409);
+    }
+    journal = { version: 1, projectId, clientRequestId, fingerprint, scopeKey: current.scopeKey, mediaType, outputDirectory,
+      status: "unknown", updatedAt: Date.now(), results: [] };
+    await persist(path, journal, true);
+    let prepareStarted = false;
+    try {
+      signal?.throwIfAborted();
+      if (!uuid.test(clientRequestId) || clientRequestId !== clientRequestId.toLowerCase()) throw fail("生成请求编号必须是标准 UUID");
+      const prepared = await parameters(directory, mediaType, request, current.scopeKey);
+      signal?.throwIfAborted();
+      prepareStarted = true;
+      const attempt = await nativeCall<NativeAttempt>("generation.prepare", { projectId, requestId: clientRequestId, kind: mediaType, expectedScopeKey: journal.scopeKey,
+        modelId: prepared.modelId, prompt: request.prompt.trim(), parameters: prepared.parameters, references: prepared.references,
+        ...(request.graphId ? { graphId: request.graphId } : {}), ...(request.nodeId ? { nodeId: request.nodeId } : {}), ...(request.revision !== undefined ? { revision: request.revision } : {}),
+      }, 125000);
+      if (!attempt.attemptId || attempt.scopeKey !== current.scopeKey) throw fail("原生生成准备回执身份无效", "SEECUT_JOURNAL_INVALID", 409);
+      journal.attemptId = attempt.attemptId;
+      journal.status = nativeStatus(attempt);
+      journal.dispatched = attempt.dispatched;
+      journal.readyToSubmit = attempt.readyToSubmit;
+      journal.requestDigest = attempt.requestDigest;
+      await persist(path, journal);
+      signal?.throwIfAborted();
+      await account(journal.scopeKey);
+      if (journal.status === "prepared" && attempt.dispatched !== true && attempt.readyToSubmit !== false) {
+        journal.status = "submitting";
+        delete journal.dispatched;
+        delete journal.readyToSubmit;
+        await persist(path, journal);
+        const submitted = await nativeCall<NativeAttempt>("generation.submit", { attemptId: journal.attemptId, expectedScopeKey: journal.scopeKey }, 125000);
+        if (submitted.attemptId !== journal.attemptId) throw fail("原生生成提交回执身份无效", "SEECUT_JOURNAL_INVALID", 409);
+        journal.status = nativeStatus(submitted);
+        journal.dispatched = submitted.dispatched;
+        journal.readyToSubmit = submitted.readyToSubmit;
+        await persist(path, journal);
+      }
+      const deadline = Date.now() + 30 * 60 * 1000;
+      while (Date.now() < deadline) {
+        signal?.throwIfAborted();
+        await refresh(directory, path, journal, signal);
+        if (journal.status === "completed") return journal.results.map(result => ({ ...result, capturedCredits: journal?.capturedCredits ?? 0 }));
+        if (journal.status === "failed") throw fail(journal.error || "SeeCut 生成失败，请检查原任务", "SEECUT_GENERATION_FAILED", 422);
+        if (["unknown", "prepared"].includes(journal.status)) throw fail("生成提交结果尚未确认，请恢复原任务", "SEECUT_GENERATION_UNKNOWN", 409);
+        await new Promise<void>((yes, no) => {
+          const done = () => { clearTimeout(timer); signal?.removeEventListener("abort", abort); yes(); };
+          const abort = () => { clearTimeout(timer); signal?.removeEventListener("abort", abort); no(signal?.reason); };
+          const timer = setTimeout(done, 1500);
+          signal?.addEventListener("abort", abort, { once: true });
+          if (signal?.aborted) abort();
+        });
+      }
+      throw fail("生成等待超时，请恢复原任务查询结果", "SEECUT_GENERATION_UNKNOWN", 409);
+    } catch (error) {
+      let confirmedAbsent = !prepareStarted && isLocalRefusal(error) && !signal?.aborted;
+      if (prepareStarted && !journal.attemptId && !signal?.aborted && error instanceof Error && !String((error as { code?: string }).code).startsWith("HOST_") && error.name !== "AbortError") {
+        try {
+          await nativeCall("generation.find", { projectId, requestId: clientRequestId, expectedScopeKey: journal.scopeKey });
+        } catch (lookupError) { confirmedAbsent = (lookupError as { code?: string }).code === "GENERATION_NOT_FOUND"; }
+      }
+      if (confirmedAbsent) {
+        journal.status = "failed";
+        journal.notSubmitted = true;
+        journal.dispatched = false;
+        journal.readyToSubmit = false;
+      }
+      if (journal.status !== "failed" && journal.status !== "completed") journal.status = "unknown";
+      journal.error = messageOf(error);
+      await persist(path, journal);
+      if (confirmedAbsent) throw unsubmitted(error, clientRequestId);
+      throw error;
+    }
+  })();
+  active.set(path, { fingerprint, promise });
+  try { return await promise; } finally { active.delete(path); }
+}
