+
+function nativeStatus(value: NativeAttempt): Status {
+  const phase = String(value.phase).toLowerCase();
+  const tasks = value.tasks ?? [];
+  if (value.outcomeUnknown) return "unknown";
+  if (tasks.length && tasks.every(task => ["completed", "succeeded"].includes(task.status ?? ""))) return "completed";
+  if (tasks.some(task => ["failed", "cancelled", "canceled", "expired"].includes(task.status ?? ""))) return "failed";
+  if (["completed", "succeeded", "registered"].includes(phase)) return "completed";
+  if (["failed", "rejected", "refused", "cancelled", "canceled"].includes(phase)) return "failed";
+  if (phase === "prepared") return "prepared";
+  if (["intent", "dispatching", "submitting"].includes(phase)) return "submitting";
+  if (tasks.length || ["running", "accepted", "submitted", "polling"].includes(phase)) return "running";
+  return "unknown";
+}
+
+async function fileDigest(path: string) {
+  const handle = await open(path, "r");
+  const digest = createHash("sha256");
+  try {
+    const bytes = Buffer.alloc(1024 * 1024);
+    while (true) {
+      const { bytesRead } = await handle.read(bytes, 0, bytes.length, null);
+      if (!bytesRead) break;
+      digest.update(bytes.subarray(0, bytesRead));
+    }
+    return digest.digest("hex");
+  } finally { await handle.close(); }
+}
+
+async function registerResults(directory: string, path: string, journal: Journal, signal?: AbortSignal) {
+  await account(journal.scopeKey);
+  const receipt = await nativeCall<{ attemptId: string; assets: { assetId: string; version: unknown; path: string; type: string; name: string }[] }>("generation.register", { attemptId: journal.attemptId, expectedScopeKey: journal.scopeKey }, 125000);
