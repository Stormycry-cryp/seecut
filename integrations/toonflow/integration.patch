+  if (attempt.attemptId !== journal.attemptId) throw fail("原生生成任务身份不匹配", "SEECUT_JOURNAL_INVALID", 409);
+  const value = attempt.tasks?.length && nativeStatus(attempt) !== "completed" && nativeStatus(attempt) !== "failed"
