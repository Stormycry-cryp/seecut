+}
+
+async function account(scopeKey?: string) {
+  const value = await nativeCall<SeecutAccount>("account.status");
+  if (!value.signedIn || !value.scopeKey) throw fail("请先登录 SeeCut 账户", "SIGNED_OUT", 401);
