+type NativeAttempt = { attemptId: string; phase: string; scopeKey?: string; requestDigest?: string; outcomeUnknown?: boolean; readyToSubmit?: boolean; dispatched?: boolean; tasks?: { id?: string; status?: string; error?: unknown; captured_credits?: number; billing_id?: string; billing_captured_credits?: number }[]; error?: unknown };
+type Request = MediaGenerationRequest & { clientRequestId?: string; graphId?: string; nodeId?: string; revision?: number };
+const uuid = /^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i;
+const requestIdentity = /^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$/;
