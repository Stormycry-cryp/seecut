+type WriteBarrier = <T>(directory: string, operation: () => Promise<T>) => Promise<T>;
+let writeBarrier: WriteBarrier = (_directory, operation) => operation();
+
+export function setSeecutGenerationObserver(callback: typeof observer) { observer = callback; }
+export function setSeecutGenerationWriteBarrier(callback: WriteBarrier) { writeBarrier = callback; }
+export const isSeecutGeneration = () => Boolean(process.env.SEECUT_HOST_ENDPOINT);
