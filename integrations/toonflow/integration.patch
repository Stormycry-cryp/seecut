+    if (!mimeType.startsWith(`${journal.mediaType}/`) || !extensions[mimeType]) throw fail("生成输出的实际格式与节点类型不匹配", "SEECUT_RESULT_INVALID", 502);
+    const destination = await writeBarrier(directory, async () => {
+      const output = await resolveWorkspacePath(directory, journal.outputDirectory, true);
+      await mkdir(output.path, { recursive: true });
+      const name = `seecut-${hash(canonical([journal.clientRequestId, asset.assetId, version])).slice(0, 32)}.${extensions[mimeType]}`;
+      const destination = await resolveWorkspacePath(directory, join(journal.outputDirectory, name));
+      const temporary = join(output.path, `.write-${randomUUID()}.tmp`);
+      try {
+        await copyFile(asset.path, temporary, constants.COPYFILE_EXCL);
