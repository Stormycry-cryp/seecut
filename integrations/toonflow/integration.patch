+}
+
+export async function getSeecutMediaPrice() {
+  // Real quotes are created by native prepare; no separate public price API is wired yet.
+  return null;
+}
+
+async function workspace(cwd: string) {
+  const data = process.env.TOONFLOW_DATA_DIR;
+  if (!data) throw fail("SeeCut 数据目录尚未就绪", "SEECUT_WORKSPACE_INVALID", 503);
+  const root = await realpath(join(data, "workspaces"));
+  const info = await lstat(cwd);
+  const directory = await realpath(cwd);
+  const projectId = relative(root, directory);
+  if (!info.isDirectory() || info.isSymbolicLink() || !uuid.test(projectId) || directory !== resolve(root, projectId)) throw fail("生成只能使用当前 SeeCut Flow 项目", "SEECUT_WORKSPACE_INVALID", 403);
+  return { directory, projectId };
+}
+
+async function journalPath(directory: string, id: string) {
+  if (!requestIdentity.test(id) || [".", ".."].includes(id)) throw fail("生成请求编号无效");
+  await writeBarrier(directory, async () => {
+    const folder = await resolveWorkspacePath(directory, ".seecut/generation", true);
+    await mkdir(folder.path, { recursive: true });
+  });
+  return (await resolveWorkspacePath(directory, `.seecut/generation/${id}.json`)).path;
+}
+
+async function readJournal(path: string): Promise<Journal | undefined> {
+  try {
+    const info = await lstat(path);
+    if (!info.isFile() || info.isSymbolicLink() || info.size > 1024 * 1024) throw fail("生成恢复记录无效，请保留文件并核对", "SEECUT_JOURNAL_INVALID", 409);
+    const value = JSON.parse(await readFile(path, "utf8"));
+    if (value.version !== 1 || typeof value.scopeKey !== "string" || !uuid.test(value.projectId) || !requestIdentity.test(value.clientRequestId) || !/^[a-f0-9]{64}$/.test(value.fingerprint) || !Array.isArray(value.results)) throw fail("生成恢复记录损坏，请保留文件并核对", "SEECUT_JOURNAL_INVALID", 409);
+    return value;
+  } catch (error) { if ((error as NodeJS.ErrnoException).code === "ENOENT") return undefined; throw error; }
+}
+
+async function persist(path: string, journal: Journal, exclusive = false) {
+  const directory = dirname(dirname(dirname(path)));
+  const changed = await writeBarrier(directory, async () => {
+    const previous = exclusive ? undefined : await readJournal(path);
+    if (previous && canonical({ ...previous, updatedAt: undefined }) === canonical({ ...journal, updatedAt: undefined })) {
+      journal.updatedAt = previous.updatedAt;
+      return false;
+    }
+    journal.updatedAt = Date.now();
+    await writeAtomic(path, JSON.stringify(journal), { exclusive });
+    const handle = await open(path, "r");
+    try { await handle.sync(); } finally { await handle.close(); }
+    if (process.platform !== "win32") {
+      const parent = await open(dirname(path), "r");
+      try { await parent.sync(); } finally { await parent.close(); }
+    }
+    return true;
+  });
+  if (!changed) return;
+  try { await observer?.(directory); }
+  catch (error) { console.warn("生成记录已保存，云端同步待重试", messageOf(error)); }
+}
+
+export function actualCredits(tasks: NonNullable<NativeAttempt["tasks"]>): number {
+  const parents = new Map<string, number>();
+  const children = new Map<string, number>();
+  const valid = (n: unknown): n is number => Number.isSafeInteger(n) && Number(n) >= 0;
+  for (const task of tasks) {
+    if (task.billing_id && valid(task.billing_captured_credits)) {
+      parents.set(task.billing_id, Math.max(parents.get(task.billing_id) ?? 0, task.billing_captured_credits));
+    } else if (task.id && valid(task.captured_credits)) children.set(task.id, task.captured_credits);
+  }
+  // Do not add a child's delta to a parent total already represented here.
+  for (const task of tasks) if (task.id && task.billing_id && parents.has(task.billing_id)) children.delete(task.id);
