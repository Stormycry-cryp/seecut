+    });
+    results.push({ path: relative(directory, destination.path).replaceAll("\\", "/"), mimeType, mediaType: journal.mediaType,
+      source: { providerId: "seecut", attemptId: journal.attemptId!, assetId: asset.assetId, version } });
+  }
+  journal.results = results;
+  journal.status = "completed";
+  delete journal.error;
+  await persist(path, journal);
