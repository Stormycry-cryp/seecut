diff --git a/apps/web/src/lib/seecutAssets.ts b/apps/web/src/lib/seecutAssets.ts
new file mode 100644
index 0000000..1445fd4
--- /dev/null
+++ b/apps/web/src/lib/seecutAssets.ts
@@ -0,0 +1,75 @@
+export type SeecutAssetType = "image" | "video" | "audio";
+export type SeecutAssetVersion = { sha256: string; registration_id: string; previous_id?: string | null };
+export type SeecutAsset = {
+  assetId: string;
+  name: string;
+  type: SeecutAssetType;
+  version: SeecutAssetVersion | null;
+  createdAt: number | string;
+  source: string;
+  available: boolean;
+  size?: number | null;
+  mimeType?: string | null;
+  thumbnailAvailable: boolean;
+  thumbnailUrl?: string;
+  contentUrl?: string;
+};
+export type SeecutAssetPage = { items: SeecutAsset[]; total: number; offset: number; limit: number; nextOffset?: number; scopeKey: string };
+export type SeecutImportedAsset = Pick<SeecutAsset, "assetId" | "name" | "type"> & {
+  version: SeecutAssetVersion;
+  path: string;
+  mimeType: string;
+  sha256: string;
+  scopeKey: string;
+  deduplicated?: boolean;
+};
+
+async function assetRequest<T>(path: string, signal: AbortSignal, body?: object): Promise<T> {
+  signal.throwIfAborted();
+  const response = await fetch(`/__seecut/${path}`, {
+    method: body ? "POST" : "GET", credentials: "same-origin", cache: "no-store", signal,
+    ...(body ? { headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) } : {}),
+  });
+  const data = await response.json();
+  signal.throwIfAborted();
+  if (!response.ok) throw new Error(data?.error?.message || `资产请求失败（${response.status}）`);
+  return data;
+}
+
+export function seecutAssetUrl(value: string | undefined) {
+  if (!value?.startsWith("/__seecut/assets/") || value.includes("\\")) return;
+  const url = new URL(value, window.location.origin);
+  return url.origin === window.location.origin && url.pathname.startsWith("/__seecut/assets/") ? url.href : undefined;
+}
+
+export async function listSeecutAssets(query: { q?: string; type?: SeecutAssetType | ""; offset?: number; limit?: number; expectedScopeKey?: string }, signal: AbortSignal) {
+  const params = new URLSearchParams({ offset: String(query.offset ?? 0), limit: String(query.limit ?? 24) });
+  if (query.q?.trim()) params.set("q", query.q.trim());
+  if (query.type) params.set("type", query.type);
+  if (query.expectedScopeKey) params.set("expectedScopeKey", query.expectedScopeKey);
+  const page = await assetRequest<SeecutAssetPage>(`assets?${params}`, signal);
+  if (!Array.isArray(page.items) || !Number.isSafeInteger(page.total) || page.total < 0 || typeof page.scopeKey !== "string" || !page.scopeKey
+    || query.expectedScopeKey && page.scopeKey !== query.expectedScopeKey) throw new Error("资产库已变化，请重新打开");
+  return page;
+}
+
+export async function importSeecutAsset(projectId: string, asset: SeecutAsset, scopeKey: string, signal: AbortSignal) {
+  if (!asset.available || !asset.version) throw new Error("此资产暂不可用");
+  const imported = await assetRequest<SeecutImportedAsset>(`projects/${encodeURIComponent(projectId)}/assets/import`, signal, {
+    assetId: asset.assetId, version: asset.version, expectedScopeKey: scopeKey,
+  });
+  if (imported.assetId !== asset.assetId || imported.scopeKey !== scopeKey || imported.type !== asset.type
+    || imported.version?.sha256 !== asset.version.sha256 || imported.version?.registration_id !== asset.version.registration_id
+    || (imported.version?.previous_id ?? null) !== (asset.version.previous_id ?? null) || imported.sha256 !== asset.version.sha256
+    || typeof imported.path !== "string" || !imported.path.startsWith("assets/") || imported.path.split(/[\\/]/).some(part => !part || part.startsWith("."))
+    || typeof imported.mimeType !== "string" || !imported.mimeType.startsWith(`${asset.type}/`)) throw new Error("资产导入回执无效");
+  return imported;
+}
+
+export async function registerSeecutAsset(projectId: string, path: string, name: string, scopeKey: string, signal: AbortSignal) {
+  const result = await assetRequest<{ assetId: string; version: SeecutAssetVersion; name: string; type: SeecutAssetType; scopeKey: string; deduplicated?: boolean }>(
+    `projects/${encodeURIComponent(projectId)}/assets/register`, signal, { path, name, expectedScopeKey: scopeKey }
+  );
+  if (!result.assetId || !result.version?.sha256 || result.scopeKey !== scopeKey) throw new Error("资产保存回执无效");
+  return result;
+}
