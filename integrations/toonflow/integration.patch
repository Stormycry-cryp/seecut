+
+function publicJournal(journal: Journal) {
+  return { clientRequestId: journal.clientRequestId, outputDirectory: journal.outputDirectory, mediaType: journal.mediaType,
+    status: journal.status, capturedCredits: journal.capturedCredits ?? 0, updatedAt: new Date(journal.updatedAt).toISOString(),
