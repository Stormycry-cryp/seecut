+        if (old && call.name !== 'flow_get_operation' && old.fingerprint !== fingerprint) throw new Error('FLOW_OPERATION_CONFLICT');
+        return old ?? null;
+      }
+      if (action === 'begin' && old) return old;
+      if (action === 'finish' && (!old || old.status !== 'accepted')) throw new Error('FLOW_OPERATION_CONFLICT');
