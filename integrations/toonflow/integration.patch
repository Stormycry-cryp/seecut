+        try { await handle.sync(); } finally { await handle.close(); }
+        if (await fileDigest(temporary) !== version.sha256) throw fail("生成输出与登记版本的 SHA256 不匹配", "SEECUT_RESULT_INVALID", 502);
+        try { await link(temporary, destination.path); }
+        catch (error) {
+          if ((error as NodeJS.ErrnoException).code !== "EEXIST") throw error;
