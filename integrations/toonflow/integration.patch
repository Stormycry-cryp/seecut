+    });
+    queue = run.then(()=>{},()=>{});
+    try { res.json(await run); } catch(e) { next(e); }
+  });
+  router.use((e: any, _req: any, res: any, _next: any) => res.status(409).json({error: String(e.message || 'FLOW_OPERATION_FAILED')}));
+  return router;
+}
