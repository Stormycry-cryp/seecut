+}
+// Only local, deterministic rejection with no existing journal can release a node.
+// Native/network errors and existing requests always retain their original identity.
+export async function classifySeecutGenerationRejection(cwd: string, clientRequestId: unknown, error: unknown) {
+  if (!isLocalRefusal(error) || typeof clientRequestId !== "string" || !requestIdentity.test(clientRequestId)) return error;
+  try {
+    const { directory } = await workspace(cwd);
+    const path = (await resolveWorkspacePath(directory, `.seecut/generation/${clientRequestId}.json`, true)).path;
