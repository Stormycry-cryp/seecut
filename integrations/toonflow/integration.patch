+
+async function refresh(directory: string, path: string, journal: Journal, signal?: AbortSignal) {
+  signal?.throwIfAborted();
+  await account(journal.scopeKey);
+  // Journals travel inside user-editable ZIPs. Resolve their project/request
+  // tuple against the account-scoped native ledger before trusting attemptId.
+  const found = await nativeCall<NativeAttempt>("generation.find", { projectId: journal.projectId, requestId: journal.clientRequestId, expectedScopeKey: journal.scopeKey });
