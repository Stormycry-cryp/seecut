+++ b/apps/server/src/seecutNative.ts
@@ -0,0 +1,65 @@
+import { connect } from "node:net";
+import { randomUUID } from "node:crypto";
+
+export type SeecutAccount = { signedIn: boolean; scope?: { account: string; service: string }; scopeKey?: string; epoch?: number };
+
+export async function nativeCall<T = any>(method: string, params: object = {}, timeout = 45000): Promise<T> {
+  const endpoint = process.env.SEECUT_HOST_ENDPOINT;
+  const token = process.env.SEECUT_HOST_TOKEN;
+  if (!endpoint || !token) return Promise.reject(Object.assign(new Error("SeeCut 宿主连接尚未就绪"), { code: "HOST_UNAVAILABLE" }));
+  const match = /^127\.0\.0\.1:(\d{1,5})$/.exec(endpoint);
+  if (!match || Number(match[1]) > 65535) return Promise.reject(new Error("SeeCut 宿主地址无效"));
+  const id = randomUUID();
+  const request = JSON.stringify({ id, method, params }) + "\n";
+  const started = performance.now();
+  const busyDeadline = started + Math.min(timeout, 3000);
+  const callOnce = () => new Promise<T>((resolve, reject) => {
+    const socket = connect({ host: "127.0.0.1", port: Number(match[1]) });
+    let buffer = "";
+    let authenticated = false;
+    let settled = false;
+    const finish = (error?: Error, value?: T) => {
+      if (settled) return;
+      settled = true;
+      clearTimeout(timer);
+      socket.destroy();
+      if (error) reject(error); else resolve(value as T);
+    };
+    const timer = setTimeout(() => finish(Object.assign(new Error("SeeCut 宿主响应超时，请核实原操作"), { code: "HOST_TIMEOUT" })), Math.max(1, timeout - (performance.now() - started)));
+    socket.setEncoding("utf8");
+    socket.once("connect", () => socket.write(JSON.stringify({ type: "auth", token }) + "\n"));
+    socket.on("data", chunk => {
+      buffer += chunk;
+      if (Buffer.byteLength(buffer) > 1024 * 1024) return finish(new Error("SeeCut 宿主响应过大"));
+      let end: number;
+      while ((end = buffer.indexOf("\n")) >= 0) {
+        const line = buffer.slice(0, end); buffer = buffer.slice(end + 1);
+        try {
+          const value = JSON.parse(line);
+          if (!authenticated) {
+            if (value.type !== "auth" || value.ok !== true) return finish(new Error("SeeCut 宿主认证失败"));
+            authenticated = true;
+            socket.write(request);
+          } else if (value.id === id) {
+            if (value.error) finish(Object.assign(new Error(value.error.message || "SeeCut 操作失败"), { code: value.error.code, details: value.error.details }));
+            else finish(undefined, value.result);
+          }
+        } catch { finish(new Error("SeeCut 宿主返回了无效响应")); }
+      }
+    });
+    socket.once("error", () => finish(Object.assign(new Error("SeeCut 宿主连接已断开"), { code: "HOST_UNAVAILABLE" })));
+    socket.once("end", () => finish(Object.assign(new Error("SeeCut 操作结果尚未确认"), { code: "HOST_UNKNOWN" })));
+  });
+  let delay = 50;
+  while (true) {
+    try { return await callOnce(); }
+    catch (error) {
+      // Rust BUSY means the project guard rejected this call before any operation.
+      // Lost responses, transport errors and all other failures remain uncertain.
+      if ((error as { code?: string }).code !== "BUSY" || performance.now() + delay >= busyDeadline) throw error;
+      await new Promise(resolve => setTimeout(resolve, delay));
+      if (performance.now() >= busyDeadline) throw error;
