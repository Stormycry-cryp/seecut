+    journal.attemptId = found.attemptId;
+    await persist(path, journal);
+  }
+  const attempt = await nativeCall<NativeAttempt>("generation.lookup", { attemptId: journal.attemptId, expectedScopeKey: journal.scopeKey }, 125000);
