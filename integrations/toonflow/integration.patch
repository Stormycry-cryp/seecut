@@ -0,0 +1,219 @@
+<template>
+  <main class="seecutProjects">
+    <header class="projectHeader">
+      <h1>Flow</h1>
+      <input v-model="query" class="projectSearch" type="search" placeholder="搜索项目" aria-label="搜索 Flow 项目" />
+    </header>
+    <div v-if="error || listError" class="requestError" role="alert">
+      <span>{{ error || listError }}</span><el-button text :disabled="busy" @click="retryOperation">{{ error && retryProjectId ? '重试打开' : '重新加载' }}</el-button>
+    </div>
+    <section class="projectGrid" aria-label="Flow 项目" :aria-busy="loading">
+      <button class="projectCard newProjectCard" type="button" :disabled="busy" @click="showCreateDialog">
+        <span class="projectPreview"><icon-plus :size="24" aria-hidden="true" /></span>
+        <span class="projectDetails"><span class="projectName">新建项目</span></span>
+      </button>
+      <button v-for="project in filteredProjects" :key="project.id" class="projectCard" type="button" :disabled="busy" :aria-label="`打开 ${project.name}`" @click="openProject(project.id)">
+        <span class="projectPreview"><icon-vector :size="24" aria-hidden="true" /><span v-if="openingId === project.id" class="openingLabel">正在打开…</span></span>
+        <span class="projectDetails"><span class="projectName" :title="project.name">{{ project.name }}</span><span class="projectDate">修改于 {{ formatDate(project.updatedAt) }}</span></span>
+      </button>
+    </section>
+    <el-dialog v-model="createVisible" title="新建 Flow 项目" width="min(400px, 92vw)" alignCenter :closeOnClickModal="!busy" :closeOnPressEscape="!busy" :showClose="!busy" @opened="nameInput?.focus()">
+      <el-form @submit.prevent="createProject">
+        <el-form-item label="项目名称"><el-input ref="nameInput" v-model="name" autofocus maxlength="120" placeholder="输入项目名称" aria-label="Flow 项目名称" :disabled="busy" @keydown.enter.prevent="createProject" /></el-form-item>
+        <p v-if="createError" class="createError" role="alert">{{ createError }}</p>
+      </el-form>
+      <template #footer><el-button :disabled="busy" @click="createVisible = false">取消</el-button><el-button type="primary" :loading="busy" :disabled="busy || !name.trim()" @click="createProject">创建</el-button></template>
+    </el-dialog>
+  </main>
+</template>
+
+<script setup lang="ts">
+import { computed, nextTick, onMounted, onScopeDispose, ref } from "vue";
+import type { InputInstance } from "element-plus";
+import { IconPlus, IconVector } from "@tabler/icons-vue";
+import { openSeecutProject, readSeecutProject, seecutProjectRequest, type SeecutProject } from "@/lib/seecutWorkspaceBridge";
+
+const projects = ref<SeecutProject[]>([]);
+const query = ref("");
+const loading = ref(true);
+const busy = ref(false);
+const error = ref("");
+const listError = ref("");
+const retryProjectId = ref("");
+const createVisible = ref(false);
+const createError = ref("");
+const name = ref("");
+const nameInput = ref<InputInstance>();
+const openingId = ref("");
+const lifetime = new AbortController();
+const listLoaded = ref(false);
+let refreshTimer: ReturnType<typeof setTimeout> | undefined;
+let loadController: AbortController | undefined;
+let cloudPolls = 0;
+let disposed = false;
+let idlePreload: number | undefined;
+let preloadTimer: ReturnType<typeof setTimeout> | undefined;
+let preloadStarted = false;
+function cancelPreload() {
+  if (idlePreload !== undefined) window.cancelIdleCallback?.(idlePreload);
+  clearTimeout(preloadTimer);
+  idlePreload = undefined;
+  preloadTimer = undefined;
+}
+function warmWorkspace() {
+  if (preloadStarted || idlePreload !== undefined || preloadTimer !== undefined || disposed || document.hidden) return;
+  const preload = () => {
+    idlePreload = undefined;
+    preloadTimer = undefined;
+    if (disposed || document.hidden) return;
+    preloadStarted = true;
+    void import("@/pages/workspace/index.vue").catch(() => {});
+  };
+  if (typeof window.requestIdleCallback === "function") idlePreload = window.requestIdleCallback(preload, { timeout: 1500 });
+  else preloadTimer = setTimeout(preload, 200);
+}
+function visibilityChanged() {
+  clearTimeout(refreshTimer);
+  if (document.hidden) { loadController?.abort(); cancelPreload(); return; }
+  cloudPolls = 0;
+  void loadProjects();
+}
+onMounted(() => { document.addEventListener("visibilitychange", visibilityChanged); void loadProjects(); });
+onScopeDispose(() => {
+  disposed = true;
+  lifetime.abort();
+  loadController?.abort();
+  clearTimeout(refreshTimer);
+  cancelPreload();
+  document.removeEventListener("visibilitychange", visibilityChanged);
+});
+const filteredProjects = computed(() => projects.value.filter(project => project.name.toLocaleLowerCase().includes(query.value.trim().toLocaleLowerCase()))
+  .sort((left, right) => new Date(right.updatedAt).getTime() - new Date(left.updatedAt).getTime()));
+const formatDate = (value: string | number) => new Date(value).toLocaleString(undefined, { dateStyle: "medium", timeStyle: "short" });
+const errorMessage = (value: unknown) => value instanceof Error ? value.message : "项目操作失败，请重试";
+
+async function loadProjects(forceRefresh = false) {
+  if (disposed || document.hidden) return;
+  clearTimeout(refreshTimer);
+  if (forceRefresh) cloudPolls = 0;
+  loadController?.abort();
+  const controller = new AbortController();
+  loadController = controller;
+  loading.value = !listLoaded.value;
+  try {
+    const signal = AbortSignal.any([controller.signal, lifetime.signal, AbortSignal.timeout(20_000)]);
+    const data = await seecutProjectRequest(forceRefresh ? "?refresh=1" : "", undefined, signal) as { projects?: unknown[]; cloudLoading?: boolean; cloudError?: string };
+    if (controller !== loadController || disposed) return;
+    if (!Array.isArray(data.projects)) throw new Error("Flow 项目列表无效");
+    const incoming = data.projects.map(readSeecutProject);
+    const cloudLoading = data.cloudLoading === true;
+    projects.value = cloudLoading ? [...new Map([...projects.value, ...incoming].map(project => [project.id, project])).values()] : incoming;
+    listLoaded.value = true;
+    listError.value = "";
+    await nextTick();
+    warmWorkspace();
+    if (cloudLoading && !data.cloudError && !document.hidden) {
+      if (cloudPolls < 12) {
+        const delay = [1000, 2000, 5000][Math.min(cloudPolls, 2)]!;
+        cloudPolls++;
+        refreshTimer = setTimeout(() => void loadProjects(), delay);
+      }
+    }
+  } catch (cause) {
+    if (controller.signal.aborted || lifetime.signal.aborted || disposed) return;
+    if (!listLoaded.value) listError.value = "项目列表加载失败，请重试";
+  } finally { if (controller === loadController) loading.value = false; }
+}
+
+function showCreateDialog() {
+  createError.value = "";
+  createVisible.value = true;
+}
+function projectOperationError(cause: unknown) {
+  const message = errorMessage(cause);
+  if (/登录|账户会话|账户已变化/.test(message)) return "请先在 SeeCut 登录所属账户，再重试打开项目";
+  if (/结果尚未确认|宿主|连接|超时|fetch|network/i.test(message)) return "暂时无法打开项目，请稍后重试";
+  return `项目打开失败：${message}`;
+}
+async function retryOperation() {
+  if (error.value && retryProjectId.value) await openProject(retryProjectId.value);
+  else { listError.value = ""; await loadProjects(true); }
+}
+async function openProject(id: string) {
+  if (busy.value) return;
+  busy.value = true;
+  openingId.value = id;
+  retryProjectId.value = id;
+  error.value = "";
+  try { await openSeecutProject(id); }
+  catch (cause) { error.value = projectOperationError(cause); }
+  finally { busy.value = false; openingId.value = ""; }
+}
+
+async function createProject() {
+  if (busy.value || !name.value.trim()) return;
+  busy.value = true;
+  createError.value = "";
+  let created: SeecutProject | undefined;
+  try {
+    const data = await seecutProjectRequest("", { name: name.value.trim() }, lifetime.signal) as { project?: unknown };
+    created = readSeecutProject(data.project);
+    projects.value = [created, ...projects.value.filter(project => project.id !== created!.id)];
+    createVisible.value = false;
+    name.value = "";
+    openingId.value = created.id;
+    await openSeecutProject(created.id);
+  } catch (cause) {
+    if (created) { retryProjectId.value = created.id; error.value = `项目已创建。${projectOperationError(cause)}`; }
+    else {
+      const message = errorMessage(cause);
+      createError.value = /结果尚未确认|超时/.test(message) ? "暂时无法确认是否已创建，请先返回项目列表检查"
+        : /宿主|连接|fetch|network/i.test(message) ? "项目暂时无法创建，请稍后重试" : `项目创建失败：${message}`;
+    }
+  } finally { busy.value = false; openingId.value = ""; }
+}
+</script>
+
+<style scoped lang="scss">
+.seecutProjects {
+  --project-search-line: #858c98;
+  --project-search-focus: #547aa3;
+  min-height: 100dvh;
+  padding: 40px 48px 24px 32px;
+  background: var(--seecut-page);
+  color: var(--seecut-fg);
+
