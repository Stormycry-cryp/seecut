--- /dev/null
+++ b/apps/server/src/seecutHost.ts
@@ -0,0 +1,101 @@
+import { createSeecutFlowOperations } from "./seecutFlowOperations";
+import express from "express";
+import { createHash, randomBytes, timingSafeEqual } from "node:crypto";
+import { resolve } from "node:path";
+import { readFile, readdir, writeAtomic } from "@toonflow/file";
+import { createApp } from "./app";
+import { createSeecutProjects } from "./seecutProjects";
+import { createSeecutAssets } from "./seecutAssets";
+import { setSeecutGenerationObserver, setSeecutGenerationWriteBarrier } from "./seecutGeneration";
+
+const appDirectory = resolve(import.meta.dirname, "..");
+
+async function bundledPluginRevision(directory: string) {
+  const hash = createHash("sha256").update("seecut-bundled-plugins-v1\0");
+  async function visit(relativeDirectory: string) {
+    const entries = await readdir(resolve(directory, relativeDirectory), { withFileTypes: true });
+    entries.sort((a, b) => a.name < b.name ? -1 : a.name > b.name ? 1 : 0);
+    for (const entry of entries) {
+      const relativePath = `${relativeDirectory}/${entry.name}`;
+      if (entry.isDirectory()) await visit(relativePath);
+      else if (entry.isFile()) {
+        const content = await readFile(resolve(directory, relativePath));
+        hash.update(relativePath).update("\0").update(String(content.length)).update("\0").update(content);
+      } else throw new Error(`内置插件必须是普通文件或目录：${relativePath}`);
+    }
+  }
+  for (const root of ["nodes", "tools", "ext", "providers"]) await visit(root);
+  return hash.digest("hex");
+}
+
+const dataDirectory = process.env.TOONFLOW_DATA_DIR;
+const readyFile = process.env.SEECUT_TOONFLOW_READY_FILE;
+if (!dataDirectory || !readyFile) throw new Error("缺少 SeeCut 本地服务启动参数");
+const parentPid = Number(process.env.SEECUT_PARENT_PID);
+if (Number.isSafeInteger(parentPid) && parentPid > 0) {
+  setInterval(() => {
+    try { process.kill(parentPid, 0); }
+    catch { process.exit(0); }
+  }, 1000).unref();
+}
+const sessionToken = randomBytes(32).toString("hex");
+const cookieName = `seecutToonflow${process.pid}`;
+const app = express();
+let origin = "";
+
+function matchesToken(value: string | undefined) {
+  if (!value || value.length !== sessionToken.length) return false;
+  const actual = Buffer.from(value);
+  const expected = Buffer.from(sessionToken);
+  return actual.length === expected.length && timingSafeEqual(actual, expected);
+}
+
+app.use((request, response, next) => {
+  if (request.get("host") !== new URL(origin).host) return response.status(403).send("Unexpected local host");
+  response.setHeader("Referrer-Policy", "same-origin");
+  response.setHeader("Cache-Control", "no-store");
+  if (request.path === "/__seecut/start" && request.method === "GET") {
+    if (!matchesToken(typeof request.query.token === "string" ? request.query.token : undefined)) return response.status(403).send("Invalid startup session");
+    response.setHeader("Referrer-Policy", "no-referrer");
+    response.setHeader("Set-Cookie", `${cookieName}=${sessionToken}; HttpOnly; SameSite=Strict; Path=/`);
+    return response.redirect("/?seecut=1#/seecut/projects");
+  }
+  const cookie = request.get("cookie")?.split(";").map(value => value.trim()).find(value => value.startsWith(`${cookieName}=`));
+  if (!matchesToken(cookie?.slice(cookieName.length + 1))) return response.sendStatus(401);
+  const requestOrigin = request.get("origin");
+  if (requestOrigin && requestOrigin !== origin) return response.sendStatus(403);
+  next();
+});
+
+const projects = await createSeecutProjects(dataDirectory);
+app.use("/__seecut", createSeecutFlowOperations(dataDirectory));
+setSeecutGenerationObserver(directory => projects.touch(projects.projectIdForDirectory(directory)));
+setSeecutGenerationWriteBarrier(projects.withProjectWrite);
+app.use("/__seecut", projects.router);
+app.use("/__seecut", createSeecutAssets(projects));
+app.use(projects.observeWrites);
+
+const workspace = await createApp({
+  webRoot: resolve(appDirectory, "web"),
+  appVersion: "2.0.6-seecut",
+  dataDirectory,
+  toolsRoot: resolve(appDirectory, "tools"),
+  nodesRoot: resolve(appDirectory, "nodes"),
+  extRoot: resolve(appDirectory, "ext"),
+  providersRoot: resolve(appDirectory, "providers"),
+  skillsRoot: resolve(appDirectory, "skills"),
+  pluginRevision: await bundledPluginRevision(appDirectory),
+});
+app.use(workspace);
+const { initializeMcpRuntime, stopMcpRuntime } = await import("./utils/mcp/runtime");
+const server = app.listen(0, "127.0.0.1", async () => {
+  const address = server.address();
+  if (!address || typeof address === "string") throw new Error("无法取得本地服务端口");
+  origin = `http://127.0.0.1:${address.port}`;
+  await initializeMcpRuntime(workspace, origin, resolve(appDirectory, "mcp/stdio.js"), undefined, { Cookie: `${cookieName}=${sessionToken}` });
+  await writeAtomic(readyFile, JSON.stringify({ url: `${origin}/__seecut/start?token=${sessionToken}` }), { mode: 0o600 });
+});
+server.on("error", error => { console.error(error); process.exit(1); });
+for (const signal of ["SIGINT", "SIGTERM"] as const) {
+  process.on(signal, () => { void Promise.allSettled([stopMcpRuntime(), projects.close()]).finally(() => { server.close(); process.exit(0); }); });
+}
