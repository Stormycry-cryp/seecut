diff --git a/apps/server/src/seecutAssets.ts b/apps/server/src/seecutAssets.ts
new file mode 100644
index 0000000..b5f74d2
--- /dev/null
+++ b/apps/server/src/seecutAssets.ts
@@ -0,0 +1,213 @@
+import express, { type NextFunction, type Request, type Response } from "express";
+import { isAbsolute } from "node:path";
+import { lstat } from "@toonflow/file";
+import { z } from "zod";
+import { nativeCall, type SeecutAccount } from "./seecutNative";
+import { sendFile } from "./utils/fileHttp";
+
+const versionSchema = z.strictObject({
+  sha256: z.string().regex(/^[a-f0-9]{64}$/),
+  registration_id: z.string().min(1).max(256),
+  previous_id: z.string().min(1).max(256).nullable().optional(),
+});
+const assetIdSchema = z.string().min(1).max(256);
+const scopeSchema = z.string().min(1).max(512).optional();
+const mediaTypeSchema = z.enum(["image", "video", "audio"]);
+const uuid = /^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i;
+const publicError = Symbol("seecut.asset.publicError");
+const fail = (message: string, status = 400, code = "FLOW_ASSET_INVALID") => Object.assign(new Error(message), { status, code, [publicError]: true });
+type Version = z.infer<typeof versionSchema>;
+type Projects = {
+  directory(id: string): Promise<string>;
+  projectIdForDirectory(path: string): string;
+  withProjectWrite<T>(directory: string, operation: () => Promise<T>): Promise<T>;
+  touch(id: string): Promise<void>;
+};
+
+// 原生桥共用四条连接；资产操作最多占两条，排队不创建连接。
+let activeOperations = 0;
+const waitingOperations: (() => void)[] = [];
+async function acquireOperation() {
+  if (activeOperations >= 2) {
+    if (waitingOperations.length >= 64) throw fail("当前素材请求较多，请稍后重试", 503, "FLOW_ASSET_BUSY");
+    await new Promise<void>(resolve => waitingOperations.push(resolve));
+  } else activeOperations++;
+  let released = false;
+  return () => {
+    if (released) return;
+    released = true;
+    const next = waitingOperations.shift();
+    if (next) next();
+    else activeOperations--;
+  };
+}
+
+function parse<T extends z.ZodType>(schema: T, value: unknown): z.infer<T> {
+  const result = schema.safeParse(value);
+  if (!result.success) throw fail("素材请求参数无效");
+  return result.data;
+}
+
+function projectMediaPath(value: unknown) {
+  if (typeof value !== "string" || value.length > 4096 || !value.startsWith("assets/") || isAbsolute(value)
+    || value.split("/").some(part => !part || part === "." || part === ".." || /[\\<>:\"|?*\x00-\x1f\x7f]/.test(part))) {
+    throw fail("请选择当前项目 assets 目录内的素材");
+  }
+  return value;
+}
+
+function sameVersion(actual: Version, expected: Version) {
+  return actual.sha256 === expected.sha256 && actual.registration_id === expected.registration_id
+    && (actual.previous_id ?? null) === (expected.previous_id ?? null);
+}
+
+function receiptAsset(value: any) {
+  const result = z.object({ assetId: assetIdSchema, version: versionSchema, name: z.string(), type: mediaTypeSchema,
+    deduplicated: z.boolean().optional() }).safeParse(value);
+  if (!result.success) throw fail("SeeCut 素材回执无效", 502, "FLOW_ASSET_RECEIPT_INVALID");
+  return result.data;
+}
+
+export function createSeecutAssets(projects: Projects) {
+  const router = express.Router();
+  router.use(express.json({ limit: "16kb" }));
+
+  async function session(expected?: string) {
+    const value = await nativeCall<SeecutAccount>("account.status");
+    const scopeKey = value.signedIn ? value.scopeKey : "local";
+    if (typeof scopeKey !== "string" || !scopeKey) throw fail("SeeCut 会话状态无效", 502, "FLOW_SESSION_INVALID");
+    if (expected !== undefined && scopeKey !== expected) throw fail("SeeCut 账户已切换，请重新打开资产库", 409, "FLOW_ACCOUNT_CHANGED");
+    return scopeKey;
+  }
+
+  async function operation<T>(method: string, params: object, expected?: string, finalize?: (result: T, scopeKey: string) => Promise<void>): Promise<{ result: T; scopeKey: string }> {
+    const release = await acquireOperation();
+    try {
+      const scopeKey = await session(expected);
+      const result = await nativeCall(method, { ...params, expectedScopeKey: scopeKey }, 125000);
+      await session(scopeKey);
+      if (result?.scopeKey !== undefined && result.scopeKey !== scopeKey) throw fail("素材回执属于其他会话，请重新打开资产库", 409, "FLOW_ACCOUNT_CHANGED");
+      await finalize?.(result, scopeKey);
+      return { result, scopeKey };
+    } finally { release(); }
+  }
+
+  async function projectDirectory(id: string) {
+    if (!uuid.test(id)) throw fail("Flow 项目编号无效");
+    const directory = await projects.directory(id);
+    if (projects.projectIdForDirectory(directory) !== id) throw fail("Flow 项目目录无效", 403);
+    return directory;
+  }
+
+  router.get("/assets", async (request, response) => {
+    const input = parse(z.strictObject({ q: z.string().max(256).optional(), type: mediaTypeSchema.optional(),
+      offset: z.coerce.number().int().min(0).max(1_000_000).default(0), limit: z.coerce.number().int().min(1).max(50).default(24), expectedScopeKey: scopeSchema }), request.query);
+    const { result, scopeKey } = await operation<any>("assets.list", { q: input.q ?? "", type: input.type, offset: input.offset, limit: input.limit }, input.expectedScopeKey);
+    if (!Array.isArray(result?.items) || result.items.length > input.limit || !Number.isSafeInteger(result.total) || result.total < 0
+      || result.items.length === 0 && input.offset < result.total) throw fail("SeeCut 资产列表无效", 502, "FLOW_ASSET_RECEIPT_INVALID");
+    const items = result.items.map((item: any) => {
+      const parsed = z.object({ assetId: assetIdSchema, name: z.string(), type: mediaTypeSchema, version: versionSchema.nullable(),
+        createdAt: z.number().finite(), source: z.enum(["imported", "generated"]), available: z.boolean(), size: z.number().int().nonnegative().nullable(),
+        mimeType: z.string().nullable(), thumbnailAvailable: z.boolean() }).safeParse(item);
+      if (!parsed.success) throw fail("SeeCut 资产条目无效", 502, "FLOW_ASSET_RECEIPT_INVALID");
+      const entry = parsed.data;
+      const urls: { contentUrl?: string; thumbnailUrl?: string } = {};
+      if (entry.available && entry.version) {
+        const query = new URLSearchParams({ version: JSON.stringify(entry.version), expectedScopeKey: scopeKey });
+        const base = `/__seecut/assets/${encodeURIComponent(entry.assetId)}`;
+        urls.contentUrl = `${base}/content?${query}`;
+        if (entry.thumbnailAvailable) urls.thumbnailUrl = `${base}/thumbnail?${query}`;
+      }
+      return { ...entry, ...urls };
+    });
+    const nextOffset = input.offset + items.length;
+    response.set("Cache-Control", "no-store").json({ items, total: result.total, offset: input.offset, limit: input.limit,
+      ...(nextOffset < result.total ? { nextOffset } : {}), scopeKey });
+  });
+
+  for (const kind of ["thumbnail", "content"] as const) router.get(`/assets/:id/${kind}`, async (request, response, next) => {
+    const assetId = parse(assetIdSchema, request.params.id);
+    const input = parse(z.strictObject({ version: z.string().min(1).max(2048), expectedScopeKey: scopeSchema }), request.query);
+    let decoded: unknown;
+    try { decoded = JSON.parse(input.version); } catch { throw fail("素材版本无效"); }
+    const version = parse(versionSchema, decoded);
+    const { result } = await operation<any>(kind === "thumbnail" ? "assets.thumbnail" : "assets.resolve", { assetId, version }, input.expectedScopeKey, async (result, scopeKey) => {
+      if (!result || typeof result.path !== "string" || !isAbsolute(result.path)) {
+        if (kind === "thumbnail") throw fail("此素材暂无缩略图", 404, "FLOW_ASSET_THUMBNAIL_NOT_FOUND");
+        throw fail("SeeCut 素材文件回执无效", 502, "FLOW_ASSET_RECEIPT_INVALID");
+      }
+      if (kind === "content") {
+        const receipt = receiptAsset(result);
+        if (receipt.assetId !== assetId || !sameVersion(receipt.version, version)) throw fail("素材版本回执不匹配", 409, "FLOW_ASSET_VERSION_CHANGED");
+      }
+      const info = await lstat(result.path).catch(() => { throw fail("素材文件已不可用", 404, "FLOW_ASSET_UNAVAILABLE"); });
+      if (!info.isFile() || info.isSymbolicLink()) throw fail("素材文件已不可用", 404, "FLOW_ASSET_UNAVAILABLE");
+      await session(scopeKey);
+    });
+    response.set({ "Cache-Control": "no-store", "Content-Security-Policy": "sandbox", "X-Content-Type-Options": "nosniff" });
+    if (typeof result.contentType === "string" && /^(image|video|audio)\/[a-zA-Z0-9.+-]+$/.test(result.contentType)) response.type(result.contentType);
+    await sendFile(response, result.path, { dotfiles: "allow" }, error => { if (error) next(fail("素材预览失败，请刷新后重试", (error as any).status ?? 500)); });
+  });
+
+  router.post("/projects/:id/assets/import", async (request, response) => {
+    const input = parse(z.strictObject({ assetId: assetIdSchema, version: versionSchema, expectedScopeKey: scopeSchema }), request.body);
+    const id = request.params.id;
+    const directory = await projectDirectory(id);
+    let attempted = false;
+    let result;
+    try {
+      result = await projects.withProjectWrite(directory, async () => {
+        attempted = true;
+        const { result, scopeKey } = await operation<any>("assets.copyToProject", { projectId: id, assetId: input.assetId, version: input.version }, input.expectedScopeKey);
+        const receipt = receiptAsset(result);
+        const path = projectMediaPath(result.path);
+        if (!path.startsWith("assets/imported/") || receipt.assetId !== input.assetId || !sameVersion(receipt.version, input.version)
+          || result.sha256 !== input.version.sha256 || typeof result.mimeType !== "string" || !result.mimeType.startsWith(`${receipt.type}/`)) {
+          throw fail("素材导入回执不匹配", 502, "FLOW_ASSET_RECEIPT_INVALID");
+        }
+        // 原生只返回受管项目副本；浏览器不会得到资产库的本机路径。
+        return { ...receipt, path, sha256: result.sha256, mimeType: result.mimeType, scopeKey };
+      });
+    } finally {
+      // 响应丢失或中途切账户时原生可能已落盘，项目仍需记录待保存状态。
+      if (attempted) await projects.touch(id);
+    }
+    response.json(result);
+  });
+
+  router.post("/projects/:id/assets/register", async (request, response) => {
+    const input = parse(z.strictObject({ path: z.string(), name: z.string().trim().min(1).max(256).optional(), expectedScopeKey: scopeSchema }), request.body);
+    const path = projectMediaPath(input.path);
+    const id = request.params.id;
+    const directory = await projectDirectory(id);
+    let attempted = false;
+    let result;
+    try {
+      result = await projects.withProjectWrite(directory, async () => {
+        attempted = true;
+        const { result, scopeKey } = await operation<any>("assets.registerProjectMedia", { projectId: id, path, ...(input.name ? { name: input.name } : {}) }, input.expectedScopeKey);
+        return { ...receiptAsset(result), scopeKey };
+      });
+    } finally { if (attempted) await projects.touch(id); }
+    response.json(result);
+  });
+
+  router.use((error: any, _request: Request, response: Response, next: NextFunction) => {
+    if (response.headersSent) return next(error);
+    const code = typeof error.code === "string" && /^[A-Z0-9_]{1,80}$/.test(error.code) ? error.code : "FLOW_ASSET_ERROR";
+    const status = Number.isInteger(error.status) && error.status >= 400 && error.status < 600 ? error.status
+      : ["NOT_FOUND", "ASSET_NOT_FOUND", "THUMBNAIL_NOT_FOUND"].includes(code) ? 404
+        : ["FLOW_ACCOUNT_CHANGED", "BUSY", "EBUSY", "ASSET_VERSION_CONFLICT", "ASSET_TRASHED"].includes(code) ? 409
+          : ["INVALID_ARGUMENT", "INVALID_VERSION", "INVALID_MEDIA"].includes(code) ? 400
+            : ["INVALID_PATH", "INVALID_SOURCE"].includes(code) ? 403 : 500;
+    // 原生或系统错误可能携带绝对路径，仅本模块构造的业务消息可直接显示。
+    const message = error[publicError] ? error.message : status === 404 ? "素材文件已不可用"
+      : code === "FLOW_ACCOUNT_CHANGED" ? "SeeCut 账户已切换，请重新打开资产库"
+        : ["BUSY", "EBUSY"].includes(code) ? "项目正在使用，请稍后重试"
+          : ["ASSET_VERSION_CONFLICT", "ASSET_TRASHED"].includes(code) ? "素材版本已变化或已移入废纸篓，请刷新资产库"
+            : code === "INVALID_MEDIA" ? "素材需要是格式受支持且不超过 100 MB 的普通媒体文件"
+              : status === 400 || status === 403 ? "素材身份、版本或项目路径无效" : "SeeCut 素材操作失败，请刷新后重试";
+    response.status(status).json({ error: { code, message } });
+  });
+  return router;
+}
diff --git a/apps/server/src/seecutFlowOperations.ts b/apps/server/src/seecutFlowOperations.ts
new file mode 100644
index 0000000..7bcc6c9
--- /dev/null
+++ b/apps/server/src/seecutFlowOperations.ts
@@ -0,0 +1,54 @@
+import express from 'express';
+import { createHash } from 'node:crypto';
+import { mkdir, readFile, lstat } from 'node:fs/promises';
+import { join } from 'node:path';
+import { writeAtomic } from '@toonflow/file';
+import { nativeCall, type SeecutAccount } from './seecutNative';
+
+// Outside exported project ZIPs: imported project data cannot manufacture operation receipts.
+export function createSeecutFlowOperations(dataDirectory: string) {
+  const router = express.Router();
+  const root = join(dataDirectory, 'seecut-flow-operations');
+  let queue = Promise.resolve();
+  router.use(express.json({limit: '256kb'}));
+  const account = async (expected?: string) => {
+    const a = await nativeCall<SeecutAccount>('account.status');
+    const scope = `${a.signedIn ? a.scopeKey : 'local'}:${a.epoch ?? 0}`;
+    if (expected !== undefined && scope !== expected) throw new Error('FLOW_ACCOUNT_CHANGED');
+    return scope;
+  };
+  router.get('/flow/account', async (_req, res) => { res.json({ accountScope: await account() }); });
+  router.post('/flow/operation', async (req, res, next) => {
+    const run = queue.then(async () => {
+      const {call, action, result} = req.body;
+      if (!call || !['begin', 'get', 'finish'].includes(action) || typeof call.operationId !== 'string' || !call.operationId || call.operationId.length > 192
