+++ b/apps/web/src/lib/seecutEmbedded.ts
@@ -0,0 +1,62 @@
+import { ref } from "vue";
+
+type SeecutTheme = "light" | "dark";
+
+declare global {
+  interface Window {
+    __SEECUT_EMBEDDED__?: boolean;
+    __SEECUT_THEME__?: SeecutTheme;
+    __SEECUT_FLUSH__?: () => Promise<void>;
+  }
+}
+
+export const isSeecutEmbedded = window.__SEECUT_EMBEDDED__ === true || new URLSearchParams(window.location.search).get("seecut") === "1";
+export const seecutTheme = ref<SeecutTheme>();
+let workspaceFlush: (() => Promise<void>) | undefined;
+
+export function registerSeecutFlush(handler: () => Promise<void>) {
+  if (!isSeecutEmbedded) return () => {};
+  workspaceFlush = handler;
+  return () => {
+    if (workspaceFlush === handler) workspaceFlush = undefined;
+  };
+}
+
+export async function flushSeecutWorkspace() {
+  await workspaceFlush?.();
+}
+
+export function notifySeecutViewReady() {
+  if (!isSeecutEmbedded) return;
+  const host = window as Window & { ipc?: { postMessage(message: string): void } };
+  host.ipc?.postMessage(JSON.stringify({ type: "seecut:view-ready" }));
+}
+
+function applySeecutTheme(theme: unknown) {
+  if (theme !== "light" && theme !== "dark") return;
+  seecutTheme.value = theme;
+  window.__SEECUT_THEME__ = theme;
+  const root = document.documentElement;
+  root.dataset.seecutTheme = theme;
+  root.classList.toggle("dark", theme === "dark");
+  root.setAttribute("theme-mode", theme);
+  root.style.colorScheme = theme;
+}
+
+export function registerSeecutTheme() {
+  if (!isSeecutEmbedded) return () => {};
+  const root = document.documentElement;
+  root.dataset.seecutEmbedded = "true";
+  document.title = "SeeCut Flow";
+  applySeecutTheme(window.__SEECUT_THEME__ ?? root.dataset.seecutTheme ?? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"));
+  function receiveTheme(event: Event) {
+    const detail = (event as CustomEvent<unknown>).detail;
+    applySeecutTheme(typeof detail === "object" && detail !== null && "theme" in detail ? detail.theme : detail);
+  }
+  window.addEventListener("seecut:theme", receiveTheme);
+  window.addEventListener("seecut-theme", receiveTheme);
+  return () => {
+    window.removeEventListener("seecut:theme", receiveTheme);
+    window.removeEventListener("seecut-theme", receiveTheme);
+  };
+}
diff --git a/apps/web/src/lib/seecutFlowControl.ts b/apps/web/src/lib/seecutFlowControl.ts
new file mode 100644
index 0000000..4e163c3
--- /dev/null
+++ b/apps/web/src/lib/seecutFlowControl.ts
@@ -0,0 +1,71 @@
+import { watch } from 'vue';
+import { getWorkspaceControl } from './mcpControl';
+import { currentSeecutProjectId, seecutOpeningProject } from './seecutWorkspaceBridge';
+import { isSeecutEmbedded } from './seecutEmbedded';
+import { createFlowGate, type FlowBinding, type FlowCall } from './seecutFlowGate';
+
+declare global { interface Window { __SEECUT_FLOW_CALL__?: (call: FlowCall) => Promise<unknown> } }
+export function installSeecutFlowControl() {
+  if (!isSeecutEmbedded) return () => {};
+  let accountScope = '';
+  let sessionId = crypto.randomUUID();
+  let bindingKey = '';
+  let lifetime = new AbortController();
+  let stopped = false;
+  const host = (message: object) => (window as Window & {ipc?:{postMessage(value:string):void}}).ipc?.postMessage(JSON.stringify(message));
+  async function request(path: string, body?: unknown) {
+    const response = await fetch(`/__seecut/flow/${path}`, {credentials:'same-origin', cache:'no-store', signal:AbortSignal.timeout(10000), ...(body ? {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body)} : {})});
+    const value = await response.json();
+    if (!response.ok) throw new Error(value.error || 'FLOW_UNAVAILABLE');
+    return value;
+  }
+  async function account(expected?: string) {
+    const value = await request('account');
+    if (typeof value.accountScope !== 'string') throw new Error('FLOW_ACCOUNT_UNAVAILABLE');
+    accountScope = value.accountScope;
+    publish();
+    if (expected !== undefined && expected !== accountScope) throw new Error('FLOW_ACCOUNT_CHANGED');
+  }
+  function binding(): FlowBinding | undefined {
+    const state = getWorkspaceControl()?.getState();
+    if (!accountScope || !currentSeecutProjectId.value || !state?.canvasReady || !state.canvasId || seecutOpeningProject.value) return;
+    return {projectId:currentSeecutProjectId.value, canvasId:state.canvasId, sessionId, accountScope, revision:state.flowRevision ?? 0};
+  }
+  function publish() {
+    if (stopped) return;
+    const state = getWorkspaceControl()?.getState();
+    const key = JSON.stringify([currentSeecutProjectId.value, state?.canvasId, accountScope, state?.canvasReady, seecutOpeningProject.value]);
+    if (key !== bindingKey) {
+      bindingKey = key; sessionId = crypto.randomUUID();
+      lifetime.abort(new Error('FLOW_BINDING_CHANGED')); lifetime = new AbortController();
+    }
+    host({type:'seecut:flow-context', context:binding() ? {...binding(), selectionRevision:state?.flowSelectionRevision, selectedNodeIds:state?.selectedNodeIds ?? [], name:state?.projectName ?? '', busy:state?.flowBusy ?? false} : null});
+  }
+  const gate = createFlowGate({ binding, account,
+    receipt:(call, action, result) => request('operation', {call, action, result}),
+    workspace:async () => {
+      const control = getWorkspaceControl()!;
+      const call = (name: string, args: Record<string,unknown>) => control.call({type:'call',callId:crypto.randomUUID(), name,args}, lifetime.signal);
+      return {...binding(), selectedNodeIds:control.getState().selectedNodeIds ?? [], canvas:await call('getCanvas',{include:['canvases','nodeTypes']}), selected:await call('findCanvasNodes',{selectedOnly:true}), edges:await call('getCanvasEdges',{limit:100})};
+    },
+    execute:async (command, signal, call) => {
+      const control = getWorkspaceControl(); if (!control) throw new Error('FLOW_UNAVAILABLE');
+      return control.call({type:'call',callId:crypto.randomUUID(), ...command, expectedCanvasId:call.canvasId, expectedRevision:call.revision}, signal);
+    },
+    flush:async () => { await getWorkspaceControl()?.flushSave(); publish(); },
+  });
+  window.__SEECUT_FLOW_CALL__ = async call => {
+    await account(call.accountScope);
+    // Capture lifetime after refreshing the account. Canvas tools also guard their exact binding.
+    const signal = AbortSignal.any([...(call.name === "flow_switch_canvas" ? [] : [lifetime.signal]), AbortSignal.timeout(125000)]);
+    return gate(call, signal);
+  };
+  const stop = watch(()=>[currentSeecutProjectId.value, seecutOpeningProject.value, getWorkspaceControl()?.getState()], publish, {deep:true, flush:'post'});
+  let checking = false;
+  const timer = setInterval(() => {
+    if (checking) return; checking = true;
+    void account().catch(()=>{accountScope=''; publish();}).finally(()=>{checking=false;});
+  }, 1000);
+  void account().catch(()=>publish());
+  return () => { stopped=true;stop();clearInterval(timer);lifetime.abort();delete window.__SEECUT_FLOW_CALL__;host({type:'seecut:flow-context',context:null}); };
+}
diff --git a/apps/web/src/lib/seecutFlowGate.ts b/apps/web/src/lib/seecutFlowGate.ts
new file mode 100644
index 0000000..9585d7e
--- /dev/null
+++ b/apps/web/src/lib/seecutFlowGate.ts
@@ -0,0 +1,101 @@
+/** One current-workspace gate for native Agent and MCP. Never edits JSON files. */
+export type FlowBinding = { projectId: string; canvasId: string; sessionId: string; accountScope: string; revision: number };
+export type FlowCall = FlowBinding & { name: string; args: Record<string, unknown>; operationId?: string };
+export const flowReads = new Set(['flow_get_workspace', 'flow_read_canvas', 'flow_list_node_types', 'flow_get_node_tools', 'flow_get_operation', 'flow_get_node_config', 'flow_get_task']);
+export const flowCommands: Record<string, string> = {
+  flow_get_node_config: 'nodeTools', flow_get_task: 'nodeTools',
+  flow_read_canvas: 'getCanvasNodes', flow_list_node_types: 'getCanvas', flow_get_node_tools: 'getNodeTools',
+  flow_add_node: 'addNode', flow_update_node: 'nodeTools', flow_connect_nodes: 'connectNodes',
+  flow_delete_nodes: 'deleteNodes', flow_switch_canvas: 'switchCanvas', flow_execute_node: 'nodeTools',
+};
+export function assertFlowBinding(actual: FlowBinding | undefined, expected: FlowBinding, revision = true) {
+  if (!actual || ['projectId', 'canvasId', 'sessionId', 'accountScope'].some(key => actual[key as keyof FlowBinding] !== expected[key as keyof FlowBinding])) throw new Error('FLOW_BINDING_CHANGED');
+  if (revision && actual.revision !== expected.revision) throw new Error('FLOW_STALE_REVISION');
+}
+export function flowCommand(call: FlowCall) {
+  const name = flowCommands[call.name];
+  if (!name) throw new Error('FLOW_TOOL_UNAVAILABLE');
+  const args = structuredClone(call.args);
+  if (call.name === 'flow_get_node_config' || call.name === 'flow_get_task') return {name, args:{nodeId:args.nodeId, name:call.name === 'flow_get_node_config' ? 'node:getConfig' : 'node:getRecordedGeneration', args:{}}};
+  if (call.name === 'flow_update_node' && (args.args as any)?.providerId !== undefined && (args.args as any)?.providerId !== 'seecut') throw new Error('FLOW_MANAGED_PROVIDER_REQUIRED');
+  if ('canvasId' in args && args.canvasId !== call.canvasId && call.name !== 'flow_switch_canvas') throw new Error('FLOW_BINDING_CHANGED');
+  if (call.name === 'flow_list_node_types') return { name, args: { include: ['nodeTypes', 'canvases'], ...args, canvasId: call.canvasId } };
+  if (call.name === 'flow_update_node' && !['node:setConfig', 'node:setPrompt', 'node:setText'].includes(String(args.name))) throw new Error('FLOW_TOOL_UNAVAILABLE');
+  if (call.name === 'flow_execute_node' && !['node:generateImage', 'node:generateVideo'].includes(String(args.name))) throw new Error('FLOW_TOOL_UNAVAILABLE');
+  return { name, args };
+}
+export function createFlowGate(deps: {
+  binding(): FlowBinding | undefined;
+  account(expected: string): Promise<void>;
+  receipt(call: FlowCall, action: 'begin' | 'get' | 'finish', result?: unknown): Promise<any>;
+  workspace(): Promise<unknown>;
+  execute(command: {name: string; args: Record<string, unknown>}, signal: AbortSignal, call: FlowCall): Promise<unknown>;
+  flush(): Promise<void>;
+}) {
+  let busy = false;
+  return async (call: FlowCall, signal: AbortSignal) => {
+    let started = false, dispatched = false, ownsBusy = false;
+    try {
+    signal.throwIfAborted();
+    await deps.account(call.accountScope);
+    if (call.name === 'flow_get_operation') return deps.receipt(call, 'get');
+    assertFlowBinding(deps.binding(), call, false);
+    if (call.name === 'flow_get_workspace') return deps.workspace();
+    const command = flowCommand(call);
+    if (flowReads.has(call.name)) {
+      assertFlowBinding(deps.binding(), call);
+      const result = await deps.execute(command, signal, call);
+      if (call.name === 'flow_get_task') {
+        signal.throwIfAborted();
+        assertFlowBinding(deps.binding(), call, false);
+        await deps.account(call.accountScope);
+        await deps.flush();
+        signal.throwIfAborted();
+      }
+      return result;
+    }
+    if (!call.operationId || call.operationId.length > 192) throw new Error('FLOW_OPERATION_REQUIRED');
+    if (busy) throw new Error('FLOW_BUSY');
+    busy = true; ownsBusy = true;
+      // Lookup comes before revision validation: a successful replay keeps its original result.
+      const existing = await deps.receipt(call, 'get');
+      if (existing) return existing;
+      await deps.account(call.accountScope);
+      assertFlowBinding(deps.binding(), call);
+      signal.throwIfAborted();
+      if (call.name === 'flow_execute_node') {
+        const config = await deps.execute({name: 'nodeTools', args: {nodeId: call.args.nodeId, name: 'node:getConfig', args: {}}}, signal, call) as any;
+        if (config?.config?.providerId !== 'seecut') throw new Error('FLOW_MANAGED_PROVIDER_REQUIRED');
+        await deps.account(call.accountScope);
+        assertFlowBinding(deps.binding(), call);
+        signal.throwIfAborted();
+      }
+      const receipt = await deps.receipt(call, 'begin');
+      if (receipt.status !== 'accepted') return receipt;
+      started = true;
+      await deps.account(call.accountScope);
+      assertFlowBinding(deps.binding(), call);
+      signal.throwIfAborted();
+      dispatched = true;
+      const result = await deps.execute(command, signal, call);
+      // A switch has intentionally changed canvas/session. The real canvas tool saves the old one first.
+      if (call.name !== 'flow_switch_canvas') assertFlowBinding(deps.binding(), call, false);
+      await deps.account(call.accountScope);
+      await deps.flush();
+      await deps.account(call.accountScope);
+      signal.throwIfAborted();
+      return await deps.receipt(call, 'finish', { status: 'completed', result, binding: deps.binding(), saved: true });
+    } catch (error) {
+      if (!flowReads.has(call.name) && call.operationId && !dispatched) {
+        const result = { status: 'notExecuted', operationId: call.operationId, error: String(error) };
+        if (started) { try { await deps.receipt(call, 'finish', result); } catch { /* local caller still receives proof that execute was never entered */ } }
+        return result;
+      }
+      if (started) {
+        // A dispatched operation is never automatically attempted again, including save failures.
+        try { await deps.receipt(call, 'finish', { status: 'outcomeUnknown', error: String(error) }); } catch { /* durable accepted record remains */ }
+      }
+      throw error;
+    } finally { if (ownsBusy) busy = false; }
+  };
+}
diff --git a/apps/web/src/lib/seecutWorkspaceBridge.ts b/apps/web/src/lib/seecutWorkspaceBridge.ts
new file mode 100644
index 0000000..003a028
--- /dev/null
+++ b/apps/web/src/lib/seecutWorkspaceBridge.ts
@@ -0,0 +1,110 @@
+import { nextTick, ref } from "vue";
+import { getWorkspaceControl, waitForControlValue } from "@/lib/mcpControl";
+import { saveSettings } from "@/stores/settings";
+import { useWorkspaceStore } from "@/stores/workspace";
+
+export type SeecutSync = { state: "local" | "pending" | "syncing" | "synced" | "error" | "conflict" | "signedOut"; error?: string };
+export type SeecutProject = { id: string; name: string; createdAt: string | number; updatedAt: string | number; sync: SeecutSync; directory?: string };
+export const currentSeecutProjectId = ref<string>();
+export const seecutOpeningProject = ref(false);
+export const seecutWorkspaceError = ref("");
+export const seecutSync = ref<SeecutSync>();
+const projectIdPattern = /^[\da-f]{8}-[\da-f]{4}-[\da-f]{4}-[\da-f]{4}-[\da-f]{12}$/i;
+
+export async function seecutProjectRequest(path = "", body?: object, signal?: AbortSignal): Promise<unknown> {
+  const response = await fetch(`/__seecut/projects${path}`, {
+    method: body ? "POST" : "GET", credentials: "same-origin", cache: "no-store", signal,
+    ...(body ? { headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) } : {}),
+  });
+  const data = await response.json();
+  if (!response.ok) throw new Error(typeof data?.error?.message === "string" ? data.error.message : typeof data?.error === "string" ? data.error : typeof data?.message === "string" ? data.message : `Flow 项目请求失败（${response.status}）`);
+  return data;
+}
+
+export function readSeecutSync(value: unknown): SeecutSync {
+  if (!value || typeof value !== "object" || !("state" in value)
+    || !["local", "pending", "syncing", "synced", "error", "conflict", "signedOut"].includes(String(value.state))) throw new Error("云端同步状态无效");
+  return { state: value.state as SeecutSync["state"], ...("error" in value && typeof value.error === "string" ? { error: value.error } : {}) };
+}
+
+export function readSeecutProject(value: unknown): SeecutProject {
+  if (!value || typeof value !== "object") throw new Error("Flow 项目信息无效");
+  const item = value as Record<string, unknown>;
+  if (typeof item.id !== "string" || !projectIdPattern.test(item.id) || typeof item.name !== "string" || !item.name.trim()
+    || ![item.createdAt, item.updatedAt].every(date => (typeof date === "string" || typeof date === "number") && Number.isFinite(new Date(date).getTime()))) throw new Error("Flow 项目信息无效");
+  return { id: item.id, name: item.name, createdAt: item.createdAt as string | number, updatedAt: item.updatedAt as string | number,
+    sync: readSeecutSync(item.sync), ...(typeof item.directory === "string" ? { directory: item.directory } : {}) };
+}
+
+export async function flushSeecutProject() {
+  const control = getWorkspaceControl();
+  control?.assertCanLeave();
+  await control?.flushSave();
+  await saveSettings();
+  control?.assertCanLeave();
+}
+
+export async function openSeecutProject(projectId: string) {
+  if (!projectIdPattern.test(projectId)) throw new Error("Flow 项目编号无效");
+  if (seecutOpeningProject.value) throw new Error("项目正在打开，请稍候");
+  seecutOpeningProject.value = true;
+  seecutWorkspaceError.value = "";
+  const signal = AbortSignal.timeout(120_000);
+  try {
+    await flushSeecutProject();
+    const data = await seecutProjectRequest(`/${encodeURIComponent(projectId)}/open`, {}, signal) as { project?: unknown };
+    const project = readSeecutProject(data.project);
+    if (project.id !== projectId || !project.directory?.trim()) throw new Error("Flow 工作区信息无效");
+    const workspace = useWorkspaceStore();
+    await workspace.openProject(project.directory, project.directory, signal);
+    const directory = workspace.project?.directory;
+    if (!directory) throw new Error("Flow 工作区未打开");
+    workspace.renameProject(directory, project.name);
+    currentSeecutProjectId.value = project.id;
+    seecutSync.value = project.sync;
+    const router = (await import("@/router")).default;
+    await router.replace("/workspace");
+    await waitForSeecutWorkspace(directory, signal);
+  } catch (error) {
+    seecutWorkspaceError.value = error instanceof Error ? error.message : "Flow 项目打开失败";
+    throw error;
+  } finally { seecutOpeningProject.value = false; }
+}
+
+export async function returnToSeecutProjects() {
+  await flushSeecutProject();
+  const router = (await import("@/router")).default;
+  await router.replace("/seecut/projects");
+  if (router.currentRoute.value.path !== "/seecut/projects") throw new Error("项目尚未保存，无法返回");
+  currentSeecutProjectId.value = undefined;
+  seecutSync.value = undefined;
+}
+
+export async function refreshSeecutSync(retry = false) {
+  const id = currentSeecutProjectId.value;
+  if (!id) return;
+  const result = await seecutProjectRequest(`/${encodeURIComponent(id)}/sync`, retry ? {} : undefined, AbortSignal.timeout(retry ? 125_000 : 20_000)) as { sync?: unknown; project?: { sync?: unknown } };
+  const sync = readSeecutSync(result.sync ?? result.project?.sync ?? result);
+  if (id === currentSeecutProjectId.value) seecutSync.value = sync;
+}
+
+async function waitForSeecutWorkspace(directory: string, signal: AbortSignal) {
+  await nextTick();
+  const control = await waitForControlValue(() => {
+    const current = getWorkspaceControl();
+    const state = current?.getState();
+    return state?.directory === directory && (state.canvasLoadError || (state.canvasListReady && (!state.canvasId || state.canvasReady))) ? current : undefined;
+  }, signal);
+  if (control.getState().canvasLoadError) throw new Error(control.getState().canvasLoadError);
+  const call = (name: string, args: Record<string, unknown>) => control.call({ type: "call", callId: crypto.randomUUID(), name, args, directory }, signal);
+  if (!control.getState().canvasId) {
+    const state = await call("getCanvas", { include: ["canvases"], limit: 1 }) as { canvases?: { id: string }[]; canvasCount?: number };
+    if (state.canvases?.[0]) await call("switchCanvas", { canvasId: state.canvases[0].id });
+    else if (state.canvasCount === 0) await call("addCanvas", {});
+    else throw new Error("工作区画布列表尚未就绪");
+  }
+  await waitForControlValue(() => {
+    const state = control.getState();
+    return state.directory === directory && state.canvasReady && state.canvasId ? true : undefined;
+  }, signal);
+}
