+}
+
+function ratioForSize(size: string) {
+  const match = /^(\d+)x(\d+)$/.exec(size);
+  if (!match || Number(match[1]) <= 0 || Number(match[2]) <= 0) return undefined;
+  let a = Number(match[1]), b = Number(match[2]);
+  while (b) [a, b] = [b, a % b];
+  return `${Number(match[1]) / a}:${Number(match[2]) / a}`;
+}
+const strings = (values: unknown[] | undefined) => (values ?? []).filter((value): value is string => typeof value === "string");
+
+function specsRatios(model: NativeModel, sizes: string[]) {
+  const ratios = strings(model.parameters.aspect_ratio?.values);
+  return ratios.length ? ratios : [...new Set(sizes.map(ratioForSize).filter((value): value is string => !!value))];
+}
+
+export async function listSeecutMediaModels(): Promise<MediaModel[]> {
+  const current = await account();
+  const catalog = await nativeCall<Catalog>("generation.catalog", { expectedScopeKey: current.scopeKey });
+  if (catalog.scopeKey !== current.scopeKey) throw fail("账户已切换，请重新加载模型", "FLOW_ACCOUNT_CHANGED", 409);
