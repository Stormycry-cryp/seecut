+use super::*;
+use crate::control::{ControlRequest, Outcome};
+
+const HOST: &str = "8e88a522-e405-40cd-9ef0-56b530ec0c21";
+fn fixture(extra_layer: bool) -> (PhotocraftApp, egui::Context, u64) {
+    let mut session = photocraft_engine::Session::new();
+    session.execute("file.new", json!({"width":8,"height":8})).unwrap();
+    if extra_layer {
+        session.execute("layer.new.layer", json!({"name":"Agent target"})).unwrap();
+    }
+    let layer = session.active().unwrap().active_layer.unwrap().0;
+    let mut app = PhotocraftApp::new(session, crate::Services::default());
+    // No process-global env mutation; exercise the exact production binding parser.
+    app.seecut_agent = ControlState::from_binding(Some(HOST.into()));
+    (app, egui::Context::default(), layer)
+}
+fn call(app: &mut PhotocraftApp, ctx: &egui::Context, method: &str, params: Value) -> Value {
+    let (request, _rx) = ControlRequest::new(method, params);
+    match crate::control::handle(app, ctx, &request) {
+        Outcome::Done(reply) => reply,
+        _ => panic!("private methods must settle synchronously"),
+    }
+}
+fn request(app: &PhotocraftApp, id: &str, action: Value) -> Value {
+    let st = app.session.active().unwrap();
+    json!({"operationId":id,"expected":{"hostInstanceId":HOST,"docId":st.doc.id.0,
+        "documentGeneration":st.document_generation,"revision":st.revision},"action":action})
+}
+fn opacity(app: &PhotocraftApp, layer: u64) -> f32 {
+    app.session.active().unwrap().doc.layer(LayerId(layer)).unwrap().opacity
+}
+fn change(app: &PhotocraftApp, id: &str, layer: u64) -> Value {
+    request(app, id, json!({"kind":"layerSetOpacity","layerId":layer,"opacity":0.4}))
+}
