+    assert_eq!(state["result"]["kind"], "uiCallbackMetadata");
+    assert_eq!(state["result"]["atomicPixels"], false);
+    assert!(state["result"]["document"]["identity"]["documentGeneration"].as_u64().unwrap() > 0);
+    assert_eq!(state["result"]["receiptCache"]["restartRecovery"], false);
+    assert!(state["result"].get("pixels").is_none());
+    assert_eq!(state["result"]["document"]["hasPixelSelection"], false);
+    assert!(state["result"]["document"]["selectionBounds"].is_null());
+    assert_eq!(state["result"]["document"]["selectionBoundsMeasurement"], "notSampled");
+    app.session.execute("select.all", json!({})).unwrap();
+    let selected = call(&mut app, &ctx, "seecut.state", json!({}));
+    assert_eq!(selected["result"]["document"]["hasPixelSelection"], true);
+    assert!(selected["result"]["document"]["selectionBounds"].is_null());
+    assert_eq!(selected["result"]["document"]["selectionBoundsMeasurement"], "notSampled");
+    assert_eq!(call(&mut app, &ctx, "seecut.state", json!({"extra":1}))["ok"], false);
