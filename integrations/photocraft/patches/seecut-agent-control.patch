+    let original = change(&app, "opacity", layer);
+    let first = call(&mut app, &ctx, "seecut.execute", original.clone());
+    assert_eq!(first["result"]["status"], "applied");
+    assert_eq!(opacity(&app, layer), 0.4);
+    assert_eq!(app.session.active().unwrap().history.entries().len(), before + 1);
+    let duplicate = call(&mut app, &ctx, "seecut.execute", original.clone());
+    assert_eq!(duplicate, first);
+    assert_eq!(app.session.active().unwrap().history.entries().len(), before + 1);
+    assert_eq!(call(&mut app, &ctx, "seecut.receipt", json!({"operationId":"opacity"})), first);
+    let undo = request(&app, "separate-undo-permit", json!({"kind":"undo"}));
+    let undone = call(&mut app, &ctx, "seecut.execute", undo);
+    assert_eq!(undone["result"]["status"], "applied");
+    assert_eq!(opacity(&app, layer), 1.0);
+    assert!(app.session.active().unwrap().history.can_redo());
+    assert_eq!(app.session.active().unwrap().history.entries().len(), before);
+    // A matched retry remains the original receipt after later manual/history changes.
+    assert_eq!(call(&mut app, &ctx, "seecut.execute", original), first);
+    assert_eq!(opacity(&app, layer), 1.0);
+    assert!(app.session.active().unwrap().history.can_redo());
+}
