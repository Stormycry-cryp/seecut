+//! Private SeeCut host endpoints. Metadata only: no screenshot or atomic pixel claim.
+//! The owning SeeCut host must pass its existing exact-call and Task gates before
+//! calling. This module is deliberately not a new authorization authority.
+use std::collections::HashMap;
+
+use photocraft_doc::{Layer, LayerId};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+
+use crate::PhotocraftApp;
+
+const HOST_ENV: &str = "SEECUT_PHOTO_HOST_INSTANCE_ID";
+const RECEIPT_LIMIT: usize = 1024;
+const LIST_LIMIT: usize = 256;
+
+#[derive(Default)]
+pub(crate) struct ControlState {
+    host_instance: Option<String>,
+    // No eviction: an old id must never become executable again. Memory only.
+    receipts: HashMap<String, Entry>,
+}
+impl ControlState {
+    pub(crate) fn from_environment() -> Self {
+        Self::from_binding(std::env::var(HOST_ENV).ok())
+    }
+    fn from_binding(binding: Option<String>) -> Self {
+        Self { host_instance: binding.filter(|s| valid_host_id(s)), receipts: HashMap::new() }
+    }
+}
+fn valid_host_id(s: &str) -> bool {
+    s.len() == 36 && s.bytes().enumerate().all(|(i, c)| if [8, 13, 18, 23].contains(&i) { c == b'-' } else { c.is_ascii_hexdigit() })
+}
+fn valid_operation_id(s: &str) -> bool {
+    !s.is_empty() && s.len() <= 128 && s.bytes().all(|c| c.is_ascii_alphanumeric() || b"-_.:".contains(&c))
+}
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Expected {
+    host_instance_id: String,
+    doc_id: u64,
+    document_generation: u64,
+    revision: u64,
+}
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(tag = "kind", rename_all = "camelCase", deny_unknown_fields)]
+enum Action {
+    #[serde(rename_all = "camelCase")]
+    LayerSetOpacity {
+        layer_id: u64,
+        opacity: f64,
+    },
+    // A separate exact-call permit is required by the owning host for this action.
+    Undo {},
+}
+impl Action {
+    fn command(&self) -> &'static str {
+        match self {
+            Self::LayerSetOpacity { .. } => "layer.setProps",
+            Self::Undo {} => "edit.undo",
+        }
+    }
+    fn params(&self) -> Value {
+        match self {
+            Self::LayerSetOpacity { layer_id, opacity } => {
+                json!({"layer": layer_id, "opacity": opacity})
+            }
+            Self::Undo {} => json!({}),
+        }
+    }
+    fn layer(&self) -> Option<LayerId> {
+        match self {
+            Self::LayerSetOpacity { layer_id, .. } => Some(LayerId(*layer_id)),
+            Self::Undo {} => None,
+        }
+    }
+    fn valid(&self) -> bool {
+        match self {
+            Self::LayerSetOpacity { layer_id, opacity } => *layer_id > 0 && opacity.is_finite() && (0.0..=1.0).contains(opacity),
+            Self::Undo {} => true,
+        }
+    }
+}
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Execute {
+    operation_id: String,
+    expected: Expected,
+    action: Action,
+}
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct ReceiptQuery {
+    operation_id: String,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct StateQuery {}
+#[derive(Clone, Debug, PartialEq, Serialize)]
+#[serde(rename_all = "camelCase")]
+struct LayerState {
+    id: u64,
+    name: String,
+    opacity: f32,
+    visible: bool,
+}
+fn layer_state(l: &Layer) -> LayerState {
+    LayerState { id: l.id.0, name: l.name.chars().take(256).collect(), opacity: l.opacity, visible: l.visible }
+}
+fn layers_bounded(layers: &[Layer], out: &mut Vec<LayerState>) {
+    for l in layers.iter().rev() {
+        if out.len() == LIST_LIMIT {
+            return;
+        }
+        out.push(layer_state(l));
+        if let Some(children) = l.children() {
+            layers_bounded(children, out);
+        }
+    }
+}
+#[derive(Clone, Debug, PartialEq, Serialize)]
+#[serde(rename_all = "camelCase")]
+struct DocumentState {
+    identity: Expected,
+    name: String,
+    size: [u32; 2],
+    active_layer: Option<u64>,
+    selected_layers: Vec<u64>,
+    selection_list_truncated: bool,
+    has_pixel_selection: bool,
+    selection_bounds: Option<[i32; 4]>,
+    selection_bounds_measurement: &'static str,
+    layers: Vec<LayerState>,
+    layer_list_may_be_truncated: bool,
+    target: Option<LayerState>,
+    dirty: bool,
+    can_undo: bool,
+    can_redo: bool,
+    history_entries: usize,
+}
+fn observe(app: &PhotocraftApp, host: &str, target: Option<LayerId>) -> Option<DocumentState> {
+    let st = app.session.active()?;
+    let mut layers = Vec::new();
+    layers_bounded(&st.doc.layers, &mut layers);
+    let selected = st.selected_layers();
+    Some(DocumentState {
+        identity: Expected { host_instance_id: host.into(), doc_id: st.doc.id.0, document_generation: st.document_generation, revision: st.revision },
+        name: st.doc.name.chars().take(256).collect(),
+        size: [st.doc.size.width, st.doc.size.height],
+        active_layer: st.active_layer.map(|l| l.0),
+        selected_layers: selected.iter().take(LIST_LIMIT).map(|l| l.0).collect(),
+        selection_list_truncated: selected.len() > LIST_LIMIT,
+        has_pixel_selection: st.doc.selection.is_some(),
+        // Metadata reads must not scan selection tiles/pixels on the UI thread.
+        selection_bounds: None,
+        selection_bounds_measurement: "notSampled",
+        layer_list_may_be_truncated: layers.len() == LIST_LIMIT,
+        layers,
+        target: target.and_then(|l| st.doc.layer(l)).map(layer_state),
+        dirty: st.is_dirty(),
+        can_undo: st.history.can_undo(),
+        can_redo: st.history.can_redo(),
+        history_entries: st.history.entries().len(),
+    })
+}
+#[derive(Clone, Debug, PartialEq, Serialize)]
+#[serde(rename_all = "camelCase")]
+struct ReceiptState {
+    identity: Expected,
+    active_layer: Option<u64>,
+    target: Option<LayerState>,
+    can_undo: bool,
+    can_redo: bool,
+    history_entries: usize,
+}
+fn receipt_state(app: &PhotocraftApp, host: &str, target: Option<LayerId>) -> Option<ReceiptState> {
+    let st = app.session.active()?;
+    Some(ReceiptState {
+        identity: Expected { host_instance_id: host.into(), doc_id: st.doc.id.0, document_generation: st.document_generation, revision: st.revision },
+        active_layer: st.active_layer.map(|l| l.0),
+        target: target.and_then(|l| st.doc.layer(l)).map(layer_state),
+        can_undo: st.history.can_undo(),
+        can_redo: st.history.can_redo(),
+        history_entries: st.history.entries().len(),
+    })
+}
+#[derive(Clone, Debug, PartialEq, Serialize)]
+#[serde(rename_all = "camelCase")]
+struct Receipt {
+    operation_id: String,
+    status: &'static str,
+    error_code: Option<&'static str>,
+    before: Option<ReceiptState>,
+    after: Option<ReceiptState>,
+    // This remains false even on rejected/failed results; callers query receipts,
+    // never turn an engine error into permission to resend a write.
+    safe_to_resend: bool,
+}
+struct Entry {
+    // Exact canonical typed request equality is the parameter fingerprint. No
+    // lossy/defaulted fields, string hashing or collision-prone short digest.
+    request: Execute,
+    receipt: Option<Receipt>,
+}
+fn ok(result: impl Serialize) -> Value {
+    json!({"ok":true,"result":result})
+}
+fn invalid(code: &'static str) -> Value {
+    json!({"ok":false,"error":code})
+}
+fn unknown(id: &str) -> Value {
+    ok(json!({"operationId":id,"status":"unknown","safeToResend":false,"cache":"memoryOnlyRestartDoesNotRecover"}))
+}
+
+/// No changes, commits or synthetic UI events are performed by this predicate.
+fn busy(app: &PhotocraftApp, ctx: &egui::Context, command: &str) -> Option<&'static str> {
+    if !crate::menus::modal_allows(app, command)
+        || app.ui.shell.dialog.is_some()
+        || app.distort.active()
+        || app.wide_angle.is_some()
+        || app.pending_raw_open.is_some()
+        || app.raw_redevelop.is_some()
+        || app.pending_after_prompt.is_some()
+    {
+        return Some("modalBusy");
+    }
+    if app.session.has_jobs() {
+        return Some("jobBusy");
+    }
+    if ctx.input(|i| i.pointer.any_down() || !i.keys_down.is_empty())
+        || ctx.egui_wants_keyboard_input()
+        || app.drag.is_some()
+        || app.live_stroke.is_some()
+        || app.press_stroke
+        || app.ui.text_edit.is_some()
+        || app.ui.transform.is_some()
+        || app.ui.type_transform.is_some()
+        || app.ui.cam_transform.is_some()
+        || app.ui.symmetry_transform.is_some()
+        || app.ui.pen.is_some()
+        || app.ui.stroke_editor.is_some()
+        || app.ui.corner_radius.is_some()
+        || !app.ui.polygon.is_empty()
+        || app.ui.magnetic.active()
+        || app.crop.drag.is_some()
+        || app.crop.editing
+        || app.ui.crop_rect.is_some()
+        || crate::perspective_crop_ui::pending(app)
+        || app.gradient.has_pending_edit()
+        || app.guide_drag.is_some()
+        || app.layer_box.is_some()
+        || app.brush_resize.is_some()
+        || app.quick_pick
+        || !app.remove_pending.is_empty()
+        || !app.synthetic.is_empty()
+        || !app.drop_places.is_empty()
+        || !app.held_opens.is_empty()
+    {
+        return Some("activeEditBusy");
+    }
+    if app.live_adjust.is_some()
+        || app.move_preview.is_some()
+        || app.blend_preview.is_some()
+        || app.reorder_preview.is_some()
+        || app.patch_preview.is_some()
+        || app.cam_preview.is_some()
+        || app.filter_preview.is_some()
+        || app.color_range.is_some()
+        || app.adjust_preview.is_some()
+        || app.live_adjust_preview.is_some()
+        || app.transform_preview.is_some()
+        || app.text_style_preview.is_some()
+        || app.style_preview.is_some()
+        || app.solid_fill_preview.is_some()
+        || app.pattern_fill_preview.is_some()
+        || app.shape_fill_preview.is_some()
+        || app.type_transform_preview.is_some()
+        || app.type_font_preview.is_some()
+    {
+        return Some("previewBusy");
+    }
+    // Executing a closed command must not trigger user-configured script hooks.
+    if app.session.prefs().script_events.enabled {
+        return Some("scriptEventsEnabled");
+    }
+    None
+}
+fn preflight(app: &PhotocraftApp, ctx: &egui::Context, host: &str, request: &Execute) -> Result<(), &'static str> {
+    let st = app.session.active().ok_or("noDocument")?;
+    if request.expected.host_instance_id != host {
+        return Err("wrongHostInstance");
+    }
+    if st.document_generation == 0 {
+        return Err("generationUnavailable");
+    }
+    if st.doc.id.0 != request.expected.doc_id || st.document_generation != request.expected.document_generation {
+        return Err("wrongDocument");
+    }
+    if st.revision != request.expected.revision {
+        return Err("staleRevision");
+    }
+    if let Some(why) = busy(app, ctx, request.action.command()) {
+        return Err(why);
+    }
+    if let Some(layer) = request.action.layer() {
+        st.doc.layer(layer).ok_or("noLayer")?;
+        // layer.setProps converts Background to a regular layer for opacity < 1.
+        // That implicit conversion is outside this endpoint's opacity-only scope.
+        if st.doc.is_background(layer) {
+            return Err("backgroundConversionUnsupported");
+        }
+    }
+    Ok(())
+}
+
+pub(crate) fn handle(app: &mut PhotocraftApp, ctx: &egui::Context, method: &str, params: &Value) -> Value {
+    let Some(host) = app.seecut_agent.host_instance.clone() else {
+        return invalid("hostBindingUnavailable");
+    };
+    match method {
+        "seecut.state" => {
+            if serde_json::from_value::<StateQuery>(params.clone()).is_err() {
+                return invalid("invalidParams");
+            }
+            if app.session.active().is_some_and(|st| st.document_generation == 0) {
+                return invalid("generationUnavailable");
+            }
+            ok(json!({
+                "kind":"uiCallbackMetadata","atomicPixels":false,"frame":app.frame,
+                "hostInstanceId":host,"document":observe(app,&host,None),
+                "view":app.session.active_index().and_then(|i|app.ui.views.get(i)),
+                "geometrySource":"lastLaidOutFrame","lastLaidOutCanvasRect":{
+                    "min":[app.last_canvas_rect.min.x,app.last_canvas_rect.min.y],
+                    "max":[app.last_canvas_rect.max.x,app.last_canvas_rect.max.y]},
+                "busy":busy(app,ctx,"layer.setProps"),
+                "receiptCache":{"storage":"memoryOnly","restartRecovery":false,"capacity":RECEIPT_LIMIT,
+                    "entries":app.seecut_agent.receipts.len(),"eviction":false}
+            }))
+        }
+        "seecut.receipt" => {
+            let Ok(query) = serde_json::from_value::<ReceiptQuery>(params.clone()) else {
+                return invalid("invalidParams");
+            };
+            if !valid_operation_id(&query.operation_id) {
+                return invalid("invalidOperationId");
+            }
+            match app.seecut_agent.receipts.get(&query.operation_id).and_then(|e| e.receipt.as_ref()) {
+                Some(receipt) => ok(receipt),
+                None => unknown(&query.operation_id),
+            }
+        }
+        "seecut.execute" => execute(app, ctx, &host, params),
+        _ => invalid("unknownPrivateMethod"),
+    }
+}
+fn execute(app: &mut PhotocraftApp, ctx: &egui::Context, host: &str, params: &Value) -> Value {
+    let Ok(request) = serde_json::from_value::<Execute>(params.clone()) else {
+        return invalid("invalidParams");
+    };
+    if !valid_operation_id(&request.operation_id)
+        || !request.action.valid()
+        || request.expected.doc_id == 0
+        || request.expected.document_generation == 0
+        || request.expected.revision == 0
+    {
+        return invalid("invalidParams");
+    }
+    if request.expected.host_instance_id != host {
+        return invalid("wrongHostInstance");
+    }
+    if let Some(entry) = app.seecut_agent.receipts.get(&request.operation_id) {
+        if entry.request != request {
+            return invalid("operationIdConflict");
+        }
+        return entry.receipt.as_ref().map(ok).unwrap_or_else(|| unknown(&request.operation_id));
+    }
+    if app.seecut_agent.receipts.len() >= RECEIPT_LIMIT {
+        return invalid("receiptCapacityReached");
+    }
+    let before = receipt_state(app, host, request.action.layer());
+    app.seecut_agent.receipts.insert(request.operation_id.clone(), Entry { request: request.clone(), receipt: None });
+    let rejection = preflight(app, ctx, host, &request).err();
+    let (status, error_code) = if let Some(why) = rejection {
+        ("rejected", Some(why))
+    } else {
+        let command = request.action.command();
+        let engine_params = request.action.params();
+        // Match control.rs's automation_command gate and keep control::handle's
+        // temporary Session::authorize installed for the real engine dispatch.
+        let allowed = app.services.automation_command.as_ref().is_none_or(|gate| gate(command, &engine_params).is_ok());
+        if !allowed {
+            ("rejected", Some("automationPolicyRejected"))
+        } else {
+            match app.session.execute(command, engine_params) {
+                Ok(_) => {
+                    ctx.request_repaint();
+                    ("applied", None)
+                }
+                Err(_) => ("failed", Some("engineError")),
+            }
+        }
+    };
+    let receipt = Receipt {
+        operation_id: request.operation_id.clone(),
+        status,
+        error_code,
+        before,
+        after: receipt_state(app, host, request.action.layer()),
+        safe_to_resend: false,
+    };
+    if let Some(entry) = app.seecut_agent.receipts.get_mut(&request.operation_id) {
+        entry.receipt = Some(receipt.clone());
+    }
+    ok(receipt)
+}
