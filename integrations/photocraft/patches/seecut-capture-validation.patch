+fn paint(
+    app: &mut PhotocraftApp,
+    ctx: &egui::Context,
+    events: Vec<egui::Event>,
+    mut after: impl FnMut(&mut PhotocraftApp, &egui::Context),
+) {
+    let rect = egui::Rect::from_min_size(egui::pos2(20.0, 30.0), egui::vec2(320.0, 240.0));
+    let view = app.ui.views[0].clone();
+    app.frame += 1;
+    let mut output = ctx.run_ui(
+        egui::RawInput {
+            screen_rect: Some(egui::Rect::from_min_size(
+                egui::Pos2::ZERO,
+                egui::vec2(400.0, 320.0),
+            )),
+            time: Some(1.0),
+            events,
+            ..Default::default()
+        },
+        |ui| {
+            begin_frame(app, ctx);
+            app.ui.views[0] = crate::canvas::canvas_view(app, ui, 0, rect, view.clone(), true);
+            after(app, ctx);
+            finish_frame(app, ctx);
+        },
+    );
+    // This fixture checks paint submission and the separate document-composite PNG;
+    // it intentionally has no egui screen renderer to upload these UI texture deltas.
+    output.textures_delta.clear();
+    assert!(
