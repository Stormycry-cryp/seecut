+#[test]
+fn seecut_validation_geometry_doc_selection_presentation_are_monotonic() {
+    for change in 0..12 {
+        let c = Coordinator::new().unwrap();
+        let mut session = fixture();
+        let (material, snapshot) = capture(&c, &session, &format!("change:{change}"));
+        let rx = enqueue(&c, &snapshot, "change-validation");
+        let mut different = material.clone();
+        different.captured_at = Instant::now();
+        different.frame += 1;
+        match change {
+            0 => different.geometry.rect_points[2] += 1.0,
+            1 => different.geometry.pixels_per_point = 2.0,
+            2 => different.geometry.display_camera[1] += 1.0,
+            3 => different.presentation.display_key += 1,
+            4 => different.presentation.renderer = Renderer::Gpu,
+            5 => different.active_layer = None,
+            6 => {
+                different.selected_layers.push(u64::MAX);
+                different.selected_layers.push(different.active_layer.unwrap());
+            }
+            7 => {
+                session.execute("layer.setProps", json!({"layer":material.active_layer.unwrap(),"opacity":0.25})).unwrap();
+                different = frozen(&session, &material.request_id);
+            }
+            8 => different.doc = Arc::new((*different.doc).clone()),
+            9 => {
+                let mut mask = Surface::new(PixelFormat::GRAY8);
+                mask.write_region(Rect::new(0, 0, 1, 1), &[1.0]);
+                session
+                    .edit("Pixel selection", |doc, _| {
+                        doc.selection = Some(mask);
+                        Ok(())
+                    })
+                    .unwrap();
+                different = frozen(&session, &material.request_id);
+            }
+            10 => different.viewport_id += 1,
+            _ => different.canvas_id += 1,
+        }
+        assert!(c.observe(different).is_none());
+        assert_eq!(rx.recv_timeout(Duration::from_secs(1)).unwrap()["error"], "validationInvalidated");
+        let mut original_again = material;
+        original_again.captured_at = Instant::now();
+        assert!(c.observe(original_again).is_none(), "matching old terminal values cannot revive capture");
+    }
+}
+struct Gate {
+    entered: Sender<()>,
+    open: Mutex<bool>,
+    wake: Condvar,
+}
+impl Gate {
+    fn wait(&self) {
+        let _ = self.entered.send(());
+        let mut open = self.open.lock().unwrap();
+        while !*open {
+            open = self.wake.wait(open).unwrap();
+        }
+    }
+    fn release(&self) {
+        *self.open.lock().unwrap() = true;
+        self.wake.notify_all();
+    }
+}
+struct Release(Arc<Gate>);
+impl Drop for Release {
+    fn drop(&mut self) {
+        self.0.release();
+    }
+}
+#[test]
+fn seecut_validation_invalidate_during_real_encode_late_success_never_revives() {
+    let (entered_tx, entered_rx) = channel();
+    let gate = Arc::new(Gate { entered: entered_tx, open: Mutex::new(false), wake: Condvar::new() });
+    let _release = Release(gate.clone());
+    let worker_gate = gate.clone();
+    let c = Coordinator::with_before_work_hook(Arc::new(move || worker_gate.wait())).unwrap();
+    let session = fixture();
+    let mut material = frozen(&session, "late");
+    let (tx, rx) = channel();
+    c.enqueue(snapshot_request(&material), tx, None).unwrap();
+    material.captured_at = Instant::now();
+    c.adopt(material.clone()).unwrap();
+    entered_rx.recv_timeout(Duration::from_secs(1)).unwrap();
+    assert!(c.observation_ticket().is_some(), "watch starts at adoption, before encode");
+    let ticket = c.observe(material.clone()).unwrap();
+    c.finish_frame(ticket, true);
+    let (tx, _) = channel();
+    let unknown = ValidationRequest { request_id: "while-running".into(), snapshot_id: format!("snapshot-v1-{}", "a".repeat(64)) };
+    assert_eq!(c.enqueue_validation(unknown, tx, None).unwrap_err()["error"], "validationBusy");
+    c.invalidate();
+    for n in 0..8 {
+        let (tx, _) = channel();
+        assert_eq!(c.enqueue(snapshot_request(&frozen(&session, &format!("blocked:{n}"))), tx, None).unwrap_err()["error"], "snapshotBusy");
+    }
+    gate.release();
+    let snapshot = rx.recv_timeout(Duration::from_secs(3)).unwrap();
+    assert_eq!(snapshot["ok"], true, "historical image remains historical after freshness loss");
+    wait_for_slot(&c);
+    assert!(c.observation_ticket().is_none());
+    let (tx, _) = channel();
+    assert_eq!(c.enqueue_validation(validation(&snapshot, "late-validation"), tx, None).unwrap_err()["error"], "validationUnknownSnapshot");
+    assert_eq!(c.shared.lock().jobs_started, 1);
+    assert_eq!(c.worker.current_num_threads(), 1);
+}
