+    let (tx, _) = channel();
+    assert_eq!(c.enqueue_validation(validation(&snapshot, "other"), tx, None).unwrap_err()["error"], "validationBusy");
+    let (tx, _) = channel();
+    assert_eq!(c.enqueue(snapshot_request(&frozen(&session, "blocked")), tx, None).unwrap_err()["error"], "snapshotBusy");
+    assert_eq!(rx.recv_timeout(Duration::from_secs(1)).unwrap()["error"], "validationTimeout");
+    let rx = enqueue(&c, &snapshot, "after-timeout");
+    let ticket = repaint(&c, &material, 19);
+    c.finish_frame(ticket, true);
+    assert_eq!(rx.recv_timeout(Duration::from_secs(1)).unwrap()["ok"], true);
+    assert_eq!(c.shared.lock().jobs_started, 1);
+}
