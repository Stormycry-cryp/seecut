+fn seecut_validation_strict_closed_ids_and_real_snapshot_format() {
+    let base = json!({"requestId":"validation:1","snapshotId":format!("snapshot-v1-{}", "a".repeat(64))});
+    assert!(ValidationRequest::parse(&base).is_ok());
+    for change in [
+        json!({"extra":true}),
+        json!({"expected":{}}),
+        json!({"requestId":"x".repeat(129)}),
+        json!({"requestId":"非ASCII"}),
+        json!({"requestId":""}),
+        json!({"snapshotId":"snapshot-v1-short"}),
+        json!({"snapshotId":format!("snapshot-v1-{}", "A".repeat(64))}),
+        json!({"snapshotId":format!("snapshot-v2-{}", "a".repeat(64))}),
+    ] {
+        let mut bad = base.clone();
+        for (k, v) in change.as_object().unwrap() {
+            bad[k] = v.clone();
+        }
+        assert!(ValidationRequest::parse(&bad).is_err(), "{bad}");
+    }
+    let mut longest = base;
+    longest["requestId"] = json!("a".repeat(128));
+    assert!(ValidationRequest::parse(&longest).is_ok());
+}
