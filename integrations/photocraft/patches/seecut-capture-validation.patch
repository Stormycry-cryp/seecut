--- /dev/null
+++ b/crates/ui-egui/src/seecut_agent/validation.rs
@@ -0,0 +1,177 @@
+//! A private, one-paint frame-end check. It cannot grant command authority.
+use super::*;
+use crate::seecut_snapshot::{FrozenMaterial, ObservationTicket, ValidationRequest};
+
+pub(super) struct PaintFrame {
+    material: FrozenMaterial,
+    ticket: ObservationTicket,
+    index: usize,
+    output: Option<u32>,
+    view: crate::state::View,
+    options: crate::view_cmds::ViewOptions,
+    channels: photocraft_engine::channel_cmds::ChannelView,
+    gpu_available: bool,
+}
+
+pub(crate) fn invalidate(app: &mut PhotocraftApp) {
+    app.seecut_agent.validation_frame = None;
+    if let Some(c) = app.seecut_agent.snapshot.as_ref() {
+        c.invalidate();
+    }
+}
+
+// Unknown methods conservatively invalidate. engine.execute is excluded even for reads.
+pub(crate) fn before_control(app: &mut PhotocraftApp, method: &str) {
+    if !matches!(
+        method,
+        "seecut.state"
+            | "seecut.receipt"
+            | "seecut.snapshot.validate"
+            | "ui.inspect"
+            | "ui.menu.list"
+            | "engine.commands"
+            | "jobs.list"
+    ) {
+        invalidate(app);
+    }
+}
+
+fn changes_input(events: &[egui::Event]) -> bool {
+    events.iter().any(|e| {
+        !matches!(
+            e,
+            egui::Event::PointerMoved(_)
+                | egui::Event::MouseMoved(_)
+                | egui::Event::PointerGone
+                | egui::Event::WindowFocused(_)
+        )
+    })
+}
+pub(crate) fn before_input(app: &mut PhotocraftApp, events: &[egui::Event]) {
+    if changes_input(events) {
+        invalidate(app);
+    }
+}
+pub(crate) fn begin_frame(app: &mut PhotocraftApp, ctx: &egui::Context) {
+    // A previous paint that never reached the end is not evidence of a settled frame.
+    if app.seecut_agent.validation_frame.is_some()
+        || ctx.input(|i| changes_input(&i.raw.events) || i.smooth_scroll_delta != egui::Vec2::ZERO)
+    {
+        invalidate(app);
+    }
+}
+
+pub(crate) fn enqueue(
+    app: &mut PhotocraftApp,
+    ctx: &egui::Context,
+    request: ValidationRequest,
+    reply: std::sync::mpsc::Sender<Value>,
+    deadline: Option<std::time::Instant>,
+) -> Result<(), Value> {
+    use crate::seecut_snapshot::error;
+    if app.seecut_agent.host_instance.is_none() {
+        return Err(error("hostBindingUnavailable"));
+    }
+    if let Some(code) = snapshot_busy(app, ctx) {
+        invalidate(app);
+        return Err(error(code));
+    }
+    let coordinator = app
+        .seecut_agent
+        .snapshot
+        .as_ref()
+        .ok_or_else(|| error("snapshotUnavailable"))?;
+    coordinator.enqueue_validation(request, reply, deadline)?;
+    ctx.request_repaint();
+    Ok(())
+}
+
+pub(crate) fn record_paint(
+    app: &mut PhotocraftApp,
+    _ctx: &egui::Context,
+    index: usize,
+    output: Option<u32>,
+    view: crate::state::View,
+    material: FrozenMaterial,
+    ticket: ObservationTicket,
+) {
+    if app.seecut_agent.validation_frame.is_some() {
+        invalidate(app);
+        return;
+    }
+    app.seecut_agent.validation_frame = Some(PaintFrame {
+        material,
+        ticket,
+        index,
+        output,
+        view,
+        options: app.ui.view.clone(),
+        channels: app.session.documents()[index].channel_view.clone(),
+        gpu_available: app.gpu.is_some(),
+    });
+}
+
+fn unchanged(app: &PhotocraftApp, ctx: &egui::Context, paint: &PaintFrame) -> bool {
+    let m = &paint.material;
+    if app.frame != m.frame
+        || app.session.active_index() != Some(paint.index)
+        || snapshot_busy(app, ctx).is_some()
+        || app.ui.views.get(paint.index) != Some(&paint.view)
+        || app.ui.view != paint.options
+        || app.gpu.is_some() != paint.gpu_available
+        || ctx.pixels_per_point() != m.geometry.pixels_per_point
+        || ctx.input(|i| i.smooth_scroll_delta != egui::Vec2::ZERO)
+        || app.ui.mask_target
+        || app.ui.vector_mask_target
+    {
+        return false;
+    }
+    let Some(st) = app.session.documents().get(paint.index) else {
+        return false;
+    };
+    let selected: Vec<u64> = match st.active_layer {
+        Some(active) if st.selected_layers.contains(&active) => {
+            st.selected_layers.iter().map(|id| id.0).collect()
+        }
+        Some(active) => vec![active.0],
+        None => Vec::new(),
+    };
+    let proof = app.session.color.proof(st.doc.id);
+    if !std::sync::Arc::ptr_eq(&st.doc, &m.doc)
+        || snapshot_identity(app, paint.index).as_ref() != Some(&m.expected)
+        || st.active_layer.map(|id| id.0) != m.active_layer
+        || selected != m.selected_layers
+        || st.channel_view != paint.channels
+        || proof.enabled
+        || proof.gamut_warning
+        || app.session.color.hdr_preview(&st.doc).is_some()
+        || st.is_dirty() != m.dirty
+        || st.history.can_undo() != m.can_undo
+        || st.history.can_redo() != m.can_redo
+    {
+        return false;
+    }
+    let (display, _) = crate::canvas::canvas_display(app, &st.doc, paint.output);
+    display.is_some_and(|d| {
+        d.key == m.presentation.display_key
+            && d.is_identity() == m.presentation.display_identity
+            && !d.encode_srgb
+            && d.source.content_hash() == photocraft_cms::Builtin::Srgb.profile().content_hash()
+    })
+}
+
+pub(crate) fn finish_frame(app: &mut PhotocraftApp, ctx: &egui::Context) {
+    let Some(paint) = app.seecut_agent.validation_frame.take() else {
+        if let Some(c) = app.seecut_agent.snapshot.as_ref() {
+            c.invalidate();
+        }
+        return;
+    };
+    let same = unchanged(app, ctx, &paint);
+    if let Some(c) = app.seecut_agent.snapshot.as_ref() {
+        c.finish_frame(paint.ticket, same);
+    }
+}
