+fn seecut_validation_unknown_and_idle_repaints_keep_original_hashes_and_u64() {
+    let c = Coordinator::new().unwrap();
+    let (tx, _) = channel();
+    let unknown = ValidationRequest::parse(&json!({"requestId":"unknown","snapshotId":format!("snapshot-v1-{}", "a".repeat(64))})).unwrap();
+    assert_eq!(c.enqueue_validation(unknown, tx, None).unwrap_err()["error"], "validationUnknownSnapshot");
+    let session = fixture();
+    let (material, snapshot) = capture(&c, &session, "idle");
+    for frame in [18, 19, 20] {
+        let rx = enqueue(&c, &snapshot, "idle-repeated-request");
+        assert!(rx.try_recv().is_err(), "cached previous frame is insufficient");
+        let ticket = repaint(&c, &material, frame);
+        assert!(rx.try_recv().is_err(), "paint alone is insufficient before post-input boundary");
+        c.finish_frame(ticket, true);
+        let reply = rx.recv_timeout(Duration::from_secs(1)).unwrap();
+        let result = &reply["result"];
+        assert_eq!(reply["ok"], true);
+        assert_eq!(result["kind"], "adoptedSnapshotValidation");
+        assert_eq!(result["requestId"], "idle-repeated-request");
+        assert_eq!(result["validationStage"], "postInputFrame");
+        assert_eq!(result["adoptionStage"], "uiPaintSubmitted");
+        assert_eq!(result["identity"], snapshot["result"]["identity"]);
+        assert_eq!(result["snapshotId"], snapshot["result"]["snapshotId"]);
+        assert_eq!(result["viewStateId"], snapshot["result"]["view"]["viewStateId"]);
+        assert_eq!(result["selectionStateId"], snapshot["result"]["selection"]["selectionStateId"]);
+        assert_eq!(result["validatedFrame"].as_u64(), Some(frame));
+        assert!(result["captureAgeMs"].is_u64());
