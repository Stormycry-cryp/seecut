+    let mut later = material.clone();
+    later.frame += 1;
+    later.captured_at = Instant::now();
+    assert!(c.observe(later).is_none(), "later matching content cannot settle the missing initial boundary");
+    c.finish_frame(initial_ticket, true);
+    assert!(c.observation_ticket().is_none());
+
+    let (material, snapshot) = capture(&c, &session, "intermediate-unsettled");
+    let rx = enqueue(&c, &snapshot, "intermediate-not-finished");
+    let old_ticket = repaint(&c, &material, 18);
