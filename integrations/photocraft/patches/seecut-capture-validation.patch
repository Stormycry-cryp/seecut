+fn enqueue(
+    app: &mut PhotocraftApp,
+    ctx: &egui::Context,
+    id: &str,
+) -> (Value, mpsc::Receiver<Value>) {
+    let st = app.session.active().unwrap();
+    let expected = json!({"hostInstanceId":HOST,"docId":st.doc.id.0,
+        "documentGeneration":st.document_generation,"revision":st.revision});
+    let (request, reply) = crate::control::ControlRequest::new(
+        "seecut.snapshot",
+        json!({"requestId":id,"expected":expected,"maxEdge":8}),
+    );
+    let (tx, rx) = mpsc::channel();
+    app.control_rx = Some(rx);
+    tx.send(request).unwrap();
+    app.drain_control(ctx);
+    assert!(
+        matches!(reply.try_recv(), Err(mpsc::TryRecvError::Empty)),
+        "drain must defer until actual canvas adoption"
+    );
+    assert!(app.seecut_agent.snapshot.as_ref().unwrap().wants_capture());
+    (expected, reply)
