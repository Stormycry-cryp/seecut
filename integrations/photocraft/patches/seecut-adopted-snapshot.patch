+    if area.checked_mul(cost.raster_count.max(1)).is_none_or(|v| v > MAX_COMPOSITE_WORK) {
+        return Err(error("snapshotCostLimit"));
+    }
+    // Match DocState::selected_layers exactly for valid active ids: document
+    // bottom-to-top walk order; raw ids are a set, stale/duplicate ids disappear.
+    // An active layer missing from raw selection falls back to that layer alone.
+    let selected_set: std::collections::HashSet<u64> = match material.active_layer {
+        None => std::collections::HashSet::new(),
+        Some(active) if !cost.ids.contains(&active) => {
+            return Err(error("snapshotSelectionUnsupported"));
+        }
+        Some(active) if material.selected_layers.contains(&active) => material.selected_layers.iter().copied().collect(),
+        Some(active) => std::iter::once(active).collect(),
+    };
+    let selected_layers: Vec<u64> = layers.iter().filter_map(|l| l["id"].as_u64()).filter(|id| selected_set.contains(id)).collect();
+    let selection = selection(material, &selected_layers, &mut cost, cancelled, deadline)?;
+    check(cancelled, deadline)?;
