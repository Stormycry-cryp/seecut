+pub(crate) fn enqueue_snapshot(app: &mut PhotocraftApp, ctx: &egui::Context, request: crate::seecut_snapshot::SnapshotRequest,
+    reply: std::sync::mpsc::Sender<Value>, deadline: Option<std::time::Instant>) -> Result<(), Value> {
+    use crate::seecut_snapshot::error;
+    let host = app.seecut_agent.host_instance.as_ref().ok_or_else(|| error("hostBindingUnavailable"))?;
+    let st = app.session.active().ok_or_else(|| error("noDocument"))?;
+    if &request.expected.host_instance_id != host { return Err(error("wrongHostInstance")); }
+    if st.document_generation == 0 { return Err(error("generationUnavailable")); }
+    if st.doc.id.0 != request.expected.doc_id || st.document_generation != request.expected.document_generation { return Err(error("wrongDocument")); }
+    if st.revision != request.expected.revision { return Err(error("staleRevision")); }
+    if let Some(code) = snapshot_busy(app, ctx) { return Err(error(code)); }
+    if app.seecut_agent.snapshot.is_none() { app.seecut_agent.snapshot = Some(crate::seecut_snapshot::Coordinator::new()?); }
+    app.seecut_agent.snapshot.as_ref().unwrap().enqueue(request, reply, deadline)?;
+    ctx.request_repaint();
+    Ok(())
+}
+
+pub(crate) fn snapshot_busy(app: &PhotocraftApp, ctx: &egui::Context) -> Option<&'static str> {
+    if !app.ui.dialogs.is_empty() { return Some("modalBusy"); }
+    if let Some(code) = busy(app, ctx, "seecut.snapshot") { return Some(code); }
+    // Preserve release/wheel/key frames too; ordinary pointer hover alone is safe.
+    if ctx.input(|i| i.raw.events.iter().any(|e| !matches!(e,
+        egui::Event::PointerMoved(_) | egui::Event::MouseMoved(_) | egui::Event::PointerGone))) {
+        return Some("inputFrameBusy");
+    }
+    if app.ui.view.arrange != "tabs" { return Some("viewUnsupported"); }
+    if !app.jobs.opens.is_empty() || app.jobs.focus.is_some() { return Some("jobBusy"); }
+    if !app.redraws.is_empty() { return Some("redrawBusy"); }
+    None
+}
