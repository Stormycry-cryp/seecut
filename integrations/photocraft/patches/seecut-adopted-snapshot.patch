+    assert_eq!(rx.recv_timeout(Duration::from_secs(1)).unwrap()["error"], "snapshotCancelled");
+    assert_eq!(c.shared.lock().jobs_started, 1);
+    assert_eq!(c.worker.current_num_threads(), 1);
+    gate.open();
+    await_slot_release(&c);
+    assert!(rx.recv_timeout(Duration::from_millis(10)).is_err());
+}
+#[test]
+fn stale_capture_cannot_steal_successor_even_with_identical_document_identity() {
+    let session = fixture();
+    let mut old = frozen(&session, "old");
+    let c = Coordinator::new().unwrap();
+    let (tx, rx) = std::sync::mpsc::channel();
+    c.enqueue(request(&old), tx, None).unwrap();
+    old.captured_at = Instant::now();
+    assert!(c.cancel("old"));
+    assert_eq!(rx.recv().unwrap()["error"], "snapshotCancelled");
+    let mut new = frozen(&session, "new");
+    let (tx, rx) = std::sync::mpsc::channel();
+    c.enqueue(request(&new), tx, None).unwrap();
+    assert_eq!(c.adopt(old).unwrap_err()["error"], "staleCapture");
+    assert_eq!(c.pending_ticket().unwrap().request_id, "new");
+    new.captured_at = Instant::now();
+    c.adopt(new).unwrap();
+    assert_eq!(rx.recv_timeout(Duration::from_secs(2)).unwrap()["result"]["requestId"], "new");
+}
+#[test]
+fn captured_identity_mismatch_settles_only_its_own_request() {
+    let session = fixture();
+    let mut m = frozen(&session, "identity");
+    let c = Coordinator::new().unwrap();
+    let (tx, rx) = std::sync::mpsc::channel();
+    c.enqueue(request(&m), tx, None).unwrap();
+    m.expected.revision += 1;
+    m.captured_at = Instant::now();
+    assert_eq!(c.adopt(m).unwrap_err()["error"], "wrongDocument");
+    assert_eq!(rx.recv_timeout(Duration::from_secs(1)).unwrap()["error"], "wrongDocument");
+    assert_eq!(c.shared.lock().jobs_started, 0);
+    assert!(!c.wants_capture());
+}
