+//! Queued transport expiry must not become a fresh five-second task on UI resume.
+use super::*;
+use crate::control::ControlRequest;
+use std::sync::mpsc;
+use std::time::{Duration, Instant};
+
+fn fixture() -> (PhotocraftApp, egui::Context, mpsc::Sender<ControlRequest>) {
+    let mut session = photocraft_engine::Session::new();
+    session.execute("file.new", json!({"width":8,"height":8})).unwrap();
+    let mut app = PhotocraftApp::new(session, crate::Services::default());
+    app.seecut_agent = ControlState::from_binding(Some("8e88a522-e405-40cd-9ef0-56b530ec0c21".into()));
+    let (tx, rx) = mpsc::channel();
+    app = app.with_control(rx);
+    assert!(app.seecut_agent.snapshot.is_none(), "worker creation is lazy");
+    (app, egui::Context::default(), tx)
+}
+fn snapshot(app: &PhotocraftApp, id: &str) -> (ControlRequest, mpsc::Receiver<Value>) {
+    let st = app.session.active().unwrap();
+    ControlRequest::new("seecut.snapshot", json!({"requestId":id,"maxEdge":8,
+        "expected":{"hostInstanceId":"8e88a522-e405-40cd-9ef0-56b530ec0c21",
+            "docId":st.doc.id.0,"documentGeneration":st.document_generation,"revision":st.revision}}))
+}
+
+#[test]
+fn snapshot_expired_before_ui_resume_never_creates_coordinator() {
+    let (mut app, ctx, tx) = fixture();
+    let revision = app.session.active().unwrap().revision;
+    let (mut req, reply) = snapshot(&app, "expired-before-drain");
+    req.deadline = Some(Instant::now() - Duration::from_millis(1));
+    let dispatch = req.dispatch.clone();
+    tx.send(req).unwrap();
+    app.drain_control(&ctx);
+    assert_eq!(reply.try_recv().unwrap(), json!({"ok":false,"error":"snapshotTimeout"}));
+    assert!(matches!(reply.try_recv(), Err(mpsc::TryRecvError::Disconnected)));
+    assert!(app.seecut_agent.snapshot.is_none(), "expired request must not allocate a pool or enqueue work");
+    assert_eq!(app.session.active().unwrap().revision, revision);
+    assert_eq!(dispatch.give_up(), crate::control::expired_error(), "UI did not claim the expired request");
+}
+
+#[test]
+fn snapshot_abandoned_by_transport_cannot_restart_when_ui_resumes() {
+    let (mut app, ctx, tx) = fixture();
+    let revision = app.session.active().unwrap().revision;
+    let (mut req, reply) = snapshot(&app, "abandoned-before-drain");
+    // Deliberately still in the future: only Dispatch abandonment can prevent execution.
+    req.deadline = Some(Instant::now() + Duration::from_secs(5));
+    let dispatch = req.dispatch.clone();
+    tx.send(req).unwrap();
+    assert_eq!(dispatch.give_up(), crate::control::expired_error());
+    app.drain_control(&ctx);
+    assert_eq!(reply.try_recv().unwrap(), json!({"ok":false,"error":"snapshotTimeout"}));
+    assert!(app.seecut_agent.snapshot.is_none(), "transport abandonment must not become a newly enqueued snapshot");
+    assert_eq!(app.session.active().unwrap().revision, revision);
+    app.drain_control(&ctx);
+    assert!(matches!(reply.try_recv(), Err(mpsc::TryRecvError::Disconnected)));
+    assert!(app.seecut_agent.snapshot.is_none());
+}
+
+#[test]
+fn snapshot_expiry_does_not_change_generic_control_errors_or_block_next_live_command() {
+    let (mut app, ctx, tx) = fixture();
+    let layers = app.session.active().unwrap().doc.layers.len();
+    let (mut snap, snap_reply) = snapshot(&app, "expired-then-generic");
+    snap.deadline = Some(Instant::now() - Duration::from_millis(1));
+    tx.send(snap).unwrap();
+    let (mut expired, expired_reply) = ControlRequest::new("engine.execute", json!({"command":"layer.new.layer"}));
+    expired.deadline = Some(Instant::now() - Duration::from_millis(1));
+    tx.send(expired).unwrap();
+    let (mut live, live_reply) = ControlRequest::new("engine.execute", json!({"command":"layer.new.layer"}));
+    live.deadline = Some(Instant::now() + crate::control::REPLY_DEADLINE);
+    tx.send(live).unwrap();
+    app.drain_control(&ctx);
+    assert_eq!(snap_reply.try_recv().unwrap(), json!({"ok":false,"error":"snapshotTimeout"}));
+    assert_eq!(expired_reply.try_recv().unwrap(), json!({"ok":false,"error":crate::control::expired_error()}));
+    assert_eq!(crate::control::REPLY_DEADLINE, Duration::from_secs(60));
+    assert_eq!(live_reply.try_recv().unwrap()["ok"], true);
+    assert_eq!(app.session.active().unwrap().doc.layers.len(), layers + 1, "only the final live command executes");
+    assert!(app.seecut_agent.snapshot.is_none());
+}
