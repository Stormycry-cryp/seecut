+struct Gate {
+    entered: Sender<()>,
+    release: Mutex<bool>,
+    wake: Condvar,
+}
+impl Gate {
+    fn wait(&self) {
+        let _ = self.entered.send(());
+        let mut open = self.release.lock().unwrap();
+        while !*open {
+            open = self.wake.wait(open).unwrap();
+        }
+    }
+    fn open(&self) {
+        *self.release.lock().unwrap() = true;
+        self.wake.notify_all();
+    }
+}
+fn delayed(c: &mut Coordinator) -> (Arc<Gate>, std::sync::mpsc::Receiver<()>) {
+    let (tx, rx) = std::sync::mpsc::channel();
+    let gate = Arc::new(Gate { entered: tx, release: Mutex::new(false), wake: Condvar::new() });
+    let worker_gate = gate.clone();
+    c.before_work = Some(Arc::new(move || worker_gate.wait()));
+    (gate, rx)
+}
