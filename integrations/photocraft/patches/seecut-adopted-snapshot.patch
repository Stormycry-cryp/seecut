+    check(cancelled, deadline)?;
+    if image.width == 0
+        || image.height == 0
+        || image.width > MAX_EDGE
+        || image.height > MAX_EDGE
+        || image.pixels.len() != image.width as usize * image.height as usize * 4
+    {
+        return Err(error("snapshotImageInvalid"));
+    }
+    let pixel_hash = digest(&[b"seecut-rgba8-srgb-v1\0", &image.width.to_le_bytes(), &image.height.to_le_bytes(), &image.pixels]);
+    let (width, height) = (image.width, image.height);
+    let mut encoded =
+        photocraft_codecs::Image::from_u8(width, height, photocraft_codecs::ChannelLayout::Rgba, image.pixels).map_err(|_| error("snapshotEncodingFailed"))?;
+    let profile = photocraft_cms::Builtin::Srgb.profile().to_bytes();
+    if profile.len() > 64 * 1024 {
+        return Err(error("snapshotProfileLimit"));
+    }
+    let profile_hash = digest(&[&profile]);
+    encoded.icc = Some((*profile).clone());
+    let opts = photocraft_codecs::EncodeOptions { png_compression: photocraft_codecs::PngCompression::None, embed_metadata: false, ..Default::default() };
+    let png = photocraft_codecs::encode(&encoded, photocraft_codecs::Format::Png, &opts).map_err(|_| error("snapshotEncodingFailed"))?;
+    check(cancelled, deadline)?;
+    if png.len() > MAX_PNG {
+        return Err(error("snapshotPngLimit"));
+    }
+    let png_hash = digest(&[&png]);
+    let geometry_bytes = serde_json::to_vec(&material.geometry).map_err(|_| error("snapshotSerializationFailed"))?;
+    let identity_bytes = serde_json::to_vec(&material.expected).map_err(|_| error("snapshotSerializationFailed"))?;
+    let view_hash = digest(&[b"seecut-view-v1\0", &identity_bytes, &material.viewport_id.to_le_bytes(), &material.canvas_id.to_le_bytes(), &geometry_bytes]);
+    let snapshot_hash = digest(&[
+        b"seecut-snapshot-v1\0",
+        request.request_id.as_bytes(),
+        &identity_bytes,
+        &material.frame.to_le_bytes(),
+        pixel_hash.as_bytes(),
+        selection["selectionStateId"].as_str().unwrap_or("").as_bytes(),
+        view_hash.as_bytes(),
+    ]);
+    let polygon = &material.geometry.visible_document_polygon;
+    let aabb = [
+        polygon.iter().map(|p| p[0]).fold(f64::INFINITY, f64::min),
+        polygon.iter().map(|p| p[1]).fold(f64::INFINITY, f64::min),
+        polygon.iter().map(|p| p[0]).fold(f64::NEG_INFINITY, f64::max),
+        polygon.iter().map(|p| p[1]).fold(f64::NEG_INFINITY, f64::max),
+    ];
+    let clipped = [
+        aabb[0].clamp(0.0, f64::from(doc.size.width)),
+        aabb[1].clamp(0.0, f64::from(doc.size.height)),
+        aabb[2].clamp(0.0, f64::from(doc.size.width)),
+        aabb[3].clamp(0.0, f64::from(doc.size.height)),
+    ];
+    let reply = json!({"ok":true,"result":{
+        "kind":"adoptedDocumentComposite","adoptionStage":"uiPaintSubmitted","snapshotId":format!("snapshot-v1-{snapshot_hash}"),
+        "requestId":request.request_id,"capturedFrame":material.frame,"capturedAfterUiEnqueueMs":material.captured_at.saturating_duration_since(started).as_millis(),
+        "timeBasis":{"captureDelay":"uiEnqueue","captureAge":"adoptedFrameCapture"},
+        "returnedHistoricalFrame":true,"captureAgeAtReplyMs":material.captured_at.elapsed().as_millis(),"viewportId":material.viewport_id,"canvasId":material.canvas_id,"identity":material.expected,
+        "document":{"name":doc.name,"size":[doc.size.width,doc.size.height],"layers":layers,"layersOrder":"documentBottomToTop","activeLayer":material.active_layer,
+            "selectedLayers":selected_layers,"selectedLayersOrder":"documentBottomToTop","dirty":material.dirty,"canUndo":material.can_undo,"canRedo":material.can_redo},
+        "selection":selection,"view":{"geometry":material.geometry,"visibleDocumentAabb":aabb,"clippedVisibleDocumentAabb":clipped,"aabbFormat":"xyxyExclusive","viewStateId":format!("view-v1-{view_hash}")},
+        "presentation":{"source":p,"colorSpace":"sRGB IEC61966-2.1","profileHash":profile_hash,"pixelSemantics":"documentCompositeNotMonitorPixels"},
+        "pixels":{"kind":"documentComposite","transparent":true,"mime":"image/png","width":width,"height":height,
+            "documentRect":[0,0,doc.size.width,doc.size.height],"documentPixelsPerOutputPixel":[f64::from(doc.size.width)/f64::from(width),f64::from(doc.size.height)/f64::from(height)],
+            "pixelHash":pixel_hash,"pngHash":png_hash,"base64":base64::engine::general_purpose::STANDARD.encode(png)}
+    }});
+    let bytes = serde_json::to_vec(&reply).map_err(|_| error("snapshotSerializationFailed"))?;
+    if bytes.len() > MAX_REPLY - 1024 {
+        return Err(error("snapshotReplyLimit"));
+    }
+    check(cancelled, deadline)?;
+    Ok(reply)
