+//! Private native adopted-frame snapshots; no UI capture or current-state reread.
+// All string fields are bounded by the backend; geometry is from the same paint branch.
+#[derive(Clone, Debug, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(crate) struct ExpectedIdentity {
+    pub host_instance_id: String,
+    pub doc_id: u64,
+    pub document_generation: u64,
+    pub revision: u64,
+}
+#[derive(Clone, Debug, serde::Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(crate) struct SnapshotRequest {
+    pub request_id: String,
+    pub expected: ExpectedIdentity,
+    pub max_edge: u32,
+}
+#[derive(Clone, Debug)]
+pub(crate) struct CaptureTicket {
+    pub request_id: String,
+    pub expected: ExpectedIdentity,
+}
+#[derive(Clone, Copy, Debug, serde::Serialize)]
+#[serde(rename_all = "lowercase")]
+pub(crate) enum Renderer {
+    Cpu,
+    Gpu,
+}
+#[derive(Clone, Debug, serde::Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct FrozenGeometry {
+    pub rect_points: [f32; 4], // x,y,width,height inside rulers
+    pub pixels_per_point: f32,
+    pub zoom: f32, // actual xf.zoom, egui points / document pixel
+    pub center: [f32; 2],
+    pub flip: bool,
+    pub rotation: f32,
+    pub aspect: f32,
+    pub display_camera: [f32; 3], // actual device-pixel zoom, center.x, center.y
+    pub target_camera: [f32; 3],
+    pub visible_document_polygon: [[f64; 2]; 4], // xf.to_doc(rect corners), no padded AABB
+}
+#[derive(Clone, Debug, serde::Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct FrozenPresentation {
+    pub renderer: Renderer,
+    pub display_key: u64,
+    pub raw_preview_key: u64,
+    pub complete: bool,
+    pub display_identity: bool, // actual successful CanvasDisplay, no fallback None
+    pub source_is_srgb: bool,   // successful adopted display source is builtin sRGB, !encode_srgb
+    pub proof: bool,
+    pub hdr: bool,
+    pub channel_composite: bool,
+}
+pub(crate) struct FrozenMaterial {
