+//! Native, offscreen integration: real control drain, canvas branch, worker and PNG codec.
+//! No native window, input injection, mock canvas, or manually constructed FrozenMaterial.
+use super::*;
+use base64::Engine as _;
+use photocraft_color::PixelFormat;
