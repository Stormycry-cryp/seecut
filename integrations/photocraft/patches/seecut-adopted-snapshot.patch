+    if material.selected_layers.len() > 256 {
+        return Err(error("snapshotLayerLimit"));
+    }
+    let mut cost = Cost { layers: 0, surfaces: 0, bytes: 0, raster_count: 0, ids: std::collections::HashSet::new() };
+    let mut layers = Vec::new();
