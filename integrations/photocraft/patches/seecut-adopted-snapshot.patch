+        assert!(abandoned.reply.send(json!({"ok":true,"result":"late"})).is_err(), "a late UI reply cannot replace the timeout");
+        drop(abandoned);
+
+        // A timeout consumes exactly this reply; the authenticated connection and
+        // following normal request retain their original framing and 60s budget.
+        writeln!(stream, "{}", json!({"id":3,"method":"test.after"})).unwrap();
+        let next = rx.recv_timeout(Duration::from_secs(1)).unwrap();
+        let remaining = next.deadline.unwrap().saturating_duration_since(Instant::now());
+        assert!(remaining > Duration::from_secs(55) && remaining <= Duration::from_secs(60));
