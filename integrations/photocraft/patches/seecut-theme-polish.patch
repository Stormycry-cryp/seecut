 /// Translate an English UI string into the current language ([`tr`] with [`current`]).
 pub fn t(s: &str) -> &str {
     tr(current(), s)
+}
+
+/// SeeCut-specific attribution follows the active language scope without changing
+/// the upstream translation catalogue or its stable keys.
+pub fn upstream_resources_label() -> &'static str {
+    match current().code() {
+        "zh-hans" => "PhotoCraft 项目资源",
+        _ => "PhotoCraft upstream resources",
+    }
+}
+
+/// Attribute the upstream project and its licence, not the entire SeeCut product.
+pub fn upstream_attribution() -> &'static str {
+    match current().code() {
+        "zh-hans" => "本编辑器基于 ArtCraft 团队的 PhotoCraft，原项目采用 MIT 或 Apache-2.0 许可。",
+        _ => "Based on PhotoCraft by the ArtCraft team · MIT OR Apache-2.0",
+    }
 }
 
