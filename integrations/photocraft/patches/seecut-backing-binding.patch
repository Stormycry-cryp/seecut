+/// Real native-format bytes and atomic writes, restricted to this test's new directory.
+/// No editor process, global environment changes or permissive fake writer.
+#[cfg(not(target_arch = "wasm32"))]
+struct BackingFiles(std::path::PathBuf);
+#[cfg(not(target_arch = "wasm32"))]
+impl BackingFiles {
+    fn new() -> Self {
+        static NEXT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(1);
+        for _ in 0..32 {
+            let root = std::env::temp_dir().join(format!("photocraft-backing-{}-{}", std::process::id(), NEXT.fetch_add(1, std::sync::atomic::Ordering::Relaxed)));
+            match std::fs::create_dir(&root) {
+                Ok(()) => return Self(root),
+                Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => continue,
+                Err(error) => panic!("cannot create owned backing fixture: {error}"),
+            }
+        }
+        panic!("owned backing fixture directory budget exhausted");
+    }
+    fn path(&self, relative: &str) -> String {
+        self.0.join(relative).to_str().unwrap().to_owned()
+    }
+    fn enable_real_saves(&self, app: &mut PhotocraftApp) {
+        let root = self.0.clone();
+        app.background_jobs = false;
+        app.services.export = Some(Box::new(|doc, path, settings| {
+            photocraft_io::export(doc, path, &settings.io_options()).map(|result| (result.bytes, result.warnings)).map_err(|error| error.to_string())
+        }));
+        app.services.write = Some(Box::new(move |path, bytes| {
+            let path = std::path::Path::new(path);
+            if !path.starts_with(&root) || path.components().any(|part| part == std::path::Component::ParentDir) {
+                return Err("write outside owned backing fixture".into());
+            }
+            photocraft_format::atomic_write(path, bytes).map_err(|error| error.to_string())
+        }));
+    }
+}
+#[cfg(not(target_arch = "wasm32"))]
+impl Drop for BackingFiles {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+#[cfg(not(target_arch = "wasm32"))]
+fn save_backing_as(app: &mut PhotocraftApp, ctx: &egui::Context, path: &str) {
+    crate::menus::invoke(app, ctx, "file.saveAs", json!({"path":path})).unwrap();
+    let loaded = photocraft_format::load_path(std::path::Path::new(path)).unwrap();
+    let st = app.session.active().unwrap();
+    assert_eq!(loaded.id, st.doc.id);
+    assert_eq!(loaded.size, st.doc.size);
+    assert_eq!(st.path.as_deref(), Some(path));
+}
