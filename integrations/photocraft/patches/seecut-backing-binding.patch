+#[test]
+fn backing_metadata_reports_raw_facts_without_path_guessing_or_truncation() {
+    let (mut app, ctx, _) = fixture(true);
+    let initial = call(&mut app, &ctx, "seecut.state", json!({}));
+    let missing = &initial["result"]["document"]["backing"];
+    assert_eq!(missing["pathStatus"], "missing");
+    assert!(missing["nativePath"].is_null());
+    assert_eq!(missing["sourceReadOnly"], false);
+    assert_eq!(missing["savedRevision"], app.session.active().unwrap().saved_revision);
+    assert!(initial["result"]["document"].get("savedRevision").is_none());
+    let maximum = format!("{}a", "界".repeat(1365));
+    assert_eq!(maximum.len(), 4096);
+    for (path, status) in [(Some("".to_owned()), "invalid"), (Some("a\0b.pcraft".to_owned()), "invalid"),
+        (Some(format!("{maximum}b")), "tooLong"), (Some(maximum.clone()), "recorded"),
+        (Some("relative/作品.pcraft".to_owned()), "recorded"), (None, "missing")] {
+        let st = app.session.active_mut().unwrap();
+        st.set_backing_path(path.clone());
+        st.source_read_only = true;
+        st.saved_revision = 0; // Exact recovery sentinel; metadata must preserve the fact.
+        let state = call(&mut app, &ctx, "seecut.state", json!({}));
+        let backing = &state["result"]["document"]["backing"];
+        assert_eq!(backing["pathStatus"], status);
+        assert_eq!(backing["sourceReadOnly"], true);
+        assert_eq!(backing["savedRevision"], 0);
+        if status == "recorded" {
+            assert_eq!(backing["nativePath"].as_str(), path.as_deref());
+        } else {
+            assert!(backing["nativePath"].is_null());
+        }
+    }
+}
