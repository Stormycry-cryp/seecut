+}
+fn backing_state(st: &photocraft_engine::DocState) -> BackingState {
+    let (native_path, path_status) = match st.path.as_deref() {
+        None => (None, "missing"),
+        Some(path) if path.len() > 4096 => (None, "tooLong"),
+        Some(path) if path.is_empty() || path.contains('\0') => (None, "invalid"),
+        Some(path) => (Some(path.to_owned()), "recorded"),
+    };
+    BackingState { native_path, path_status, source_read_only: st.source_read_only, saved_revision: st.saved_revision }
+}
