+#[test]
+fn opened_from_rebinds_generation_but_same_path_preserves_the_active_identity() {
+    let (mut app, stamps) = fixture();
+    let st = app.session.active().unwrap();
+    let (doc_id, revision, saved_revision, admission) = (st.doc.id, st.revision, st.saved_revision, st.document_generation);
+    assert!(st.path.is_none());
+    app.opened_from("/seecut-backing-test-only/a.pcraft");
+    let st = app.session.active().unwrap();
+    let first = st.document_generation;
+    assert!(first > 0 && first != admission, "a new backing association invalidates the previous generation");
+    assert_eq!(st.path.as_deref(), Some("/seecut-backing-test-only/a.pcraft"));
+    assert_eq!((st.doc.id, st.revision, st.saved_revision), (doc_id, revision, saved_revision));
+    app.opened_from("/seecut-backing-test-only/a.pcraft");
+    assert_eq!(app.session.active().unwrap().document_generation, first, "same raw path must not retire execution identity");
+    app.opened_from("/seecut-backing-test-only/b.pcraft");
+    let st = app.session.active().unwrap();
+    assert!(st.document_generation > 0 && st.document_generation != first, "old expected generation cannot match a rebind");
+    assert_eq!(st.path.as_deref(), Some("/seecut-backing-test-only/b.pcraft"));
+    assert_eq!((st.doc.id, st.revision, st.saved_revision), (doc_id, revision, saved_revision));
+    assert_eq!(stamps.borrow().as_slice(), ["/seecut-backing-test-only/a.pcraft", "/seecut-backing-test-only/a.pcraft", "/seecut-backing-test-only/b.pcraft"]);
+    assert_eq!(app.disk_stamps.get(&doc_id).unwrap().0, "/seecut-backing-test-only/b.pcraft");
+}
