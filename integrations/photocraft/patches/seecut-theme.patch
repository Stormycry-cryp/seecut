+    fn visible_brand_labels_keep_translation_and_never_claim_upstream_brand() {
+        for lang in Lang::all() {
+            assert!(tr(lang, "PhotoCraft").contains("SeeCut"), "{}", lang.code());
+            assert!(tr_id(lang, "help.about", "About PhotoCraft").contains("SeeCut"), "{}", lang.code());
+            for label in ["ArtCraft", "ArtCraft Website", "Join the ArtCraft Discord…"] {
+                assert!(!tr(lang, label).contains("ArtCraft"), "{}: {label}", lang.code());
+            }
+        }
+    }
+}
