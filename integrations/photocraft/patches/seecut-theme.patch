+/// Brand presentation is separate from command IDs, file formats and translation keys.
+/// Upstream support links retain their destinations and are labelled as upstream.
+fn branded_source(s: &str) -> &str {
+    match s {
+        "PhotoCraft" => "SeeCut 图像编辑",
+        "About PhotoCraft" => "About SeeCut 图像编辑",
+        "PhotoCraft Website" | "PhotoCraft website" => "PhotoCraft upstream website",
+        "PhotoCraft on GitHub" => "PhotoCraft source on GitHub",
+        "ArtCraft" | "ArtCraft Website" => "Upstream project website",
+        "Join the ArtCraft Discord…" => "Upstream community on Discord…",
+        "Join the ArtCraft Discord" | "Join us on Discord" => "Upstream community on Discord",
+        "Join the ArtCraft Discord ({url})" => "Upstream community on Discord ({url})",
+        "PhotoCraft — Screen Color Picker" => "SeeCut 图像编辑 — Screen Color Picker",
+        _ => s,
+    }
+}
+
 /// Translate an English UI string; unknown strings come back unchanged.
 pub fn tr(lang: Lang, s: &str) -> &str {
-    lang.catalog().plain(s).unwrap_or(s)
+    lang.catalog().plain(s).unwrap_or_else(|| branded_source(s))
 }
 
 /// Like [`tr`], for an English string that needs a disambiguating `context`.
