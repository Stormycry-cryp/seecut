import { LauncherSafeArea } from "../seecut/launcher-safe-area.slint";
// SPDX-License-Identifier: AGPL-3.0-or-later
import { Theme, Icon, IconButton, Glyph, FocusRing, Tip } from "../primitives/primitives.slint";
import { AppButton } from "../seecut/components.slint";
export struct FlowParameter { id: string, label: string }
export struct FlowAttachment { id: string, label: string, preview: image, kind: string }
/// One input surface. Drafts stay editable while host actions are pending.
/// Enter remains native multiline/IME editing; committing requires the named action.
export component FlowComposer inherits Rectangle {
    in-out property <string> value;
    in property <string> identity-token;
    property <string> editing-token;
    property <int> parameter-page;
    changed identity-token => { root.editing-token = ""; root.parameter-page = 0; }
    in property <string> label: "节点提示词";
    in property <string> placeholder: "写下这个节点的提示词…";
    in property <[FlowAttachment]> attachments;
    in property <string> source-id;
    in property <string> source-title;
    in property <bool> allow-assets;
    in property <bool> allow-upload: true;
    in property <bool> read-only;
    in property <[FlowParameter]> parameters;
    in property <string> action-label: "保存提示词";
    in property <bool> show-action: true;
    in property <string> points-label;
    in property <Glyph> action-glyph: Glyph.check;
    in property <string> caption: "提示词";
    callback parameter-requested(string);
    callback attachment-requested(string);
    callback attachment-action(string,string);
    in property <bool> busy;
    in property <bool> dirty;
    callback edited(string, string);
    callback commit(string, string);
    callback library-requested();
    callback upload-requested();
    out property <bool> input-focused: editor.has-focus;
    public function focus-editor() { editor.focus(); }
    min-width: 0px;
    property <length> reference-height: root.attachments.length > 0 || root.allow-assets || root.source-id != "" ? 72px : 0px;
    property <length> content-top: root.reference-height > 0px ? root.reference-height + 28px : 16px;
    property <length> action-clearance: LauncherSafeArea.trailing(root.absolute-position.x + root.width - 12px, root.absolute-position.y + root.height - 12px);
    property <bool> has-controls: root.show-action || root.parameters.length > 0;
    preferred-height: (root.reference-height > 0px ? root.reference-height + 14px : 0px) + min(170px, max(108px, editor.preferred-height + (root.has-controls ? 74px : 32px)));
    border-radius: 18px;
    background: Theme.field;
    border-width: 1px;
    border-color: editor.has-focus ? Theme.line-strong : Theme.line;
    clip: true;
    if root.reference-height > 0px: Flickable {
        x: 16px; y: 14px; width: parent.width - 32px; height: root.reference-height;
        viewport-height: root.reference-height; viewport-width: max(self.width, reference-row.preferred-width);
        reference-row := HorizontalLayout {
            height: root.reference-height; alignment: start; spacing: 8px;
            if root.source-id != "": Rectangle {
                width: 72px; height: 72px; border-radius: 8px;
                background: Theme.well; border-width: 1px; border-color: Theme.line;
                accessible-role: button; accessible-label: "查看引用提示词 · " + root.source-title;
                accessible-action-default => { root.attachment-requested(root.source-id); }
                Icon { x: 26px; y: 12px; size: 20px; glyph: Glyph.text-mark; tint: Theme.fg-muted; }
                Text { x: 4px; y: 42px; width: 64px; height: 18px; text: root.source-title; font-size: 11px; color: Theme.fg; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                source-focus := FocusScope {
                    key-pressed(event) => { if (event.text == " " || event.text == "\n") && !event.repeat { root.attachment-requested(root.source-id); return accept; } return reject; }
                }
                source-touch := TouchArea { mouse-cursor: pointer; clicked => { source-focus.focus(); root.attachment-requested(root.source-id); } }
                FocusRing { active: source-focus.has-focus; radius: 8px; }
                Tip { text: root.source-title; active: source-touch.has-hover || source-focus.has-focus; }
            }
            for attachment[index] in root.attachments: Rectangle {
                width: 72px; height: 72px; border-radius: 8px; background: Theme.well; clip: true;
                border-width: 1px; border-color: Theme.line;
                accessible-role: button; accessible-label: "参考 " + (index + 1) + " · " + attachment.label;
                accessible-action-default => { root.attachment-requested(attachment.id); }
                Rectangle {
                    x: 0px; y: 0px; width: parent.width; height: parent.height; clip: true;
                    if attachment.kind != "audio": Image { x: 0px; y: 0px; width: parent.width; height: parent.height; source: attachment.preview; image-fit: cover; }
                    if attachment.kind == "audio": Icon { x: 22px; y: 18px; size: 28px; glyph: Glyph.waveform; tint: Theme.fg-muted; }
                }
                Rectangle {
                    x: 4px; y: 4px; width: 19px; height: 19px; border-radius: 10px; background: Theme.image-control;
                    Text { text: "" + (index + 1); color: Theme.image-control-ink; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                }
                attachment-focus := FocusScope {
                    key-pressed(event) => { if (event.text == " " || event.text == "\n") && !event.repeat { root.attachment-requested(attachment.id); return accept; } return reject; }
                }
                TouchArea { x:0px; y:0px; width:parent.width; height:48px; mouse-cursor: pointer; clicked => { attachment-focus.focus(); root.attachment-requested(attachment.id); } }
                Rectangle {
                    x: 0px; y: parent.height - 24px; width: parent.width; height: 24px; background: Theme.image-control;
                    HorizontalLayout { spacing: 0px;
                        IconButton { glyph: Glyph.chevron-left; label: "参考前移"; side: 24px; icon-size: 12px; on-image: true; enabled: index > 0; clicked => { root.attachment-action(attachment.id,"earlier"); } }
                        IconButton { glyph: Glyph.close; label: "移除参考连线"; side: 24px; icon-size: 12px; on-image: true; clicked => { root.attachment-action(attachment.id,"remove"); } }
                        IconButton { glyph: Glyph.chevron-right; label: "参考后移"; side: 24px; icon-size: 12px; on-image: true; enabled: index + 1 < root.attachments.length; clicked => { root.attachment-action(attachment.id,"later"); } }
                    }
                }
                FocusRing { active: attachment-focus.has-focus; radius: 8px; }
                Tip { text: attachment.label; active: attachment-focus.has-focus; }
            }
            if root.allow-assets: Rectangle {
                width: 72px; height: 72px; border-radius: 8px; border-width: 1px; border-color: Theme.line;
                IconButton { width: parent.width; height: parent.height; glyph: Glyph.plus; label: "从资产库添加参考素材"; icon-size: 19px; side: 32px; clicked => { root.library-requested(); } }
            }
        }
    }
    area := Flickable {
        x: 16px; y: root.content-top;
        width: max(0px, parent.width - 32px); height: max(0px, parent.height - self.y - (root.has-controls ? 58px : 16px));
        viewport-width: self.width; viewport-height: max(self.height, editor.preferred-height);
        editor := TextInput {
            width: parent.width; height: max(parent.height, self.preferred-height);
            page-height: area.height;
            text <=> root.value; read-only: root.read-only; single-line: false; wrap: word-wrap;
            font-family: Theme.font; font-size: Theme.workbench-font; color: Theme.fg;
            selection-background-color: Theme.accent-soft; selection-foreground-color: Theme.workbench-selection-ink;
            accessible-role: text-input; accessible-label: root.label; accessible-value: self.text; accessible-placeholder-text: root.placeholder;
            changed has-focus => { if self.has-focus { root.editing-token = root.identity-token; } }
            edited => { root.edited(root.editing-token, self.text); }
            cursor-position-changed(position) => {
                if position.y + area.viewport-y < 0px { area.viewport-y = max(area.height - self.height, -position.y); }
                else if position.y + area.viewport-y > area.height - 22px { area.viewport-y = min(0px, max(area.height - self.height, area.height - position.y - 22px)); }
            }
        }
    }
    if root.value == "": Text {
        x: 16px; y: root.content-top;
        width: parent.width - 32px; text: root.placeholder;
        font-family: Theme.font; font-size: Theme.workbench-font; color: Theme.fg-muted;
        accessible-role: none;
    }
    if root.has-controls: controls := Rectangle {
        x: 12px; y: parent.height - 48px; height: 36px; width: max(0px, parent.width - (root.show-action ? 76px : 24px) - (root.points-label != "" ? 44px : 0px) - root.action-clearance);
        property <int> capacity: self.width < 270px ? 1 : 2;
        property <int> pages: max(1, Math.ceil(root.parameters.length / self.capacity));
        property <int> page: min(max(0, root.parameter-page), self.pages - 1);
        property <length> upload-width: root.allow-assets && root.allow-upload ? 36px : 0px;
        if root.allow-assets && root.allow-upload: IconButton { glyph: Glyph.import; label: "上传本地素材到资产库"; side: 32px; icon-size: 18px; clicked => { root.upload-requested(); } }
        if controls.pages > 1: IconButton { x: controls.upload-width; y: 2px; glyph: Glyph.chevron-left; side: 28px; label: "前一组生成设置"; enabled: controls.page > 0; clicked => { root.parameter-page = controls.page - 1; } }
        parameters-area := Rectangle {
            x: controls.upload-width + (controls.pages > 1 ? 30px : 0px); height: 36px;
            width: max(0px, parent.width - controls.upload-width - (controls.pages > 1 ? 60px : 0px));
            property <length> slot-width: self.width / min(controls.capacity, max(1, root.parameters.length));
            for parameter[index] in root.parameters: AppButton {
                visible: index >= controls.page * controls.capacity && index < (controls.page + 1) * controls.capacity;
                x: (index - controls.page * controls.capacity) * parameters-area.slot-width;
                width: max(0px, parameters-area.slot-width - 4px); height: 32px;
                subtle: true; elide-label: true; label: parameter.label; glyph: Glyph.chevron-down;
                accessible-name: "SeeCut 生成设置 · " + parameter.label;
                clicked => { root.parameter-requested(parameter.id); }
            }
            if root.parameters.length == 0: Text { text: root.dirty ? "未保存" : root.caption; color: Theme.fg-dim; font-family: Theme.font; font-size: Theme.fs; vertical-alignment: center; }
        }
        if controls.pages > 1: IconButton { x: parent.width - 28px; y: 2px; glyph: Glyph.chevron-right; side: 28px; label: "更多生成设置"; enabled: controls.page < controls.pages - 1; clicked => { root.parameter-page = controls.page + 1; } }
    }
    if root.points-label != "": Rectangle {
        x: parent.width - 96px - root.action-clearance; y: parent.height - 48px; width: 40px; height: 36px;
        accessible-role: text; accessible-label: "本次消耗 " + root.points-label + " 积分";
        Text { width: parent.width; height: parent.height; text: root.points-label; color: Theme.fg-muted; font-size: Theme.fs; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { Tip { text: "本次消耗积分"; active: parent.has-hover; } }
    }
    if root.show-action: Rectangle {
        x: parent.width - 48px - root.action-clearance; y: parent.height - 48px; width: 36px; height: 36px; border-radius: 18px;
        background: root.busy ? Theme.field-active : touch.pressed ? Theme.workbench-action-pressed : touch.has-hover ? Theme.accent-hover : Theme.accent;
        accessible-role: button; accessible-label: root.action-label; accessible-enabled: !root.busy;
        accessible-action-default => { if !root.busy { root.commit(root.identity-token, root.value); } }
        forward-focus: focus;
        focus := FocusScope {
            enabled: !root.busy;
            key-pressed(event) => { if (event.text == " " || event.text == "\n") && !event.repeat { root.commit(root.identity-token, root.value); return accept; } return reject; }
        }
        Icon { x: 9px; y: 9px; size: 18px; glyph: root.action-glyph; tint: root.busy ? Theme.fg-dim : Theme.on-accent; }
        touch := TouchArea { enabled: !root.busy; mouse-cursor: pointer; clicked => { root.commit(root.identity-token, root.value); } }
        FocusRing { active: focus.has-focus; radius: 18px; button: true; }
        Tip { text: root.action-label; active: touch.has-hover || focus.has-focus; }
    }
}
