import { Theme, Glyph, IconButton, Modal } from "../primitives/primitives.slint";
import { FlowProjectsPage, FlowProjectRow } from "projects.slint";
import { AppButton, CloudField } from "../seecut/components.slint";
import { FlowWorkspace, FlowNodeView, FlowEdgeView, FlowAttachment, FlowParameter, FlowCandidate } from "workspace.slint";
import { ScrollView } from "std-widgets.slint";
export { FlowProjectRow, FlowNodeView, FlowEdgeView, FlowAttachment, FlowParameter, FlowCandidate }
export global Flow {
    in-out property <bool> images-enabled;
    in-out property <bool> execution-enabled;
    in-out property <bool> paused;
    in-out property <bool> has-attempt;
    in-out property <bool> selected-output;
    in-out property <string> points: "0";
    in-out property <[FlowAttachment]> references;
    in-out property <[FlowCandidate]> candidates;
    in-out property <[FlowParameter]> generation-parameters;
    in-out property <bool> settings-open;
    in-out property <string> setting-token;
    in-out property <string> setting-title;
    in-out property <[FlowParameter]> setting-rows;
    callback image-settings(string);
    callback setting-choice(string, string);
    callback image-assets();
    callback image-choose(string);
    in-out property <bool> open;
    in-out property <bool> browsing: true;
    in-out property <string> project-search;
    in-out property <bool> project-list-view;
    in-out property <bool> project-name-sort;
    in-out property <bool> read-only;
    in-out property <[FlowProjectRow]> projects;
    in-out property <bool> project-dialog;
    in-out property <string> dialog-token;
    in-out property <string> dialog-name;
    in-out property <string> dialog-title;
    callback project-action(string, string);
    callback name-submit(string, string);
    callback name-cancel(string);
    in-out property <string> title;
    in-out property <string> token;
    in-out property <string> draft-token;
    in-out property <string> selected-id;
    in-out property <string> selected-title;
    in-out property <string> selected-status;
    in-out property <string> selected-kind;
    in-out property <string> prompt;
    in-out property <string> generation-prompt;
    in-out property <bool> dirty;
    in-out property <bool> confirm;
    in-out property <bool> recovery;
    in-out property <bool> recovery-available;
    in-out property <bool> picker-open;
    in-out property <bool> input-focused;
    in-out property <bool> can-undo;
    in-out property <bool> can-redo;
    in-out property <bool> error;
    in-out property <string> message: "新建或打开 Flow 工程";
    in-out property <string> connecting-from;
    in-out property <float> pan-x: 60;
    in-out property <float> pan-y: 64;
    in-out property <float> zoom: 0.8;
    in-out property <[FlowNodeView]> nodes;
    in-out property <[FlowEdgeView]> edges;
    in-out property <int> focus-token;
    callback action(string);
    callback selected(string, string);
    callback draft-changed(string, string);
    callback prompt-commit(string, string);
    callback move-node(string, string, float, float, bool);
    callback viewport(string, float, float, float, bool);
    callback input-port(string, string, string);
    callback output-port(string, string);
    callback resolve(int);
    callback recover(int);
    callback leave-requested(int) -> bool;
    callback close-requested() -> bool;
}
export component FlowPage inherits Rectangle {
    in property <length> launcher-clearance: 84px;
    background: Theme.page;
    clip: true;
    if Flow.browsing: FlowProjectsPage {
        launcher-clearance: root.launcher-clearance; focus-token: Flow.focus-token;
        projects: Flow.projects; search <=> Flow.project-search; list-view <=> Flow.project-list-view; name-sort <=> Flow.project-name-sort; message: Flow.error ? Flow.message : "";
        action(action,key) => { Flow.project-action(action,key); }
        new-project => { Flow.action("new"); }
        open-existing => { Flow.action("open"); }
        refresh => { Flow.action("refresh"); }
    }
    if Flow.open && !Flow.browsing: workspace := FlowWorkspace {
        width: parent.width; height: parent.height;
        project-title: Flow.title; read-only: Flow.read-only; recovery-available: Flow.recovery-available;
        document-token: Flow.token; draft-token: Flow.draft-token;
        nodes: Flow.nodes; edges: Flow.edges;
        selected-id: Flow.selected-id; selected-title: Flow.selected-title; selected-kind: Flow.selected-kind;
        selected-status: Flow.read-only ? "只读" : Flow.dirty ? "提示词未保存" : Flow.selected-status != "" ? Flow.selected-status : "已保存";
        generation-prompt: Flow.generation-prompt;
        references: Flow.references; candidates: Flow.candidates; generation-parameters: Flow.generation-parameters;
        assets-enabled: Flow.images-enabled && Flow.selected-kind != "video_generate";
        generation-settings-enabled: Flow.images-enabled;
        execution-enabled: Flow.execution-enabled && !Flow.read-only && Flow.selected-kind == "image_generate";
        paused: Flow.paused; has-attempt: Flow.has-attempt; can-cancel: Flow.has-attempt && !Flow.paused;
        points-label: Flow.points; selected-output: Flow.selected-output;
        assets-requested(_,_) => { Flow.image-assets(); }
        shared-generation-requested(_) => { Flow.image-settings("model"); }
        parameter-requested(field) => { Flow.image-settings(field); }
        choose(id) => { Flow.image-choose(id); }
        prompt-text <=> Flow.prompt;
        changed input-focused => { Flow.input-focused = self.input-focused; }
        focus-token: Flow.focus-token;
        message: Flow.read-only && !Flow.error ? "只读 · 原文已保留" : Flow.message; error: Flow.error;
        pan-x <=> Flow.pan-x; pan-y <=> Flow.pan-y; zoom <=> Flow.zoom;
        connecting-from: Flow.connecting-from;
        can-undo: Flow.can-undo; can-redo: Flow.can-redo;
        save-label: Flow.read-only ? "只读" : Flow.dirty ? "未保存提示词" : "已保存";
        launcher-clearance: root.launcher-clearance;
        selected(id) => { Flow.selected(Flow.token, id); }
        draft-changed(token,text) => { Flow.draft-changed(token, text); }
        prompt-commit(token,text) => { Flow.prompt-commit(token, text); }
        move-node(id, x, y, commit) => { Flow.move-node(Flow.token, id, x, y, commit); }
        viewport-preview(x,y,z) => { Flow.viewport(Flow.token,x,y,z,false); }
        viewport-settled(token,x,y,z) => { Flow.viewport(token,x,y,z,true); }
        input-port(id, port) => { Flow.input-port(Flow.token,id,port); }
        output-port(id) => { Flow.output-port(Flow.token,id); }
        action(action) => { Flow.action(action); }
    }
}
export component FlowSettingsDialog inherits Modal {
    open: Flow.settings-open; title: Flow.setting-title; trap-focus: true; surface-width: 360px;
    closed => { Flow.settings-open = false; Flow.focus-token += 1; }
    ScrollView {
        width: 360px; height: min(360px, root.height - 100px);
        VerticalLayout { padding: 16px; spacing: 4px;
            if Flow.setting-rows.length == 0: Text { text: "暂无可用选项"; color: Theme.fg-muted; }
            for option in Flow.setting-rows: AppButton { label: option.label; subtle: true; clicked => { Flow.setting-choice(Flow.setting-token,option.id); } }
        }
    }
}
export component FlowDraftDialog inherits Modal {
    open: Flow.confirm;
    title: "保存提示词草稿";
    trap-focus: true;
    surface-width: 460px;
    closed => { Flow.resolve(0); }
    VerticalLayout {
        padding: 20px; spacing: 20px;
        Text { text: Flow.error ? Flow.message : "当前提示词尚未保存。请选择如何继续。"; color: Theme.fg; wrap: word-wrap; }
        if Flow.error: AppButton { label: "恢复选项"; clicked => { Flow.action("recover"); } }
        HorizontalLayout { alignment: end; spacing: 8px;
            AppButton { label: "取消"; clicked => { Flow.resolve(0); } }
            AppButton { label: "放弃并继续"; clicked => { Flow.resolve(1); } }
            AppButton { label: "保存并继续"; primary: true; clicked => { Flow.resolve(2); } }
        }
    }
}
export component FlowRecoveryDialog inherits Modal {
    open: Flow.recovery;
    title: "恢复工程内容";
    trap-focus: true;
    surface-width: 540px;
    closed => { Flow.recover(0); }
    VerticalLayout {
        padding: 20px; spacing: 16px;
        Text { text: "可先导出当前图、提示词草稿和视口的 JSON 备份，供恢复内容时参考。该文件不能作为工程直接打开。"; color: Theme.fg; wrap: word-wrap; }
        Text { text: "放弃并关闭会丢弃未保存的提示词和视口。磁盘写入结果需要在重新打开原工程后检查。"; color: Theme.fg-muted; wrap: word-wrap; }
        Text { text: Flow.message; color: Flow.error ? Theme.accent : Theme.fg-muted; wrap: word-wrap; }
        HorizontalLayout { alignment: end; spacing: 8px;
            AppButton { label: "取消"; clicked => { Flow.recover(0); } }
            AppButton { label: "导出恢复备份"; clicked => { Flow.recover(1); } }
            AppButton { label: "放弃未保存内容并关闭"; clicked => { Flow.recover(2); } }
        }
    }
}

export component FlowNameDialog inherits Modal {
    open: Flow.project-dialog; title: Flow.dialog-title;
    trap-focus: true; surface-width: 380px;
    closed => { Flow.name-cancel(Flow.dialog-token); }
    VerticalLayout {
        padding: 20px; spacing: 14px;
        CloudField { value <=> Flow.dialog-name; placeholder: "工程名称"; auto-focus: true; }
        if Flow.error: Text { text: Flow.message; color: Theme.accent; wrap: word-wrap; }
        HorizontalLayout { alignment: end; spacing: 8px;
            AppButton { label: "取消"; clicked => { Flow.name-cancel(Flow.dialog-token); } }
            AppButton { label: "保存"; primary: true; enabled: Flow.dialog-name != ""; clicked => { Flow.name-submit(Flow.dialog-token, Flow.dialog-name); } }
        }
    }
}
