import { Theme, Icon, IconButton, Glyph, FocusRing } from "../primitives/primitives.slint";
import { AppButton, CloudField } from "../seecut/components.slint";
import { FlowComposer, FlowAttachment, FlowParameter } from "composer.slint";
export { FlowAttachment, FlowParameter }
export struct FlowNodeView { id: string, title: string, kind: string, summary: string, state: string, selected: bool, x: float, y: float, preview: image, has-preview: bool, inputs: [string] }
export struct FlowEdgeView { path: string, selected: bool, related: bool }
export struct FlowCandidate { id: string, label: string, selected: bool, ready: bool, preview: image }
component CandidateButton inherits Rectangle {
    in property <FlowCandidate> candidate;
    callback chosen(string);
    width: 92px; height: 78px; border-radius: 8px; background: Theme.well;
    border-width: root.candidate.selected ? 2px : 0px; border-color: Theme.accent;
    accessible-role: button; accessible-label: root.candidate.label; accessible-enabled: root.candidate.ready;
    accessible-action-default => { if root.candidate.ready { root.chosen(root.candidate.id); } }
    Image { x: 4px; y: 4px; width: parent.width - 8px; height: 52px; source: root.candidate.preview; image-fit: contain; }
    Text { x: 4px; y: 56px; width: parent.width - 8px; height: 20px; text: root.candidate.label; font-size: Theme.fs; color: Theme.fg; horizontal-alignment: center; }
    focus := FocusScope { enabled: root.candidate.ready; key-pressed(event) => { if event.text == " " || event.text == "\n" { root.chosen(root.candidate.id); return accept; } return reject; } }
    TouchArea { enabled: root.candidate.ready; mouse-cursor: pointer; clicked => { focus.focus(); root.chosen(root.candidate.id); } }
    FocusRing { active: focus.has-focus; radius: 8px; }
}
component StartAction inherits Rectangle {
    in property <string> label;
    in property <Glyph> glyph;
    callback activated();
    height: 56px;
    border-radius: 12px;
    background: touch.has-hover || focus.has-focus ? Theme.well : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.activated(); }
    HorizontalLayout {
        padding-left: 18px; padding-right: 18px; spacing: 12px;
        Rectangle { width: 22px; Icon { y: (parent.height - self.height) / 2; glyph: root.glyph; size: 22px; tint: touch.has-hover ? Theme.accent : Theme.fg-muted; } }
        Text { text: root.label; color: Theme.fg; font-family: Theme.font; font-size: Theme.fs-xl; font-weight: Theme.weight-title; vertical-alignment: center; }
    }
    focus := FocusScope { key-pressed(event) => { if event.text == " " || event.text == "\n" { root.activated(); return accept; } return reject; } }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.activated(); } }
    FocusRing { active: focus.has-focus; radius: 12px; }
}
component PortPoint inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> enabled: true;
    callback activated();
    callback gesture(string,length,length);
    width: 28px; height: 28px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.activated(); } }
    Rectangle { x: 9px; y: 9px; width: 10px; height: 10px; border-radius: 5px; background: root.active ? Theme.accent : Theme.panel; border-width: 1px; border-color: root.active ? Theme.accent : Theme.fg-muted; }
    scope := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => { if event.text == " " || event.text == "\n" { root.activated(); return accept; } return reject; }
        FocusRing { active: scope.has-focus; radius: 6px; button: true; }
    }
    touch := TouchArea {
        enabled: root.enabled; mouse-cursor: crosshair;
        property <bool> dragged;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { self.dragged = false; }
            if event.kind == PointerEventKind.up && self.dragged { root.gesture("end",self.mouse-x,self.mouse-y); }
            if event.kind == PointerEventKind.cancel && self.dragged { root.gesture("cancel",self.mouse-x,self.mouse-y); }
        }
        moved => { if self.pressed {
            if !self.dragged && abs(self.mouse-x - self.pressed-x)+abs(self.mouse-y - self.pressed-y)>4px {
                self.dragged = true;
                root.gesture("start",self.pressed-x,self.pressed-y);
            }
            if self.dragged { root.gesture("move",self.mouse-x,self.mouse-y); }
        } }
        clicked => { if !self.dragged { scope.focus(); root.activated(); } }
    }
}
/// Host supplies view models and callbacks; it owns every graph edit and run transition.
export component FlowWorkspace inherits Rectangle {
    in property <string> prompt-source-id;
    in property <string> prompt-source-title;
    in property <image> selected-preview;
    in property <string> source-label;
    callback reference-action(string,string);
    in property <float> selected-x;
    in property <float> selected-y;
    in property <int> selection-count;
    in property <bool> edge-selected;
    in property <string> wire-path;
    in property <string> wire-target;
    callback canvas-size(float,float);
    callback select-node(string,bool);
    callback canvas-select(float,float,float,float,bool);
    callback wire-gesture(string,string,string,float,float);
    callback find-node(string);
    property <bool> panning;
    property <bool> search-open;
    changed search-open => { if !root.search-open { root.defer-canvas-focus(); } }
    property <bool> show-node-menu;
    changed selected-id => { root.show-node-menu = false; }
    in-out property <string> search-text;
    property <bool> size-sent;
    property <bool> resize-focus-pending;
    property <string> resize-document;
    property <string> resize-selection;
    function report-canvas-size() {
        if root.size-sent {
            root.resize-document = root.document-token;
            root.resize-selection = root.selected-id;
            root.resize-focus-pending = true;
            resize-settled.restart();
        }
    }
    resize-settled := Timer { interval: 60ms; running: root.resize-focus-pending; triggered => {
        root.resize-focus-pending = false;
        root.canvas-size((root.width - root.launcher-clearance)/1px, root.height/1px);
        if root.resize-document == root.document-token && root.resize-selection == root.selected-id && root.selected-id != "" && root.selection-count == 1 {
            root.action("focus");
        }
    } }
    Timer { interval: 1ms; running: !root.size-sent && root.width > 0px && root.height > 0px; triggered => {
        root.size-sent = true; root.canvas-size((root.width - root.launcher-clearance)/1px, root.height/1px);
    } }
    changed width => { root.report-canvas-size(); }
    changed height => { root.report-canvas-size(); }
    property <length> editor-x: (root.selected-x*root.zoom+root.pan-x)*1px;
    property <length> editor-y: 64px+(root.selected-y+202)*root.zoom*1px+root.pan-y*1px;

    in property <string> project-title;
    in property <bool> read-only;
    changed read-only => { if root.read-only { root.show-catalog = false; } }
    in property <bool> recovery-available;
    in property <string> document-token;
    in property <string> draft-token;
    // Reused prompt inputs must leave the previous draft before accepting edits.
    // Focus changes must not reenter AccessKit while it instantiates a changed node tree.
    property <bool> focus-pending;
    property <string> focus-document;
    property <string> focus-draft;
    function defer-canvas-focus() { root.focus-document = root.document-token; root.focus-draft = root.draft-token; root.focus-pending = true; }
    Timer { interval: 1ms; running: root.focus-pending; triggered => {
        root.focus-pending = false;
        if !root.search-open && root.focus-document == root.document-token && root.focus-draft == root.draft-token { canvas-focus.focus(); }
    } }
    changed draft-token => { root.defer-canvas-focus(); }
    changed document-token => {
        root.view-dirty = false; root.view-document-token = root.document-token;
        root.resize-focus-pending = false; root.size-sent = false;
    }
    in property <int> focus-token;
    in property <bool> can-undo;
    in property <bool> can-redo;
    property <bool> composer-input-focused;
    out property <bool> input-focused: root.composer-input-focused || root.search-open;
    changed selected-kind => { root.composer-input-focused = false; }
    changed focus-token => { if root.selected-kind != "prompt" { root.defer-canvas-focus(); } }
    in property <bool> execution-enabled: false;
    in property <bool> paused;
    in property <bool> selected-output;
    in property <bool> assets-enabled: false;
    in property <bool> generation-settings-enabled: false;
    in property <[FlowNodeView]> nodes;
    in property <[FlowEdgeView]> edges;
    in property <[FlowCandidate]> candidates;
    in property <[FlowAttachment]> references;
    in property <[FlowParameter]> generation-parameters;
    in property <string> generation-prompt;
    callback reference-selected(string);
    in property <string> selected-id;
    in property <string> selected-title;
    in property <string> selected-kind;
    in property <string> selected-status;
    in property <bool> has-attempt;
    in property <bool> can-cancel;
    in property <bool> can-retry;
    in-out property <string> prompt-text;
    in property <string> message: "生成、资产导入及交付尚未接通";
    in property <bool> error;
    in-out property <float> zoom: 0.75;
    in-out property <float> pan-x: 60;
    in-out property <float> pan-y: 84;
    in property <string> connecting-from;
    in property <string> points-label;
    in property <string> save-label: "已保存";
    callback draft-changed(string, string);
    // Host supplies the fixed launcher exclusion size when integrating into App.
    in property <length> launcher-clearance: 104px;
    callback selected(string);
    callback move-node(string, float, float, bool);
    callback viewport-settled(string, float, float, float);
    callback viewport-preview(float, float, float);
    property <bool> view-dirty;
    property <string> view-document-token;
    property <bool> show-catalog;
    property <bool> catalog-at-pointer;
    property <length> catalog-x;
    property <length> catalog-y;
    function open-catalog-at(x: length, y: length) {
        if !root.read-only {
            root.catalog-at-pointer = true;
            root.catalog-x = x; root.catalog-y = y;
            root.show-node-menu = false; root.show-catalog = true;
        }
    }
    property <bool> selection-pending;
    property <string> pending-selection;
    Timer { interval: 1ms; running: root.selection-pending; triggered => {
        root.selection-pending = false; canvas-focus.focus(); root.selected(root.pending-selection);
    } }
    changed pan-x => { if !root.view-dirty { root.view-document-token = root.document-token; } root.viewport-preview(root.pan-x, root.pan-y, root.zoom); root.view-dirty = true; }
    changed pan-y => { if !root.view-dirty { root.view-document-token = root.document-token; } root.viewport-preview(root.pan-x, root.pan-y, root.zoom); root.view-dirty = true; }
    changed zoom => { if !root.view-dirty { root.view-document-token = root.document-token; } root.viewport-preview(root.pan-x, root.pan-y, root.zoom); root.view-dirty = true; }
    Timer { interval: 250ms; running: root.view-dirty && !floor.pressed; triggered => { root.save-viewport(); } }
    callback input-port(string, string);
    callback output-port(string);
    callback action(string);
    callback prompt-commit(string, string);
    callback choose(string);
    callback assets-requested(string, bool);
    callback shared-generation-requested(string);
    callback parameter-requested(string);
    background: Theme.page;
    clip: true;
    function save-viewport() { root.view-dirty = false; root.viewport-settled(root.view-document-token, root.pan-x, root.pan-y, root.zoom); }
    // An unbounded world is mapped into this clipped viewport; no bitmap editor state is reused.
    canvas-focus := FocusScope {
        key-pressed(event) => {
            if event.text == " " {root.panning=true;return accept;}
            if event.text == Key.Delete || event.text == Key.Backspace {root.action("remove");return accept;}
            if (event.modifiers.meta || event.modifiers.control) && event.text.to-lowercase() == "a" {root.action("select-all");return accept;}
            if (event.modifiers.meta || event.modifiers.control) && event.text.to-lowercase() == "d" {root.action("duplicate");return accept;}
            if event.text == Key.Escape {root.panning=false;root.show-node-menu=false;root.show-catalog=false;root.search-open=false;root.action("cancel-connect");return accept;}
            return reject;
        }
        key-released(event) => {if event.text==" " {root.panning=false;return accept;}return reject;}
    }
    stage := Rectangle {
        y: 64px; width: parent.width; height: parent.height - 64px;
        clip: true;
        property <length> dot-gap: max(16, min(80, round(16 / root.zoom))) * root.zoom * 1px;
        property <length> dot-size: max(1, root.zoom) * 1px;
        for row in ceil(stage.height / stage.dot-gap) + 1: Rectangle {
          for column in ceil(stage.width / stage.dot-gap) + 1: Rectangle {
            x: mod(mod(root.pan-x * 1px, stage.dot-gap) + stage.dot-gap, stage.dot-gap) + column * stage.dot-gap;
            y: mod(mod(root.pan-y * 1px, stage.dot-gap) + stage.dot-gap, stage.dot-gap) + row * stage.dot-gap;
            width: stage.dot-size; height: stage.dot-size; border-radius: stage.dot-size / 2;
            background: Theme.line-strong; opacity: Theme.dark ? 0.85 : 0.8;
          }
        }
        floor := TouchArea {
            property <float> start-x; property <float> start-y;
            property <bool> pan; property <bool> add;
            mouse-cursor: root.panning ? move : default;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {canvas-focus.focus();self.start-x=root.pan-x;self.start-y=root.pan-y;self.pan=root.panning || event.button==PointerEventButton.middle;self.add=event.modifiers.shift;}
                if event.kind == PointerEventKind.up {if self.pan {root.save-viewport();}else{root.canvas-select(self.pressed-x/1px,self.pressed-y/1px,self.mouse-x/1px,self.mouse-y/1px,self.add);}}
                if event.kind == PointerEventKind.cancel && self.pan {root.pan-x=self.start-x;root.pan-y=self.start-y;}
            }
            moved => {if self.pressed && self.pan {root.pan-x=self.start-x+(self.mouse-x - self.pressed-x)/1px;root.pan-y=self.start-y+(self.mouse-y - self.pressed-y)/1px;}}
            double-clicked => { root.open-catalog-at(self.mouse-x, self.mouse-y + 64px); }
            scroll-event(event) => {
                if event.modifiers.control || event.modifiers.meta {
                    let next=max(0.25,min(2,root.zoom+event.delta-y/1000px));
                    root.pan-x=self.mouse-x/1px-(self.mouse-x/1px - root.pan-x)*next/root.zoom;
                    root.pan-y=self.mouse-y/1px-(self.mouse-y/1px - root.pan-y)*next/root.zoom;root.zoom=next;
                }else{root.pan-x+=event.delta-x/1px;root.pan-y+=event.delta-y/1px;}return accept;
            }
        }
        if floor.pressed && !floor.pan: Rectangle {
            x:min(floor.pressed-x,floor.mouse-x);y:min(floor.pressed-y,floor.mouse-y);width:abs(floor.mouse-x - floor.pressed-x);height:abs(floor.mouse-y - floor.pressed-y);
            border-width:1px;border-color:Theme.accent;background:Theme.accent-soft;opacity:0.65;
        }
        if root.wire-path != "": Path {width:parent.width;height:parent.height;viewbox-width:parent.width/1px;viewbox-height:parent.height/1px;commands:root.wire-path;stroke:Theme.accent;stroke-width:2px;}
        for edge in root.edges: Path { x: 0px; y: 0px; width: parent.width; height: parent.height; viewbox-width: parent.width / 1px; viewbox-height: parent.height / 1px; commands: edge.path; stroke: edge.selected || edge.related ? Theme.accent : Theme.line-strong; stroke-width: edge.selected ? 2.5px : edge.related ? 1.6px : 1px; }
        if root.nodes.length == 0 && !root.read-only: empty-guide := Rectangle {
            width: min(600px, parent.width - 64px); height: 120px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            hint := Rectangle {
                x: (parent.width - self.width) / 2; width: 230px; height: 40px;
                HorizontalLayout { alignment: center; spacing: 10px;
                    Rectangle { width: 20px; Icon { y: (parent.height - self.height) / 2; glyph: Glyph.pointer; size: 20px; tint: Theme.fg-muted; } }
                    Text { text: "双击画布，添加节点"; font-family: Theme.font; font-size: Theme.fs-xl; color: Theme.fg-muted; vertical-alignment: center; }
                }
                TouchArea { double-clicked => { root.open-catalog-at(empty-guide.x + hint.x + self.mouse-x, 64px + empty-guide.y + self.mouse-y); } }
            }
            HorizontalLayout { y: 64px; height: 56px; spacing: 12px;
                StartAction { label: "图片生成"; glyph: Glyph.image; activated => { root.action("add_image_generate"); } }
                StartAction { label: "提示词"; glyph: Glyph.text-mark; activated => { root.action("add_prompt"); } }
                StartAction { label: "导入素材"; glyph: Glyph.folder; activated => { root.action("add_asset"); } }
            }
        }
        for node in root.nodes: card := Rectangle {
            x: (node.x * root.zoom + root.pan-x) * 1px;
            y: (node.y * root.zoom + root.pan-y) * 1px;
            width: 228px * root.zoom; height: 190px * root.zoom;
            accessible-role: button;
            accessible-label: "选择节点 · " + node.title;
            accessible-action-default => { root.pending-selection = node.id; root.selection-pending = true; }
            Text { y: 0px; width: parent.width; height: 26px * root.zoom; text: node.title; font-family: Theme.font; font-size: max(11px, Theme.fs-lg * root.zoom); color: node.selected ? Theme.fg : Theme.fg-muted; overflow: elide; }
            Rectangle {
                y: 28px * root.zoom; width: parent.width; height: 154px * root.zoom;
                border-radius: 8px; background: Theme.well;
                border-width: node.selected ? 1.5px : 1px;
                border-color: node.selected ? Theme.accent : Theme.line;
                clip: true;
                if node.has-preview: Image { x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px; source: node.preview; image-fit: contain; }
                if !node.has-preview: Text {
                    x: 12px; y: 12px; width: parent.width - 24px; height: parent.height - 24px;
                    text: node.summary; font-family: Theme.font; font-size: max(11px, Theme.fs * root.zoom);
                    color: Theme.fg-muted; wrap: word-wrap; overflow: elide;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                if node.has-preview && node.state != "": Rectangle {
                    x: 8px; y: parent.height - 26px; width: parent.width - 16px; height: 20px; border-radius: 4px; background: Theme.panel;
                    Text { text: node.state; font-family: Theme.font; font-size: 10px; color: Theme.fg-muted; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            drag := TouchArea {
                property <float> start-x;
                property <float> start-y;
                property <length> pointer-x;
                property <length> pointer-y;
                property <bool> dragged;
                mouse-cursor: root.read-only ? pointer : move;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        self.dragged = false; canvas-focus.focus(); root.select-node(node.id,event.modifiers.shift); self.start-x = node.x; self.start-y = node.y;
                        self.pointer-x = self.absolute-position.x + self.mouse-x;
                        self.pointer-y = self.absolute-position.y + self.mouse-y;
                    }
                    if !root.read-only && event.kind == PointerEventKind.up { if self.dragged { root.move-node(node.id, node.x, node.y, true); } else { root.action("focus"); } }
                    if !root.read-only && self.dragged && event.kind == PointerEventKind.cancel { root.move-node(node.id, self.start-x, self.start-y, false); }
                }
                moved => { if !root.read-only && self.pressed && (self.dragged || abs(self.absolute-position.x+self.mouse-x - self.pointer-x)+abs(self.absolute-position.y+self.mouse-y - self.pointer-y)>4px) { self.dragged=true; root.move-node(node.id, self.start-x + (self.absolute-position.x + self.mouse-x - self.pointer-x) / (root.zoom * 1px), self.start-y + (self.absolute-position.y + self.mouse-y - self.pointer-y) / (root.zoom * 1px), false); } }
            }
            for port[index] in node.inputs: PortPoint {
                x: -14px; y: (82 + index * 36) * root.zoom * 1px - 14px;
                label: node.title + " · 输入 " + port;
                enabled: !root.read-only; active: root.wire-target == node.id + ":" + port;
                activated => { canvas-focus.focus(); root.input-port(node.id, port); }
                gesture(phase,x,y) => {if phase == "start" {canvas-focus.focus();} root.wire-gesture(node.id,port,phase,(card.x+self.x+x)/1px,(card.y+self.y+y)/1px);}
            }
            PortPoint { enabled: !root.read-only; x: parent.width - 14px; y: 100px * root.zoom - 14px; label: node.title + " · 输出"; active: root.connecting-from == node.id;
                activated => { canvas-focus.focus(); root.output-port(node.id); }
                gesture(phase,x,y) => {if phase == "start" {canvas-focus.focus();} root.wire-gesture(node.id,"",phase,(card.x+self.x+x)/1px,(card.y+self.y+y)/1px);} }
        }
    }
    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: 64px; background: Theme.page;
        Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
        Flickable { x: 0px; y: 12px; height: 40px; width: parent.width; viewport-height: 40px; viewport-width: max(self.width, toolbar.preferred-width);
        toolbar := HorizontalLayout {
            height: 40px; padding-left: 24px; padding-right: 24px; spacing: 12px;
            IconButton { glyph: Glyph.chevron-left; label: "返回 Flow 项目"; side: 36px; clicked => { root.action("projects"); } }
            IconButton { glyph: Glyph.search; label: "查找节点"; side:36px; clicked => {root.search-open=!root.search-open;} }
            Text { max-width: 180px; overflow: elide; text: root.project-title; color: Theme.fg; font-family: Theme.font; font-size: Theme.fs-xl; font-weight: 500; vertical-alignment: center; }
            Text { text: root.save-label; color: Theme.fg-dim; font-family: Theme.font; font-size: Theme.fs; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            IconButton { glyph: Glyph.save; label: "保存 Flow 工程"; enabled: !root.read-only; side: 36px; clicked => { root.action("save"); } }
            IconButton { glyph: Glyph.text-mark; label: "重命名工程"; enabled: !root.read-only; side: 36px; clicked => { root.action("rename"); } }
            if root.recovery-available: IconButton { glyph: Glyph.reset; label: "恢复选项"; side: 36px; clicked => { root.action("recover"); } }
            IconButton { enabled: !root.read-only; glyph: Glyph.plus; label: "新建节点"; side: 36px; icon-size: 18px; clicked => { root.catalog-at-pointer = false; root.show-catalog = !root.show-catalog; root.show-node-menu = false; } }
            IconButton { enabled: !root.read-only; glyph: Glyph.distribute; label: "整理节点"; side: 36px; icon-size: 18px; clicked => { root.action("arrange"); } }
            IconButton { glyph: Glyph.undo; label: "撤销"; enabled: !root.read-only && root.can-undo; side: 36px; icon-size: 18px; clicked => { root.action("undo"); } }
            IconButton { glyph: Glyph.redo; label: "重做"; enabled: !root.read-only && root.can-redo; side: 36px; icon-size: 18px; clicked => { root.action("redo"); } }
            IconButton { glyph: Glyph.copy; label: "节点操作 · 复制与重命名"; enabled: !root.read-only && root.selected-id != ""; side: 36px; clicked => { root.show-node-menu = !root.show-node-menu; root.show-catalog = false; } }
            IconButton { glyph: Glyph.close; label: "删除选中节点"; enabled: !root.read-only && (root.selected-id != "" || root.edge-selected); side: 36px; clicked => { root.action("remove"); } }
            IconButton { glyph: Theme.dark ? Glyph.sun : Glyph.moon; label: Theme.dark ? "切换浅色主题" : "切换深色主题"; side: 36px; icon-size: 18px; clicked => { Theme.dark = !Theme.dark; } }
        }
    }
    }
    if root.search-open: Rectangle {x:24px;y:70px;width:300px;height:48px;background:Theme.panel;border-radius:8px;
        HorizontalLayout {padding:6px;spacing:4px;CloudField {value<=>root.search-text;edited(value)=>{root.search-text=value;}placeholder:"名称、类型、正文或 ID"; auto-focus: true; key-event(text) => {if text == "\n" {root.find-node(root.search-text); return true;} if text == Key.Escape {root.search-open=false; return true;} return false;}}IconButton {glyph:Glyph.search;label:"定位下一个匹配节点";side:36px;clicked=>{root.find-node(root.search-text);}}}
    }
    if root.show-node-menu: Rectangle {
        x: max(16px, parent.width - 252px); y: 70px; width: 228px; height: 148px; background: Theme.panel; border-radius: 12px;
        VerticalLayout { padding: 8px; spacing: 4px;
            AppButton { label: "复制节点"; subtle: true; clicked => {root.show-node-menu=false;root.action("copy-node");} }
            AppButton { label: "复制节点及输入连线"; subtle: true; clicked => {root.show-node-menu=false;root.action("duplicate");} }
            AppButton { label: "重命名节点"; subtle: true; enabled: root.selection-count == 1; clicked => {root.show-node-menu=false;root.action("rename-node");} }
        }
    }
    if root.show-catalog: Rectangle {
        x: root.catalog-at-pointer ? max(16px, min(root.catalog-x, parent.width - 216px)) : max(16px, parent.width - 420px);
        y: root.catalog-at-pointer ? max(70px, min(root.catalog-y, parent.height - 192px)) : 70px; width: 200px; height: 176px;
        border-radius: 12px; background: Theme.panel; border-width: 1px; border-color: Theme.line-strong;
        VerticalLayout { padding: 10px; spacing: 4px;
            for label[index] in ["提示词", "参考素材", "图像生成", "采用图片"]: AppButton {
                height: 36px; label: label; enabled: !root.read-only; subtle: true;
                clicked => { root.show-catalog = false; root.action("add_" + ["prompt", "asset", "image_generate", "select"][index]); }
            }
        }
    }
    Rectangle {
        x: 20px; y: parent.height - 52px; width: 180px; height: 36px; border-radius: 10px; background: Theme.panel; border-width: 1px; border-color: Theme.line;
        HorizontalLayout { padding: 3px; spacing: 4px;
            IconButton { glyph: Glyph.minus; side: 30px; label: "缩小画布"; clicked => { root.zoom = max(0.25, root.zoom - 0.1); root.save-viewport(); } }
            Text { text: round(root.zoom * 100) + "%"; color: Theme.fg-muted; horizontal-alignment: center; vertical-alignment: center; font-size: Theme.fs; }
            IconButton { glyph: Glyph.plus; side: 30px; label: "放大画布"; clicked => { root.zoom = min(2, root.zoom + 0.1); root.save-viewport(); } }
            IconButton { glyph: Glyph.fit; side: 30px; label: "适合画布"; clicked => { root.action("fit"); } }
        }
    }
    if root.selection-count == 1 && root.selected-id != "" && root.selected-kind != "prompt" && root.selected-kind != "image_generate" && root.selected-kind != "video_generate": Rectangle {
        x: root.editor-x;
        y: root.editor-y;
        width: min(480px, max(0px, parent.width - 32px - root.launcher-clearance));
        height: min(root.selected-kind == "asset" ? 270px : root.candidates.length > 0 ? 216px : 176px, max(0px, parent.height - 144px));
        clip: true;
        border-radius: 16px; background: Theme.panel; border-width: 1px; border-color: Theme.line-strong;
        VerticalLayout {
            padding: 18px; spacing: 12px;
            HorizontalLayout {
                height: 40px;
                Text { min-width: 0px; horizontal-stretch: 1; overflow: elide; text: root.selected-title; color: Theme.fg; font-family: Theme.font; font-size: Theme.fs-xl; font-weight: 500; vertical-alignment: center; }
                Text { min-width: 0px; max-width: 90px; overflow: elide; text: root.selected-status; color: Theme.fg-muted; font-family: Theme.font; font-size: Theme.fs; horizontal-alignment: right; vertical-alignment: center; }
                IconButton { glyph: Glyph.close; side: 28px; label: "收起编辑区"; clicked => { root.selected(""); } }
            }
            if root.error: Text { text: root.message; color: root.error ? Theme.accent : Theme.fg-muted; wrap: word-wrap; font-family: Theme.font; font-size: Theme.fs-lg; }
            if root.selected-kind == "asset": Image {height:120px;source:root.selected-preview;image-fit:contain;}
            if root.selected-kind == "asset": Text {text:root.source-label;color:Theme.fg-muted;font-size:Theme.fs;overflow:elide;}
            if root.candidates.length > 0: HorizontalLayout {
                spacing: 8px; alignment: start;
                for candidate in root.candidates: CandidateButton { candidate: candidate; chosen(id) => { root.choose(id); } }
            }
            HorizontalLayout {
                spacing: 8px; alignment: start;
                if root.selected-kind == "asset": IconButton { glyph: Glyph.folder; label: "从资产库选择"; enabled: root.assets-enabled; side: 36px; icon-size: 18px; clicked => { root.assets-requested(root.selected-id, false); } }
                if root.selected-kind == "image_generate" || root.selected-kind == "video_generate": IconButton { glyph: Glyph.sliders; label: "SeeCut 生成设置 · 尚未接通"; enabled: root.generation-settings-enabled; side: 36px; icon-size: 18px; clicked => { root.shared-generation-requested(root.selected-id); } }
                if root.selected-output: IconButton { glyph: Glyph.brush; label: "放入画布"; side: 32px; clicked => { root.action("flow-canvas"); } }
                if root.selected-output: IconButton { glyph: Glyph.film; label: "放入剪辑"; side: 32px; clicked => { root.action("flow-clip"); } }
                if root.can-cancel: IconButton { glyph: Glyph.pause; label: "暂停后续步骤"; side: 32px; clicked => { root.action("cancel"); } }
                if root.has-attempt: IconButton { glyph: Glyph.search; label: "核实结果"; side: 32px; clicked => { root.action("reconcile"); } }
                if root.can-retry: IconButton { glyph: Glyph.reset; label: "重试"; side: 32px; clicked => { root.action("retry"); } }
                IconButton { enabled: !root.read-only; glyph: Glyph.copy; side: 32px; label: "复制节点及输入连线"; clicked => { root.action("duplicate"); } }
                Rectangle { horizontal-stretch: 1; }
                if root.selected-kind != "asset": IconButton { glyph: Glyph.play; label: "运行此节点 · 尚未接通"; enabled: root.execution-enabled; side: 36px; clicked => { root.action("run_node"); } }
                if root.selected-kind != "asset": IconButton { glyph: Glyph.skip-forward; label: "运行到这里 · 尚未接通"; enabled: root.execution-enabled; accent: true; side: 36px; clicked => { root.action("run_to"); } }
            }
        }
    }
    if root.selection-count == 1 && root.selected-id != "" && (root.selected-kind == "image_generate" || root.selected-kind == "video_generate"): generation-panel := Rectangle {
        property <length> actions-height: root.has-attempt || root.paused || root.can-retry || root.selected-output ? 40px : 0px;
        x: root.editor-x;
        y: root.editor-y;
        width: min(480px, max(0px, parent.width - 32px - root.launcher-clearance)); height: min(generation-composer.preferred-height + self.actions-height + (root.error ? 24px : 0px) + (root.candidates.length > 0 ? 100px : 0px), max(0px, parent.height - 144px));
        clip: true;
        background: Theme.field; border-radius: 18px; border-width: 1px;
        border-color: generation-composer.input-focused ? Theme.line-strong : Theme.line;
        if generation-panel.actions-height > 0px: HorizontalLayout {
            x: 16px; y: 8px; width: parent.width - 28px; height: 28px; spacing: 8px; alignment: end;
            if root.has-attempt && !root.paused: IconButton { glyph: Glyph.pause; label: "暂停后续步骤"; side: 28px; clicked => { root.action("cancel"); } }
            if root.paused: IconButton { glyph: Glyph.play; label: "恢复后续步骤"; side: 28px; clicked => { root.action("resume"); } }
            if root.has-attempt: IconButton { glyph: Glyph.search; label: "核实结果"; side: 28px; clicked => { root.action("reconcile"); } }
            if root.can-retry: IconButton { glyph: Glyph.reset; label: "重试"; side: 28px; clicked => { root.action("retry"); } }
            if root.selected-output: IconButton { glyph: Glyph.brush; label: "放入画布"; side: 28px; clicked => { root.action("flow-canvas"); } }
            if root.selected-output: IconButton { glyph: Glyph.film; label: "放入剪辑"; side: 28px; clicked => { root.action("flow-clip"); } }
        }
        if root.candidates.length > 0: Flickable {
            x: 16px; y: parent.actions-height + 8px; height: 84px; width: parent.width - 32px; viewport-height: 84px; viewport-width: max(self.width, root.candidates.length * 100px);
            HorizontalLayout { x: 0px; y: 0px; height: 80px; alignment: start; spacing: 8px;
                for candidate in root.candidates: CandidateButton { candidate: candidate; chosen(id) => { root.choose(id); } }
            }
        }
        generation-composer := FlowComposer {
            background: transparent; border-width: 0px;
            x: 0px; y: parent.actions-height + (root.candidates.length > 0 ? 100px : 0px); width: parent.width; height: max(0px, parent.height - self.y - (root.error ? 24px : 0px));
            identity-token: root.draft-token;
            value <=> root.prompt-text; read-only: root.read-only; label: "生成节点提示词";
            placeholder: root.generation-prompt != "" ? "补充此节点的要求…" : "写下要生成的内容…";
            changed input-focused => {root.composer-input-focused=self.input-focused;}
            edited(token,value) => {root.draft-changed(token,value);}
            attachments: root.references; allow-assets: root.assets-enabled; allow-upload: false; busy: !root.execution-enabled || root.paused; parameters: root.generation-parameters;
            source-id: root.prompt-source-id; source-title: root.prompt-source-title;
            points-label: root.points-label;
            action-label: "运行图片节点"; action-glyph: Glyph.play;
            commit(token,value) => {root.prompt-commit(token,value);root.action("run_node");}
            parameter-requested(field) => { root.parameter-requested(field); }
            attachment-requested(id) => { root.reference-action(id,"open"); }
            attachment-action(id,action) => {root.reference-action(id,action);}
            library-requested => { root.assets-requested(root.selected-id, false); }
            upload-requested => { root.assets-requested(root.selected-id, true); }
        }
        if root.error: Text { x: 12px; y: parent.height - 18px; width: parent.width - 24px; height: 18px; text: root.message; color: root.error ? Theme.accent : Theme.fg-dim; font-size: Theme.fs; overflow: elide; }
    }
    if root.selection-count == 1 && root.selected-id != "" && root.selected-kind == "prompt": Rectangle {
        x: root.editor-x;
        y: root.editor-y;
        width: min(480px, max(0px, parent.width - 32px - root.launcher-clearance)); height: min(prompt-composer.preferred-height, max(0px, parent.height - 144px));
        clip: true;
        background: Theme.field; border-radius: 18px; border-width: 1px;
        border-color: prompt-composer.input-focused ? Theme.line-strong : Theme.line;
        prompt-composer := FlowComposer {
            background: transparent; border-width: 0px;
            property <int> restore-token: root.focus-token;
            property <bool> restore-pending;
            property <string> restore-draft;
            changed restore-token => { self.restore-draft = root.draft-token; self.restore-pending = true; }
            Timer { interval: 1ms; running: prompt-composer.restore-pending; triggered => {
                prompt-composer.restore-pending = false;
                if !root.search-open && prompt-composer.restore-draft == root.draft-token { prompt-composer.focus-editor(); }
            } }
            changed input-focused => { root.composer-input-focused = self.input-focused; }
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            show-action: false;
            read-only: root.read-only; busy: root.read-only;
            identity-token: root.draft-token;
            value <=> root.prompt-text; dirty: !root.read-only && root.save-label != "已保存"; caption: root.read-only ? "只读" : "";
            edited(token,value) => { root.draft-changed(token,value); }
            commit(token,value) => { root.prompt-commit(token,value); }
        }
    }
    if root.selected-id == "" || root.error: Text { x: 16px; y: parent.height - 82px; width: max(0px, parent.width - 32px - root.launcher-clearance); height: 24px; text: root.message; color: Theme.fg-muted; font-size: Theme.fs; vertical-alignment: center; overflow: elide; }
}
