import { I18n } from "i18n.slint";
import { Theme } from "theme/theme.slint";
import { Glyph, Icon } from "icons.slint";
import { ScrollView } from "std-widgets.slint";
import { Modal } from "primitives/modal.slint";
import { AppButton, CloudField, WorkspaceSelect, WorkspaceIcon } from "seecut/components.slint";
import { SeeCut } from "seecut/state.slint";

// Clip project gallery and creation sheet.

/// One row of the Recent column.
///
/// The two lines under the name arrive formatted. A decimal frame rate to two
/// places and a coarse "4 days ago" are both easier to produce where the
/// numbers are than in an expression language with no printf and no clock.
export struct RecentProjectData {
    /// The folder, and the row's identity — what reopening and forgetting name.
    path: string,
    name: string,
    /// "00:32" for a clip project's timeline duration.
    detail: string,
    /// "今天 14:32" or an exact calendar date and time.
    when: string,
    /// A frame from the earliest clip on its timeline, once something has
    /// produced one. Empty falls back to a quiet film mark rather than an
    /// error: the launch screen is not the place to complain about footage.
    poster: image,
}

/// The form, as one struct — the same shape the two dialogs use, and for the
/// same reason: it is one screen's worth of state and a partial update is how
/// a panel ends up showing half of two things.
export struct StartData {
    name: string,
    location: string,
    /// Index into `resolutions`; the numbers behind it are Rust's.
    resolution: int,
    /// Index into `rates`.
    rate: int,
    /// "1920 x 1080"
    size-readout: string,
    /// "30/1 fps" — the exact fraction, because 29.97 is 30000/1001 and never
    /// anything else.
    rate-readout: string,
    /// Creating. The button says so and everything is refused meanwhile.
    busy: bool,
    /// Non-empty puts up the notice above the button.
    error: string,
}

export component StartScreen inherits Rectangle {
    in property <StartData> data;
    in property <[string]> resolutions;
    in property <[string]> rates;
    in property <[RecentProjectData]> recents;
    callback name-edited(name: string);
    callback location-edited(path: string);
    callback browse();
    callback resolution-changed(index: int);
    callback rate-changed(index: int);
    callback create();
    callback create-cancelled();
    callback open-recent(path: string);
    callback forget-recent(path: string);
    callback dismiss-error();

    in-out property <bool> create-open;
    property <bool> list-view: SeeCut.clip-project-view == 1;
    background: Theme.page;
    VerticalLayout {
        padding-left: 32px; padding-right: 48px; padding-top: 40px; padding-bottom: 24px; spacing: 32px;
        HorizontalLayout {
            height: 40px;
            Text { text: "剪辑"; font-size: 24px; font-weight: Theme.weight-title; color: Theme.fg; vertical-alignment: center; horizontal-stretch: 1; }
            CloudField {
                width: 248px;
                value <=> SeeCut.clip-project-search;
                placeholder: "搜索项目";
                edited(value) => { SeeCut.action("clip-project-search", value); }
            }
            WorkspaceIcon {
                glyph: Glyph.filter;
                label: SeeCut.clip-project-sort == 0 ? "按最近更新排序" : "按名称排序";
                checked: SeeCut.clip-project-sort == 1;
                clicked => {
                    SeeCut.clip-project-sort = Math.mod(SeeCut.clip-project-sort + 1, 2);
                    SeeCut.action("clip-project-sort", "");
                }
            }
            WorkspaceIcon {
                glyph: Glyph.rows;
                label: SeeCut.clip-project-view == 1 ? "网格视图" : "列表视图";
                checked: root.list-view;
                clicked => {
                    SeeCut.clip-project-view = root.list-view ? 0 : 1;
                    SeeCut.action("clip-project-view", "");
                }
            }
        }
        if root.data.error != "": Rectangle {
            height: 44px; background: Theme.danger-soft; border-radius: Theme.r;
            HorizontalLayout {
                padding-left: 12px; padding-right: 8px;
                Text { text: root.data.error; color: Theme.danger; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                WorkspaceIcon { glyph: Glyph.close; label: "关闭提示"; clicked => { root.dismiss-error(); } }
            }
        }
        ScrollView {
            viewport-width: self.visible-width; viewport-height: grid.height;
            horizontal-scrollbar-policy: always-off;
            vertical-stretch: 1; horizontal-stretch: 1;
            grid := Rectangle {
                x: 0px; y: 0px; width: parent.width;
                property <int> columns: root.list-view ? 1 : Math.max(1, Math.floor((self.width + 24px) / 310px));
                property <length> gap: root.list-view ? 16px : 24px;
                property <length> card-width: root.list-view ? self.width : (self.width - (self.columns - 1) * self.gap) / self.columns;
                property <length> media-height: root.list-view ? 96px : self.card-width * 0.60;
                property <length> card-height: root.list-view ? 96px : self.media-height + 64px;
                height: Math.ceil((root.recents.length + 1) / self.columns) * (self.card-height + self.gap) - self.gap;
                Rectangle {
                    x: 0px; y: 0px;
                    width: grid.card-width; height: grid.card-height;
                    Rectangle {
                        x: 0px; y: 0px;
                        width: root.list-view ? 160px : parent.width; height: grid.media-height;
                        background: Theme.panel; border-radius: Theme.r-lg;
                        border-width: 1px; border-color: Theme.line-strong;
                        Icon { x: (parent.width - 24px) / 2; y: (parent.height - 24px) / 2; glyph: Glyph.plus; size: 24px; tint: Theme.fg-muted; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.create-open = true; } }
                    }
                    Text { x: root.list-view ? 176px : 0px; y: root.list-view ? 18px : grid.media-height + 10px; text: "新建项目"; font-size: 14px; color: Theme.fg; }
                }
                for project[i] in root.recents: Rectangle {
                    x: Math.mod(i + 1, grid.columns) * (grid.card-width + grid.gap);
                    y: Math.floor((i + 1) / grid.columns) * (grid.card-height + grid.gap);
                    width: grid.card-width; height: grid.card-height;
                    Rectangle {
                        x: 0px; y: 0px;
                        width: root.list-view ? 160px : parent.width; height: grid.media-height;
                        background: Theme.well; border-radius: Theme.r-lg; clip: true;
                        if project.poster.width > 0: Image { width: 100%; height: 100%; source: project.poster; image-fit: cover; }
                        if project.poster.width == 0: Icon { x: (parent.width - 24px) / 2; y: (parent.height - 24px) / 2; glyph: Glyph.film; size: 24px; tint: Theme.fg-dim; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.open-recent(project.path); } }
                    }
                    Text { x: root.list-view ? 176px : 0px; y: root.list-view ? 18px : grid.media-height + 8px; width: root.list-view ? parent.width - 176px : parent.width; text: project.name; color: Theme.fg; font-size: 14px; overflow: elide; }
                    Text { x: root.list-view ? 176px : 0px; y: root.list-view ? 44px : grid.media-height + 32px; width: root.list-view ? parent.width - 176px : parent.width; text: project.when + " · " + project.detail; color: Theme.fg-muted; font-size: 12px; overflow: elide; }
                }
            }
        }
    }
    Modal {
        open: root.create-open;
        title: "新建剪辑项目";
        glyph: Glyph.plus;
        surface-width: Math.min(500px, root.width - 32px);
        closed => { root.create-open = false; root.create-cancelled(); }
        VerticalLayout {
            padding: 24px; spacing: 12px;
            Text { text: "项目名称"; color: Theme.fg-muted; }
            CloudField { value: root.data.name; placeholder: "新建项目"; edited(value) => { root.name-edited(value); } }
            Text { text: "保存位置"; color: Theme.fg-muted; }
            HorizontalLayout {
                spacing: 8px;
                CloudField { value: root.data.location; horizontal-stretch: 1; edited(value) => { root.location-edited(value); } }
                WorkspaceIcon { glyph: Glyph.folder; label: "选择位置"; clicked => { root.browse(); } }
            }
            Text { text: "画面尺寸"; color: Theme.fg-muted; }
            WorkspaceSelect { options: root.resolutions; current: root.data.resolution; changed(index) => { root.resolution-changed(index); } }
            Text { text: "帧率"; color: Theme.fg-muted; }
            WorkspaceSelect { options: root.rates; current: root.data.rate; changed(index) => { root.rate-changed(index); } }
            HorizontalLayout {
                alignment: end; spacing: 8px;
                AppButton { label: "取消"; clicked => { root.create-open = false; root.create-cancelled(); } }
                AppButton { label: "创建"; primary: true; enabled: !root.data.busy && root.data.location != ""; clicked => { root.create(); } }
            }
        }
    }
}
