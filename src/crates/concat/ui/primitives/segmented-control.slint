import { Theme } from "../theme/theme.slint";
import { FocusRing } from "focus-ring.slint";

// Single-select tab row with a thumb that slides to the active segment.
//
// The segments share the width equally, so the thumb's geometry is computed
// from the count rather than measured from the buttons.
export component SegmentedControl inherits Rectangle {
    in property <length> text-size: Theme.fs;
    in property <[string]> options;
    in-out property <int> current;
    in property <bool> enabled: true;
    in property <bool> workbench;
    in property <bool> text-tabs;
    in property <bool> reduced-motion;

    callback changed(index: int);

    property <bool> ring;

    // 1px border + 2px padding, so the track insets by 3px on every side. A
    // Slint border is drawn inside the bounds but children still measure from
    // the outer edge, so the border has to be added in by hand.
    property <length> inset: root.workbench ? 0px : 3px;
    property <length> seg-w: (root.width - 2 * root.inset) / Math.max(root.options.length, 1);

    height: root.workbench ? 36px : Theme.h;
    min-width: 120px;
    horizontal-stretch: 1;
    background: root.workbench || root.text-tabs ? Colors.transparent : Theme.well;
    border-width: root.workbench || root.text-tabs ? 0px : 1px;
    border-color: Theme.line;
    border-radius: root.workbench ? 8px : Theme.r;
    opacity: root.enabled ? 1.0 : 0.45;

    function select(index: int) {
        if (root.enabled && index >= 0 && index < root.options.length) {
            root.current = index;
            root.changed(index);
        }
    }

    fs := FocusScope {
        enabled: root.enabled;
        // :focus-visible — keyboard focus only, see IconButton.
        focus-gained(reason) => {
            root.ring = reason == FocusReason.tab-navigation;
        }
        focus-lost(reason) => {
            root.ring = false;
        }
        key-pressed(event) => {
            if root.options.length == 0 { return EventResult.reject; }
            if (event.text == Key.RightArrow || event.text == Key.DownArrow) {
                root.select(Math.mod(root.current + 1, root.options.length));
                return EventResult.accept;
            }
            if (event.text == Key.LeftArrow || event.text == Key.UpArrow) {
                root.select(Math.mod(root.current - 1 + root.options.length, root.options.length));
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }

    thumb := Rectangle {
        x: root.inset + root.current * root.seg-w + (root.text-tabs ? (root.seg-w - self.width) / 2 : 0px);
        y: root.text-tabs ? root.height - 3px : root.inset;
        width: root.text-tabs ? Math.min(18px, root.seg-w) : root.seg-w;
        height: root.text-tabs ? 2px : root.height - 2 * root.inset;
        border-radius: root.text-tabs ? 1px : root.workbench ? 8px : Theme.r-sm;
        background: root.text-tabs ? Theme.accent : Theme.accent-soft;
        visible: root.current >= 0 && root.current < root.options.length;

        animate x, width { duration: root.reduced-motion ? 0ms : 180ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }
    }

    for option[index] in root.options: Rectangle {
        x: root.inset + index * root.seg-w;
        y: root.inset;
        width: root.seg-w;
        height: root.height - 2 * root.inset;
        accessible-role: tab;
        accessible-label: option;
        accessible-enabled: root.enabled;
        accessible-item-selectable: true;
        accessible-item-selected: index == root.current;
        accessible-action-default => { if root.enabled { fs.focus(); root.select(index); } }

        // The segment's whole box, so the label can centre in it; see the
        // note on IconButton's text in panel.slint for why a Text needs to
        // be handed one.
        Text {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: option;
            color: segment.pressed ? Theme.accent : index == root.current ? (root.text-tabs ? Theme.fg : Theme.accent) : segment.has-hover ? Theme.fg : Theme.fg-muted;
            font-size: root.text-size;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;

            animate color { duration: root.reduced-motion ? 0ms : 140ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }
        }

        segment := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                fs.focus();
                root.select(index);
            }
        }
    }

    if !root.text-tabs: FocusRing {
        active: root.ring;
        radius: root.workbench ? 8px : Theme.r;
    }
    if root.text-tabs && root.ring: Rectangle {
        x: thumb.x;
        y: root.height - 7px;
        width: thumb.width;
        height: 1px;
        for dash[index] in [0, 1, 2]: Rectangle {
            x: index * 6px; width: 4px; height: 1px;
            background: Theme.focus-control;
        }
    }
}
