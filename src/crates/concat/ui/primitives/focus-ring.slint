import { Theme } from "../theme/theme.slint";

// Keyboard focus stays inside the control's existing geometry.
export component FocusRing inherits Rectangle {
    in property <bool> active;
    in property <length> radius: Theme.r;

    background: transparent;

    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: root.radius;
        border-width: 1px;
        border-color: root.active ? Theme.focus-control : Colors.transparent;
    }
}
