import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph } from "../icons.slint";
import { Button, DialogSection, Modal } from "../primitives/modal.slint";

export struct MissingMediaItem {
    id: string,
    name: string,
    path: string,
}

export struct RelinkData {
    open: bool,
    busy: bool,
    confirm: bool,
    error: string,
    folder-enabled: bool,
    items: [MissingMediaItem],
}

export component RelinkDialog inherits Modal {
    in property <RelinkData> data;

    callback relink-all();
    callback locate-folder();
    callback dismiss();

    open: root.data.open;
    dismissable: !root.data.busy;
    closed => { root.dismiss(); }
    title: I18n.t("Missing Media");
    glyph: Glyph.info;
    surface-width: 600px;

    VerticalLayout {
        DialogSection {
            first: true;
            title: I18n.t1("{0} media file(s) not found", "" + data.items.length);

            Text {
                text: root.data.confirm ? "工程缺少原内容校验信息，无法确认是原文件。仍使用资产库中的匹配素材创建修复预览？" : "从资产库核对缺失素材，创建可播放、可另存的修复预览。";
                color: Theme.fg;
                wrap: word-wrap;
            }

            if root.data.error != "": Text { text: root.data.error; color: Theme.fg; wrap: word-wrap; }

            Flickable {
                height: 200px;
                viewport-height: items-layout.preferred-height;

                items-layout := VerticalLayout {
                    spacing: 4px;
                    
                    for item in root.data.items : Rectangle {
                        height: 40px;
                        background: Theme.field;
                        border-radius: 4px;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            alignment: start;

                            VerticalLayout {
                                alignment: center;

                                Text {
                                    text: item.name;
                                    color: Theme.fg;
                                    font-size: Theme.fs;
                                    overflow: elide;
                                }

                                Text {
                                    text: item.path;
                                    color: Theme.fg-dim;
                                    font-size: Theme.fs-sm;
                                    font-family: Theme.font-technical;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;

            Button {
                primary: false;
                label: root.data.confirm ? "取消" : I18n.t("Dismiss");
                enabled: !root.data.busy;
                clicked => { root.dismiss(); }
            }

            Button {
                primary: false;
                label: "定位文件夹";
                enabled: root.data.folder-enabled;
                clicked => { root.locate-folder(); }
            }

            Button {
                primary: true;
                label: root.data.busy ? "正在核对…" : root.data.confirm ? "仍创建修复预览" : "从资产库修复";
                enabled: !root.data.busy;
                clicked => { root.relink-all(); }
            }
        }
    }
}
