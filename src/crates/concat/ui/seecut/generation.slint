// SPDX-License-Identifier: AGPL-3.0-or-later

import { ScrollView } from "std-widgets.slint";
import { Switch, Rail } from "../inspector/controls.slint";
import { Theme, SegmentedControl, Glyph, Icon, Modal } from "../primitives/primitives.slint";
import { SeeCut } from "state.slint";
import { AppButton, AssetPreview, CloudField, Label, EmptyState, WorkspaceSelect, WorkspaceIcon } from "components.slint";


component GenerationForm inherits Rectangle {
    background: Theme.panel;
    property <int> mention-index;
    in property <bool> compact;
    property <int> reference-columns: SeeCut.creator-mode == 1 ? 3 : 2;
    property <int> reference-visible-count: SeeCut.creator-mode == 1 ? 6 : 4;
    property <int> reference-shown: SeeCut.references-expanded ? SeeCut.references.length : Math.min(SeeCut.references.length, root.reference-visible-count);
    property <length> reference-card-width: (root.width - (root.compact ? 16px : 32px) - (root.reference-columns - 1) * 8px) / root.reference-columns;
    property <length> reference-card-height: SeeCut.creator-mode == 1 ? 104px : 120px;
    property <bool> dense-controls: root.width > 600px;
    property <bool> model-valid: SeeCut.model-index >= 0 && SeeCut.model-index < SeeCut.model-names.length;
    property <string> model-label: root.model-valid ? SeeCut.model-names[SeeCut.model-index] : "请选择模型";
    property <string> ratio-label: SeeCut.ratios.length == 0 ? "自动比例" : SeeCut.ratio-index >= 0 && SeeCut.ratio-index < SeeCut.ratios.length ? SeeCut.ratios[SeeCut.ratio-index] : "请选择比例";
    property <string> resolution-label: SeeCut.resolutions.length == 0 ? "自动尺寸" : SeeCut.resolution-index >= 0 && SeeCut.resolution-index < SeeCut.resolutions.length ? SeeCut.resolutions[SeeCut.resolution-index] : "请选择尺寸";
    property <string> duration-label: SeeCut.durations.length == 0 ? "默认时长" : SeeCut.duration-index >= 0 && SeeCut.duration-index < SeeCut.durations.length ? SeeCut.durations[SeeCut.duration-index] : "请选择时长";
    property <string> quantity-label: SeeCut.quantities.length == 0 ? "默认数量" : SeeCut.quantity-index >= 0 && SeeCut.quantity-index < SeeCut.quantities.length ? SeeCut.quantities[SeeCut.quantity-index] : "请选择数量";
    property <string> parameter-summary: root.model-label + " · " + root.ratio-label + " · " + root.resolution-label
        + (SeeCut.mode == 1 ? " · 时长 " + root.duration-label : "")
        + (SeeCut.mode == 1 && SeeCut.supports-generation-audio ? " · 声音 " + (SeeCut.generate-audio ? "开启" : "关闭") : "")
        + " · 数量 " + root.quantity-label;
    VerticalLayout {
        padding: root.compact ? 8px : 16px;
        spacing: root.compact ? 4px : 10px;
        HorizontalLayout {
            height: 44px;
            spacing: 8px;
            SegmentedControl {
                width: 176px; height: 40px; text-size: 14px;
                options: ["图片", "视频"];
                current: SeeCut.mode;
                changed(index) => { SeeCut.mode = index; SeeCut.changed("mode", index); }
            }
            Rectangle { horizontal-stretch: 1; }
            AppButton {
                label: SeeCut.creator-mode == 1 ? "专业" : "快速";
                subtle: true;
                clicked => { SeeCut.action("creator-mode", SeeCut.creator-mode == 1 ? "0" : "1"); }
            }
        }
        if SeeCut.recovery-warning != "": Rectangle {
            min-height: root.compact ? 32px : 54px;
            max-height: root.compact ? 32px : 54px;
            background: Theme.danger-soft;
            border-radius: Theme.r-sm;
            border-width: 1px;
            border-color: Theme.danger;
            HorizontalLayout {
                padding-left: 10px; padding-right: 10px; spacing: 8px;
                Icon { glyph: Glyph.info; size: 16px; tint: Theme.danger; }
                ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.visible-width;
                    horizontal-scrollbar-policy: always-off;
                    Text { text: SeeCut.recovery-warning; color: Theme.danger; wrap: word-wrap; }
                }
            }
        }
        VerticalLayout {
            padding-right: 4px;
            spacing: root.compact ? 4px : 8px;
            alignment: start;
                if !SeeCut.signed-in || SeeCut.accepts-references || SeeCut.references.length > 0: VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        Label { text: "参考素材"; horizontal-stretch: 1; }
                        if SeeCut.reference-max > 0: Text { text: SeeCut.references.length + "/" + SeeCut.reference-max; color: Theme.fg-muted; vertical-alignment: center; }
                        AppButton { glyph: Glyph.folder; label: "资产库"; subtle: true; enabled: !SeeCut.signed-in || SeeCut.references.length < SeeCut.reference-max; clicked => { SeeCut.action("reference-team", ""); } }
                        AppButton { glyph: Glyph.import; label: "本机"; subtle: true; enabled: !SeeCut.working && (!SeeCut.signed-in || SeeCut.references.length < SeeCut.reference-max); clicked => { SeeCut.action("reference-browse", ""); } }
                    }
                    if SeeCut.references.length == 0: Rectangle {
                        height: SeeCut.creator-mode == 1 ? 112px : 156px;
                        background: Theme.well;
                        border-radius: Theme.r-lg;
                        border-width: 1px;
                        border-color: Theme.line;
                        Text {
                            width: 100%; height: 100%;
                            text: "添加图片、视频或音频";
                            color: Theme.fg-muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    if SeeCut.references.length > 0: Rectangle {
                        height: Math.ceil(root.reference-shown / root.reference-columns) * (root.reference-card-height + 8px) - 8px;
                        for item[i] in SeeCut.references: Rectangle {
                            visible: i < root.reference-shown;
                            x: Math.mod(i, root.reference-columns) * (root.reference-card-width + 8px);
                            y: Math.floor(i / root.reference-columns) * (root.reference-card-height + 8px);
                            width: root.reference-card-width;
                            height: root.reference-card-height;
                            background: Theme.well;
                            border-radius: Theme.r;
                            clip: true;
                            border-width: 1px;
                            border-color: item.missing ? Theme.danger : Theme.line;
                            AssetPreview {
                                width: parent.width;
                                height: parent.height - 30px;
                                source: item.preview;
                                fallback-glyph: item.kind == "video" ? Glyph.film : item.kind == "audio" ? Glyph.music : Glyph.image;
                                fallback-size: 24px;
                                interactive: item.ready;
                                accessible-name: "预览" + item.name;
                                activated => { SeeCut.action("reference-preview", item.id); }
                            }
                            Rectangle {
                                y: parent.height - 30px; height: 30px; width: 100%;
                                background: Theme.panel;
                                Text {
                                    x: 8px; width: parent.width - 42px; height: 100%;
                                    text: (i + 1) + " " + (item.status != "" ? item.status : item.name);
                                    color: item.missing || item.status == "上传失败" ? Theme.danger : Theme.fg;
                                    overflow: elide; vertical-alignment: center; font-size: 12px;
                                }
                                WorkspaceIcon {
                                    x: parent.width - 30px; y: 0px;
                                    width: 30px; height: 30px; side: 30px;
                                    glyph: item.missing || item.status == "上传失败" ? Glyph.reset : Glyph.close;
                                    label: item.missing ? "替换缺失素材" : item.status == "上传失败" ? "重新上传" : "移除参考素材";
                                    clicked => {
                                        SeeCut.action(item.missing ? "reference-replace" : item.status == "上传失败" ? "reference-retry" : "reference-remove", item.id);
                                    }
                                }
                            }
                        }
                    }
                    if SeeCut.references.length > root.reference-visible-count: AppButton {
                        label: SeeCut.references-expanded ? "收起" : "展开全部（+" + (SeeCut.references.length - root.reference-visible-count) + "）";
                        subtle: true;
                        clicked => { SeeCut.references-expanded = !SeeCut.references-expanded; }
                    }
                    if SeeCut.reference-limit != "" && !root.compact: Text {
                        min-height: root.compact ? 18px : 20px;
                        max-height: root.compact ? 18px : 20px;
                        text: SeeCut.reference-limit;
                        color: Theme.fg-muted;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
                if SeeCut.reference-error != "": Text {
                    min-height: 20px;
                    max-height: 20px;
                    text: SeeCut.reference-error;
                    color: Theme.danger;
                    font-size: 12px;
                    overflow: elide;
                }
                Label { text: "提示词"; color: Theme.fg; }

                prompt := CloudField {
                    background: Theme.panel;
                    min-height: root.compact ? 112px : 120px;
                    max-height: root.compact ? 112px : 120px;
                    value <=> SeeCut.prompt;
                    multiline: true;
                    placeholder: SeeCut.mode == 0 ? "描述画面、主体和风格" : "描述画面内容、动作和镜头";
                    edited(value) => { SeeCut.changed("prompt", value); }
                    cursor-moved(offset) => { SeeCut.prompt-cursor = offset; SeeCut.changed("prompt-cursor", offset); }
                    key-event(text) => {
                        if !SeeCut.mention-open { return false; }
                        if text == Key.Escape { SeeCut.mention-open = false; return true; }
                        if text == Key.DownArrow { root.mention-index = Math.min(root.mention-index + 1, SeeCut.references.length - 1); return true; }
                        if text == Key.UpArrow { root.mention-index = Math.max(root.mention-index - 1, 0); return true; }
                        if text == "\n" && root.mention-index >= 0 && root.mention-index < SeeCut.references.length {
                            SeeCut.action("reference-mention", SeeCut.references[root.mention-index].id);
                            prompt.focus-at(SeeCut.prompt-cursor);
                            return true;
                        }
                        return false;
                    }
                }
            }
        Rectangle { height: 1px; background: Theme.line; }
        if SeeCut.signed-in: VerticalLayout {
            spacing: 4px;
            if SeeCut.creator-mode == 0: HorizontalLayout {
                height: Theme.workbench-h;
                spacing: 8px;
                if SeeCut.model-names.length > 0: WorkspaceSelect {
                    options: SeeCut.model-names; current: SeeCut.model-index;
                    placeholder: "请选择模型"; horizontal-stretch: 1;
                    changed(index) => { SeeCut.model-index = index; SeeCut.changed("model", index); }
                }
                WorkspaceIcon { glyph: Glyph.sliders; label: SeeCut.generation-parameters-open ? "收起参数" : "展开参数"; clicked => { SeeCut.generation-parameters-open = !SeeCut.generation-parameters-open; } }
            }
            if SeeCut.creator-mode == 1 && root.dense-controls: HorizontalLayout {
                height: Theme.workbench-h;
                spacing: 6px;
                if SeeCut.model-names.length > 0: WorkspaceSelect {
                    options: SeeCut.model-names;
                    current: SeeCut.model-index;
                    placeholder: "请选择模型";
                    horizontal-stretch: 3;
                    min-width: 0px;
                    changed(index) => { SeeCut.model-index = index; SeeCut.changed("model", index); }
                }
                if SeeCut.resolutions.length > 0: WorkspaceSelect {
                    options: SeeCut.resolutions;
                    current: SeeCut.resolution-index;
                    placeholder: SeeCut.mode == 0 ? "尺寸" : "清晰度";
                    horizontal-stretch: 2;
                    min-width: 0px;
                    changed(index) => { SeeCut.resolution-index = index; SeeCut.changed("resolution", index); }
                }
                if SeeCut.ratios.length > 0: WorkspaceSelect {
                    options: SeeCut.ratios;
                    current: SeeCut.ratio-index;
                    placeholder: "比例";
                    horizontal-stretch: 1;
                    min-width: 0px;
                    changed(index) => { SeeCut.ratio-index = index; SeeCut.changed("ratio", index); }
                }
                AppButton {
                    min-width: 34px;
                    max-width: 34px;
                    label: "高级参数";
                    glyph: Glyph.sliders;
                    subtle: true;
                    elide-label: true;
                    clicked => { SeeCut.generation-parameters-open = true; }
                }
            }
            if SeeCut.creator-mode == 1 && !root.dense-controls: VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    height: Theme.workbench-h;
                    spacing: 6px;
                    if SeeCut.model-names.length > 0: WorkspaceSelect {
                        options: SeeCut.model-names;
                        current: SeeCut.model-index;
                        placeholder: "请选择模型";
                        horizontal-stretch: 2;
                        min-width: 0px;
                        changed(index) => { SeeCut.model-index = index; SeeCut.changed("model", index); }
                    }
                    if SeeCut.ratios.length > 0: WorkspaceSelect {
                        options: SeeCut.ratios;
                        current: SeeCut.ratio-index;
                        placeholder: "比例";
                        horizontal-stretch: 1;
                        min-width: 0px;
                        changed(index) => { SeeCut.ratio-index = index; SeeCut.changed("ratio", index); }
                    }
                }
                HorizontalLayout {
                    height: Theme.workbench-h;
                    spacing: 6px;
                    if SeeCut.resolutions.length > 0: WorkspaceSelect {
                        options: SeeCut.resolutions;
                        current: SeeCut.resolution-index;
                        placeholder: SeeCut.mode == 0 ? "尺寸" : "清晰度";
                        horizontal-stretch: 1;
                        min-width: 0px;
                        changed(index) => { SeeCut.resolution-index = index; SeeCut.changed("resolution", index); }
                    }
                    AppButton { label: "高级参数"; glyph: Glyph.sliders; subtle: true; clicked => { SeeCut.generation-parameters-open = true; } }
                }
            }
            if SeeCut.mode == 1 && (SeeCut.creator-mode == 1 || SeeCut.generation-parameters-open) && (SeeCut.durations.length > 0 || SeeCut.supports-generation-audio): HorizontalLayout {
                height: Theme.workbench-h;
                spacing: 6px;
                if SeeCut.durations.length > 0: Text { text: "时长"; color: Theme.fg-muted; vertical-alignment: center; }
                if SeeCut.durations.length > 0: Rail {
                    horizontal-stretch: 1;
                    minimum: 0; maximum: SeeCut.durations.length - 1; step: 1;
                    value: SeeCut.duration-index >= 0 && SeeCut.duration-index < SeeCut.durations.length ? SeeCut.duration-index : 0;
                    enabled: !SeeCut.working;
                    changed(value) => { SeeCut.duration-index = round(value); SeeCut.can-generate = false; SeeCut.quote = ""; SeeCut.changed("duration", SeeCut.duration-index); }
                }
                if SeeCut.durations.length > 0: Text { text: root.duration-label; color: Theme.fg; min-width: 48px; vertical-alignment: center; }
                if SeeCut.supports-generation-audio: Label { text: "声音"; color: Theme.fg-muted; }
                if SeeCut.supports-generation-audio: Text { text: SeeCut.generate-audio ? "开启" : "关闭"; color: Theme.fg-muted; vertical-alignment: center; }
                if SeeCut.supports-generation-audio: Switch { checked <=> SeeCut.generate-audio; toggled(checked) => { SeeCut.changed("generate-audio", ""); } }
            }
            if SeeCut.signed-in && SeeCut.creator-mode == 0 && SeeCut.generation-parameters-open: HorizontalLayout {
                height: Theme.workbench-h; spacing: 8px;
                if SeeCut.resolutions.length > 0: WorkspaceSelect { options: SeeCut.resolutions; current: SeeCut.resolution-index; placeholder: "尺寸"; horizontal-stretch: 1; changed(index) => { SeeCut.resolution-index = index; SeeCut.changed("resolution", index); } }
                if SeeCut.ratios.length > 0: WorkspaceSelect { options: SeeCut.ratios; current: SeeCut.ratio-index; placeholder: "比例"; horizontal-stretch: 1; changed(index) => { SeeCut.ratio-index = index; SeeCut.changed("ratio", index); } }
            }
            if SeeCut.signed-in && (SeeCut.creator-mode == 1 || SeeCut.generation-parameters-open) && SeeCut.qualities.length > 0: VerticalLayout {
                spacing: 4px;
                Label { text: "画质"; }
                WorkspaceSelect { options: SeeCut.qualities; current: SeeCut.quality-index; changed(index) => { SeeCut.quality-index = index; SeeCut.changed("quality", index); } }
            }
            if !root.compact: Text { text: root.parameter-summary; color: Theme.fg-muted; font-size: 12px; min-height: 18px; max-height: 18px; overflow: elide; horizontal-stretch: 1; }
        }
        if !SeeCut.signed-in: AppButton {
            label: "登录后选择模型与参数";
            glyph: Glyph.sliders;
            subtle: true;
            clicked => { SeeCut.action("auth-open", ""); }
        }
        VerticalLayout {
            spacing: 6px;
            Label { text: "数量"; }
            HorizontalLayout {
                height: Theme.workbench-h; spacing: 8px;
                if SeeCut.quantities.length > 0: WorkspaceSelect {
                    width: 108px; options: SeeCut.quantities;
                    current: SeeCut.quantity-index;
                    placeholder: "数量";
                    changed(index) => { SeeCut.quantity-index = index; SeeCut.changed("quantity", index); }
                }
                if SeeCut.quantities.length == 0: Text { text: "当前模型未提供数量选项"; color: Theme.fg-muted; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                if SeeCut.quote != "": Text { text: SeeCut.quote; color: Theme.fg-muted; overflow: elide; vertical-alignment: center; }
            }
        }
        HorizontalLayout {
            height: Theme.workbench-h;
            spacing: 8px;
            AppButton {
                horizontal-stretch: 1;
                label: !SeeCut.signed-in ? "登录后生成" : SeeCut.insufficient-credits ? (SeeCut.payment-enabled ? "充值积分" : "查看积分") : SeeCut.working ? "请稍候" : !root.model-valid ? "请选择模型" : SeeCut.mode == 0 ? "生成图片" : "生成视频";
                glyph: Glyph.sparkle;
                primary: true;
                enabled: !SeeCut.working && (!SeeCut.signed-in || SeeCut.insufficient-credits || (SeeCut.can-generate && root.model-valid));
                clicked => {
                    if !SeeCut.signed-in { SeeCut.action("auth-open", ""); }
                    else if SeeCut.insufficient-credits { SeeCut.action("navigate", "3"); }
                    else { SeeCut.action("generate", ""); }
                }
            }
        }
    }
    if SeeCut.mention-open: Rectangle {
        x: 16px; y: Math.max(16px, prompt.absolute-position.y - root.absolute-position.y - self.height - 8px);
        width: root.width - 32px;
        border-width: 1px; border-color: Theme.line-strong;
        height: Math.min(168px, Math.max(70px, SeeCut.references.length * 40px + 40px));
        background: Theme.well;
        border-radius: Theme.r-sm;
        VerticalLayout {
            padding: 6px;
            spacing: 4px;
            if SeeCut.references.length == 0: Text { text: "暂无参考素材"; color: Theme.fg-muted; height: 28px; }
            ScrollView {
                vertical-stretch: 1;
                viewport-width: self.width;
                horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    alignment: start; spacing: 2px;
                    for item[index] in SeeCut.references: Rectangle {
                        height: 38px;
                        background: mention-touch.has-hover || root.mention-index == index ? Theme.field-hover : Colors.transparent;
                        opacity: item.ready ? 1 : 0.45;
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle { width: 34px; height: 34px;
                                Icon { x: 8px; y: 8px; size: 18px; glyph: item.kind == "video" ? Glyph.film : item.kind == "audio" ? Glyph.music : Glyph.image; tint: Theme.fg-muted; }
                                Image { source: item.preview; width: 100%; height: 100%; image-fit: cover; }
                            }
                            Text { text: item.detail + "  " + item.name; min-width: 0px; color: Theme.fg; overflow: elide; vertical-alignment: center; }
                        }
                        mention-touch := TouchArea {
                            enabled: item.ready;
                            mouse-cursor: pointer;
                            clicked => { SeeCut.action("reference-mention", item.id); prompt.focus-at(SeeCut.prompt-cursor); }
                        }
                    }
                }
            }
            HorizontalLayout { Rectangle { horizontal-stretch: 1; } WorkspaceIcon { glyph: Glyph.close; label: "关闭素材引用"; clicked => { SeeCut.mention-open = false; } } }
        }
    }
}

component GenerationResults inherits Rectangle {
    min-width: 0px; min-height: 0px;
    VerticalLayout {
        padding: 24px; spacing: 16px;
        HorizontalLayout {
            height: Theme.workbench-h; spacing: Theme.workbench-gap;
            if !SeeCut.task-selection-mode: Text { text: "最近生成"; font-size: 14px; color: Theme.fg; vertical-alignment: center; horizontal-stretch: 1; }
            if SeeCut.task-selection-mode: Text { text: "已选 " + SeeCut.task-selected-count + " 项"; color: Theme.fg; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
            if SeeCut.task-selection-mode: WorkspaceIcon { glyph: Glyph.sparkle; label: "作为参考"; enabled: SeeCut.task-selected-count > 0; clicked => { SeeCut.action("task-batch-reference", ""); } }
            if SeeCut.task-selection-mode: WorkspaceIcon { glyph: Glyph.brush; label: "加入画布"; enabled: SeeCut.task-selected-count > 0; clicked => { SeeCut.action("task-batch-canvas", ""); } }
            if SeeCut.task-selection-mode: WorkspaceIcon { glyph: Glyph.film; label: "加入剪辑"; enabled: SeeCut.task-selected-count > 0; clicked => { SeeCut.action("task-batch-clip", ""); } }
            if SeeCut.task-selection-mode: WorkspaceIcon { glyph: Glyph.trash; label: "删除结果"; enabled: SeeCut.task-selected-count > 0; clicked => { SeeCut.action("task-batch-freeze-delete", ""); } }
            if SeeCut.task-selection-mode: WorkspaceIcon { glyph: Glyph.export; label: "导出结果"; enabled: SeeCut.task-selected-count > 0; clicked => { SeeCut.action("task-batch-export", ""); } }
            AppButton { label: SeeCut.task-selection-mode ? "完成管理" : "批量管理"; selected: SeeCut.task-selection-mode; clicked => { SeeCut.action("task-selection-mode", ""); } }
            WorkspaceIcon { glyph: Glyph.reset; label: "刷新生成结果"; enabled: SeeCut.signed-in && !SeeCut.working; clicked => { SeeCut.action("tasks-refresh", ""); } }
        }
        if SeeCut.batches.length == 0: EmptyState {
            glyph: Glyph.image;
            title: SeeCut.signed-in ? "还没有生成结果" : "登录后查看生成结果";
            detail: "";
        }
        if SeeCut.batches.length > 0: ScrollView {
            viewport-width: self.visible-width;
            horizontal-scrollbar-policy: always-off;
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 28px;
                alignment: start;
                for batch in SeeCut.batches: VerticalLayout {
                    spacing: 16px;
                    HorizontalLayout {
                        height: 26px; spacing: 12px;
                        Text { text: batch.label; color: Theme.fg; font-size: 13px; vertical-alignment: center; }
                        Text { text: batch.summary; color: Theme.fg-muted; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                    grid := Rectangle {
                        property <int> columns: Math.max(1, Math.floor((self.width + 16px) / 256px));
                        property <length> card-width: (self.width - (self.columns - 1) * 16px) / self.columns;
                        property <length> media-height: self.card-width * 0.61;
                        property <length> card-height: self.media-height + 54px;
                        height: Math.ceil(batch.items.length / self.columns) * (self.card-height + 16px) - 16px;
                        for item[i] in batch.items: Rectangle {
                            x: Math.mod(i, grid.columns) * (grid.card-width + 16px);
                            y: Math.floor(i / grid.columns) * (grid.card-height + 16px);
                            width: grid.card-width; height: grid.card-height;
                            background: Colors.transparent;
                            Rectangle {
                                width: 100%; height: grid.media-height;
                                background: Theme.well;
                                border-radius: Theme.r-lg;
                                clip: true;
                                preview := AssetPreview {
                                    width: 100%; height: 100%; source: item.preview;
                                    fallback-glyph: item.kind == "video" ? Glyph.film : Glyph.image;
                                    interactive: item.ready || item.failed;
                                    accessible-name: item.failed ? item.name + "，生成失败" : "预览" + item.name;
                                    activated => {
                                        if SeeCut.task-selection-mode {
                                            SeeCut.action("task-select-toggle", item.id);
                                        } else if item.failed {
                                            SeeCut.action("task-select", item.id);
                                            SeeCut.result-preview-open = true;
                                        } else {
                                            SeeCut.action("task-preview-open", item.id);
                                        }
                                    }
                                }
                                if SeeCut.task-selection-mode: Rectangle {
                                    x: 8px; y: 8px; width: 24px; height: 24px;
                                    background: item.selected ? Theme.accent : Theme.scrim;
                                    border-radius: Theme.r-sm; border-width: 1px; border-color: item.selected ? Theme.accent : Theme.line-strong;
                                    if item.selected: Icon { x: 4px; y: 4px; size: 16px; glyph: Glyph.check; tint: Theme.on-accent; }
                                    TouchArea { mouse-cursor: pointer; clicked => { SeeCut.action("task-select-toggle", item.id); } }
                                }
                                if item.failed: Text {
                                    width: 100%; height: 100%; text: "生成失败";
                                    color: Theme.danger; horizontal-alignment: center; vertical-alignment: center;
                                }
                                if !item.ready && !item.failed: Text {
                                    width: 100%; height: 100%; text: item.status;
                                    color: Theme.fg-muted; horizontal-alignment: center; vertical-alignment: center;
                                }
                                if item.ready && preview.hovered: Rectangle {
                                    x: parent.width - (item.kind == "image" ? 152px : 116px); y: 8px; width: item.kind == "image" ? 144px : 108px; height: 36px;
                                    background: Theme.scrim; border-radius: Theme.r;
                                    HorizontalLayout {
                                        WorkspaceIcon { on-image: true; glyph: Glyph.sparkle; label: "作为参考"; clicked => { SeeCut.action("task-reference", item.id); } }
                                        if item.kind == "image": WorkspaceIcon { on-image: true; glyph: Glyph.brush; label: "加入画布"; clicked => { SeeCut.action("task-canvas", item.id); } }
                                        WorkspaceIcon { on-image: true; glyph: Glyph.film; label: "加入剪辑"; clicked => { SeeCut.action("task-import", item.id); } }
                                        WorkspaceIcon { on-image: true; glyph: Glyph.reset; label: "回填配置"; enabled: item.refillable; clicked => { SeeCut.action("task-refill", item.id); } }
                                    }
                                }
                            }
                            HorizontalLayout {
                                y: grid.media-height + 8px; width: 100%; height: 22px;
                                Text { text: item.name; color: Theme.fg; font-size: 13px; min-width: 0px; overflow: elide; horizontal-stretch: 1; }
                                Text { text: item.status; color: item.failed ? Theme.danger : Theme.fg-muted; font-size: 12px; }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component GenerationPage inherits Rectangle {
    in property <bool> compact-height;
    min-width: 0px;
    min-height: 0px;
    // The workbench rail leaves about 828px of content in a 900px window;
    // keep the create/results switch available before the two-column layout
    // starts squeezing its prompt and reference controls.
    property <bool> narrow: root.width < 820px;
    property <int> step <=> SeeCut.generation-step;
    VerticalLayout {
        if root.narrow: HorizontalLayout {
            padding: 12px;
            SegmentedControl { text-size: 14px; height: 36px; options: ["创建", "生成结果"]; current <=> root.step; }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            if !root.narrow || root.step == 0: form-scroll := ScrollView {
                viewport-width: self.visible-width;
                horizontal-scrollbar-policy: always-off;
                viewport-height: Math.max(self.visible-height, form.height);
                min-width: root.narrow ? 0px : (root.width < 1100px ? 336px : root.width < 1300px ? 384px : 432px);
                max-width: root.narrow ? 100000px : (root.width < 1100px ? 336px : root.width < 1300px ? 384px : 432px);
                horizontal-stretch: root.narrow ? 1 : 0;
                form := GenerationForm {
                    width: form-scroll.visible-width;
                    compact: root.compact-height;
                    // Preserve the prompt's editing area at short window heights.
                    height: Math.max(form-scroll.visible-height, self.min-height);
                }
            }
            if !root.narrow: Rectangle { width: 1px; background: Theme.line; }
            if !root.narrow || root.step == 1: GenerationResults { horizontal-stretch: 1; }
        }
    }
    Modal {
        open: SeeCut.creator-mode < 0;
        title: "选择创作模式";
        glyph: Glyph.sparkle;
        dismissable: false;
        surface-width: Math.min(480px, root.width - 32px);
        VerticalLayout {
            padding: 24px; spacing: 12px;
            AppButton { label: "快速模式"; primary: true; clicked => { SeeCut.action("creator-mode", "0"); } }
            Text { text: "大图参考，常用参数自动填入。"; color: Theme.fg-muted; wrap: word-wrap; }
            AppButton { label: "专业模式"; clicked => { SeeCut.action("creator-mode", "1"); } }
            Text { text: "常用参数直接显示。"; color: Theme.fg-muted; wrap: word-wrap; }
        }
    }
    Modal {
        open: SeeCut.result-preview-open && SeeCut.selected-task >= 0 && SeeCut.selected-task < SeeCut.tasks.length && SeeCut.tasks[SeeCut.selected-task].failed;
        title: "生成失败详情"; glyph: Glyph.info;
        surface-width: Math.min(560px, root.width - 32px); surface-height: Math.min(320px, root.height - 32px);
        closed => { SeeCut.result-preview-open = false; }
        if SeeCut.selected-task >= 0 && SeeCut.selected-task < SeeCut.tasks.length: FocusScope {
            enabled: SeeCut.result-preview-open && SeeCut.tasks[SeeCut.selected-task].failed;
            changed enabled => { if self.enabled { self.focus(); } }
            key-pressed(event) => {
                if event.text == Key.Escape { SeeCut.result-preview-open = false; return EventResult.accept; }
                return EventResult.reject;
            }
            VerticalLayout {
                padding: 16px; spacing: 12px;
                ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.visible-width;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        alignment: start;
                        Text {
                            text: SeeCut.tasks[SeeCut.selected-task].detail == "" ? "生成失败，请调整后重试。" : SeeCut.tasks[SeeCut.selected-task].detail;
                            color: Theme.fg;
                            horizontal-alignment: left;
                            wrap: word-wrap;
                        }
                    }
                }
                HorizontalLayout { spacing: 8px; height: 34px;
                    AppButton { label: SeeCut.tasks[SeeCut.selected-task].refillable ? (SeeCut.tasks[SeeCut.selected-task].failed ? "修改后重试" : "回填") : "无历史配置"; enabled: SeeCut.tasks[SeeCut.selected-task].refillable && !SeeCut.working; clicked => { SeeCut.action("task-refill", SeeCut.tasks[SeeCut.selected-task].id); } }
                    Rectangle { horizontal-stretch: 1; }
                    AppButton { label: "关闭"; clicked => { SeeCut.result-preview-open = false; } }
                }
            }
        }
    }
    Modal {
        open: SeeCut.generation-parameters-open && SeeCut.creator-mode == 1; title: "生成参数"; glyph: Glyph.sliders;
        surface-width: Math.min(440px, root.width - 32px); surface-height: Math.min(260px, root.height - 32px);
        closed => { SeeCut.generation-parameters-open = false; }
        parameters-focus := FocusScope {
            enabled: SeeCut.generation-parameters-open;
            changed enabled => { if self.enabled { self.focus(); } }
            key-pressed(event) => {
                if event.text == Key.Escape { SeeCut.generation-parameters-open = false; return EventResult.accept; }
                return EventResult.reject;
            }
            VerticalLayout { padding: 20px; spacing: 14px;
                ScrollView { viewport-width: self.visible-width; horizontal-scrollbar-policy: always-off; vertical-stretch: 1;
                    VerticalLayout { spacing: 12px; alignment: start;
                if SeeCut.signed-in && SeeCut.model-names.length > 0 && SeeCut.qualities.length > 0: VerticalLayout {
                    spacing: 6px;
                    Label { text: "画质"; }
                    WorkspaceSelect { options: SeeCut.qualities; current: SeeCut.quality-index; changed(index) => { SeeCut.quality-index = index; SeeCut.changed("quality", index); } }
                }
                if SeeCut.qualities.length == 0: Text { text: "当前模型暂无高级参数"; color: Theme.fg-muted; }
                }
                }
                AppButton { label: "完成"; primary: true; clicked => { SeeCut.generation-parameters-open = false; } }
            }
        }
    }
    Modal {
        open: SeeCut.save-team-task != "";
        title: "保存到团队资产库";
        glyph: Glyph.folder;
        surface-width: Math.min(420px, root.width - 32px);
        closed => { SeeCut.save-team-task = ""; }
        save-team-focus := FocusScope {
            enabled: SeeCut.save-team-task != "";
            changed enabled => { if self.enabled { self.focus(); } }
            key-pressed(event) => {
                if event.text == Key.Escape { SeeCut.save-team-task = ""; return EventResult.accept; }
                return EventResult.reject;
            }
            VerticalLayout {
                padding: 20px;
                spacing: 16px;
                if SeeCut.team-names.length > 0: WorkspaceSelect { options: SeeCut.team-names; current: SeeCut.team-index; placeholder: "选择保存到的团队"; changed(index) => { SeeCut.team-index = index; SeeCut.changed("team", index); } }
                Text {
                    text: SeeCut.team-index < 0 || SeeCut.team-index >= SeeCut.team-names.length ? "加入或创建团队后，即可共享这份生成结果。" : "文件将长期保存到“" + SeeCut.team-names[SeeCut.team-index] + "”，团队成员均可查看和下载。";
                    color: Theme.fg-muted;
                    wrap: word-wrap;
                }
                if SeeCut.team-names.length == 0: AppButton { label: "创建或加入团队"; clicked => { SeeCut.action("navigate", "2"); } }
                HorizontalLayout {
                    spacing: 8px;
                    AppButton { label: "取消"; clicked => { SeeCut.save-team-task = ""; } }
                    AppButton {
                        label: "确认上传";
                        primary: true;
                        enabled: !SeeCut.working && SeeCut.team-index >= 0 && SeeCut.team-index < SeeCut.team-names.length;
                        clicked => {
                            SeeCut.action("task-save-team", SeeCut.save-team-task);
                            SeeCut.save-team-task = "";
                        }
                    }
                }
            }
        }
    }
}
