import { ScrollView, Slider } from "std-widgets.slint";
import { Switch } from "../inspector/controls.slint";
import { Theme, Select, SegmentedControl, IconButton, Glyph, Icon, Modal } from "../primitives/primitives.slint";
import { SeeCut } from "state.slint";
import { AppButton, CloudField, Label, Heading, EmptyState } from "components.slint";

component GenerationForm inherits Rectangle {
    background: Theme.panel;
    property <int> mention-index;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        SegmentedControl {
            options: ["图片", "视频"];
            current: SeeCut.mode;
            changed(index) => { SeeCut.mode = index; SeeCut.changed("mode", index); }
        }
        ScrollView {
            viewport-width: self.width;
            horizontal-scrollbar-policy: always-off;
            vertical-stretch: 1;
            VerticalLayout {
                padding-right: 4px;
                spacing: 8px;
                alignment: start;
                if SeeCut.accepts-references || SeeCut.references.length > 0: VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        Label { text: "参考素材"; horizontal-stretch: 1; }
                        Text { text: SeeCut.references.length + "/" + SeeCut.reference-max; color: Theme.fg-dim; vertical-alignment: center; }
                        IconButton { glyph: Glyph.plus; label: "添加本地素材"; enabled: SeeCut.references.length < SeeCut.reference-max; clicked => { SeeCut.action("reference-browse", ""); } }
                        IconButton { glyph: Glyph.folder; label: "从资产库选择"; enabled: SeeCut.references.length < SeeCut.reference-max; clicked => { SeeCut.action("reference-team", ""); } }
                    }
                    if SeeCut.references.length > 0: ScrollView {
                      height: Math.min(214px, SeeCut.references.length * 74px - 8px);
                      viewport-width: self.width;
                      horizontal-scrollbar-policy: always-off;
                      VerticalLayout { alignment: start; spacing: 8px;
                       for item in SeeCut.references: Rectangle {
                        height: 66px;
                        border-radius: Theme.r-sm;
                        background: Theme.well;
                        HorizontalLayout {
                            padding: 6px;
                            spacing: 8px;
                            Rectangle {
                                width: 52px; height: 52px; background: Theme.stage; clip: true; border-radius: Theme.r-sm;
                                Icon { x: 17px; y: 17px; size: 18px; glyph: item.kind == "video" ? Glyph.film : item.kind == "audio" ? Glyph.music : Glyph.image; tint: Theme.fg-dim; }
                                Image { source: item.preview; width: 100%; height: 100%; image-fit: contain; }
                                TouchArea { mouse-cursor: pointer; clicked => { SeeCut.action("reference-preview", item.id); } }
                            }
                            VerticalLayout {
                                min-width: 0px; horizontal-stretch: 1; alignment: center; spacing: 4px;
                                Text { text: item.name; min-width: 0px; color: Theme.fg; overflow: elide; }
                                Text { text: item.detail + " · " + item.status; min-width: 0px; color: item.status == "上传失败" || item.status == "已过期" ? Theme.danger : Theme.fg-dim; font-size: Theme.fs-sm; overflow: elide; }
                            }
                            if item.status == "上传失败" || item.status == "已过期": VerticalLayout { alignment: center; IconButton { glyph: Glyph.reset; label: "重新上传"; clicked => { SeeCut.action("reference-retry", item.id); } } }
                            VerticalLayout { alignment: center; IconButton { glyph: Glyph.close; label: "移除参考素材"; clicked => { SeeCut.action("reference-remove", item.id); } } }
                        }
                    }
                      }
                    }
                    if SeeCut.references.length < SeeCut.reference-max: Rectangle {
                        height: SeeCut.references.length == 0 ? 76px : 38px;
                        border-radius: Theme.r-sm;
                        border-width: 1px;
                        border-color: upload-touch.has-hover ? Theme.accent : Theme.line;
                        background: upload-touch.has-hover ? Theme.field-hover : Theme.well;
                        HorizontalLayout {
                            alignment: center; spacing: 8px;
                            VerticalLayout { alignment: center; Icon { glyph: Glyph.import; size: 18px; tint: Theme.fg-muted; } }
                            Text { text: "点击或拖入参考素材"; color: Theme.fg-muted; vertical-alignment: center; }
                        }
                        upload-touch := TouchArea { mouse-cursor: pointer; clicked => { SeeCut.action("reference-browse", ""); } }
                    }
                    if SeeCut.reference-limit != "": Text { text: SeeCut.reference-limit; color: Theme.fg-dim; wrap: word-wrap; font-size: Theme.fs-sm; }
                }
                if SeeCut.reference-error != "": Text { text: SeeCut.reference-error; color: Theme.danger; wrap: word-wrap; font-size: Theme.fs-sm; }
                Rectangle { height: 8px; }
                Label { text: "提示词"; }
                prompt := CloudField {
                    value <=> SeeCut.prompt;
                    multiline: true;
                    placeholder: SeeCut.mode == 0 ? "描述画面、主体和风格" : "描述画面内容、动作和镜头";
                    edited(value) => { SeeCut.changed("prompt", value); }
                    cursor-moved(offset) => { SeeCut.prompt-cursor = offset; SeeCut.changed("prompt-cursor", offset); }
                    key-event(text) => {
                        if !SeeCut.mention-open { return false; }
                        if text == Key.Escape { SeeCut.mention-open = false; return true; }
                        if text == Key.DownArrow { root.mention-index = Math.min(root.mention-index + 1, SeeCut.references.length - 1); return true; }
                        if text == Key.UpArrow { root.mention-index = Math.max(root.mention-index - 1, 0); return true; }
                        if text == "\n" && root.mention-index >= 0 && root.mention-index < SeeCut.references.length {
                            SeeCut.action("reference-mention", SeeCut.references[root.mention-index].id);
                            prompt.focus-at(SeeCut.prompt-cursor);
                            return true;
                        }
                        return false;
                    }
                }
                if SeeCut.mention-open: Rectangle {
                    height: Math.min(168px, Math.max(70px, SeeCut.references.length * 40px + 40px));
                    background: Theme.well;
                    border-radius: Theme.r-sm;
                    VerticalLayout {
                        padding: 6px;
                        spacing: 4px;
                        if SeeCut.references.length == 0: Text { text: "暂无参考素材"; color: Theme.fg-dim; height: 28px; }
                        ScrollView {
                            vertical-stretch: 1;
                            viewport-width: self.width;
                            horizontal-scrollbar-policy: always-off;
                            VerticalLayout {
                                alignment: start; spacing: 2px;
                                for item[index] in SeeCut.references: Rectangle {
                                    height: 38px;
                                    background: mention-touch.has-hover || root.mention-index == index ? Theme.field-hover : Colors.transparent;
                                    opacity: item.ready ? 1 : 0.45;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Rectangle { width: 34px; height: 34px;
                                            Icon { x: 8px; y: 8px; size: 18px; glyph: item.kind == "video" ? Glyph.film : item.kind == "audio" ? Glyph.music : Glyph.image; tint: Theme.fg-dim; }
                                            Image { source: item.preview; width: 100%; height: 100%; image-fit: cover; }
                                        }
                                        Text { text: item.detail + "  " + item.name; min-width: 0px; color: Theme.fg; overflow: elide; vertical-alignment: center; }
                                    }
                                    mention-touch := TouchArea {
                                        enabled: item.ready;
                                        mouse-cursor: pointer;
                                        clicked => { SeeCut.action("reference-mention", item.id); prompt.focus-at(SeeCut.prompt-cursor); }
                                    }
                                }
                            }
                        }
                        HorizontalLayout { Rectangle { horizontal-stretch: 1; } IconButton { glyph: Glyph.close; label: "关闭素材引用"; clicked => { SeeCut.mention-open = false; } } }
                    }
                }
                Label { text: "模型"; }
                Select { options: SeeCut.model-names; current: SeeCut.model-index; placeholder: "暂无可用模型"; enabled: SeeCut.model-names.length > 0; changed(index) => { SeeCut.model-index = index; SeeCut.changed("model", index); } }
                if SeeCut.ratios.length > 0: VerticalLayout {
                    spacing: 6px;
                    Label { text: "画面比例"; }
                    Select { options: SeeCut.ratios; current: SeeCut.ratio-index; changed(index) => { SeeCut.ratio-index = index; SeeCut.changed("ratio", index); } }
                }
                if SeeCut.resolutions.length > 0: VerticalLayout {
                    spacing: 6px;
                    Label { text: SeeCut.mode == 0 ? "比例与尺寸" : "清晰度"; }
                    Select { options: SeeCut.resolutions; current: SeeCut.resolution-index; changed(index) => { SeeCut.resolution-index = index; SeeCut.changed("resolution", index); } }
                }
                if SeeCut.qualities.length > 0: VerticalLayout {
                    spacing: 6px;
                    Label { text: "画质"; }
                    Select { options: SeeCut.qualities; current: SeeCut.quality-index; changed(index) => { SeeCut.quality-index = index; SeeCut.changed("quality", index); } }
                }
                if SeeCut.durations.length > 0: VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        Label { text: "时长"; horizontal-stretch: 1; }
                        Text { text: SeeCut.durations[SeeCut.duration-index]; color: Theme.fg; vertical-alignment: center; }
                    }
                    Slider {
                        minimum: 0; maximum: SeeCut.durations.length - 1; step: 1;
                        value: SeeCut.duration-index;
                        changed(value) => { SeeCut.duration-index = round(value); SeeCut.can-generate = false; SeeCut.quote = ""; }
                        released(value) => { SeeCut.changed("duration", SeeCut.duration-index); }
                    }
                    HorizontalLayout {
                        Text { text: SeeCut.durations[0]; color: Theme.fg-dim; font-size: Theme.fs-sm; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: SeeCut.durations[SeeCut.durations.length - 1]; color: Theme.fg-dim; font-size: Theme.fs-sm; }
                    }
                }
                if SeeCut.mode == 1 && SeeCut.supports-generation-audio: HorizontalLayout {
                    padding-top: 6px; padding-bottom: 6px; spacing: 10px;
                    Label { text: "生成声音"; horizontal-stretch: 1; }
                    Text { text: SeeCut.generate-audio ? "开启" : "关闭"; color: Theme.fg-dim; vertical-alignment: center; }
                    VerticalLayout { alignment: center;
                        Switch { checked <=> SeeCut.generate-audio; toggled(checked) => { SeeCut.changed("generate-audio", ""); } }
                    }
                }
                if SeeCut.quantities.length > 0: VerticalLayout {
                    spacing: 6px;
                    Label { text: "数量"; }
                    Select { options: SeeCut.quantities; current: SeeCut.quantity-index; changed(index) => { SeeCut.quantity-index = index; SeeCut.changed("quantity", index); } }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }
        if SeeCut.quote != "": Text { text: SeeCut.quote; color: Theme.fg-muted; wrap: word-wrap; }
        AppButton {
            label: !SeeCut.signed-in ? "登录后生成" : SeeCut.insufficient-credits ? (SeeCut.payment-enabled ? "充值积分" : "查看积分") : SeeCut.working ? "请稍候" : SeeCut.mode == 0 ? "生成图片" : "生成视频";
            glyph: Glyph.sparkle;
            primary: true;
            enabled: !SeeCut.working && (!SeeCut.signed-in || SeeCut.insufficient-credits || SeeCut.can-generate);
            clicked => {
                if !SeeCut.signed-in { SeeCut.action("auth-open", ""); }
                else if SeeCut.insufficient-credits { SeeCut.action("navigate", "3"); }
                else { SeeCut.action("generate", ""); }
            }
        }
    }
}

component GenerationResults inherits Rectangle {
    min-width: 0px;
    min-height: 0px;
    property <bool> has-selection: SeeCut.selected-task >= 0 && SeeCut.selected-task < SeeCut.tasks.length;
    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        HorizontalLayout {
            Heading { text: "生成记录"; horizontal-stretch: 1; }
            IconButton { glyph: Glyph.reset; label: "刷新生成记录"; enabled: SeeCut.signed-in && !SeeCut.working; clicked => { SeeCut.action("tasks-refresh", ""); } }
        }
        if SeeCut.tasks.length == 0: EmptyState { glyph: Glyph.image; title: "暂无生成记录"; }
        if root.has-selection: Rectangle {
            min-height: 120px;
            max-height: 280px;
            vertical-stretch: 1;
            background: Theme.stage;
            border-radius: Theme.r;
            clip: true;
            Image { width: 100%; height: 100%; source: SeeCut.tasks[SeeCut.selected-task].preview; image-fit: contain; }
            if SeeCut.tasks[SeeCut.selected-task].kind == "image" && SeeCut.tasks[SeeCut.selected-task].local: TouchArea {
                mouse-cursor: pointer;
                clicked => { SeeCut.action("task-preview", SeeCut.tasks[SeeCut.selected-task].id); }
            }
            if SeeCut.tasks[SeeCut.selected-task].kind == "video" && SeeCut.tasks[SeeCut.selected-task].ready: AppButton {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 110px;
                label: "播放视频";
                glyph: Glyph.play;
                clicked => { SeeCut.action("task-preview", SeeCut.tasks[SeeCut.selected-task].id); }
            }
        }
        if root.has-selection && SeeCut.tasks[SeeCut.selected-task].ready: HorizontalLayout {
            spacing: 8px;
            AppButton { glyph: Glyph.plus; label: SeeCut.project-open ? "导入当前项目" : "开始剪辑"; primary: true; enabled: !SeeCut.working; clicked => { SeeCut.action("task-import", SeeCut.tasks[SeeCut.selected-task].id); } }
            AppButton { label: "个人资产"; clicked => { SeeCut.action("navigate", "5"); } }
            IconButton { glyph: Glyph.export; label: "下载到本机"; clicked => { SeeCut.action("task-download", SeeCut.tasks[SeeCut.selected-task].id); } }
            IconButton { glyph: Glyph.folder; label: "保存到团队资产库"; enabled: SeeCut.signed-in; clicked => { SeeCut.save-team-task = SeeCut.tasks[SeeCut.selected-task].id; SeeCut.action("personal-teams", ""); } }
            Rectangle { horizontal-stretch: 1; }
        }
        if SeeCut.tasks.length > 0: ScrollView {
            viewport-width: self.width;
            horizontal-scrollbar-policy: always-off;
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 6px;
                alignment: start;
                for item[index] in SeeCut.tasks: Rectangle {
                    height: 78px;
                    background: SeeCut.selected-task == index ? Theme.field-active : Theme.panel;
                    border-radius: Theme.r;
                    border-width: 1px;
                    border-color: SeeCut.selected-task == index ? Theme.line-strong : Theme.line;
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 12px;
                        Rectangle {
                            width: 58px;
                            background: Theme.well;
                            border-radius: Theme.r-sm;
                            clip: true;
                            Image { width: 100%; height: 100%; source: item.preview; image-fit: cover; }
                            if !item.ready: Icon { x: 19px; y: 19px; size: 20px; glyph: item.kind == "video" ? Glyph.film : Glyph.image; tint: Theme.fg-dim; }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 5px;
                            Text { text: item.name; color: Theme.fg; overflow: elide; }
                            Text { text: item.detail; color: Theme.fg-dim; font-size: Theme.fs-sm; overflow: elide; }
                        }
                        Text { text: item.status; color: item.ready ? Theme.green : Theme.fg-muted; vertical-alignment: center; }
                    }
                    TouchArea { mouse-cursor: pointer; clicked => { SeeCut.selected-task = index; SeeCut.action("task-select", item.id); } }
                }
            }
        }
    }
}

export component GenerationPage inherits Rectangle {
    min-width: 0px;
    min-height: 0px;
    property <bool> narrow: root.width < 920px;
    property <int> step;
    VerticalLayout {
        if root.narrow: HorizontalLayout {
            padding: 12px;
            SegmentedControl { options: ["创建", "生成记录"]; current <=> root.step; }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            if !root.narrow || root.step == 0: GenerationForm {
                min-width: root.narrow ? 0px : 360px;
                max-width: root.narrow ? 100000px : 360px;
                horizontal-stretch: root.narrow ? 1 : 0;
            }
            if !root.narrow: Rectangle { width: 1px; background: Theme.line; }
            if !root.narrow || root.step == 1: GenerationResults { horizontal-stretch: 1; }
        }
    }
    Modal {
        open: SeeCut.save-team-task != "";
        title: "保存到团队资产库";
        glyph: Glyph.folder;
        surface-width: Math.min(420px, root.width - 32px);
        closed => { SeeCut.save-team-task = ""; }
        VerticalLayout {
            padding: 20px;
            spacing: 16px;
            if SeeCut.team-names.length > 0: Select { options: SeeCut.team-names; current: SeeCut.team-index; placeholder: "选择保存到的团队"; changed(index) => { SeeCut.team-index = index; SeeCut.changed("team", index); } }
            Text {
                text: SeeCut.team-index < 0 ? "加入或创建团队后，即可共享这份生成结果。" : "文件将长期保存到“" + SeeCut.team-names[SeeCut.team-index] + "”，团队成员均可查看和下载。";
                color: Theme.fg-muted;
                wrap: word-wrap;
            }
            if SeeCut.team-names.length == 0: AppButton { label: "创建或加入团队"; clicked => { SeeCut.action("navigate", "2"); } }
            HorizontalLayout {
                spacing: 8px;
                AppButton { label: "取消"; clicked => { SeeCut.save-team-task = ""; } }
                AppButton {
                    label: "确认上传";
                    primary: true;
                    enabled: !SeeCut.working && SeeCut.team-index >= 0;
                    clicked => {
                        SeeCut.action("task-save-team", SeeCut.save-team-task);
                        SeeCut.save-team-task = "";
                    }
                }
            }
        }
    }
}
