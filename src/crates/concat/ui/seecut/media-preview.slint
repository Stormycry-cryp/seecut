import { Theme, Modal, Glyph, Icon } from "../primitives/primitives.slint";
import { SeeCut } from "state.slint";
import { AppButton, AssetPreview, WorkspaceIcon } from "components.slint";

// One window-level viewer for local assets, team assets, references and results.
export component MediaPreview inherits Modal {
    open: SeeCut.media-preview-open;
    title: SeeCut.media-preview-item.name;
    glyph: SeeCut.media-preview-item.kind == "audio" ? Glyph.music : SeeCut.media-preview-item.kind == "video" ? Glyph.film : Glyph.image;
    surface-width: Math.min(1080px, root.width - 32px);
    surface-height: Math.min(780px, root.height - 40px);
    closed => { SeeCut.media-preview-open = false; }
    property <bool> usable: SeeCut.media-preview-item.ready && !SeeCut.media-preview-loading && SeeCut.media-preview-error == "";
    property <bool> is-result: SeeCut.media-preview-source == "task";
    property <bool> is-image: SeeCut.media-preview-item.kind == "image";
    changed open => { if root.open { preview-keys.focus(); } }
    preview-keys := FocusScope {
        enabled: root.open;
        key-pressed(event) => {
            if event.text == Key.Escape { SeeCut.media-preview-open = false; return accept; }
            return reject;
        }
        VerticalLayout {
            padding: 16px; spacing: 12px;
            Text {
                text: SeeCut.media-preview-item.detail;
                font-size: 13px; color: Theme.fg-muted; overflow: elide;
                height: 20px;
            }
            Rectangle {
                vertical-stretch: 1; min-height: 100px;
                AssetPreview {
                    width: 100%; height: 100%; source: SeeCut.media-preview-item.preview;
                    fallback-glyph: root.glyph; fallback-size: 36px;
                }
                if SeeCut.media-preview-loading: Rectangle {
                    width: 100%; height: 100%; background: Theme.scrim;
                    Text { width: 100%; height: 100%; text: "正在读取素材"; color: Theme.on-scrim; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            if SeeCut.media-preview-error != "": HorizontalLayout {
                spacing: 8px;
                Text { text: SeeCut.media-preview-error; color: Theme.danger; wrap: word-wrap; horizontal-stretch: 1; }
                AppButton { label: "重试"; clicked => { SeeCut.action("media-preview-action", "retry"); } }
            }
            if !root.is-image: Text {
                text: SeeCut.media-preview-item.kind == "video" ? "视频将在外部播放器中播放" : "音频将在外部播放器中播放";
                color: Theme.fg-muted; font-size: 13px;
            }
            HorizontalLayout {
                height: 34px; spacing: 8px;
                if root.is-result: AppButton {
                    label: SeeCut.media-preview-item.refillable ? "回填" : "无历史配置";
                    enabled: SeeCut.media-preview-item.refillable && !SeeCut.working;
                    clicked => { SeeCut.action("media-preview-action", "refill"); }
                }
                if SeeCut.media-preview-source != "reference": AppButton {
                    label: "引用"; enabled: root.usable && !SeeCut.working;
                    clicked => { SeeCut.action("media-preview-action", "reference"); }
                }
                AppButton { label: "导入剪辑"; enabled: root.usable && !SeeCut.working; clicked => { SeeCut.action("media-preview-action", "import"); } }
                if root.is-image: AppButton { label: "打开画布"; enabled: root.usable && !SeeCut.working; clicked => { SeeCut.action("media-preview-action", "canvas"); } }
                Rectangle { horizontal-stretch: 1; }
                if !root.is-image: AppButton { label: "用播放器打开"; glyph: Glyph.play; enabled: root.usable; clicked => { SeeCut.action("media-preview-action", "play"); } }
                if root.is-result: AppButton { label: "保存本地"; enabled: root.usable; clicked => { SeeCut.action("media-preview-action", "download"); } }
                if root.is-result: WorkspaceIcon { label: "保存到团队资产库"; glyph: Glyph.folder; enabled: root.usable && SeeCut.signed-in; clicked => { SeeCut.action("media-preview-action", "team"); } }
                AppButton { label: "关闭"; clicked => { SeeCut.media-preview-open = false; } }
            }
        }
    }
}
