export struct CloudItem {
    id: string,
    name: string,
    detail: string,
    status: string,
    kind: string,
    preview: image,
    ready: bool,
    local: bool,
}

export struct CreditPlan {
    id: string,
    name: string,
    price: string,
    credits: string,
}

export struct AccountEntry {
    id: string,
    title: string,
    detail: string,
    value: string,
}

export global SeeCut {
    in-out property <int> page: 1;
    in-out property <bool> busy;
    in-out property <bool> working;
    in-out property <bool> auth-open: true;
    in-out property <bool> auth-busy;
    in-out property <int> pending-import-count;
    in-out property <string> error;
    in-out property <string> notice;
    in-out property <bool> signed-in;
    in-out property <string> email;
    in-out property <string> balance: "--";
    in-out property <string> frozen: "--";
    in-out property <bool> project-open;

    in-out property <int> mode;
    in-out property <string> prompt;
    in-out property <int> prompt-cursor;
    in-out property <bool> mention-open;
    in-out property <bool> asset-picker-open;
    in-out property <string> asset-picker-purpose: "reference";
    in-out property <int> asset-picker-source;
    in-out property <[CloudItem]> personal-assets;
    in-out property <[CloudItem]> personal-references;
    in-out property <string> personal-search;
    in-out property <string> personal-reference-search;
    in-out property <int> personal-filter;
    in-out property <int> personal-source;
    in-out property <bool> personal-trash;
    in-out property <string> personal-rename;
    in-out property <string> reference-error;
    in-out property <[string]> model-names;
    in-out property <int> model-index;
    in-out property <[string]> ratios;
    in-out property <int> ratio-index;
    in-out property <[string]> resolutions;
    in-out property <int> resolution-index;
    in-out property <[string]> qualities;
    in-out property <int> quality-index;
    in-out property <[string]> durations;
    in-out property <int> duration-index;
    in-out property <bool> supports-generation-audio;
    in-out property <bool> generate-audio: true;
    in-out property <[string]> quantities;
    in-out property <int> quantity-index;
    in-out property <bool> accepts-references;
    in-out property <string> reference-limit;
    in-out property <int> reference-max;
    in-out property <[CloudItem]> references;
    in-out property <string> quote;
    in-out property <bool> can-generate;
    in-out property <bool> insufficient-credits;
    in-out property <bool> payment-enabled;
    in-out property <[CloudItem]> tasks;
    in-out property <int> selected-task: -1;
    in-out property <string> save-team-task;

    in-out property <[string]> team-names;
    in-out property <int> team-index: -1;
    in-out property <string> team-name;
    in-out property <string> invite-input;
    in-out property <string> invite-url;
    in-out property <string> invite-detail;
    in-out property <bool> team-owner;
    in-out property <[AccountEntry]> members;
    in-out property <[CloudItem]> assets;
    in-out property <string> asset-search;
    in-out property <int> asset-filter;
    in-out property <bool> trash-open;
    in-out property <[CreditPlan]> plans;
    in-out property <[AccountEntry]> ledger;
    in-out property <[AccountEntry]> orders;

    in-out property <int> auth-mode;
    in-out property <string> auth-email;
    in-out property <string> auth-password;
    in-out property <string> auth-password-confirm;
    in-out property <string> auth-token;
    in-out property <int> auth-resend-seconds;
    in-out property <string> local-folder;
    in-out property <bool> reduced-motion;

    callback action(name: string, id: string);
    callback changed(field: string, value: string);
}
