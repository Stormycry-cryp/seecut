import { Theme, Modal, Glyph, IconButton, Button } from "../primitives/primitives.slint";
import { SeeCut } from "state.slint";
import { AccountPage } from "account.slint";
import { AppButton } from "components.slint";
import { ToastLayer } from "../primitives/toast.slint";

export component AuthDialog inherits Modal {
    open: SeeCut.auth-open;
    title: "Seecut 账户";
    glyph: Glyph.lock;
    surface-width: Math.min(460px, root.width - 32px);
    surface-height: Math.min(640px, root.height - 40px);
    dismissable: !SeeCut.auth-busy;
    closed => { SeeCut.action("auth-close", ""); }
    if SeeCut.auth-open: FocusScope {
        vertical-stretch: 1;
        key-pressed(event) => {
            if event.text == Key.Escape && !SeeCut.auth-busy { SeeCut.action("auth-close", ""); return accept; }
            return reject;
        }
        VerticalLayout {
            AccountPage { authentication: true; vertical-stretch: 1; }
            if !SeeCut.signed-in: HorizontalLayout {
                padding-left: 24px; padding-right: 24px; padding-bottom: 16px;
                alignment: center;
                AppButton { label: "先使用本地剪辑和个人资产"; subtle: true; enabled: !SeeCut.auth-busy; clicked => { SeeCut.action("auth-close", ""); SeeCut.action("navigate", "0"); } }
            }
        }
    }
}

export component WorkflowFeedback inherits VerticalLayout {
    spacing: 0px;
    if SeeCut.pending-import-count > 0 && SeeCut.page == 0: Rectangle {
        min-height: 48px; background: Theme.field-active;
        HorizontalLayout {
            padding: 10px; spacing: 8px;
            Text { text: "已选 " + SeeCut.pending-import-count + " 项素材。创建或打开项目后自动导入。"; color: Theme.fg; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
            AppButton { label: "取消导入"; subtle: true; clicked => { SeeCut.action("cancel-project-import", ""); } }
        }
    }
}

// Transient workflow messages share the application's floating toast style.
// The pending project import above stays in the layout because it has an
// explicit action; ordinary operation results never shift the page.
export component WorkflowToast inherits Rectangle {
    property <string> message: !SeeCut.auth-open && !SeeCut.asset-picker-open
        ? (SeeCut.error != "" ? SeeCut.error : SeeCut.notice) : "";
    property <bool> failed: SeeCut.error != "";
    property <int> token;
    changed message => { if root.message != "" { root.token += 1; } }
    ToastLayer {
        width: parent.width; height: parent.height;
        bottom-offset: 58px;
        data: { token: root.token, message: root.message, failed: root.failed };
    }
}

export component EditorBridgeBar inherits Rectangle {
    in property <string> project-name;
    in property <string> project-status;
    in property <int> focus-request-target;
    in property <int> focus-request-token;
    changed focus-request-token => {
        if root.focus-request-target == 3 { root.focus-assets(); }
        else if root.focus-request-target == 4 { root.focus-export(); }
    }
    height: 54px;
    callback export-clicked();
    callback assets-clicked();
    public function focus-assets() { assets-button.take-focus(); }
    public function focus-export() { export-button.take-focus(); }
    background: Theme.panel;
    HorizontalLayout {
        padding-top: 10px; padding-bottom: 10px; padding-left: 20px; padding-right: 20px; spacing: 8px;
        Text { font-size: 14px; text: SeeCut.project-open ? root.project-name + " · " + root.project-status : "未打开项目"; color: Theme.fg; min-width: 0px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
        assets-button := AppButton { label: "从资产库导入"; enabled: !SeeCut.working; clicked => { root.assets-clicked(); } }
        export-button := AppButton { visible: SeeCut.project-open; label: "导出视频"; primary: true; clicked => { root.export-clicked(); } }
    }
    Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Theme.line; }
}
