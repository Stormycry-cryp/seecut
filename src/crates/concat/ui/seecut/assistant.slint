import { ScrollView } from "std-widgets.slint";
import { Theme, Glyph, Icon, IconButton, FocusRing, ThinScrollbar } from "../primitives/primitives.slint";
import { Switch } from "../inspector/controls.slint";
import { AppButton, WorkspaceSelect, AssetPreview } from "components.slint";
import { EffortSlider } from "effort-slider.slint";

// Text is content only. Operation state always comes from the host separately.
export struct AssistantReference { key: string, label: string, node: bool, thumbnail: image, has-image: bool }
export struct AssistantMessage { role: string, text: string, state: string, progress: string, references: [AssistantReference] }

component AgentMenuAction inherits Rectangle {
    in property <string> text;
    in property <Glyph> glyph;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px; min-width: 0px; border-radius: 6px;
    background: touch.has-hover && root.enabled ? Theme.field-hover : transparent;
    accessible-role: button; accessible-label: root.text; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 8px;
        VerticalLayout { alignment: center; Icon { glyph: root.glyph; size: 16px; tint: root.enabled ? Theme.fg-muted : Theme.fg-dim; } }
        Text { text: root.text; font-family: Theme.font; font-size: Theme.fs; color: root.enabled ? Theme.fg : Theme.fg-dim; vertical-alignment: center; horizontal-stretch: 1; }
    }
    keys := FocusScope { enabled: root.enabled; key-pressed(event) => { if event.text == " " || event.text == "\n" { if !event.repeat { root.clicked(); } return EventResult.accept; } return EventResult.reject; } }
    forward-focus: keys;
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component AssistantReferenceTile inherits Rectangle {
    in property <AssistantReference> reference;
    in property <bool> removable;
    callback remove();
    callback reuse();
    callback open(string);
    // Keep the owning tile alive while closing the popup before dispatch.
    function reuse-preview() { preview.close(); root.reuse(); }
    function open-preview(destination: string) { preview.close(); root.open(destination); }
    width: 64px; height: 64px; border-radius: 12px; background: Theme.field;
    border-width: 1px; border-color: Theme.line; clip: true;
    accessible-role: button; accessible-label: root.reference.label;
    thumbnail-hover := TouchArea {
        mouse-cursor: pointer; clicked => { preview.show(); }
        if root.reference.has-image: AssetPreview { width: parent.width; height: parent.height; border-radius: 12px; source: root.reference.thumbnail; fill-frame: true; }
        if !root.reference.has-image: Icon { x: 22px; y: 22px; size: 20px; glyph: root.reference.node ? Glyph.workflow : Glyph.image; }
        remove-action := IconButton {
            visible: root.removable; x: 38px; y: 2px; height: 24px; side: 24px; icon-size: 12px;
            opacity: thumbnail-hover.has-hover || self.keyboard-navigation-focus ? 1 : 0;
            on-image: true; glyph: Glyph.close; label: "移除引用"; clicked => { root.remove(); }
        }
    }
    preview := PopupWindow {
        close-policy: close-on-click-outside;
        width: 240px; height: 240px; x: -80px; y: -244px;
        Rectangle {
            background: Theme.panel; border-radius: 12px; border-width: 1px; border-color: Theme.line;
            if root.reference.has-image: AssetPreview { x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 52px; border-radius: 12px; source: root.reference.thumbnail; }
            if !root.reference.has-image: Text { x: 16px; y: 16px; width: parent.width - 32px; text: root.reference.label; color: Theme.fg; font-family: Theme.font; font-size: Theme.workbench-font; wrap: word-wrap; }
            HorizontalLayout {
                x: 8px; y: parent.height - 40px; width: parent.width - 16px; height: 32px; spacing: 4px;
                IconButton { glyph: Glyph.plus; side: 32px; label: "引用到输入框"; clicked => { root.reuse-preview(); } }
                Rectangle { horizontal-stretch: 1; }
                if !root.reference.node: IconButton { glyph: Glyph.brush; side: 32px; label: "放入画布"; clicked => { root.open-preview("canvas"); } }
                if !root.reference.node: IconButton { glyph: Glyph.film; side: 32px; label: "放入剪辑"; clicked => { root.open-preview("clip"); } }
            }
        }
    }
}

component AssistantText inherits Text {
    font-family: Theme.font;
    font-size: Theme.workbench-font + 1px;
    color: Theme.fg;
    min-width: 0px;
    wrap: word-wrap;
    accessible-role: text;
    accessible-label: self.text;
}

component AssistantMessageRow inherits Rectangle {
    in property <AssistantMessage> message;
    in property <bool> can-edit;
    callback edit();
    callback reuse-reference(string);
    callback open-reference(string, string);
    property <bool> expanded;
    height: content.preferred-height;
    vertical-stretch: 0;
    message-hover := TouchArea {
    content := VerticalLayout {
    spacing: 6px;
    if root.message.references.length > 0: HorizontalLayout {
        spacing: 6px;
        if root.message.role == "你": Rectangle { horizontal-stretch: 1; }
        for reference in root.message.references: AssistantReferenceTile {
            reference: reference; reuse => { root.reuse-reference(reference.key); }
            open(destination) => { root.open-reference(reference.key,destination); }
        }
        if root.message.role != "你": Rectangle { horizontal-stretch: 1; }
    }
    if root.message.role == "你" && root.message.text != "": HorizontalLayout {
        Rectangle { min-width: 20px; horizontal-stretch: 1; }
        Rectangle {
            width: min(parent.width - 20px, max(80px, user-text.preferred-width + 24px));
            height: user-text.preferred-height + 20px;
            border-radius: 18px; background: Theme.dark ? #272729 : #eceef2;
            user-text := AssistantText { x: 12px; y: 10px; width: max(0px, parent.width - 24px); text: root.message.text; }
        }
    }
    if root.message.role != "你": VerticalLayout {
        spacing: 6px;
        if root.message.progress != "": Rectangle {
            height: 26px;
            accessible-role: button; accessible-label: root.expanded ? "收起执行过程" : "展开执行过程";
            accessible-action-default => { root.expanded = !root.expanded; }
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout { alignment: center; Icon { size: 16px; glyph: Glyph.workflow; tint: Theme.fg-muted; } }
                AssistantText { text: root.message.state == "已完成" ? "已完成的操作" : "执行过程"; font-size: Theme.fs; color: Theme.fg-muted; wrap: no-wrap; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                VerticalLayout { alignment: center; Icon { size: 12px; glyph: root.expanded ? Glyph.chevron-down : Glyph.chevron-right; tint: Theme.fg-muted; } }
            }
            progress-focus := FocusScope { key-pressed(event) => { if event.text == " " || event.text == "\n" { if !event.repeat { root.expanded = !root.expanded; } return EventResult.accept; } return EventResult.reject; } }
            TouchArea { mouse-cursor: pointer; clicked => { progress-focus.focus(); root.expanded = !root.expanded; } }
        }
        if root.expanded: Rectangle {
            height: progress-text.preferred-height;
            progress-text := AssistantText { x: 24px; width: max(0px, parent.width - 24px); text: root.message.progress; font-size: Theme.fs; color: Theme.fg-muted; }
        }
        if root.message.text != "": AssistantText { text: root.message.text; }
        if root.message.state != "" && root.message.state != "已完成" && root.message.state != "操作结果待核实": AssistantText { text: root.message.state; font-size: Theme.fs; color: Theme.fg-muted; }
    }
    if root.message.text != "" || (root.message.role == "你" && root.message.references.length > 0): Rectangle {
        height: 24px;
        HorizontalLayout {
            spacing: 2px;
            opacity: message-hover.has-hover || copy-action.keyboard-navigation-focus || edit-action.keyboard-navigation-focus ? 1 : 0;
            if root.message.role == "你": Rectangle { horizontal-stretch: 1; }
            copy-action := IconButton { visible: root.message.text != ""; side: 24px; height: 24px; icon-size: 14px; glyph: Glyph.copy; label: "复制消息"; clicked => { clipboard.select-all(); clipboard.copy(); } }
            edit-action := IconButton { visible: root.message.role == "你"; side: 24px; height: 24px; icon-size: 14px; glyph: Glyph.edit; label: "编辑并重新发送"; enabled: root.can-edit; clicked => { root.edit(); } }
            if root.message.role != "你": Rectangle { horizontal-stretch: 1; }
        }
        clipboard := TextInput { width: 1px; height: 1px; opacity: 0; text: root.message.text; read-only: true; accessible-role: none; }
    }
    }
    }
}

// CloudField's 128px minimum and text-only key-event cannot satisfy the
// compact composer. Reuse its native TextInput/Flickable technique instead.
component AssistantInput inherits Rectangle {
    in-out property <string> value;
    in property <string> label;
    in property <string> placeholder;
    in property <bool> multiline;
    in property <bool> external-toolbar;
    in property <length> attachment-height;
    in property <bool> password;
    in property <bool> enabled: true;
    in property <bool> send-enabled;
    in property <bool> busy;
    in property <bool> can-stop;
    in property <bool> can-reconcile;
    in property <string> budget-label;
    callback submit();
    callback stop();
    callback attach();
    property <bool> action-ready: root.busy ? root.can-stop : root.send-enabled;
    function activate-action() { if root.action-ready { if root.busy { root.stop(); } else { root.submit(); } } }
    public function take-focus() { input.focus(); }
    forward-focus: input;
    min-width: 0px;
    min-height: root.multiline ? 112px + root.attachment-height : 40px;
    max-height: root.multiline ? 176px + root.attachment-height : 40px;
    preferred-height: root.multiline ? min(176px, max(112px, input.preferred-height + 72px)) + root.attachment-height : 40px;
    vertical-stretch: 0;
    border-radius: root.multiline ? 22px : 8px;
    background: root.multiline ? (Theme.dark ? #2c2c2e : #f0f1f4) : Theme.field;
    border-width: 1px;
    border-color: root.multiline ? (input.has-focus ? Theme.line-strong : Theme.line) : (input.has-focus ? Theme.focus-control : Theme.workbench-control-border);
    clip: true;
    TouchArea { enabled: root.enabled; mouse-cursor: text; clicked => { input.focus(); } }
    area := Flickable {
        x: 14px; y: 14px + root.attachment-height;
        width: max(0px, parent.width - 28px);
        height: max(0px, parent.height - root.attachment-height - (root.multiline ? 64px : 28px));
        viewport-width: root.multiline ? self.width : max(self.width, input.preferred-width);
        viewport-height: max(self.height, input.preferred-height);
        input := TextInput {
            width: parent.width;
            height: max(parent.height, self.preferred-height);
            page-height: area.height;
            text <=> root.value;
            enabled: root.enabled;
            single-line: !root.multiline;
            wrap: root.multiline ? word-wrap : no-wrap;
            input-type: root.password ? InputType.password : InputType.text;
            font-family: Theme.font;
            font-size: Theme.workbench-font;
            color: root.enabled ? Theme.fg : Theme.fg-muted;
            selection-background-color: Theme.accent-soft;
            selection-foreground-color: Theme.workbench-selection-ink;
            accessible-role: text-input;
            accessible-label: root.label;
            accessible-value: root.password ? (root.value == "" ? "" : "已填写") : self.text;
            accessible-enabled: root.enabled;
            accessible-placeholder-text: root.placeholder;
            key-pressed(event) => {
                // TextInput has no composition-state property. Ordinary Enter
                // remains native text editing; only the explicit chord sends.
                if root.multiline && event.text == "\n" && (event.modifiers.control || event.modifiers.meta) {
                    if root.enabled && root.send-enabled { root.submit(); }
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
            cursor-position-changed(position) => {
                if position.x + area.viewport-x < 0px {
                    area.viewport-x = min(0px, max(area.width - self.width, -position.x));
                } else if position.x + area.viewport-x > area.width {
                    area.viewport-x = min(0px, max(area.width - self.width, area.width - position.x));
                }
                if position.y + area.viewport-y < 0px {
                    area.viewport-y = min(0px, max(area.height - self.height, -position.y));
                } else if position.y + area.viewport-y > area.height - 20px {
                    area.viewport-y = min(0px, max(area.height - self.height, area.height - position.y - 20px));
                }
            }
        }
    }
    if root.value == "": AssistantText {
        x: 14px; y: 14px + root.attachment-height; width: max(0px, parent.width - 28px);
        text: root.placeholder; color: Theme.fg-muted;
        accessible-role: none;
    }
    if root.multiline: Rectangle {
        x: parent.width - 44px; y: parent.height - 44px;
        width: 36px; height: 36px; border-radius: 18px;
        background: !root.action-ready ? Theme.field-active : action-touch.pressed ? Theme.workbench-action-pressed : action-touch.has-hover ? Theme.accent-hover : Theme.accent;
        property <bool> action-ring;
        border-width: 0px;
        FocusRing { active: parent.action-ring; button: true; marker-color: Theme.on-accent; }
        accessible-role: button;
        accessible-label: root.busy ? "停止" : "发送";
        accessible-enabled: root.action-ready;
        accessible-action-default => { root.activate-action(); }
        forward-focus: action-focus;
        action-focus := FocusScope {
            enabled: root.action-ready;
            focus-gained(reason) => { parent.action-ring = reason == FocusReason.tab-navigation; }
            focus-lost => { parent.action-ring = false; }
            key-pressed(event) => {
                if event.text == " " || event.text == "\n" { if !event.repeat { root.activate-action(); } return EventResult.accept; }
                return EventResult.reject;
            }
        }
        if root.busy: Rectangle {
            x: 13px; y: 13px; width: 10px; height: 10px; border-radius: 2px;
            background: root.action-ready ? Theme.on-accent : Theme.fg-dim;
        }
        if !root.busy: Path {
            x: 8px; y: 8px; width: 20px; height: 20px;
            viewbox-width: 20; viewbox-height: 20;
            commands: "M 10 16 L 10 4 M 4 10 L 10 4 L 16 10";
            stroke: root.action-ready ? Theme.on-accent : Theme.fg-dim;
            stroke-width: 1.8px; stroke-line-cap: round; stroke-line-join: round;
        }
        action-touch := TouchArea {
            enabled: root.action-ready; mouse-cursor: pointer;
            clicked => { root.activate-action(); }
        }
    }
    if root.multiline && !root.external-toolbar: IconButton { x: 8px; y: parent.height - 42px; height: 32px; side: 32px; glyph: Glyph.plus; label: "引用全局资产"; enabled: root.enabled && !root.busy; clicked => { root.attach(); } }
    @children
}

component AssistantPathRow inherits VerticalLayout {
    in property <string> label;
    in property <string> filename;
    in property <bool> enabled: true;
    callback choose();
    spacing: 4px;
    AssistantText { text: root.label; color: Theme.fg-muted; }
    HorizontalLayout {
        spacing: 8px;
        AssistantText { text: root.filename == "" ? "尚未选择" : root.filename; vertical-alignment: center; horizontal-stretch: 1; }
        AppButton { label: "选择"; accessible-name: "选择" + root.label; height: 36px; enabled: root.enabled; clicked => { root.choose(); } }
    }
}

component AssistantSessionPicker inherits IconButton {
    in property <[string]> names;
    in property <int> current;
    in property <length> list-width: 280px;
    callback selected(int);
    side: 36px;
    icon-size: 20px;
    glyph: Glyph.rows;
    label: "切换会话";
    checked: list.is-open;
    property <int> active-row;
    property <length> content-height: root.names.length * 36px + 8px;
    property <length> list-height: min(224px, root.content-height);
    property <length> scroll;
    property <length> offset: clamp(root.scroll, 0px, max(0px, root.content-height - root.list-height));
    changed enabled => { if !root.enabled { list.close(); } }
    function reveal-row(index: int) {
        if index * 36px < root.offset { root.scroll = index * 36px; }
        else if (index + 1) * 36px + 8px > root.offset + root.list-height {
            root.scroll = (index + 1) * 36px + 8px - root.list-height;
        }
    }
    function select(index: int) {
        if !root.enabled || index < 0 || index >= root.names.length { return; }
        list.close();
        root.take-focus();
        // The host owns selection and all message/task state.
        root.selected(index);
    }
    clicked => {
        if list.is-open { list.close(); return; }
        if root.names.length == 0 { return; }
        root.active-row = clamp(root.current, 0, root.names.length - 1);
        root.scroll = 0px;
        root.reveal-row(root.active-row);
        list.show();
    }
    list := PopupWindow {
        x: root.width - root.list-width;
        y: root.height + 4px;
        width: root.list-width;
        height: root.list-height;
        close-policy: close-on-click-outside;
        init => { keys.focus(); }
        Rectangle {
            background: Theme.raised;
            border-width: 1px; border-color: Theme.line-strong;
            border-radius: Theme.r;
            clip: true;
            keys := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.DownArrow || event.text == Key.UpArrow {
                        root.active-row = clamp(root.active-row + (event.text == Key.DownArrow ? 1 : -1), 0, root.names.length - 1);
                        root.reveal-row(root.active-row);
                        return EventResult.accept;
                    }
                    if event.text == Key.Home || event.text == Key.End {
                        root.active-row = event.text == Key.Home ? 0 : root.names.length - 1;
                        root.reveal-row(root.active-row);
                        return EventResult.accept;
                    }
                    if event.text == "\n" || event.text == " " {
                        if !event.repeat { root.select(root.active-row); }
                        return EventResult.accept;
                    }
                    if event.text == Key.Escape {
                        list.close(); root.take-focus();
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
            }
            TouchArea {
                scroll-event(event) => { root.scroll = root.offset - event.delta-y; return EventResult.accept; }
                VerticalLayout {
                    y: -root.offset;
                    height: root.content-height;
                    padding: 4px;
                    alignment: start;
                    for name[index] in root.names: Rectangle {
                        height: 36px;
                        border-radius: Theme.r-sm;
                        background: index == root.current ? Theme.accent-soft
                            : row-touch.pressed ? Theme.field-active
                            : index == root.active-row ? Theme.field-hover : transparent;
                        accessible-role: button;
                        accessible-label: name;
                        accessible-enabled: root.enabled;
                        accessible-checkable: true;
                        accessible-checked: index == root.current;
                        accessible-action-default => { root.select(index); }
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 10px; spacing: 8px;
                            Text {
                                min-width: 0px; horizontal-stretch: 1;
                                text: name; font-family: Theme.font; font-size: Theme.workbench-font;
                                color: index == root.current ? Theme.accent : Theme.fg;
                                vertical-alignment: center; overflow: elide;
                                accessible-role: none;
                            }
                            if index == root.current: VerticalLayout {
                                alignment: center;
                                Icon { glyph: Glyph.check; size: 14px; tint: Theme.accent; }
                            }
                        }
                        row-touch := TouchArea {
                            enabled: root.enabled; mouse-cursor: pointer;
                            changed has-hover => { if self.has-hover { root.active-row = index; } }
                            clicked => { root.select(index); }
                        }
                    }
                }
            }
            ThinScrollbar {
                x: parent.width - self.width - 1px; y: 1px;
                height: parent.height - 2px;
                viewport: root.list-height; content: root.content-height; offset: root.offset;
                scrolled(to) => { root.scroll = to; }
            }
        }
    }
}

export component AssistantPanel inherits Rectangle {
    // Only the isolated development build enables local provider configuration.
    in property <bool> developer-tools;
    in property <bool> signed-in;
    callback sign-in();
    in property <bool> floating;
    in property <bool> active: true;
    // These are facts supplied by the host, never inferred from model output.
    in property <string> current-project;
    in property <string> provider-label;
    in property <[string]> session-names;
    in property <string> current-session-id;
    in property <int> session-index;
    in property <bool> can-create-session;
    in property <bool> history-ready;
    in property <[string]> model-names;
    in property <int> model-index;
    in property <bool> can-select-model;
    in property <[string]> effort-names;
    in property <int> effort-index: -1;
    in property <bool> effort-visible;
    in property <string> effort-label;
    in property <string> effort-reason;
    in property <bool> can-select-effort;
    in property <string> connection;
    in property <string> status;
    in property <string> details;
    in property <bool> busy;
    in property <bool> unknown;
    in property <bool> can-send;
    in property <bool> can-stop;
    in property <bool> can-reconcile;
    in property <string> budget-label;
    in property <bool> can-connect;
    in property <string> reconcile-label: "核实原请求";
    in property <bool> connected;
    in property <bool> can-disconnect;
    in property <string> connect-label: "连接";
    in property <bool> connecting;
    in property <string> send-disabled-reason;
    in property <string> connect-disabled-reason;
    in property <[AssistantMessage]> messages;
    in property <[AssistantReference]> draft-references;
    in property <int> scroll-token;

    in property <bool> read-granted;
    in property <bool> write-granted;
    in property <bool> can-grant-read;
    in property <bool> can-revoke-read;
    in property <bool> can-grant-write;
    in property <bool> can-revoke-write;
    in property <string> read-permission-status;
    in property <string> write-permission-status;
    in property <bool> approval-visible;
    in property <string> approval-title;
    in property <string> approval-description;
    in property <string> approval-details;
    in property <int> approval-revision;
    property <bool> approval-expanded: false;
    changed approval-revision => { root.approval-expanded = false; }
    in property <bool> can-allow;
    in property <bool> can-reject;

    in property <string> initial-service-url;
    in property <string> initial-model;
    in property <bool> initial-images;
    // Host provides display basenames after picking and validating the files.
    in property <string> runtime-filename;
    in property <string> entrypoint-filename;
    in property <string> mcp-client-filename;
    in property <bool> can-select-files: true;
    in property <bool> reduced-motion;
    in-out property <bool> settings-open;
    in-out property <string> draft;

    callback close-requested();
    callback send(text: string);
    callback stop();
    callback connect(service-url: string, model-name: string, api-key: string, images: bool);
    callback disconnect();
    callback connect-managed();
    callback new-session();
    callback rename-session(string, string);
    callback edit-message(string, int);
    callback attach();
    callback remove-reference(string);
    callback reuse-reference(string);
    callback open-reference(string, string);
    callback select-session(int);
    callback select-model(int);
    callback select-effort(int);
    callback refresh-models();
    callback reconcile();
    callback grant-read();
    callback revoke-read();
    callback grant-write();
    callback revoke-write();
    callback allow();
    callback reject();
    callback choose-runtime();
    callback choose-entrypoint();
    callback choose-mcp-client();

    // Configuration drafts are local: host refreshes do not interrupt editing.
    property <string> service-url;
    // Popup descendants hold weak parent links. Dispatch from the persistent
    // panel so closing the popup cannot discard the action's receiver.
    function choose-attachment() {
        attachments.close();
        root.attach();
    }
    function choose-permission(action: int) {
        permissions.close();
        if action == 0 { root.sign-in(); }
        else if action == 1 { root.grant-read(); }
        else if action == 2 { root.grant-write(); }
        else if action == 4 { if root.connected { root.disconnect(); } else { root.connect-managed(); } }
        else if action == 5 { root.refresh-models(); }
    }
    property <string> model-name;
    property <string> session-api-key;
    property <bool> images;
    property <bool> advanced-open;
    property <bool> follow-tail: true;
    property <length> conversation-y;
    changed active => {
        if !root.active {
            scroll-settled.stop();
            if !root.settings-open { root.conversation-y = body.viewport-y; }
        }
    }
    // Flickable reports wheel input before its 180ms movement completes.
    // Stop following immediately, then inspect the settled reading position.
    scroll-settled := Timer {
        running: false;
        interval: 220ms;
        triggered => {
            self.stop();
            if root.active && !root.settings-open {
                root.follow-tail = body.viewport-height + body.viewport-y - body.visible-height <= 32px;
                root.conversation-y = body.viewport-y;
                if root.follow-tail { body.viewport-y = min(0px, body.visible-height - body.viewport-height); }
            }
        }
    }
    changed scroll-token => {
        scroll-settled.stop();
        root.follow-tail = true;
        if !root.settings-open { body.viewport-y = min(0px, body.visible-height - body.viewport-height); }
    }
    changed settings-open => {
        scroll-settled.stop();
        if root.settings-open { root.conversation-y = body.viewport-y; body.viewport-y = 0px; }
        else {
            body.viewport-y = root.follow-tail ? min(0px, body.visible-height - body.viewport-height) : root.conversation-y;
            composer-refocus.start(); composer-refocus.restart();
        }
    }
    composer-refocus := Timer {
        running: false; interval: 1ms;
        triggered => { self.stop(); if root.active { root.focus-composer(); } }
    }
    property <bool> send-ready: root.active && !root.settings-open && root.can-send && !root.busy && !root.unknown && (root.draft != "" || root.draft-references.length > 0);
    property <bool> connect-ready: root.active && root.can-connect && !root.connecting && !root.busy
        && root.service-url != "" && root.model-name != "" && root.session-api-key != "";
    init => {
        root.service-url = root.initial-service-url;
        root.model-name = root.initial-model;
        root.images = root.initial-images;
    }
    // Call explicitly after asynchronous config load, never on a status tick.
    public function load-configuration(url: string, model: string, supports-images: bool) {
        root.service-url = url;
        root.model-name = model;
        root.images = supports-images;
    }
    public function clear-session-secret() { root.session-api-key = ""; }
    public function focus-composer() {
        if !root.active { return; }
        if !root.settings-open && !root.unknown && (root.developer-tools || root.connected) { composer.take-focus(); }
        else { close-button.take-focus(); }
    }
    function submit() { if root.send-ready { root.send(root.draft); } }
    in property <bool> header-hover;
    function rename-current-session() {
        if !root.active || !root.history-ready { return; }
        root.rename-target = root.current-session-id;
        root.rename-title = root.session-index >= 0 && root.session-index < root.session-names.length ? root.session-names[root.session-index] : "Agent";
        rename-popup.show();
    }
    property <string> rename-title;
    property <string> rename-target;
    rename-popup := PopupWindow {
        close-policy: close-on-click-outside;
        init => { rename-input.focus(); }
        x: 12px; y: 42px; width: max(220px, root.width - 24px); height: 52px;
        Rectangle {
            background: Theme.panel; border-color: Theme.line-strong; border-width: 1px; border-radius: 10px;
            HorizontalLayout {
                padding: 8px; spacing: 6px;
                rename-input := TextInput {
                    text <=> root.rename-title; single-line: true; font-family: Theme.font; font-size: Theme.workbench-font;
                    color: Theme.fg; horizontal-stretch: 1; vertical-alignment: center;
                    accessible-label: "会话名称";
                    accepted => { root.rename-session(root.rename-target, root.rename-title); rename-popup.close(); }
                }
                IconButton { side: 32px; glyph: Glyph.check; label: "保存会话名称"; clicked => { root.rename-session(root.rename-target, root.rename-title); rename-popup.close(); } }
            }
        }
    }

    preferred-width: 344px;
    min-width: 300px;
    max-width: 480px;
    min-height: 0px;
    background: root.floating ? (Theme.dark ? #1b1b1d : #fafafb) : Theme.panel;
    border-radius: root.floating ? 20px : 0px;
    border-width: root.floating ? 1px : 0px;
    border-color: Theme.line;
    drop-shadow-blur: root.floating ? 20px : 0px;
    drop-shadow-offset-y: root.floating ? 6px : 0px;
    drop-shadow-color: Theme.image-control;
    clip: true;
    accessible-role: groupbox;
    accessible-label: "Agent";
    if !root.floating: Rectangle { x: 0px; width: 1px; height: 100%; background: Theme.line; }
    VerticalLayout {
        spacing: 0px;
        HorizontalLayout {
            height: root.floating ? 48px : 40px;
            padding-left: 12px; padding-right: 4px;
            spacing: 4px;
            AssistantText {
                text: root.session-index >= 0 && root.session-index < root.session-names.length ? root.session-names[root.session-index] : "Agent";
                font-weight: Theme.weight-title; vertical-alignment: center; horizontal-stretch: 1;
                wrap: no-wrap; overflow: elide;
                title-hover := TouchArea {
                    enabled: root.history-ready; mouse-cursor: pointer;
                    clicked => { root.rename-current-session(); }
                }
            }
            IconButton {
                enabled: root.active && root.history-ready;
                side: 36px; icon-size: 16px; glyph: Glyph.edit; label: "重命名会话";
                opacity: root.header-hover || title-hover.has-hover || self.lit || self.keyboard-navigation-focus ? 1 : 0;
                clicked => { root.rename-current-session(); }
            }
            IconButton {
                enabled: root.active && root.can-create-session;
                side: 36px; icon-size: 20px; glyph: Glyph.plus; label: "新建会话";
                clicked => { root.new-session(); }
            }
            AssistantSessionPicker {
                enabled: root.active && root.session-names.length > 0;
                names: root.session-names; current: root.session-index;
                list-width: min(280px, max(120px, root.width - 100px));
                selected(index) => { root.select-session(index); }
            }
            if root.developer-tools: IconButton {
                enabled: root.active;
                side: 36px; icon-size: 20px; glyph: root.settings-open ? Glyph.chevron-left : Glyph.sliders;
                label: root.settings-open ? "返回对话" : "开发验收配置";
                clicked => { root.settings-open = !root.settings-open; }
            }
            close-button := IconButton {
                enabled: root.active;
                side: 36px; icon-size: 20px; glyph: Glyph.close; label: "关闭 Agent";
                clicked => { root.clear-session-secret(); root.close-requested(); }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }
        body := ScrollView {
            min-height: 0px;
            vertical-stretch: 1;
            viewport-width: self.width;
            horizontal-scrollbar-policy: always-off;
            scrolled => {
                if !root.settings-open {
                    root.follow-tail = false;
                    scroll-settled.start(); scroll-settled.restart();
                }
            }
            changed viewport-height => {
                if !root.settings-open && root.follow-tail {
                    self.viewport-y = min(0px, self.visible-height - self.viewport-height);
                }
            }
            changed visible-height => {
                if !root.settings-open && root.follow-tail {
                    self.viewport-y = min(0px, self.visible-height - self.viewport-height);
                }
            }
            VerticalLayout {
                width: body.visible-width;
                padding: 18px;
                spacing: 20px;
                alignment: start;
                if !root.settings-open: VerticalLayout {
                    spacing: 24px;
                    for message[index] in root.messages: AssistantMessageRow {
                        message: message; can-edit: root.active && root.history-ready && !root.busy && !root.unknown;
                        edit => { root.edit-message(root.current-session-id, index); composer.take-focus(); }
                        reuse-reference(key) => { root.reuse-reference(key); }
                        open-reference(key, destination) => { root.open-reference(key,destination); }
                    }
                    if !root.busy && !root.unknown && root.status != "" && root.status != "可以发送问题" && root.status != "已完成" && root.status != "已提交，待验证" && root.status != "处理失败" && root.status != "已停止": AssistantText {
                        text: root.status; font-size: 12px; color: Theme.fg-muted;
                    }
                }
                // Keep host approval and UNKNOWN visible when viewing permissions.
                if root.unknown: AssistantText { text: root.status == "" ? "操作结果待核实，会话已暂停" : root.status; font-size: Theme.fs; color: Theme.fg-muted; }
                if root.can-reconcile: HorizontalLayout {
                    IconButton { glyph: Glyph.search; label: root.reconcile-label; side: 32px; enabled: root.active && root.can-reconcile; clicked => { root.reconcile(); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.approval-visible: VerticalLayout {
                    spacing: 8px;
                    AssistantText { text: root.approval-title; font-size: Theme.fs; }
                    summary-scroll := ScrollView {
                        height: min(96px, max(24px, summary-text.preferred-height));
                        viewport-width: self.width; horizontal-scrollbar-policy: always-off;
                        summary-text := AssistantText { width: summary-scroll.visible-width; text: root.approval-description; font-size: 12px; color: Theme.fg-muted; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        AppButton { label: "取消"; height: 32px; enabled: root.active && root.can-reject; clicked => { root.reject(); } }
                        AppButton { label: "确认"; height: 32px; enabled: root.active && root.can-allow && !root.unknown; clicked => { root.allow(); } }
                    }
                    if root.approval-details != "": AgentMenuAction {
                        text: root.approval-expanded ? "收起参数详情" : "查看参数详情";
                        glyph: root.approval-expanded ? Glyph.chevron-down : Glyph.chevron-right;
                        clicked => { root.approval-expanded = !root.approval-expanded; }
                    }
                    if root.approval-expanded && root.approval-details != "": detail-scroll := ScrollView {
                        height: min(160px, max(32px, detail-text.preferred-height));
                        viewport-width: self.width; horizontal-scrollbar-policy: always-off;
                        detail-text := AssistantText { width: detail-scroll.visible-width; text: root.approval-details; font-size: 12px; color: Theme.fg-muted; }
                    }
                    AssistantText { text: "确认等待计入本轮 120 秒时限。页面操作授权在当前会话有效；切回允许读取会撤销旧确认。"; font-size: 11px; color: Theme.fg-dim; }
                }
                if root.settings-open: VerticalLayout {
                    spacing: 12px;
                    if !root.developer-tools: VerticalLayout {
                        spacing: 8px;
                        AssistantText { text: root.connection; color: Theme.fg-muted; }
                        if !root.connected && root.connect-disabled-reason != "": AssistantText { text: root.connect-disabled-reason; color: Theme.fg-muted; }
                        AppButton {
                            label: root.connect-label;
                            enabled: root.active && (root.connected ? root.can-disconnect : root.can-connect) && !root.connecting;
                            clicked => { if root.connected { root.disconnect(); } else { root.connect-managed(); } }
                        }
                    }
                    if root.developer-tools: VerticalLayout {
                        spacing: 12px;
                        AssistantText { text: "发送后，当前问题和已允许的画布内容会交给此服务。"; color: Theme.fg-muted; }
                        VerticalLayout {
                            spacing: 4px;
                            AssistantText { text: "服务地址"; color: Theme.fg-muted; }
                            AssistantInput { value <=> root.service-url; label: "服务地址"; placeholder: "兼容 OpenAI 的接口地址"; enabled: root.active && (!root.connected && !root.connecting && !root.busy); }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            AssistantText { text: "模型"; color: Theme.fg-muted; }
                            AssistantInput { value <=> root.model-name; label: "模型"; placeholder: "输入模型名称"; enabled: root.active && (!root.connected && !root.connecting && !root.busy); }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            AssistantText { text: "API 密钥"; color: Theme.fg-muted; }
                            AssistantInput { value <=> root.session-api-key; label: "API 密钥"; placeholder: "仅用于本次会话"; password: true; enabled: root.active && (!root.connected && !root.connecting && !root.busy); }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            AssistantText { text: "图片支持"; vertical-alignment: center; horizontal-stretch: 1; }
                            Rectangle {
                                width: 48px; height: 36px;
                                Switch { x: 4px; y: 6px; width: 40px; height: 24px; checked <=> root.images; enabled: root.active && (!root.connected && !root.connecting && !root.busy); reduced-motion: root.reduced-motion; accessible-label: "服务支持图片"; }
                            }
                        }
                        AssistantText { text: "连接只初始化 Agent，不发送问题。"; color: Theme.fg-muted; }
                        if !root.connected && !root.connect-ready: AssistantText {
                            text: root.connecting ? "正在连接…" : root.service-url == "" ? "请填写服务地址" : root.model-name == "" ? "请填写模型名称" : root.session-api-key == "" ? "请填写本次会话的 API 密钥" : root.connect-disabled-reason == "" ? "当前无法连接" : root.connect-disabled-reason;
                            color: Theme.fg-muted;
                        }
                        AppButton {
                            label: root.connect-label;
                            primary: !root.connected;
                            enabled: root.active && (root.connected ? root.can-disconnect && !root.connecting : root.connect-ready);
                            horizontal-stretch: 1; elide-label: true;
                            clicked => {
                                if root.connected { root.disconnect(); }
                                else if root.connect-ready { root.connect(root.service-url, root.model-name, root.session-api-key, root.images); }
                            }
                        }
                        // Asynchronous connection feedback must not move the inputs
                        // or the connection button while the user is targeting them.
                        if root.connection != "": AssistantText { text: root.connection; color: Theme.fg-muted; }
                        if root.status != "": AssistantText { text: root.status; color: root.unknown ? Theme.danger : Theme.fg; }
                        if root.unknown && root.status == "": AssistantText { text: "操作结果待核实"; color: Theme.danger; }
                        Rectangle { height: 1px; background: Theme.line; }
                        AppButton { enabled: root.active; label: root.advanced-open ? "收起本地 Agent 组件" : "本地 Agent 组件"; subtle: true; height: 36px; clicked => { root.advanced-open = !root.advanced-open; } }
                        if root.advanced-open: VerticalLayout {
                            spacing: 12px;
                            AssistantPathRow { label: "运行环境"; filename: root.runtime-filename; enabled: root.active && (root.can-select-files); choose => { root.choose-runtime(); } }
                            AssistantPathRow { label: "Agent 入口"; filename: root.entrypoint-filename; enabled: root.active && (root.can-select-files); choose => { root.choose-entrypoint(); } }
                            AssistantPathRow { label: "MCP 客户端"; filename: root.mcp-client-filename; enabled: root.active && (root.can-select-files); choose => { root.choose-mcp-client(); } }
                        }
                    }
                }
            }
        }
        // Keep the native input alive across settings to preserve its draft,
        // composition/selection and scroll state. Settings only hides it.
        Rectangle {
            visible: !root.settings-open;
            height: root.settings-open ? 0px : composer-layout.preferred-height;
            vertical-stretch: 0;
            clip: true;
            composer-layout := VerticalLayout {
            height: self.preferred-height;
            padding: 12px;
            spacing: 8px;
            if !root.follow-tail: HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
                IconButton { side: 28px; glyph: Glyph.chevron-down; label: "回到最新消息"; clicked => { scroll-settled.stop(); root.follow-tail = true; body.viewport-y = min(0px, body.visible-height - body.viewport-height); } }
                Rectangle { horizontal-stretch: 1; }
            }
            if !root.can-send && !root.busy && !root.unknown && root.send-disabled-reason != "": AssistantText {
                text: !root.signed-in ? "登录后与 Agent 协作" : root.send-disabled-reason; font-size: Theme.fs; color: Theme.fg-muted;
            }
            composer := AssistantInput {
                value <=> root.draft;
                label: "给 Agent 的问题"; placeholder: "与 Agent 协作…";
                multiline: true; external-toolbar: true;
                attachment-height: root.draft-references.length > 0 ? 76px : 0px;
                // Connection and turn state gate sending, while drafts remain editable.
                enabled: root.active && root.history-ready && !root.settings-open && !root.unknown;
                send-enabled: root.active && (root.send-ready);
                busy: root.busy; can-stop: root.active && !root.settings-open && root.can-stop;
                submit => { root.submit(); }
                stop => { root.stop(); }
                attach => { root.attach(); }
                if root.draft-references.length > 0: HorizontalLayout {
                    x: 12px; y: 12px; height: 64px; width: parent.width - 24px; spacing: 6px;
                    for reference in root.draft-references: AssistantReferenceTile {
                        reference: reference; removable: true; remove => { root.remove-reference(reference.key); }
                        reuse => { root.reuse-reference(reference.key); }
                        open(destination) => { root.open-reference(reference.key,destination); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    x: 8px; y: parent.height - 44px; height: 36px; width: parent.width - 64px; spacing: 2px;
                    IconButton {
                        side: 30px; height: 36px; icon-size: 19px; glyph: Glyph.plus; label: "添加引用";
                        enabled: root.active && root.history-ready && !root.busy && !root.unknown;
                        clicked => { attachments.show(); }
                        attachments := PopupWindow {
                            close-policy: close-on-click-outside;
                            x: 0px; y: -92px; width: 200px; height: 84px;
                            Rectangle {
                                background: Theme.panel; border-radius: 12px; border-width: 1px; border-color: Theme.line;
                                VerticalLayout {
                                    padding: 6px; spacing: 4px;
                                    AgentMenuAction { text: "资产库素材"; glyph: Glyph.folder; clicked => { root.choose-attachment(); } }
                                }
                            }
                        }
                    }
                    IconButton {
                        side: 28px; height: 36px; icon-size: 16px;
                        glyph: root.write-granted ? Glyph.unlock : Glyph.lock;
                        label: "当前页面权限"; checked: root.read-granted; enabled: root.active;
                        clicked => { permissions.show(); }
                        permissions := PopupWindow {
                            close-policy: close-on-click-outside;
                            x: 0px; y: -self.height - 8px; width: 258px; height: root.signed-in ? 170px : 52px;
                            Rectangle {
                                background: Theme.panel; border-radius: 12px; border-width: 1px; border-color: Theme.line;
                                VerticalLayout {
                                    padding: 8px; spacing: 4px; alignment: start;
                                    if !root.signed-in: AgentMenuAction { text: "登录账户"; glyph: Glyph.lock; clicked => { root.choose-permission(0); } }
                                    if root.signed-in: AgentMenuAction { text: "允许读取"; glyph: root.read-granted && !root.write-granted ? Glyph.check : Glyph.eye;
                                        enabled: root.active && root.can-grant-read;
                                        clicked => { root.choose-permission(1); } }
                                    if root.signed-in: AgentMenuAction { text: "允许页面操作"; glyph: root.write-granted ? Glyph.check : Glyph.unlock;
                                        enabled: root.active && root.can-grant-write;
                                        clicked => { root.choose-permission(2); } }
                                    if root.signed-in: Rectangle { height: 1px; background: Theme.line; }
                                    if root.signed-in: AgentMenuAction { text: root.connect-label; glyph: root.connected ? Glyph.close : Glyph.play;
                                        enabled: root.active && (root.connected ? root.can-disconnect : root.can-connect) && !root.connecting;
                                        clicked => { root.choose-permission(4); } }
                                    if root.signed-in: AgentMenuAction { text: "刷新模型"; glyph: Glyph.reset; enabled: root.active && !root.connecting; clicked => { root.choose-permission(5); } }
                                }
                            }
                        }
                    }
                    model-button := Rectangle {
                        horizontal-stretch: 1; min-width: 0px; height: 36px; border-radius: 8px;
                        background: model-touch.has-hover ? Theme.field-hover : transparent;
                        accessible-role: button; accessible-label: root.signed-in ? "选择模型与强度" : "登录账户";
                        accessible-enabled: root.active;
                        accessible-action-default => { if root.active { if root.signed-in { models.show(); } else { root.sign-in(); } } }
                        HorizontalLayout {
                            padding-left: 6px; padding-right: 4px; spacing: 4px;
                            Text { text: !root.signed-in ? "登录账户" : root.provider-label == "" ? "选择模型" : root.provider-label; font-family: Theme.font; font-size: Theme.fs; color: Theme.fg;
                                vertical-alignment: center; overflow: elide; min-width: 0px; horizontal-stretch: 1; }
                            if root.signed-in && root.effort-label != "": Text { text: root.effort-label; font-family: Theme.font; font-size: Theme.fs; color: Theme.fg-muted; vertical-alignment: center; }
                            VerticalLayout { alignment: center; Icon { glyph: Glyph.chevron-down; size: 12px; tint: Theme.fg-muted; } }
                        }
                        model-focus := FocusScope {
                            enabled: root.active;
                            key-pressed(event) => { if event.text == " " || event.text == "\n" { if !event.repeat { if root.signed-in { models.show(); } else { root.sign-in(); } } return EventResult.accept; } return EventResult.reject; }
                        }
                        forward-focus: model-focus;
                        model-touch := TouchArea { enabled: root.active; mouse-cursor: pointer; clicked => { if root.signed-in { models.show(); } else { root.sign-in(); } } }
                        models := PopupWindow {
                            close-policy: close-on-click-outside;
                            x: min(0px, model-button.width - self.width); y: -self.height - 8px; width: min(300px, root.width - 28px); height: root.effort-visible ? 110px : 60px;
                            Rectangle {
                                background: Theme.panel; border-radius: 12px; border-width: 1px; border-color: Theme.line;
                                VerticalLayout {
                                    padding: 10px; spacing: 8px;
                                    WorkspaceSelect { flat: true; options: root.model-names; current: root.model-index; placeholder: "选择模型";
                                        enabled: root.active && root.can-select-model; changed(index) => { root.select-model(index); } }
                                    if root.effort-visible: EffortSlider {
                                        names: root.effort-names; current: root.effort-index; current-label: root.effort-label; reason: root.effort-reason;
                                        enabled: root.active && root.can-select-effort; can-refresh: root.active && !root.connecting;
                                        selected(index) => { root.select-effort(index); } refresh => { root.refresh-models(); }
                                    }
                                }
                            }
                        }
                    }
                    Text { text: root.budget-label == "" ? "0" : root.budget-label; color: Theme.fg-muted; font-family: Theme.font; font-size: 11px;
                        vertical-alignment: center; horizontal-alignment: right; min-width: 12px; accessible-label: "当前任务实际消耗 " + self.text; }
                }
            }
            }
        }
    }
}
