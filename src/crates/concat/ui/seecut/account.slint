import { ScrollView, CheckBox } from "std-widgets.slint";
import { Theme, SegmentedControl, Glyph, IconButton } from "../primitives/primitives.slint";
import { SeeCut } from "state.slint";
import { AppButton, CloudField, Label, Heading, EmptyState } from "components.slint";

export component AccountPage inherits Rectangle {
    account-scroll := ScrollView {
        viewport-width: self.width;
        horizontal-scrollbar-policy: always-off;
        VerticalLayout {
            width: account-scroll.visible-width;
            padding: 24px;
            spacing: 20px;
            alignment: start;
            if !SeeCut.signed-in || SeeCut.auth-mode >= 2: HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    min-width: 0px;
                    max-width: 380px;
                    preferred-width: 380px;
                    spacing: 16px;
                    Rectangle { height: 16px; }
                    Heading {
                        text: SeeCut.auth-mode == 0 ? "登录 SeeCut" : SeeCut.auth-mode == 1 ? "创建账号" : SeeCut.auth-mode == 2 ? "找回密码" : SeeCut.auth-mode == 3 ? "验证邮箱" : "设置新密码";
                        font-size: 24px;
                    }
                    if SeeCut.auth-mode == 1: Text { text: "使用邮箱创建个人账号"; color: Theme.fg-muted; wrap: word-wrap; }
                    if SeeCut.auth-mode == 2: Text { text: "输入注册邮箱，获取重置密码的验证码"; color: Theme.fg-muted; wrap: word-wrap; }
                    if SeeCut.auth-mode < 3: VerticalLayout {
                        spacing: 6px;
                        Label { text: "邮箱"; }
                        email := CloudField {
                            value <=> SeeCut.auth-email;
                            placeholder: "name@example.com";
                            enabled: !SeeCut.busy && !SeeCut.signed-in;
                            key-event(text) => { if text == "\n" { SeeCut.action("auth-submit", ""); return true; } return false; }
                        }
                    }
                    if SeeCut.auth-mode >= 3: VerticalLayout {
                        spacing: 8px;
                        Text { text: SeeCut.auth-email; color: Theme.fg-muted; wrap: word-wrap; min-width: 0px; }
                        Label { text: "邮件验证码"; }
                        CloudField {
                            value <=> SeeCut.auth-token;
                            placeholder: "输入 6 位验证码";
                            enabled: !SeeCut.busy;
                            key-event(text) => { if text == "\n" { SeeCut.action("auth-submit", ""); return true; } return false; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            AppButton { label: SeeCut.auth-resend-seconds > 0 ? SeeCut.auth-resend-seconds + " 秒后重发" : "重新发送验证码"; subtle: true; enabled: !SeeCut.busy && SeeCut.auth-resend-seconds == 0; clicked => { SeeCut.action("auth-resend", ""); } }
                            Rectangle { horizontal-stretch: 1; }
                            if !SeeCut.signed-in: AppButton { label: "更换邮箱"; subtle: true; enabled: !SeeCut.busy; clicked => { SeeCut.action("auth-switch", SeeCut.auth-mode == 4 ? "2" : "0"); } }
                        }
                    }
                    if SeeCut.auth-mode < 2 || SeeCut.auth-mode == 4: VerticalLayout {
                        spacing: 6px;
                        Label { text: SeeCut.auth-mode == 4 ? "新密码" : "密码"; }
                        CloudField {
                            value <=> SeeCut.auth-password;
                            password: true;
                            placeholder: SeeCut.auth-mode == 0 ? "输入密码" : "设置密码";
                            enabled: !SeeCut.busy;
                            key-event(text) => { if text == "\n" { SeeCut.action("auth-submit", ""); return true; } return false; }
                        }
                        if SeeCut.auth-mode != 0: Text { text: "10–128 个字符"; color: Theme.fg-dim; font-size: Theme.fs-sm; }
                    }
                    if SeeCut.auth-mode == 1 || SeeCut.auth-mode == 4: VerticalLayout {
                        spacing: 6px;
                        Label { text: "确认密码"; }
                        CloudField {
                            value <=> SeeCut.auth-password-confirm;
                            password: true;
                            placeholder: "再次输入密码";
                            enabled: !SeeCut.busy;
                            key-event(text) => { if text == "\n" { SeeCut.action("auth-submit", ""); return true; } return false; }
                        }
                    }
                    if SeeCut.error != "": Text { text: SeeCut.error; color: Theme.danger; wrap: word-wrap; min-width: 0px; }
                    if SeeCut.notice != "": Text { text: SeeCut.notice; color: Theme.fg-muted; wrap: word-wrap; min-width: 0px; }
                    AppButton {
                        label: SeeCut.busy ? "正在处理…" : SeeCut.auth-mode == 0 ? "登录" : SeeCut.auth-mode == 1 ? "创建账号" : SeeCut.auth-mode == 2 ? "发送验证码" : SeeCut.auth-mode == 3 ? "验证邮箱" : "保存新密码";
                        primary: true;
                        height: 40px;
                        horizontal-stretch: 1;
                        enabled: !SeeCut.busy;
                        clicked => { SeeCut.action("auth-submit", ""); }
                    }
                    if SeeCut.auth-mode == 0: HorizontalLayout {
                        spacing: 4px;
                        AppButton { label: "创建账号"; subtle: true; enabled: !SeeCut.busy; clicked => { SeeCut.action("auth-switch", "1"); } }
                        Rectangle { horizontal-stretch: 1; }
                        AppButton { label: "忘记密码"; subtle: true; enabled: !SeeCut.busy; clicked => { SeeCut.action("auth-switch", "2"); } }
                    }
                    if SeeCut.auth-mode == 0: AppButton {
                        label: "继续验证邮箱";
                        subtle: true;
                        enabled: !SeeCut.busy;
                        clicked => { SeeCut.action("auth-verify-start", ""); }
                    }
                    if SeeCut.auth-mode > 0: AppButton {
                        label: SeeCut.signed-in ? "返回账号" : SeeCut.auth-mode == 1 ? "已有账号？登录" : "返回登录";
                        glyph: SeeCut.auth-mode == 1 ? Glyph.none : Glyph.chevron-left;
                        subtle: true;
                        enabled: !SeeCut.busy;
                        clicked => { SeeCut.action("auth-switch", "0"); }
                    }
                }
            }
            if SeeCut.signed-in && SeeCut.auth-mode < 2: VerticalLayout {
                spacing: 12px;
                Heading { text: "个人账号"; }
                Text { text: SeeCut.email; color: Theme.fg; font-size: 16px; overflow: elide; min-width: 0px; }
                HorizontalLayout {
                    spacing: 8px;
                    AppButton { label: "修改密码"; clicked => { SeeCut.action("change-password", ""); } }
                    AppButton { label: "退出登录"; enabled: !SeeCut.busy; clicked => { SeeCut.action("logout", ""); } }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            if SeeCut.signed-in && SeeCut.auth-mode < 2: VerticalLayout {
            spacing: 16px;
            Rectangle { height: 12px; }
            Rectangle { height: 1px; background: Theme.line; }
            Heading { text: "偏好设置"; }
            Label { text: "生成结果保存位置"; }
            HorizontalLayout {
                spacing: 8px;
                Text { text: SeeCut.local-folder == "" ? "尚未选择" : SeeCut.local-folder; color: Theme.fg-muted; overflow: elide; min-width: 0px; vertical-alignment: center; horizontal-stretch: 1; }
                AppButton { label: "选择文件夹"; glyph: Glyph.folder; clicked => { SeeCut.action("local-folder-browse", ""); } }
            }
            CheckBox { text: "减少动态效果"; checked <=> SeeCut.reduced-motion; toggled => { SeeCut.changed("reduced-motion", self.checked ? "true" : "false"); } }
            }
        }
    }
}

export component CreditsPage inherits Rectangle {
    property <int> tab;
    credits-scroll := ScrollView {
        viewport-width: self.width;
        horizontal-scrollbar-policy: always-off;
        VerticalLayout {
            width: credits-scroll.visible-width;
            padding: 24px;
            spacing: 18px;
            alignment: start;
            HorizontalLayout {
                spacing: 36px;
                VerticalLayout {
                    spacing: 8px;
                    Label { text: "可用积分"; }
                    Text { text: SeeCut.balance; color: Theme.fg; font-size: 30px; font-weight: Theme.weight-title; }
                }
                VerticalLayout {
                    spacing: 8px;
                    Label { text: "冻结积分"; }
                    Text { text: SeeCut.frozen; color: Theme.fg-muted; font-size: 30px; }
                }
                Rectangle { horizontal-stretch: 1; }
                IconButton { glyph: Glyph.reset; label: "刷新余额"; enabled: SeeCut.signed-in && !SeeCut.busy; clicked => { SeeCut.action("wallet-refresh", ""); } }
            }
            Rectangle { height: 1px; background: Theme.line; }
            Heading { text: "充值积分"; }
            if !SeeCut.payment-enabled: Label { text: "充值暂未开放"; }
            if SeeCut.payment-enabled && !SeeCut.signed-in: AppButton { label: "登录后充值"; primary: true; clicked => { SeeCut.page = 4; } }
            if SeeCut.payment-enabled && SeeCut.signed-in && SeeCut.plans.length == 0: Label { text: "暂无可用套餐"; }
            for plan in (SeeCut.payment-enabled ? SeeCut.plans : []): Rectangle {
                height: 78px;
                border-radius: Theme.r;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.panel;
                HorizontalLayout {
                    padding: 16px;
                    spacing: 18px;
                    VerticalLayout {
                        spacing: 5px;
                        Text { text: plan.name; color: Theme.fg; font-weight: Theme.weight-title; }
                        Text { text: plan.credits; color: Theme.fg-muted; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: plan.price; color: Theme.fg; vertical-alignment: center; font-size: 18px; }
                    AppButton { label: "购买"; primary: true; enabled: SeeCut.signed-in && !SeeCut.busy; clicked => { SeeCut.action("purchase", plan.id); } }
                }
            }
            Rectangle { height: 8px; }
            SegmentedControl { options: ["积分明细", "充值订单"]; current <=> root.tab; }
            if root.tab == 0 && SeeCut.ledger.length == 0: EmptyState { glyph: Glyph.rows; title: "暂无积分记录"; }
            if root.tab == 1 && SeeCut.orders.length == 0: EmptyState { glyph: Glyph.rows; title: "暂无充值订单"; }
            for entry in (root.tab == 0 ? SeeCut.ledger : SeeCut.orders): Rectangle {
                height: 62px;
                HorizontalLayout {
                    spacing: 16px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text { text: entry.title; color: Theme.fg; overflow: elide; }
                        Text { text: entry.detail; color: Theme.fg-dim; font-size: Theme.fs-sm; overflow: elide; }
                    }
                    Text { text: entry.value; color: Theme.fg-muted; vertical-alignment: center; }
                    if root.tab == 1: IconButton { glyph: Glyph.reset; label: "查询订单状态"; clicked => { SeeCut.action("order-refresh", entry.id); } }
                }
                Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: Theme.line; }
            }
        }
    }
}
