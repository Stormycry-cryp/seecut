import { ScrollView } from "std-widgets.slint";
import { Theme, Select, SegmentedControl, IconButton, Glyph, Icon, Modal } from "../primitives/primitives.slint";
import { CopyChip } from "../primitives/modal.slint";
import { SeeCut } from "state.slint";
import { AppButton, CloudField, Label, Heading, EmptyState } from "components.slint";

export component TeamPage inherits Rectangle {
    property <int> dialog;
    property <string> remove-id;
    property <string> remove-name;
    property <bool> narrow: root.width < 860px;
    property <int> selected-asset: -1;
    VerticalLayout {
        padding: 20px;
        spacing: 14px;
        if !SeeCut.signed-in: VerticalLayout {
            alignment: center;
            spacing: 16px;
            EmptyState { glyph: Glyph.folder; title: "登录后查看团队资产"; }
            HorizontalLayout { alignment: center; AppButton { label: "登录"; primary: true; clicked => { SeeCut.page = 4; } } }
        }
        if SeeCut.signed-in && SeeCut.team-names.length == 0: VerticalLayout {
            alignment: center;
            spacing: 16px;
            EmptyState { glyph: Glyph.folder; title: "尚未加入团队"; }
            HorizontalLayout {
                alignment: center;
                spacing: 10px;
                AppButton { label: "创建团队"; primary: true; glyph: Glyph.plus; clicked => { root.dialog = 1; } }
                AppButton { label: "通过邀请加入"; clicked => { root.dialog = 2; } }
            }
        }
        if SeeCut.signed-in && SeeCut.team-names.length > 0: VerticalLayout {
            spacing: 12px;
            HorizontalLayout {
                spacing: 8px;
                Select { width: root.width < 560px ? 150px : 180px; options: SeeCut.team-names; current: SeeCut.team-index; placeholder: "选择团队"; changed(index) => { SeeCut.team-index = index; root.selected-asset = -1; SeeCut.changed("team", index); } }
                IconButton { glyph: Glyph.plus; label: "创建团队"; clicked => { root.dialog = 1; } }
                IconButton { glyph: Glyph.import; label: "通过邀请加入团队"; clicked => { root.dialog = 2; } }
                Rectangle { horizontal-stretch: 1; }
                if root.width >= 560px: AppButton { label: "成员"; clicked => { root.dialog = 3; SeeCut.action("members-refresh", ""); } }
                if root.width >= 560px: AppButton { label: "上传到团队"; glyph: Glyph.import; primary: true; enabled: SeeCut.team-index >= 0 && !SeeCut.busy; clicked => { root.dialog = 4; } }
            }
            if root.width < 560px: HorizontalLayout {
                spacing: 8px;
                AppButton { label: "成员"; clicked => { root.dialog = 3; SeeCut.action("members-refresh", ""); } }
                AppButton { label: "上传到团队"; glyph: Glyph.import; primary: true; enabled: SeeCut.team-index >= 0 && !SeeCut.busy; clicked => { root.dialog = 4; } }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.width < 560px: CloudField { value <=> SeeCut.asset-search; placeholder: "搜索团队资产"; edited(value) => { SeeCut.changed("asset-search", value); } }
            HorizontalLayout {
                spacing: 8px;
                if root.width >= 560px: CloudField { value <=> SeeCut.asset-search; placeholder: "搜索团队资产"; edited(value) => { SeeCut.changed("asset-search", value); } }
                Select { width: 110px; options: ["全部类型", "图片", "视频", "音频"]; current: SeeCut.asset-filter; changed(index) => { SeeCut.asset-filter = index; SeeCut.changed("asset-filter", index); } }
                if root.width < 560px: Rectangle { horizontal-stretch: 1; }
                IconButton { glyph: Glyph.trash; label: "回收站"; checked: SeeCut.trash-open; clicked => { SeeCut.trash-open = !SeeCut.trash-open; SeeCut.action("assets-refresh", ""); } }
                IconButton { glyph: Glyph.reset; label: "刷新团队资产"; enabled: !SeeCut.busy; clicked => { SeeCut.action("assets-refresh", ""); } }
            }
            if SeeCut.trash-open: Heading { text: "回收站"; }
            if SeeCut.assets.length == 0: EmptyState { glyph: Glyph.folder; title: SeeCut.asset-search != "" ? "没有找到相关资产" : SeeCut.trash-open ? "回收站为空" : "暂无团队资产"; }
            if SeeCut.assets.length > 0: ScrollView {
                viewport-width: self.width;
                horizontal-scrollbar-policy: always-off;
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    spacing: 6px;
                    for asset[index] in SeeCut.assets: Rectangle {
                        height: root.narrow ? 114px : 88px;
                        background: root.selected-asset == index ? Theme.field-active : Theme.panel;
                        border-radius: Theme.r;
                        border-width: 1px;
                        border-color: Theme.line;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 12px;
                                Rectangle {
                                    width: 64px;
                                    height: 52px;
                                    background: Theme.well;
                                    border-radius: Theme.r-sm;
                                    Image { source: asset.preview; image-fit: contain; }
                                    TouchArea { mouse-cursor: pointer; clicked => { root.selected-asset = index; SeeCut.action("asset-preview", asset.id); } }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 5px;
                                    Text { text: asset.name; color: Theme.fg; overflow: elide; }
                                    Text { text: asset.detail; color: Theme.fg-dim; overflow: elide; font-size: Theme.fs-sm; }
                                }
                                if !root.narrow: HorizontalLayout {
                                    spacing: 4px;
                                    if !SeeCut.trash-open: IconButton { glyph: Glyph.export; label: "下载到本机"; clicked => { SeeCut.action("asset-download", asset.id); } }
                                    if !SeeCut.trash-open: IconButton { glyph: Glyph.sparkle; label: "用于生成"; clicked => { SeeCut.action("asset-reference", asset.id); } }
                                    if !SeeCut.trash-open: IconButton { glyph: Glyph.plus; label: "加入当前项目"; enabled: SeeCut.project-open; clicked => { SeeCut.action("asset-import", asset.id); } }
                                    if SeeCut.trash-open && SeeCut.team-owner: IconButton { glyph: Glyph.reset; label: "恢复资产"; clicked => { SeeCut.action("asset-restore", asset.id); } }
                                    if !SeeCut.trash-open && SeeCut.team-owner: IconButton { glyph: Glyph.trash; label: "移入回收站"; danger: true; clicked => { root.remove-id = asset.id; root.remove-name = asset.name; root.dialog = 5; } }
                                }
                            }
                            if root.narrow: HorizontalLayout {
                                spacing: 6px;
                                Rectangle { horizontal-stretch: 1; }
                                if !SeeCut.trash-open: IconButton { glyph: Glyph.export; label: "下载到本机"; clicked => { SeeCut.action("asset-download", asset.id); } }
                                if !SeeCut.trash-open: IconButton { glyph: Glyph.sparkle; label: "用于生成"; clicked => { SeeCut.action("asset-reference", asset.id); } }
                                if !SeeCut.trash-open: IconButton { glyph: Glyph.plus; label: "加入当前项目"; enabled: SeeCut.project-open; clicked => { SeeCut.action("asset-import", asset.id); } }
                                if SeeCut.trash-open && SeeCut.team-owner: IconButton { glyph: Glyph.reset; label: "恢复资产"; clicked => { SeeCut.action("asset-restore", asset.id); } }
                                if !SeeCut.trash-open && SeeCut.team-owner: IconButton { glyph: Glyph.trash; label: "移入回收站"; danger: true; clicked => { root.remove-id = asset.id; root.remove-name = asset.name; root.dialog = 5; } }
                            }
                        }
                    }
                }
            }
        }
    }
    Modal {
        open: root.dialog > 0;
        title: root.dialog == 1 ? "创建团队" : root.dialog == 2 ? "加入团队" : root.dialog == 3 ? "团队成员" : root.dialog == 4 ? "上传到团队资产库" : root.dialog == 5 ? "移入回收站" : "移除成员";
        glyph: Glyph.folder;
        surface-width: Math.min(460px, root.width - 40px);
        closed => { root.dialog = 0; }
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            if root.dialog == 1: VerticalLayout {
                spacing: 10px;
                Label { text: "团队名称"; }
                CloudField { value <=> SeeCut.team-name; placeholder: "输入团队名称"; }
                AppButton { label: "创建团队"; primary: true; enabled: !SeeCut.busy && SeeCut.team-name != ""; clicked => { SeeCut.action("team-create", ""); root.dialog = 0; } }
            }
            if root.dialog == 2: VerticalLayout {
                spacing: 10px;
                Label { text: "邀请链接"; }
                CloudField { value <=> SeeCut.invite-input; placeholder: "粘贴邀请链接"; }
                AppButton { label: "加入团队"; primary: true; enabled: !SeeCut.busy && SeeCut.invite-input != ""; clicked => { SeeCut.action("team-join", ""); root.dialog = 0; } }
            }
            if root.dialog == 3: VerticalLayout {
                spacing: 12px;
                if SeeCut.team-owner: AppButton { label: "创建邀请链接"; glyph: Glyph.plus; enabled: !SeeCut.busy; clicked => { SeeCut.action("invite-create", ""); } }
                if SeeCut.invite-url != "": VerticalLayout {
                    spacing: 8px;
                    Text { text: SeeCut.invite-url; color: Theme.fg-muted; overflow: elide; }
                    HorizontalLayout {
                        spacing: 8px;
                        CopyChip { text: SeeCut.invite-url; }
                        Text { text: SeeCut.invite-detail; color: Theme.fg-dim; vertical-alignment: center; overflow: elide; }
                        IconButton { glyph: Glyph.close; label: "撤销邀请链接"; enabled: !SeeCut.busy; clicked => { SeeCut.action("invite-revoke", ""); } }
                    }
                }
                ScrollView {
                    viewport-width: self.width;
                    horizontal-scrollbar-policy: always-off;
                    height: 220px;
                    VerticalLayout {
                        alignment: start;
                        spacing: 8px;
                        for member in SeeCut.members: HorizontalLayout {
                            min-height: 36px;
                            spacing: 8px;
                            Text { text: member.title; color: Theme.fg; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                            Text { text: member.value; color: Theme.fg-dim; vertical-alignment: center; }
                            if SeeCut.team-owner && member.value != "创建者": IconButton { glyph: Glyph.close; label: "移除成员"; danger: true; clicked => { root.remove-id = member.id; root.remove-name = member.title; root.dialog = 6; } }
                        }
                    }
                }
            }
            if root.dialog == 4: VerticalLayout {
                spacing: 16px;
                Text { text: "所选文件将上传到云端，团队成员均可查看和下载。"; color: Theme.fg-muted; wrap: word-wrap; }
                AppButton { label: "选择文件并上传"; primary: true; enabled: !SeeCut.busy; clicked => { SeeCut.action("asset-upload", ""); root.dialog = 0; } }
            }
            if root.dialog >= 5: VerticalLayout {
                spacing: 16px;
                Text { text: root.dialog == 5 ? "将“" + root.remove-name + "”移入回收站？" : "移除“" + root.remove-name + "”后，该成员将无法继续访问团队资产。"; color: Theme.fg-muted; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    AppButton { label: "取消"; clicked => { root.dialog = 0; } }
                    AppButton { label: root.dialog == 5 ? "移入回收站" : "移除成员"; danger: true; enabled: !SeeCut.busy; clicked => { SeeCut.action(root.dialog == 5 ? "asset-delete" : "member-remove", root.remove-id); root.dialog = 0; } }
                }
            }
        }
    }
}
