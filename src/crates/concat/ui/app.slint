// Helvetica Neue is bundled rather than assumed: a desktop binary should look
// the same on a machine that has never installed it. One file per weight the
// design uses — Roman for body, Medium for titles, Bold for the page heading.
import { I18n } from "i18n.slint";
import { ScrollView } from "std-widgets.slint";
import "fonts/HelveticaNeue-Roman.otf";
import "fonts/HelveticaNeue-Medium.otf";
import "fonts/HelveticaNeue-Bold.otf";

// Synonym, the interface's text face. It is published as one variable font,
// which Slint cannot load, so these are static instances cut from it at the
// three weights the theme uses. Licensed under the ITF Free Font License — see
// fonts/LICENSE-Synonym.
import "fonts/Synonym-Regular.ttf";
import "fonts/Synonym-Medium.ttf";
import "fonts/Synonym-SemiBold.ttf";

import { Theme } from "theme/theme.slint";
import { Flow, FlowPage, FlowDraftDialog, FlowRecoveryDialog, FlowNodeView, FlowEdgeView, FlowAttachment, FlowParameter } from "flow/page.slint";
import { Bezier, Curves, Fmt, Focus, Payload } from "util.slint";
import { EffectData } from "demo/effects-panel.slint";
import { MediaFilter, MediaItemData, MediaKind, TextPresetData } from "workspace/media-pane.slint";
import { ContextMenu, MenuItemData, MenuRow } from "primitives/context-menu.slint";
import { ExportData, ExportDialog, ExportPhase } from "dialogs/export.slint";
import { ModelData, SettingsData, SettingsDialog, SystemFactData } from "dialogs/settings.slint";
import { ProjectDialog, ProjectSheetData } from "dialogs/project.slint";
import { RelinkDialog, RelinkData, MissingMediaItem } from "dialogs/relink.slint";
import { CaptionsDialog, CaptionsSheetData } from "dialogs/captions.slint";
import { SpeechDialog, SpeechSheetData } from "dialogs/speech.slint";
import { DockDivider, DockSide, SeatBox } from "dock.slint";
import { Editor, CanvasControls, CanvasThumbs } from "editor.slint";
import { PaneKind } from "workspace/pane-switcher.slint";
import { RecentProjectData, StartData, StartScreen, ProjectCreateDialog } from "start.slint";
import { TitleBar } from "title-bar.slint";
import {
    AppliedEntryData, AppliedParamData, CatalogueEntryData, Library, LibraryViewData,
} from "inspector/clip-inspector.slint";
import { ParamFormat } from "inspector/controls.slint";
import { ToastData, ToastLayer } from "primitives/toast.slint";
import { Tips, TooltipLayer } from "primitives/tooltip.slint";
import { Seat } from "workspace/seat.slint";
import { Modal, Glyph, Icon, FocusRing } from "primitives/primitives.slint";
import { AppButton, WorkspaceIcon, MenuAction } from "seecut/components.slint";
import { Workspace } from "workspace/workspace.slint";
import { AppRail, CloudWorkbench, SeeCut, CloudItem, CreditPlan, AccountEntry, GenerationTemplate, PersonalAssetGroup, GenerationBatch } from "seecut/workbench.slint";
import { AuthDialog, EditorBridgeBar, WorkflowFeedback, WorkflowToast } from "seecut/shell.slint";
import { CanvasProjectsPage } from "seecut/project-gallery.slint";
import { LauncherSafeArea } from "seecut/launcher-safe-area.slint";
import { AssetPicker } from "seecut/asset-picker.slint";
import { MediaPreview } from "seecut/media-preview.slint";
import { Assistant, AssistantMessage } from "seecut/assistant_state.slint";
import { AssistantFloating } from "seecut/assistant-floating.slint";
import {
    ClipData, ClipField, ClipKeyData, ClipKind, ClipTextField, DropData, Keyframes,
    SelectedClipData, StageGuideData, StageItemData, TextAlignment, TimelineTabData,
    TimelineTool, TrackData, TrackSize,
} from "timeline/model.slint";

// Re-exported so main.rs can reach the globals and the struct.
export {
    Flow, FlowNodeView, FlowEdgeView, FlowAttachment, FlowParameter,
    Curves, Fmt, Focus, Payload, Theme, Bezier, Editor, CanvasControls, CanvasThumbs, I18n, Assistant, AssistantMessage,
    AppliedEntryData, AppliedParamData, CatalogueEntryData, Library, LibraryViewData, ParamFormat,
    DockDivider, DockSide, PaneKind, SeatBox,
    EffectData, MediaFilter, MediaItemData, MediaKind, TextPresetData,
    ClipData, ClipField, ClipKeyData, ClipKind, ClipTextField, DropData, Keyframes,
    SelectedClipData, StageGuideData, StageItemData, TextAlignment, TimelineTabData,
    TimelineTool, TrackData, TrackSize, MenuItemData, MenuRow, ExportData, ExportPhase, ModelData, SettingsData,
    RecentProjectData, StartData, SystemFactData, ToastData, ProjectSheetData,
    CaptionsSheetData, SpeechSheetData, SeeCut, CloudItem, CreditPlan, AccountEntry, GenerationTemplate, PersonalAssetGroup, GenerationBatch,
}

export component App inherits Window {
    title: "Seecut";
    background: Theme.page;
    default-font-family: Theme.font;
    default-font-size: 14px;
    // One line rather than a weight on every Text: everything inherits the
    // compensated body weight, and only titles override it. See theme.slint.
    default-font-weight: Theme.weight-body;
    preferred-width: 1400px;
    preferred-height: 900px;
    // Below this the three columns cannot all hold their minimum and the panes
    // start eating each other.
    min-width: 900px;
    min-height: 560px;
    // So the shortcuts work before anything has been clicked. Without it the
    // window opens with nothing focused, and a key would have nowhere to be
    // delivered from until the first press landed somewhere.
    forward-focus: keys;

    // The same hole opens again later, and `forward-focus` does not close
    // it: it is read once, when the window first focuses. Slint delivers a
    // key to the focused item and its ancestors, and when that item has
    // been torn down - the launch screen's name field once a project opens,
    // a sheet's field once the sheet closes - there is no item and the key
    // is dropped. Nothing walks up to `keys`, so every shortcut is dead
    // until a press lands on a pane's floor. Each of those teardowns hands
    // the focus back here on the way out.
    changed on-start => {
        SeeCut.project-open = !root.on-start;
        if (!root.on-start) {
            root.clip-create-open = false;
            keys.focus();
        }
    }
    property <bool> assistant-modal-active: root.workflow-modal-open || root.sheet-open
        || (SeeCut.page == 1 && SeeCut.creator-mode < 0) || SeeCut.save-team-task != ""
        || SeeCut.canvas-create-open || SeeCut.team-dialog > 0 || SeeCut.team-menu > 0;
    property <bool> assistant-modal-exiting;
    changed assistant-modal-active => {
        root.assistant-modal-exiting = !root.assistant-modal-active && !SeeCut.reduced-motion;
        if root.assistant-modal-exiting { assistant-modal-settled.start(); assistant-modal-settled.restart(); }
        else { assistant-modal-settled.stop(); }
        if !root.assistant-modal-active && !root.assistant-modal-exiting {
            root.focus-restore-pending = true;
        }
    }
    assistant-modal-settled := Timer {
        running: false; interval: 200ms;
        triggered => { self.stop(); root.assistant-modal-exiting = false; root.restore-focus(); }
    }
    property <bool> assistant-ui-blocked: root.assistant-modal-active || root.assistant-modal-exiting;
    property <bool> assistant-show: Assistant.enabled && Assistant.open && !root.assistant-ui-blocked;
    property <bool> clip-menu-shortcuts-active: !root.on-start && SeeCut.page == 0 && !root.workflow-modal-open && !root.sheet-open;
    property <bool> assistant-was-open: Assistant.open;
    property <bool> assistant-focus-pending;
    changed assistant-was-open => {
        if !Assistant.open {
            assistant-panel.clear-session-secret();
            // Keep keyboard events inside the panel until its close animation settles.
            assistant-panel.focus();
        }
    }
    Timer {
        interval: 1ms;
        running: root.assistant-focus-pending;
        triggered => {
            root.assistant-focus-pending = false;
            if !root.assistant-ui-blocked && Assistant.enabled {
                if Assistant.open { assistant-panel.focus-composer(); }
                else { assistant-panel.focus-launcher(); }
            }
        }
    }
    function toggle-assistant() {
        if Assistant.open { Assistant.close-requested(); }
        else if Assistant.enabled && !root.assistant-ui-blocked { Assistant.open = true; }
    }
    property <bool> sheet-open: root.export.open || root.settings.open
        || root.project-sheet.open || root.captions.open || root.speech.open;
    in-out property <bool> canvas-open-menu;
    property <bool> canvas-space-hand: false;
    property <int> canvas-tool-before-space: 0;
    in-out property <bool> clip-create-open;
    changed clip-create-open => { if !root.clip-create-open { root.focus-restore-pending = true; } }
    callback canvas-export-library();
    callback export-destination-selected(to-library: bool);
    callback canvas-new-with-paths(payload: string);
    callback canvas-handoff-current(payload: string);
    callback canvas-open-with-paths(path: string, payload: string);
    callback canvas-leave-page(target: int) -> bool;
    callback close-clip-project();
    property <int> workspace-page: SeeCut.page;
    property <bool> canvas-editor-active: SeeCut.page == 6 && !SeeCut.canvas-gallery-open;
    changed canvas-editor-active => {
        if root.canvas-editor-active {
            // Opening a gallery card destroys the item that held focus. Restore
            // the window keyboard scope after the new editor has been mounted.
            root.focus-return = 0;
            SeeCut.focus-return-claimed = false;
            root.focus-restore-pending = true;
        }
    }
    changed workspace-page => {
        Flow.input-focused = false;
        SeeCut.generation-parameters-open = false; SeeCut.result-preview-open = false; SeeCut.media-preview-open = false;
        SeeCut.personal-menu = 0;
        SeeCut.template-menu-id = "";
        root.canvas-open-menu = false;
        SeeCut.personal-dialog = 0;
        SeeCut.template-delete-id = "";
        SeeCut.canvas-create-open = false;
        SeeCut.team-dialog = 0;
    }
    property <bool> workflow-modal-open: Flow.confirm || Flow.recovery || Flow.picker-open || root.clip-create-open || SeeCut.generation-parameters-open || SeeCut.result-preview-open || SeeCut.media-preview-open || SeeCut.auth-open || SeeCut.asset-picker-open || SeeCut.template-editor-open || SeeCut.handoff-open || SeeCut.canvas-export-open || SeeCut.clip-export-open || SeeCut.export-copy-open || SeeCut.task-delete-open || root.relink.open || Editor.canvas-open-confirm || Editor.canvas-transform-confirm || Editor.canvas-exit-confirm || root.canvas-open-menu || SeeCut.personal-menu > 0 || SeeCut.template-menu-id != "" || SeeCut.personal-dialog > 0 || SeeCut.template-delete-id != "";
    // A small set of stable opening controls can receive focus again after
    // their sheet closes. Other workflows use the window keyboard scope.
    // 1 canvas open, 2 canvas export, 3 clip assets, 4 clip export, 5 settings.
    property <int> focus-return;
    property <int> focus-request-target;
    property <int> focus-request-token;
    property <bool> focus-restore-pending;
    function restore-focus() {
        if !root.assistant-ui-blocked {
            if SeeCut.focus-return-claimed {
                SeeCut.focus-return-claimed = false;
            } else if root.focus-return == 1 && SeeCut.page == 6 && !SeeCut.canvas-gallery-open {
                root.focus-request-target = 1;
                root.focus-request-token += 1;
            } else if root.focus-return == 2 && SeeCut.page == 6 && !SeeCut.canvas-gallery-open && Editor.canvas-has-document {
                root.focus-request-target = 2;
                root.focus-request-token += 1;
            } else if root.focus-return == 3 && SeeCut.page == 0 && !root.on-start && !SeeCut.working {
                root.focus-request-target = 3;
                root.focus-request-token += 1;
            } else if root.focus-return == 4 && SeeCut.page == 0 && !root.on-start && SeeCut.project-open {
                root.focus-request-target = 4;
                root.focus-request-token += 1;
            } else if root.focus-return == 5 {
                rail.focus-settings();
            } else if SeeCut.page == 8 && !root.assistant-show {
                Flow.focus-token += 1;
            } else if root.assistant-show {
                assistant-panel.focus-composer();
            } else {
                keys.focus();
            }
            root.focus-return = 0;
        }
    }
    // Modal changes can be evaluated while AccessKit is rebuilding its tree.
    // Move focus after that pass has returned to the event loop.
    Timer {
        interval: 1ms;
        running: root.focus-restore-pending;
        triggered => {
            root.focus-restore-pending = false;
            root.restore-focus();
        }
    }
    property <bool> handoff-keyboard-open: SeeCut.handoff-open;
    changed handoff-keyboard-open => { if root.handoff-keyboard-open { keys.focus(); Tips.close(); } }
    changed workflow-modal-open => {
        if root.workflow-modal-open {
            root.focus-restore-pending = false;
            Tips.close(); SeeCut.focus-return-claimed = false;
        } else { root.focus-restore-pending = true; }
    }
    changed sheet-open => {
        if root.sheet-open { root.focus-restore-pending = false; SeeCut.focus-return-claimed = false; }
        else { root.focus-restore-pending = true; }
    }
    // The parameter section remains mounted under a viewer. If its card was
    // removed while the viewer was open, retain a working keyboard target.
    property <bool> viewer-open: SeeCut.media-preview-open || SeeCut.result-preview-open || SeeCut.asset-picker-open || SeeCut.handoff-open;
    changed viewer-open => {
        if !root.viewer-open && SeeCut.page == 1 && SeeCut.generation-parameters-open && !SeeCut.focus-return-claimed
            && !SeeCut.task-delete-open && !SeeCut.export-copy-open && !root.sheet-open {
            keys.focus();
        }
    }

    // The editor's own state and actions live on the Editor global rather
    // than here — see editor.slint. What is left on the window is the window:
    // its title bar, its menus, and the two sheets that cover everything.

    // ── the launch screen ────────────────────────────────────────────────
    //
    // Which screen the window is showing. The editor is not built until a
    // project exists, so nothing behind this is instantiated meanwhile — and
    // the workspace, when it does arrive, arrives with every callback already
    // bound rather than during the window's own construction.
    in property <bool> on-start: true;
    in property <StartData> start;
    in property <[string]> start-resolutions;
    in property <[string]> start-rates;
    in property <[RecentProjectData]> recents;

    callback start-name-edited(name: string);
    callback start-location-edited(path: string);
    callback start-browse();
    callback start-resolution-changed(index: int);
    callback start-rate-changed(index: int);
    callback start-create();
    callback start-open-recent(path: string);
    callback start-forget-recent(path: string);
    callback start-dismiss-error();
    in property <bool> project-open-busy;
    in property <string> project-open-target;
    callback project-open-cancel();
    // Native bridge callbacks, never used to infer completion from on-start.
    callback clip-open-started(request-id: string, target: string, created: bool);
    callback clip-open-failed(request-id: string);
    callback clip-open-completed(request-id: string) -> string;

    // Title bar. The drag/maximize pair must be handled in main.rs — a window
    // cannot drag itself from inside the scene graph; the rest are seams like
    // the library callbacks above.
    in property <string> project-name: I18n.t("Untitled project");
    in property <string> project-status: I18n.t("saved");
    in property <bool> macos;

    /// The File / Edit / View menus. Built in Rust like every other menu here,
    /// because what belongs on them depends on the project.
    in property <int> open-menu: -1;
    in property <[MenuItemData]> app-menu-items;
    in property <length> app-menu-height;
    in property <int> app-menu-token;
    callback menu-opened(index: int);
    callback app-menu-selected(id: string);

    callback titlebar-begin-drag();
    callback titlebar-toggle-maximize();
    /// The strip's own window buttons, where the platform's decorations were
    /// taken off; see platform.rs.
    callback titlebar-minimize();
    callback titlebar-close();
    /// Draw minimise / maximise / close on the strip. False on macOS, where
    /// the traffic lights are the window's own.
    in property <bool> own-window-buttons;
    /// Read back from the platform on every resize, so the strip can show
    /// restore rather than maximise - whichever route maximised it.
    in-out property <bool> window-maximized;
    callback window-resized();
    init => { LauncherSafeArea.window-width = root.width; LauncherSafeArea.window-height = root.height; }
    changed width => { LauncherSafeArea.window-width = root.width; root.window-resized(); }
    changed height => { LauncherSafeArea.window-height = root.height; root.window-resized(); }
    // The dialogs. Both are held at the root because Slint has no portal: a
    // modal has to be declared where it is drawn, and it is drawn over
    // everything.
    in property <ExportData> export;
    in property <SettingsData> settings;
    in property <[ModelData]> transcribers;
    in property <[ModelData]> voices;
    in property <[string]> languages;
    /// Settings > About's copyable block. Gathered once in main.rs and
    /// never republished — every line of it is fixed for the life of the
    /// process.
    in property <[SystemFactData]> system-facts;
    in property <string> system-report;

    callback export-closed();
    callback export-name-edited(name: string);
    callback export-browse();
    callback export-resolution-changed(index: int);
    callback export-rate-changed(index: int);
    callback export-quality-changed(index: int);
    callback export-codec-changed(index: int);
    callback export-ten-bit-changed(on: bool);
    callback export-start();
    callback export-cancel();
    callback export-reveal();
    callback export-again();

    callback settings-closed();
    callback settings-page-changed(index: int);
    callback settings-show-log();
    callback settings-language-changed(index: int);
    callback settings-theme-changed(dark: bool);
    callback settings-playhead-stops-changed(on: bool);
    callback settings-custom-context-actions-changed(on: bool);
    callback settings-hardware-decode-changed(on: bool);
    callback settings-download-source-changed(index: int);
    callback settings-download-base-edited(text: string);
    callback settings-server-enabled-changed(on: bool);
    callback settings-server-listen-edited(text: string);
    callback settings-server-token-edited(text: string);
    callback settings-server-token-generated();
    callback settings-mcp-client-edited(text: string);
    callback settings-mcp-grant-r();
    callback settings-mcp-grant-m();
    callback settings-mcp-revoke();
    callback settings-mcp-grant-move();
    callback settings-mcp-renew-move();
    callback settings-mcp-revoke-move();
    callback model-activated(id: string);
    callback model-download(id: string);
    callback model-cancel(id: string);
    callback model-remove(id: string);

    callback open-canvas-path(path: string);
    callback add-canvas-paths(payload: string);
    callback canvas-new(width: int, height: int);
    callback open-settings();
    callback export-clicked();

    /// The project sheet, opened from the Details panel.
    in property <ProjectSheetData> project-sheet;
    callback project-closed();
    callback project-name-edited(name: string);
    callback project-size-changed(index: int);
    callback project-rate-changed(index: int);
    callback project-apply();

    /// The two speech sheets: captions from a clip's sound, and a title's
    /// words - or any words - read aloud. Their option lists come from what
    /// is installed, so they are handed over as models.
    in property <CaptionsSheetData> captions;
    in property <[string]> caption-models;
    callback captions-closed();
    callback captions-text-edited(text: string);
    callback captions-model-changed(index: int);
    callback captions-placement-changed(index: int);
    callback captions-size-changed(index: int);
    callback captions-begin();
    callback captions-cancel();

    in property <SpeechSheetData> speech;
    in property <[string]> speech-models;
    in property <[string]> speech-voices;
    in property <[string]> speech-voice-details;
    callback speech-closed();
    callback speech-text-edited(text: string);
    callback speech-voice-changed(index: int);
    callback speech-model-changed(index: int);
    callback speech-pace-changed(index: int);
    callback speech-begin();
    callback speech-cancel();

    /// Takes focus back from whatever field holds it. The keyboard scope is
    /// where focus rests when nothing is being typed into, so giving it the
    /// focus is what "click beside the field" means; Rust calls this for
    /// every press a pane reports through Editor.blur.
    public function blur() {
        keys.focus();
    }

    /// The bottom-right notice: what just happened, said once. Set from Rust
    /// and watched by its token — see ToastLayer, which owns the timing.
    in property <ToastData> toast;

    // The level feed is a Rust timer, and a property cannot reach across to
    // stop it, so the hover edge is forwarded as a callback: Rust arms the
    // timer on the way in and disarms it on the way out. Idle then costs
    // nothing, because nothing is dirtying a property.
    callback meter-watched-changed(watched: bool);
    changed meter-watched => {
        root.meter-watched-changed(root.meter-watched);
    }
    // Left unbound. A seat may hold two ConfigPanes or none, so there is no
    // single hover flag for this to read. Nothing sets it, so the level timer
    // in main.rs stays disarmed.
    out property <bool> meter-watched;
    /// The same seam, and just as idle. main.rs reads it on every tick.
    out property <bool> muted;

    // The window's keyboard, and the thing focus falls back to.
    //
    // It wraps the content rather than sitting beside it, and both of its jobs
    // come out of that:
    //
    //   - Clicking anything that is not a control blurs the one that had
    //     focus, the way a browser does. Slint holds focus until something
    //     else takes it, so without somewhere for it to land a number field
    //     stays in its editing state — ring and all — for the rest of the
    //     session. Every real control is inside this and takes its own press
    //     first; what reaches here is a press on nothing, and a FocusScope
    //     takes focus on one.
    //   - A key goes to the focused element first and walks up the ancestors
    //     with whatever that one rejects, so the bindings below only fire when
    //     nothing in the window wanted the keystroke. A field that is being
    //     typed into keeps its keys, and that comes from the delivery order
    //     rather than from a check on the target.
    //
    // `Control` in a binding is the platform's own command modifier: Slint
    // remaps it to ⌘ on macOS, which is also what the menu row beside it says.
    keys := FocusScope {
        enabled: !SeeCut.auth-open && !SeeCut.asset-picker-open;
        width: 100%;
        height: 100%;
        focus-on-tab-navigation: false;

        // Through the menu's own callback rather than a second handler: a
        // shortcut and the row that advertises it have to do the same thing,
        // and the cheapest way to be sure of that is for there to be one
        // thing. Every other row in those menus is a KeyBinding away from
        // working the same way.
        KeyBinding {
            keys: @keys(Control + S);
            // Nothing on the launch screen has a project to act on, which is
            // why the strip up there is missing the menus this belongs to.
            enabled: root.clip-menu-shortcuts-active;
            activated => { root.app-menu-selected("save"); }
        }
        KeyBinding {
            keys: @keys(Control + Z);
            enabled: root.clip-menu-shortcuts-active;
            activated => { root.app-menu-selected("undo"); }
        }
        KeyBinding {
            keys: @keys(Control + Shift + Z);
            enabled: root.clip-menu-shortcuts-active;
            activated => { root.app-menu-selected("redo"); }
        }

        // The rest of the keyboard, the way CapCut lays it out: the chord
        // key with a letter for an edit, a bare letter for a tool, the
        // arrows and Home/End for the playhead. Every one lands here only
        // when nothing else took it - a field being typed into consumes
        // its own letters and spaces before a key can walk up to this
        // scope, which is what keeps typing a title from cutting a clip.
        key-pressed(event) => {
            if event.text == Key.Escape && Flow.recovery { Flow.recover(0); return accept; }
            if event.text == Key.Escape && Flow.confirm { Flow.resolve(0); return accept; }
            if event.text == Key.Escape && Editor.canvas-transform-confirm { Editor.canvas-transform-resolve(0); return accept; }
            if event.text == Key.Escape && Editor.canvas-exit-confirm { Editor.canvas-exit-cancel(); return accept; }
            if event.text == Key.Escape && root.clip-create-open {
                root.clip-create-open = false; root.project-open-cancel();
                SeeCut.action("handoff-create-cancel", ""); return accept;
            }
            if event.text == Key.Escape && root.canvas-open-menu { root.canvas-open-menu = false; return accept; }
            if event.text == Key.Escape && Editor.canvas-open-confirm { Editor.canvas-open-cancel(); return accept; }
            if event.text == Key.Escape && SeeCut.export-copy-open { if !SeeCut.export-copy-running { SeeCut.action("export-copy-close", ""); } return accept; }
            if event.text == Key.Escape && SeeCut.canvas-export-open { SeeCut.canvas-export-open = false; return accept; }
            if event.text == Key.Escape && SeeCut.handoff-open { SeeCut.handoff-open = false; SeeCut.action("handoff-cancel", ""); return accept; }
            if event.text == Key.Escape && SeeCut.task-delete-open { SeeCut.task-delete-open = false; SeeCut.action("task-batch-cancel-delete", ""); return accept; }
            if event.text == Key.Escape && SeeCut.clip-export-open { SeeCut.clip-export-open = false; return accept; }
            if event.text == Key.Escape && SeeCut.media-preview-open { SeeCut.media-preview-open = false; return accept; }
            if event.text == Key.Escape && SeeCut.result-preview-open { SeeCut.result-preview-open = false; return accept; }
            if event.text == Key.Escape && SeeCut.generation-parameters-open { SeeCut.generation-parameters-open = false; return accept; }
            if event.text == Key.Escape && SeeCut.personal-menu > 0 { SeeCut.personal-menu = 0; return accept; }
            if event.text == Key.Escape && SeeCut.template-menu-id != "" { SeeCut.template-menu-id = ""; return accept; }
            if event.text == Key.Escape && SeeCut.template-editor-open { SeeCut.template-editor-open = false; return accept; }
            if event.text == Key.Escape && SeeCut.template-delete-id != "" { SeeCut.template-delete-id = ""; return accept; }
            if event.text == Key.Escape && SeeCut.personal-dialog > 0 { if !SeeCut.personal-dialog-busy { SeeCut.personal-dialog = 0; SeeCut.personal-dialog-error = ""; } return accept; }
            if event.text == Key.Escape && root.settings.open { root.settings-closed(); return accept; }
            if SeeCut.page == 8 && !root.workflow-modal-open && !root.sheet-open {
                if !Flow.input-focused && (event.modifiers.control || event.modifiers.meta) {
                    let shortcut = event.text.to-lowercase();
                    if shortcut == "z" { Flow.action(event.modifiers.shift ? "redo" : "undo"); return accept; }
                    if shortcut == "s" { Flow.action("save"); return accept; }
                    if shortcut == "o" { Flow.action("open"); return accept; }
                }
                if !Flow.input-focused && event.text == Key.Escape { Flow.action("cancel-connect"); return accept; }
                return reject;
            }
            if (SeeCut.page == 6 && !SeeCut.canvas-gallery-open && !root.workflow-modal-open && !root.sheet-open) {
                if (event.modifiers.control || event.modifiers.meta) {
                    let shortcut = event.text.to-lowercase();
                    if (shortcut == "z") { if event.modifiers.shift { if Editor.canvas-can-redo { Editor.canvas-redo(); } } else { if Editor.canvas-can-undo { Editor.canvas-undo(); } } return accept; }
                    if (shortcut == "a" && Editor.canvas-has-document) { Editor.canvas-select-all(); return accept; }
                    if (shortcut == "d") { Editor.canvas-deselect(); return accept; }
                    if (shortcut == "o") { Editor.canvas-open(); return accept; }
                    if (event.modifiers.shift && shortcut == "s" && Editor.canvas-has-document) { Editor.canvas-save-comp-as(); return accept; }
                    if (shortcut == "s" && Editor.canvas-has-document) { Editor.canvas-save-comp(); return accept; }
                    if (shortcut == "t" && Editor.canvas-has-object) {
                        Editor.canvas-tool-changed(0);
                        Editor.canvas-transform-start();
                        return accept;
                    }
                }
                if (event.text == Key.Space && Editor.canvas-has-document) {
                    if (Editor.canvas-transforming) { return accept; }
                    if (!root.canvas-space-hand) {
                        root.canvas-tool-before-space = Editor.canvas-tool;
                        root.canvas-space-hand = true;
                        Editor.canvas-tool-changed(1);
                    }
                    return accept;
                }
                if (event.modifiers.control || event.modifiers.meta || event.modifiers.alt) { return reject; }
                if (event.text == "v" || event.text == "V") { Editor.canvas-tool-changed(0); return accept; }
                if (event.text == "h" || event.text == "H") { Editor.canvas-tool-changed(1); return accept; }
                if (event.text == "z" || event.text == "Z") { Editor.canvas-tool-changed(2); return accept; }
                if (Editor.canvas-transforming && event.text == "\n") { Editor.canvas-transform-finish(true); return accept; }
                if (event.text == Key.Escape && Editor.canvas-transforming) { Editor.canvas-transform-finish(false); return accept; }
                if (event.text == Key.Escape && Editor.canvas-has-object) { Editor.canvas-object-release(false); return accept; }
                if (Editor.canvas-tool == 0 && Editor.canvas-has-object) {
                    let step = event.modifiers.shift ? 10 : 1;
                    if (event.text == Key.LeftArrow) { Editor.canvas-nudge(-step, 0); return accept; }
                    if (event.text == Key.RightArrow) { Editor.canvas-nudge(step, 0); return accept; }
                    if (event.text == Key.UpArrow) { Editor.canvas-nudge(0, -step); return accept; }
                    if (event.text == Key.DownArrow) { Editor.canvas-nudge(0, step); return accept; }
                }
                if (event.text == Key.Delete || event.text == Key.Backspace) {
                    if (Editor.canvas-has-selection) { Editor.canvas-delete-selection(); return accept; }
                    if (Editor.canvas-active-layer >= 0) { Editor.canvas-layer-deleted(Editor.canvas-active-layer); return accept; }
                    return reject;
                }
                if (event.text == Key.Escape) { Editor.canvas-deselect(); return accept; }
                return reject;
            }
            if (root.on-start || SeeCut.page != 0 || root.workflow-modal-open || root.sheet-open) {
                return reject;
            }
            // The command key arrives as meta on a Mac and as control
            // everywhere else; either is the chord key.
            if (event.modifiers.control || event.modifiers.meta) {
                if (event.modifiers.shift || event.modifiers.alt) {
                    return reject;
                }
                if (event.text == "b") { Editor.shortcut("split"); return accept; }
                if (event.text == "a") { Editor.shortcut("select-all"); return accept; }
                if (event.text == "c") { Editor.shortcut("copy"); return accept; }
                if (event.text == "v") { Editor.shortcut("paste"); return accept; }
                if (event.text == "d") { Editor.shortcut("duplicate"); return accept; }
                if (event.text == "e") { Editor.shortcut("export"); return accept; }
                if (event.text == "i") { Editor.shortcut("import"); return accept; }
                if (event.text == ",") { Editor.shortcut("settings"); return accept; }
                if (event.text == "=" || event.text == "+") {
                    Editor.shortcut("zoom-in");
                    return accept;
                }
                if (event.text == "-") { Editor.shortcut("zoom-out"); return accept; }
                return reject;
            }
            if (event.modifiers.alt) {
                return reject;
            }
            if (event.text == Key.Space) { Editor.play-toggled(); return accept; }
            if (event.text == Key.Delete || event.text == Key.Backspace) {
                Editor.delete-selected();
                return accept;
            }
            if (event.text == Key.Home) { Editor.shortcut("start"); return accept; }
            if (event.text == Key.End) { Editor.shortcut("end"); return accept; }
            // A frame, or ten with shift.
            if (event.text == Key.LeftArrow) {
                Editor.step-frames(event.modifiers.shift ? -10 : -1);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                Editor.step-frames(event.modifiers.shift ? 10 : 1);
                return accept;
            }
            if (event.modifiers.shift) {
                return reject;
            }
            if (event.text == "a" || event.text == "v") {
                Editor.shortcut("tool-select");
                return accept;
            }
            if (event.text == "b") { Editor.shortcut("tool-razor"); return accept; }
            if (event.text == "s") { Editor.shortcut("split-selected"); return accept; }
            if (event.text == "n") { Editor.shortcut("snap"); return accept; }
            if (event.text == "m") { Editor.shortcut("mute"); return accept; }
            if (event.text == "h") { Editor.shortcut("flip-h"); return accept; }
            if (event.text == "j") { Editor.shortcut("flip-v"); return accept; }
            if (event.text == "r") { Editor.shortcut("reverse"); return accept; }
            return reject;
        }
        key-released(event) => {
            if (event.text == Key.Space && root.canvas-space-hand) {
                root.canvas-space-hand = false;
                if (SeeCut.page == 6) { Editor.canvas-tool-changed(root.canvas-tool-before-space); }
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            width: 100%;
            height: 100%;
            // Inside the system's own bars. A phone or a tablet draws the
            // window edge to edge, under the status bar and the home
            // indicator, and the window says how far each reaches in; the
            // title strip and everything under it start below it, and the
            // ground shows through behind the bars. Zero on a desktop.
            padding-top: root.safe-area-insets.top;
            padding-bottom: root.safe-area-insets.bottom;
            padding-left: root.safe-area-insets.left;
            padding-right: root.safe-area-insets.right;

            TitleBar {
                visible: !root.macos;
                height: root.macos ? 0px : 32px;
                macos: root.macos;
                minimal: root.on-start || SeeCut.page != 0;
                project-name: root.project-name;
                status: root.project-status;
                document-controls: false;

                menu: root.open-menu;
                menu-opened(index, at-x) => {
                    // Under the strip, which is 32px tall - both measured
                    // from the window's corner, past the system's bars.
                    appmenu.request-x = at-x + root.safe-area-insets.left;
                    appmenu.request-y = 32px + root.safe-area-insets.top;
                    root.menu-opened(index);
                }

                own-buttons: root.own-window-buttons;
                maximized: root.window-maximized;
                begin-drag => { root.titlebar-begin-drag(); }
                toggle-maximize => { root.titlebar-toggle-maximize(); }
                minimize => { root.titlebar-minimize(); }
                close => { root.titlebar-close(); }
                open-settings => { root.focus-return = 0; root.open-settings(); }
                add-pane(kind) => { Editor.dock-add(kind); }
                export-clicked => { root.focus-return = 0; root.export-clicked(); }
            }

            workspace-area := Rectangle {
                vertical-stretch: 1;
                min-width: 0px;
                min-height: 0px;
                rail := AppRail {
                    x: 0; y: 0; height: parent.height;
                    begin-drag => { root.titlebar-begin-drag(); }
                    toggle-maximize => { root.titlebar-toggle-maximize(); }
                    open-settings => { root.focus-return = 5; root.open-settings(); }
                }
                if SeeCut.page != 0 && SeeCut.page != 6 && SeeCut.page != 8: CloudWorkbench { compact-height: root.height < 800px; x: rail.width; width: Math.max(0px, parent.width - rail.width); height: 100%; }
                if SeeCut.page == 8: FlowPage {
                    x: rail.width; width: max(0px, parent.width - rail.width - (Assistant.enabled && !root.assistant-ui-blocked && !assistant-panel.fully-closed ? assistant-panel.width + 32px : 0px)); height: 100%;
                    launcher-clearance: Assistant.enabled && !root.assistant-ui-blocked && !assistant-panel.fully-closed ? 0px : LauncherSafeArea.inset;
                }
                if SeeCut.page == 6 && SeeCut.canvas-gallery-open: CanvasProjectsPage {
                    x: rail.width; width: Math.max(0px, parent.width - rail.width); height: 100%;
                }
                if SeeCut.page == 6 && !SeeCut.canvas-gallery-open: Rectangle {
                    x: rail.width;
                    width: Math.max(0px, parent.width - rail.width);
                    height: 100%;
                    VerticalLayout {
                        width: parent.width; height: parent.height;
                        canvas-header := Rectangle {
                            height: 56px; background: Theme.panel;
                            property <int> restore-token: root.focus-request-token;
                            property <bool> restore-pending;
                            changed restore-token => {
                                if root.focus-request-target == 1 || root.focus-request-target == 2 {
                                    self.restore-pending = true;
                                }
                            }
                            Timer {
                                interval: 1ms;
                                running: canvas-header.restore-pending;
                                triggered => {
                                    canvas-header.restore-pending = false;
                                    if !root.assistant-ui-blocked && SeeCut.page == 6 && !SeeCut.canvas-gallery-open {
                                        if root.focus-request-target == 1 { canvas-open-button.take-focus(); }
                                        else if root.focus-request-target == 2 { canvas-export-button.take-focus(); }
                                    }
                                }
                            }
                            HorizontalLayout {
                                padding-top: 12px; padding-bottom: 12px; padding-left: 16px; padding-right: 16px; spacing: 10px;
                                WorkspaceIcon { width: 32px; height: 32px; side: 32px; glyph: Glyph.chevron-left; label: "返回画布项目"; clicked => {
                                    if !root.canvas-leave-page(6) {
                                        SeeCut.canvas-gallery-open = true;
                                        SeeCut.action("canvas-projects-refresh", "");
                                    }
                                } }
                                Text { text: Editor.canvas-has-document ? Editor.canvas-name + (Editor.canvas-modified ? " · 未保存" : "") : "未打开文档"; font-size: 14px; color: Theme.fg; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide; }
                                WorkspaceIcon {
                                    width: 32px; height: 32px; side: 32px;
                                    glyph: Editor.canvas-transforming ? Glyph.check : Glyph.fit;
                                    label: Editor.canvas-transforming ? "完成变换" : "自由变换";
                                    enabled: Editor.canvas-has-document;
                                    checkable: true; checked: Editor.canvas-transforming;
                                    clicked => { if (Editor.canvas-transforming) { Editor.canvas-transform-finish(true); } else { Editor.canvas-transform-start(); } }
                                }
                                WorkspaceIcon { width: 32px; height: 32px; side: 32px; glyph: Glyph.flip-h; label: "水平翻转"; enabled: Editor.canvas-has-object; clicked => { Editor.canvas-flip(true); } }
                                WorkspaceIcon { width: 32px; height: 32px; side: 32px; glyph: Glyph.flip-v; label: "垂直翻转"; enabled: Editor.canvas-has-object; clicked => { Editor.canvas-flip(false); } }
                                canvas-open-button := WorkspaceIcon {
                                    width: 32px; height: 32px; side: 32px;
                                    glyph: Glyph.folder; label: "打开画布";
                                    clicked => { root.focus-return = 1; root.canvas-open-menu = !root.canvas-open-menu; }
                                }
                                WorkspaceIcon { width: 32px; height: 32px; side: 32px; glyph: Glyph.undo; label: "撤销"; enabled: Editor.canvas-can-undo; clicked => { Editor.canvas-undo(); } }
                                WorkspaceIcon { width: 32px; height: 32px; side: 32px; glyph: Glyph.redo; label: "重做"; enabled: Editor.canvas-can-redo; clicked => { Editor.canvas-redo(); } }
                                Rectangle { width: 1px; height: 32px; Rectangle { y: 7px; width: 1px; height: 18px; background: Theme.line; } }
                                WorkspaceIcon { width: 32px; height: 32px; side: 32px; glyph: Glyph.save; label: "保存画布工程"; enabled: Editor.canvas-has-document; clicked => { Editor.canvas-save-comp(); } }
                                WorkspaceIcon { width: 32px; height: 32px; side: 32px; glyph: Glyph.copy; label: "另存画布工程"; enabled: Editor.canvas-has-document; clicked => { Editor.canvas-save-comp-as(); } }
                                canvas-export-button := AppButton {
                                    height: 32px; label: "导出"; enabled: Editor.canvas-has-document;
                                    clicked => { root.focus-return = 2; SeeCut.canvas-export-open = true; }
                                }
                                WorkspaceIcon {
                                    width: 32px; height: 32px; side: 32px; glyph: Glyph.sliders;
                                    label: Editor.canvas-sidebar-open ? "收起图层与属性" : "展开图层与属性";
                                    checkable: true; checked: Editor.canvas-sidebar-open;
                                    clicked => { Editor.canvas-sidebar-open = !Editor.canvas-sidebar-open; }
                                }
                            }
                        }
                        HorizontalLayout {
                            vertical-stretch: 1; min-height: 0px; spacing: 0px;
                            VerticalLayout {
                                horizontal-stretch: 1; min-width: 0px;
                                WorkflowFeedback { }
                                Seat { kind: PaneKind.canvas; standalone: true; vertical-stretch: 1; min-width: 0px; }
                            }
                        }
                    }
                }
                if SeeCut.page == 0: Rectangle {
                    x: rail.width;
                    width: Math.max(0px, parent.width - rail.width);
                    height: 100%;
                    VerticalLayout {
                    if !root.on-start: bridge-bar := EditorBridgeBar {
                        project-name: root.project-name;
                        project-status: root.project-status;
                        focus-request-target: root.focus-request-target;
                        focus-request-token: root.focus-request-token;
                        focus-restore-allowed: !root.assistant-ui-blocked && SeeCut.page == 0 && !root.on-start;
                        assets-clicked => { root.focus-return = 3; SeeCut.action("project-assets", ""); }
                        export-clicked => { root.focus-return = 4; root.export-clicked(); }
                    }
                    if root.project-open-busy: Rectangle {
                        height: 40px; background: Theme.panel;
                        HorizontalLayout {
                            padding-left: 16px; padding-right: 12px; spacing: 8px;
                            Text { horizontal-stretch: 1; min-width: 0px;
                                text: I18n.t1("Opening “{0}”…", root.project-open-target);
                                color: Theme.fg-muted; vertical-alignment: center; overflow: elide;
                            }
                            AppButton { label: I18n.t("Cancel"); height: 28px; clicked => { root.project-open-cancel(); } }
                        }
                    }
                    HorizontalLayout {
                        vertical-stretch: 1; min-height: 0px; spacing: 0px;
                        VerticalLayout {
                            horizontal-stretch: 1; min-width: 0px;
                            WorkflowFeedback { }
                            if root.on-start: StartScreen {
                                vertical-stretch: 1;
                                create-open <=> root.clip-create-open;
                                data: root.start;
                                resolutions: root.start-resolutions;
                                rates: root.start-rates;
                                recents: root.recents;

                                name-edited(name) => { root.start-name-edited(name); }
                                location-edited(path) => { root.start-location-edited(path); }
                                browse => { root.start-browse(); }
                                resolution-changed(index) => { root.start-resolution-changed(index); }
                                rate-changed(index) => { root.start-rate-changed(index); }
                                create => { root.start-create(); }
                                create-cancelled => { root.project-open-cancel(); SeeCut.action("handoff-create-cancel", ""); }
                                open-recent(path) => { root.start-open-recent(path); }
                                forget-recent(path) => { root.start-forget-recent(path); }
                                dismiss-error => { root.start-dismiss-error(); }
                            }
                            if !root.on-start: Workspace { vertical-stretch: 1; min-width: 0px; }
                        }
                    }
                    }
                }
            }
        }
    }

    if !root.on-start: ProjectCreateDialog {
        width: root.width; height: root.height;
        open: root.clip-create-open;
        data: root.start; resolutions: root.start-resolutions; rates: root.start-rates;
        name-edited(name) => { root.start-name-edited(name); }
        location-edited(path) => { root.start-location-edited(path); }
        browse => { root.start-browse(); }
        resolution-changed(index) => { root.start-resolution-changed(index); }
        rate-changed(index) => { root.start-rate-changed(index); }
        create => { root.start-create(); }
        dismiss-error => { root.start-dismiss-error(); }
        closed => {
            root.clip-create-open = false; root.project-open-cancel();
            SeeCut.action("handoff-create-cancel", "");
        }
    }

    // Declared last, and that is load-bearing: Slint paints siblings in
    // declaration order, so a modal placed above the workspace in the file is
    // painted *under* it on screen — open, correct, and completely hidden.
    ExportDialog {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        data: root.export;

        closed => { root.export-closed(); }
        name-edited(name) => { root.export-name-edited(name); }
        browse => { root.export-browse(); }
        resolution-changed(index) => { root.export-resolution-changed(index); }
        rate-changed(index) => { root.export-rate-changed(index); }
        quality-changed(index) => { root.export-quality-changed(index); }
        codec-changed(index) => { root.export-codec-changed(index); }
        ten-bit-changed(on) => { root.export-ten-bit-changed(on); }
        begin => { root.export-start(); }
        cancel => { root.export-cancel(); }
        reveal => { root.export-reveal(); }
        again => { root.export-again(); }
    }

    SettingsDialog {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        data: root.settings;
        transcribers: root.transcribers;
        voices: root.voices;
        languages: root.languages;
        system-facts: root.system-facts;
        system-report: root.system-report;

        closed => { root.settings-closed(); }
        page-changed(index) => { root.settings-page-changed(index); }
        show-log => { root.settings-show-log(); }
        language-changed(index) => { root.settings-language-changed(index); }
        theme-changed(dark) => { root.settings-theme-changed(dark); }
        playhead-stops-changed(on) => { root.settings-playhead-stops-changed(on); }
        custom-context-actions-changed(on) => { root.settings-custom-context-actions-changed(on); }
        hardware-decode-changed(on) => { root.settings-hardware-decode-changed(on); }
        download-source-changed(index) => { root.settings-download-source-changed(index); }
        download-base-edited(text) => { root.settings-download-base-edited(text); }
        server-enabled-changed(on) => { root.settings-server-enabled-changed(on); }
        server-listen-edited(text) => { root.settings-server-listen-edited(text); }
        server-token-edited(text) => { root.settings-server-token-edited(text); }
        server-token-generated => { root.settings-server-token-generated(); }
        mcp-client-edited(text) => { root.settings-mcp-client-edited(text); }
        mcp-grant-r => { root.settings-mcp-grant-r(); }
        mcp-grant-m => { root.settings-mcp-grant-m(); }
        mcp-revoke => { root.settings-mcp-revoke(); }
        mcp-grant-move => { root.settings-mcp-grant-move(); }
        mcp-renew-move => { root.settings-mcp-renew-move(); }
        mcp-revoke-move => { root.settings-mcp-revoke-move(); }
        model-activated(id) => { root.model-activated(id); }
        model-download(id) => { root.model-download(id); }
        model-cancel(id) => { root.model-cancel(id); }
        model-remove(id) => { root.model-remove(id); }
    }

    in property <RelinkData> relink;
    callback relink-all();
    callback relink-dismiss();

    ProjectDialog {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        data: root.project-sheet;

        closed => { root.project-closed(); }
        name-edited(name) => { root.project-name-edited(name); }
        size-changed(index) => { root.project-size-changed(index); }
        rate-changed(index) => { root.project-rate-changed(index); }
        apply => { root.project-apply(); }
    }

    RelinkDialog {
        data: root.relink;
        relink-all => { root.relink-all(); }
        dismiss => { root.relink-dismiss(); }
    }


    CaptionsDialog {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        data: root.captions;
        models: root.caption-models;

        closed => { root.captions-closed(); }
        text-edited(text) => { root.captions-text-edited(text); }
        model-changed(index) => { root.captions-model-changed(index); }
        placement-changed(index) => { root.captions-placement-changed(index); }
        size-changed(index) => { root.captions-size-changed(index); }
        begin => { root.captions-begin(); }
        cancel => { root.captions-cancel(); }
    }

    SpeechDialog {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        data: root.speech;
        models: root.speech-models;
        voices: root.speech-voices;
        voice-details: root.speech-voice-details;

        closed => { root.speech-closed(); }
        text-edited(text) => { root.speech-text-edited(text); }
        voice-changed(index) => { root.speech-voice-changed(index); }
        model-changed(index) => { root.speech-model-changed(index); }
        pace-changed(index) => { root.speech-pace-changed(index); }
        begin => { root.speech-begin(); }
        cancel => { root.speech-cancel(); }
    }

    if SeeCut.asset-picker-open: AssetPicker { width: root.width; height: root.height; }
    MediaPreview { width: root.width; height: root.height; }
    AuthDialog { width: root.width; height: root.height; }
    Modal {
        open: SeeCut.clip-export-open;
        trap-focus: true;
        title: "导出";
        title-at-start: true;
        show-close-for-start-title: true;
        prominent-close: true;
        surface-width: Math.min(544px, root.width - 32px);
        surface-height: 214px;
        closed => { SeeCut.clip-export-open = false; }
        VerticalLayout {
            padding-left: 24px; padding-right: 24px;
            padding-top: 6px; padding-bottom: 34px;
            spacing: 16px;
            AppButton { height: 48px; label: "导出至资产库"; clicked => { SeeCut.clip-export-open = false; root.export-destination-selected(true); } }
            AppButton { height: 48px; label: "导出至其他文件夹"; subtle: true; subtle-normal-ink: true; clicked => { SeeCut.clip-export-open = false; root.export-destination-selected(false); } }
        }
    }
    Modal {
        open: SeeCut.task-delete-open;
        title: "删除生成结果";
        glyph: Glyph.trash;
        surface-width: 400px;
        closed => { SeeCut.task-delete-open = false; SeeCut.action("task-batch-cancel-delete", ""); }
        VerticalLayout {
            padding: 20px; spacing: 16px;
            Text { text: "从结果列表移除 " + SeeCut.task-delete-count + " 项？已入库素材和任务记录仍保留。"; color: Theme.fg; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end; spacing: 8px;
                AppButton { label: "取消"; clicked => { SeeCut.task-delete-open = false; SeeCut.action("task-batch-cancel-delete", ""); } }
                AppButton { label: "删除"; danger: true; clicked => { SeeCut.action("task-batch-confirm-delete", ""); } }
            }
        }
    }
    Modal {
        open: SeeCut.handoff-open;
        title: "发送 " + SeeCut.handoff-count + " 项到" + (SeeCut.handoff-kind == "canvas" ? "画布" : "剪辑");
        glyph: SeeCut.handoff-kind == "canvas" ? Glyph.brush : Glyph.film;
        title-at-start: true;
        surface-width: Math.min(720px, root.width - 32px);
        surface-height: Math.min(490px, root.height - 32px);
        closed => { SeeCut.handoff-open = false; SeeCut.action("handoff-cancel", ""); }
        VerticalLayout {
            padding: 24px; padding-top: 4px; spacing: 16px; vertical-stretch: 1;
            Text { text: "所选素材会一起加入同一个项目"; color: Theme.fg-muted; font-size: 13px; }
            ScrollView {
                height: 216px;
                viewport-width: self.visible-width;
                horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    width: parent.width;
                    spacing: 16px;
                    for target in SeeCut.handoff-targets: target-row := Rectangle {
                        visible: target.id != "new";
                        width: parent.width;
                        height: target.id == "new" ? 0px : 88px; border-radius: Theme.r; background: touch.pressed ? Theme.field-active : touch.has-hover ? Theme.field-hover : Theme.field;
                        border-width: 1px; border-color: SeeCut.handoff-selected-id == target.id ? Theme.accent : Theme.line-strong;
                        property <bool> ring;
                        accessible-role: button;
                        accessible-label: target.name + " " + target.detail;
                        accessible-action-default => { SeeCut.handoff-selected-id = target.id; }
                        focus := FocusScope {
                            focus-gained(reason) => { target-row.ring = reason == FocusReason.tab-navigation; }
                            focus-lost(reason) => { target-row.ring = false; }
                            key-pressed(event) => {
                                if event.text == " " || event.text == "\n" {
                                    SeeCut.handoff-selected-id = target.id;
                                    return EventResult.accept;
                                }
                                return EventResult.reject;
                            }
                        }
                        HorizontalLayout {
                            width: parent.width; height: parent.height;
                            padding-left: 12px; padding-right: 16px; spacing: 16px;
                            VerticalLayout {
                                width: 96px; height: parent.height; alignment: center;
                                Rectangle {
                                    width: 96px; height: 64px; background: Theme.well; border-radius: Theme.r-sm; clip: true;
                                    if target.preview.width > 0: Image { width: 100%; height: 100%; source: target.preview; image-fit: cover; }
                                    if target.preview.width == 0: Icon { x: 36px; y: 20px; size: 24px; glyph: SeeCut.handoff-kind == "canvas" ? Glyph.image : Glyph.film; tint: Theme.fg-muted; }
                                }
                            }
                            VerticalLayout {
                                alignment: center; spacing: 2px; horizontal-stretch: 1;
                                Text { text: target.name; color: Theme.fg; font-size: 14px; overflow: elide; }
                                Text { text: target.detail; color: Theme.fg-muted; font-size: 12px; overflow: elide; }
                            }
                            VerticalLayout { width: 16px; height: parent.height; alignment: center; Icon { glyph: Glyph.chevron-right; size: 16px; tint: Theme.fg-muted; } }
                        }
                        touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); SeeCut.handoff-selected-id = target.id; } }
                        FocusRing { active: target-row.ring; radius: Theme.r; }
                    }
                }
            }
            AppButton {
                width: 180px;
                label: SeeCut.handoff-kind == "canvas" ? "新建画布项目" : "新建剪辑项目";
                clicked => { SeeCut.handoff-selected-id = "new"; }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                alignment: end; spacing: 8px;
                AppButton { width: 96px; label: "取消"; clicked => { SeeCut.handoff-open = false; SeeCut.action("handoff-cancel", ""); } }
                AppButton { width: 104px; label: "加入并打开"; primary: true; enabled: SeeCut.handoff-selected-id != ""; clicked => { SeeCut.action("handoff-select", SeeCut.handoff-selected-id); } }
            }
        }
    }
    Modal {
        open: SeeCut.canvas-export-open;
        trap-focus: true;
        title: "导出";
        title-at-start: true;
        show-close-for-start-title: true;
        prominent-close: true;
        surface-width: Math.min(544px, root.width - 32px);
        surface-height: 214px;
        closed => { SeeCut.canvas-export-open = false; }
        VerticalLayout {
            padding-left: 24px; padding-right: 24px;
            padding-top: 6px; padding-bottom: 34px;
            spacing: 16px;
            AppButton { height: 48px; label: "导出至资产库"; clicked => { SeeCut.canvas-export-open = false; root.canvas-export-library(); } }
            AppButton { height: 48px; label: "导出至其他文件夹"; subtle: true; subtle-normal-ink: true; clicked => { SeeCut.canvas-export-open = false; Editor.canvas-export-png(); } }
        }
    }
    Modal {
        open: SeeCut.export-copy-open;
        title: "导出文件";
        glyph: Glyph.export;
        surface-width: Math.min(440px, root.width - 32px);
        dismissable: !SeeCut.export-copy-running;
        closed => { SeeCut.action("export-copy-close", ""); }
        VerticalLayout {
            padding: 20px; spacing: 16px;
            Text {
                text: "已完成 " + SeeCut.export-copy-done + "/" + SeeCut.export-copy-total + " 项 · " + SeeCut.export-copy-progress + "%";
                color: Theme.fg; font-size: 14px;
            }
            Rectangle {
                height: 6px; background: Theme.well; border-radius: 3px;
                Rectangle { width: parent.width * Math.clamp(SeeCut.export-copy-progress, 0, 100) / 100; height: 100%; background: Theme.accent; border-radius: 3px; }
            }
            if SeeCut.export-copy-error != "": Text { text: SeeCut.export-copy-error; color: SeeCut.export-copy-done == SeeCut.export-copy-total ? Theme.fg-muted : Theme.danger; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end; spacing: 8px;
                if SeeCut.export-copy-running: AppButton { label: "取消导出"; clicked => { SeeCut.action("export-copy-cancel", ""); } }
                if !SeeCut.export-copy-running && SeeCut.export-copy-done < SeeCut.export-copy-total: AppButton { label: "重试未完成"; primary: true; clicked => { SeeCut.action("export-copy-retry", ""); } }
                if !SeeCut.export-copy-running: AppButton { label: "关闭"; clicked => { SeeCut.action("export-copy-close", ""); } }
            }
        }
    }

    // Over the workspace and both sheets, under the menus. A tooltip has to
    // clear the pane it belongs to — panes clip — and it has no business over
    // an open menu, which is the one surface that would rather not be
    // explained at. A PopupWindow is its own layer above all of this anyway,
    // so the menus win without having to be declared after it.
    TooltipLayer {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
    }

    // Above the dialogs as well as the workspace. A PopupWindow is its own
    // layer so the order does not strictly decide the outcome, but the
    // element that places it still measures against this one's box, and this
    // one is the whole window.
    appmenu := ContextMenu {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        items: root.app-menu-items;
        menu-height: root.app-menu-height;
        token: root.app-menu-token;
        selected(id) => { root.app-menu-selected(id); }
    }

    Modal {
        open: Editor.canvas-transform-confirm;
        title: "结束自由变换？";
        glyph: Glyph.fit;
        surface-width: Math.min(440px, root.width - 32px);
        closed => { Editor.canvas-transform-resolve(0); }
        changed open => {
            if Editor.canvas-transform-confirm {
                root.canvas-open-menu = false;
                transform-keys.focus();
            }
        }
        transform-keys := FocusScope {
            enabled: Editor.canvas-transform-confirm;
            focus-on-tab-navigation: false;
            key-pressed(event) => {
                if event.text == Key.Escape { Editor.canvas-transform-resolve(0); return accept; }
                return reject;
            }
            VerticalLayout {
                padding: 20px; spacing: 16px;
                Text {
                    text: Editor.canvas-transform-context + "前，先处理当前变换。";
                    color: Theme.fg; wrap: word-wrap;
                }
                HorizontalLayout { spacing: 8px; alignment: end;
                    AppButton { label: "返回编辑"; clicked => { Editor.canvas-transform-resolve(0); } }
                    AppButton { label: "放弃并继续"; danger: true; clicked => { Editor.canvas-transform-resolve(2); } }
                    AppButton { label: "应用并继续"; primary: true; clicked => { Editor.canvas-transform-resolve(1); } }
                }
            }
        }
    }
    Modal {
        open: Editor.canvas-open-confirm; title: "保存画布修改？"; glyph: Glyph.save;
        surface-width: Math.min(480px, root.width - 32px);
        closed => { Editor.canvas-open-cancel(); }
        VerticalLayout {
            padding: 20px; spacing: 16px;
            Text { text: "当前画布有未保存的修改。打开其他图片或项目之前，可先保存当前画布。"; color: Theme.fg; wrap: word-wrap; }
            HorizontalLayout { spacing: 8px; alignment: end;
                AppButton { label: "取消"; clicked => { Editor.canvas-open-cancel(); } }
                AppButton { label: "放弃修改并打开"; danger: true; clicked => { Editor.canvas-open-discard(); } }
                AppButton { label: "保存并打开"; primary: true; clicked => { Editor.canvas-open-save(); } }
            }
        }
    }
    if root.canvas-open-menu: TouchArea { clicked => { root.canvas-open-menu = false; } }
    if root.canvas-open-menu: Rectangle {
        x: Math.max(84px, root.width - 470px); y: 76px; width: 244px; height: 130px;
        background: Theme.raised; border-radius: Theme.r-lg; border-width: 1px; border-color: Theme.line-strong;
        VerticalLayout { padding: 8px; spacing: 0px;
            MenuAction { auto-focus: true; close-on-escape: true; label: "从资产库选择图片"; glyph: Glyph.folder; cancelled => { root.canvas-open-menu = false; } clicked => { root.canvas-open-menu = false; root.focus-return = 1; SeeCut.action("canvas-assets", ""); } }
            MenuAction { close-on-escape: true; label: "打开本机图片"; glyph: Glyph.image; cancelled => { root.canvas-open-menu = false; } clicked => { root.canvas-open-menu = false; Editor.canvas-open(); } }
            MenuAction { close-on-escape: true; label: "打开画布工程"; glyph: Glyph.folder-plus; cancelled => { root.canvas-open-menu = false; } clicked => { root.canvas-open-menu = false; Editor.canvas-project-open(); } }
        }
    }
    Modal {
        open: Editor.canvas-exit-confirm;
        title: Editor.canvas-exit-error != "" ? "无法退出" : "保存画布修改？";
        glyph: Glyph.save;
        surface-width: Math.min(480px, root.width - 32px);
        closed => { Editor.canvas-exit-cancel(); }
        changed open => {
            if Editor.canvas-exit-confirm {
                root.canvas-open-menu = false;
                exit-keys.focus();
            }
        }
        exit-keys := FocusScope {
            enabled: Editor.canvas-exit-confirm;
            focus-on-tab-navigation: false;
            key-pressed(event) => {
                if event.text == Key.Escape { Editor.canvas-exit-cancel(); return accept; }
                return reject;
            }
            VerticalLayout {
                padding: 20px; spacing: 16px;
                Text {
                    text: Editor.canvas-exit-error != "" ? Editor.canvas-exit-error : "当前画布有未保存的修改。退出前请选择如何处理。";
                    color: Theme.fg; wrap: word-wrap;
                }
                HorizontalLayout { spacing: 8px; alignment: end;
                    AppButton { label: "取消"; clicked => { Editor.canvas-exit-cancel(); } }
                    AppButton { label: "放弃并退出"; danger: true; clicked => { Editor.canvas-exit-discard(); } }
                    AppButton { label: "保存并退出"; primary: true; clicked => { Editor.canvas-exit-save(); } }
                }
            }
        }
    }

    FlowDraftDialog { }
    FlowRecoveryDialog { }

    // Global floating UI stays above pages. Modal tasks temporarily hide the
    // panel and disable the entry; the host keeps the active-workspace rules.
    assistant-panel := AssistantFloating {
        dock-right: SeeCut.page == 8;
        room-width: root.width;
        room-height: root.height;
        animations-active: !root.minimized && Assistant.window-visible && Assistant.window-focused;
        visible: Assistant.enabled;
        enabled: !root.assistant-ui-blocked;
        blocked: root.assistant-ui-blocked;
        toggle-requested => { root.toggle-assistant(); }
        settled(expanded) => { root.assistant-focus-pending = true; }
        focus-on-tab-navigation: false;
        // This overlay is a sibling of the workspace keyboard scope. Preserve
        // its menu chords while the closed entry owns keyboard focus.
        KeyBinding {
            keys: @keys(Control + S);
            enabled: assistant-panel.fully-closed && root.clip-menu-shortcuts-active;
            activated => { root.app-menu-selected("save"); }
        }
        KeyBinding {
            keys: @keys(Control + Z);
            enabled: assistant-panel.fully-closed && root.clip-menu-shortcuts-active;
            activated => { root.app-menu-selected("undo"); }
        }
        KeyBinding {
            keys: @keys(Control + Shift + Z);
            enabled: assistant-panel.fully-closed && root.clip-menu-shortcuts-active;
            activated => { root.app-menu-selected("redo"); }
        }
        key-pressed(event) => {
            if assistant-panel.fully-closed { return keys.key-pressed(event); }
            if event.text == Key.Escape { Assistant.close-requested(); return EventResult.accept; }
            return assistant-panel.fully-open && (event.text == Key.Tab || event.text == Key.Backtab) ? EventResult.reject : EventResult.accept;
        }
        key-released(event) => {
            if event.text == Key.Space && root.canvas-space-hand { return keys.key-released(event); }
            return assistant-panel.fully-closed ? EventResult.reject : EventResult.accept;
        }
    }
    // Notices remain readable above the panel; reserve the launcher's corner.
    ToastLayer {
        width: root.width - (Assistant.enabled ? 84px : 0px);
        height: root.height;
        data: root.toast;
        bottom-offset: root.canvas-editor-active ? 80px : 16px;
    }
    WorkflowToast {
        width: root.width - (Assistant.enabled ? 84px : 0px);
        height: root.height;
        bottom-offset: root.canvas-editor-active ? 122px : 58px;
    }

}
