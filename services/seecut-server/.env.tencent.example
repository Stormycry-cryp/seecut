# SeeCut production template for Tencent Cloud SES + seecut.stormycry.cloud.
# Copy to the server's protected environment file and fill the values there.
SECUT_ENV=production
SECUT_HOST=127.0.0.1
SECUT_PORT=8798
SECUT_PUBLIC_BASE_URL=https://seecut.stormycry.cloud
SECUT_DATABASE_PATH=/var/lib/seecut/seecut.sqlite3
SECUT_STORAGE_PATH=/var/lib/seecut/storage
SECUT_SIGNING_SECRET=replace-with-at-least-32-random-bytes

# Tencent Cloud SES SMTP relay in ap-guangzhou. Before deployment, register
# seecut@mail.stormycry.cloud as a sender under the verified mail.stormycry.cloud
# domain, then create dedicated SMTP credentials for SeeCut.
SECUT_EMAIL_PROVIDER=smtp
SECUT_EMAIL_FROM=seecut@mail.stormycry.cloud
SECUT_SMTP_HOST=smtp.qcloudmail.com
SECUT_SMTP_PORT=587
SECUT_SMTP_USERNAME=replace-with-dedicated-seecut-smtp-username
SECUT_SMTP_PASSWORD=replace-with-dedicated-seecut-smtp-password
SECUT_SMTP_STARTTLS=true

# Keep provider credentials only on the server.
SECUT_XIANGXIN_BASE_URL=https://xiangxinai123.xyz
SECUT_XIANGXIN_API_KEY=replace-with-xiangxin-key
SECUT_IMAGE2_MODEL=gpt-image-2
SECUT_IMAGE2_API_KEY=replace-with-image2-key
SECUT_MODEL_PRICES_JSON={}
SECUT_EXPOSE_TEST_TOKENS=false

# Alipay is intentionally disabled until merchant settings are supplied.
SECUT_ALIPAY_APP_ID=
SECUT_ALIPAY_PUBLIC_KEY_PATH=
SECUT_ALIPAY_MERCHANT_PRIVATE_KEY_PATH=
SECUT_ALIPAY_NOTIFY_URL=
SECUT_ALIPAY_SELLER_ID=
