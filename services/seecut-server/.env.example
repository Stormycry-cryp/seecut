SECUT_ENV=development
SECUT_HOST=127.0.0.1
SECUT_PORT=8787
SECUT_PUBLIC_BASE_URL=http://127.0.0.1:8787
SECUT_DATABASE_PATH=./data/seecut.sqlite3
SECUT_STORAGE_PATH=./data/storage
SECUT_SIGNING_SECRET=replace-with-at-least-32-random-bytes
SECUT_SESSION_TTL_SECONDS=2592000
SECUT_INVITE_TTL_SECONDS=86400
SECUT_UPLOAD_TTL_SECONDS=3600
SECUT_MAX_UPLOAD_BYTES=536870912
SECUT_MODEL_PRICES_JSON={}

# Email: set provider to smtp when all SMTP fields are configured.
SECUT_EMAIL_PROVIDER=disabled
SECUT_EMAIL_FROM=
SECUT_SMTP_HOST=
SECUT_SMTP_PORT=587
SECUT_SMTP_USERNAME=
SECUT_SMTP_PASSWORD=
SECUT_SMTP_STARTTLS=true
SECUT_EXPOSE_TEST_TOKENS=false

# Xiangxin credentials remain on this server.
SECUT_XIANGXIN_BASE_URL=https://xiangxinai123.xyz
SECUT_XIANGXIN_API_KEY=
SECUT_IMAGE2_MODEL=gpt-image-2.5-flare
SECUT_IMAGE2_API_KEY=
SECUT_WORKER_INTERVAL_SECONDS=2
SECUT_PROVIDER_TIMEOUT_SECONDS=600
SECUT_MAX_PROVIDER_RESPONSE_BYTES=33554432
SECUT_MAX_REFERENCE_IMAGE_BYTES=20971520
SECUT_AUTH_RATE_LIMIT_PER_MINUTE=30
SECUT_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
SECUT_GENERATION_OUTPUT_TTL_SECONDS=86400
SECUT_CLEANUP_INTERVAL_SECONDS=60
SECUT_PROVIDER_RESULT_HOSTS=xiangxinai123.xyz,qwe.g-aisc.com

# Alipay web payment configuration.
SECUT_ALIPAY_APP_ID=
SECUT_ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
SECUT_ALIPAY_PUBLIC_KEY_PATH=
SECUT_ALIPAY_MERCHANT_PRIVATE_KEY_PATH=
SECUT_ALIPAY_NOTIFY_URL=
SECUT_ALIPAY_SELLER_ID=
