# Put this in the nginx http context.
limit_req_zone $binary_remote_addr zone=seecut_mcp:10m rate=1r/s;
log_format seecut_mcp_safe '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent $request_time';

server {
    listen 443 ssl;
    server_name mcp.seecut.example;
    ssl_certificate /etc/seecut/tls/fullchain.pem;
    ssl_certificate_key /etc/seecut/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log /var/log/nginx/seecut-mcp.access.log seecut_mcp_safe;
    client_max_body_size 64k;
    client_body_timeout 10s;
    limit_req_status 429;

    location = /mcp {
        limit_req zone=seecut_mcp burst=5 nodelay;
        proxy_pass http://127.0.0.1:8799/mcp;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        proxy_send_timeout 5s;
        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 8 32k;
    }

    location / { return 404; }
}
