# Include these limit zones once in the nginx http context.
limit_req_zone $binary_remote_addr zone=seecut_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=seecut_auth:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=seecut_connections:10m;

server {
    listen 443 ssl;
    server_name seecut.stormycry.cloud;
    ssl_certificate /etc/seecut/tls/fullchain.pem;
    ssl_certificate_key /etc/seecut/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 512m;
    client_body_timeout 30s;
    limit_conn seecut_connections 8;
    limit_req_status 429;

    location /api/auth/ {
        limit_req zone=seecut_auth burst=5 nodelay;
        proxy_pass http://127.0.0.1:8798;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }

    location / {
        limit_req zone=seecut_api burst=20 nodelay;
        proxy_pass http://127.0.0.1:8798;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }
}
